import { PaintedTagText } from "tag_text.slint";
// The manage tags window (F3): the files' tags on the tag service chosen,
// and an input whose tag, entered, is added to them (or, if they all have
// it, removed); double-clicking a listed tag removes it. Up and down move
// through the suggestions. Changes wait: enter with nothing typed (or
// "apply") applies them, escape (or "cancel") forgets them.

import { Button, ComboBox, ListView } from "std-widgets.slint";
import { WriteTagInput, TagMenuOverlay } from "write_autocomplete.slint";
import { Question } from "favourites.slint";
import { MenuPane } from "main_menu.slint";
import { ListText, Theme } from "theme.slint";
import { TagServicePanels } from "tag_service_panels.slint";
import { TagSuggestionPanels } from "tag_suggestions.slint";
import { TableRow } from "list_table.slint";

export component ManageTagsWindow inherits Window {
    in property <[MenuPane]> tag-menu-panes;
    in property <string> tag-menu-question;
    in property <string> tag-menu-question-title;
    in property <string> tag-menu-yes-label: "yes";
    in property <string> tag-menu-no-label: "no";
    callback tag-menu-hovered(int,int,length,length,length);
    callback tag-menu-clicked(int,int,length,length,length);
    callback tag-menu-placed(int,length,length,length);
    callback tag-menu-dismissed();
    callback tag-menu-answered(bool);

    // ("manage tags for 3 files" from the thumbnails, as the reference has it)
    in property <string> window-title: "manage tags";
    title: root.window-title;
    preferred-width: root.use-listbook ? 580px : 420px;
    preferred-height: 560px;
    background: Theme.window;

    in property <[string]> service-names;
    in property <bool> use-listbook;
    out property <float> service-content-offset: services.content-offset;
    in-out property <int> service-index;
    in property <[ListText]> tags;
    in property <int> sort-type;
    in property <int> sort-order;
    in property <int> sort-group;
    in property <int> sort-siblings;
    callback sort-chosen(int,int);
    out property <bool> sort-enabled: root.question == "" && root.tag-menu-panes.length == 0 && root.tag-menu-question == "";
    in property <string> deleted-count-label;
    in property <bool> deleted-count-visible;
    in property <bool> show-deleted;
    callback flip-show-deleted();
    in property <[ListText]> suggestions;
    in property <int> highlighted: -1;
    in property <[bool]> suggestion-selected;
    in property <int> autocomplete-tab;
    in property <string> error;
    in property <string> question;
    in property <int> autocomplete-height: 11;
    in-out property <string> text;

    public function normal-paste() { input.normal-paste(); }
    public function focus-input() { input.focus-input(); }
    out property <bool> input-focused: input.editor-focused;
    public function select-input(anchor: int, cursor: int) { input.select-input(anchor,cursor); }
    callback service-chosen(int);
    callback text-edited(string);
    callback fetch();
    callback tab-chosen(int);
    callback refresh-autocomplete();
    callback entered();
    callback suggestion-chosen(int);
    callback selection-clicked(int,bool,bool);
    callback context-menu(int,length,length);
    callback domain-menu(bool,length,length);
    in property <string> file-label;
    in property <string> tag-label;
    callback paste-requested(bool) -> bool;
    callback paste-answered(bool);
    callback move-highlight(int);
    callback navigate(int,bool,bool);
    callback results-action(int) -> bool;
    callback tag-activated(int);
    in property <bool> incremental-available;
    in property <bool> incremental-open;
    callback incremental-tags();
    callback migrate-tags();
    callback apply();
    callback cancel();
    in property <[TableRow]> most-used-rows;
    in property <[TableRow]> recent-tag-rows;
    in property <bool> most-used-enabled;
    in property <bool> recent-tags-enabled;
    in property <[TableRow]> related-tag-rows;
    in property <bool> related-tags-enabled;
    in property <string> related-status;
    in-out property <bool> related-local:true;
    in-out property <bool> related-display:true;
    callback related-search();
    in property <bool> suggested-columns;
    in property <length> suggested-width:300px;
    in-out property <int> suggested-page;
    callback side-clicked(int,int,bool,bool);
    callback side-activated(int,int);

    forward-focus: input;
    FocusScope {
        enabled: !root.incremental-open;
        capture-key-pressed(event) => {
            if (event.text == Key.Escape) {
                if root.tag-menu-panes.length > 0 || root.tag-menu-question != "" { root.tag-menu-dismissed(); } else if !input.escape-results() { root.cancel(); }
                return accept;
            }
            reject
        }
        services := TagServicePanels {
            names: root.service-names;
            index: root.service-index;
            use-listbook: root.use-listbook;
            chosen(i) => { root.service-chosen(i); }
            HorizontalLayout {
              VerticalLayout {
                padding: 8px;
                spacing: 6px;
                VerticalLayout {
                    ComboBox { enabled:root.sort-enabled;model:["sort by tag","sort by subtag","sort by count"];current-index:root.sort-type;selected=>{root.sort-chosen(0,self.current-index);} }
                    ComboBox { enabled:root.sort-enabled;model:root.sort-type == 2 ? ["most first","fewest first"] : ["a-z","z-a"];current-index:root.sort-order;selected=>{root.sort-chosen(1,self.current-index);} }
                    if root.sort-type != 2: ComboBox { enabled:root.sort-enabled;model:["siblings","tags"];current-index:root.sort-siblings;selected=>{root.sort-chosen(3,self.current-index);} }
                    if root.sort-type != 1: ComboBox { enabled:root.sort-enabled;model:["no grouping","namespace (a-z)","namespace (user)"];current-index:root.sort-group;selected=>{root.sort-chosen(2,self.current-index);} }
                }
                Rectangle {
                    border-width: 1px;
                    border-color: Theme.border;
                    background: Theme.panel;
                    vertical-stretch: 1;
                    ListView {
                        for tag[i] in root.tags: Rectangle {
                            height: 20px;
                            background: pick.has-hover ? Theme.hover : transparent;
                            PaintedTagText { x:4px;item:tag;width:parent.width - 8px;height:parent.height; }
                            pick := TouchArea {
                                double-clicked => { root.tag-activated(i); }
                            }
                        }
                    }
                }
                if root.incremental-available: Button { text: "± Incremental Tagging"; enabled: root.question == ""; clicked => { root.incremental-tags(); } }
                if root.deleted-count-visible: HorizontalLayout {
                    alignment: end;
                    spacing: 6px;
                    Text { text: root.deleted-count-label; color: Theme.text; vertical-alignment: center; }
                    Button {
                        text: root.show-deleted ? "hide deleted mappings" : "show deleted mappings";
                        enabled: root.question == "";
                        clicked => { root.flip-show-deleted(); }
                    }
                }
                input := WriteTagInput {
                    enabled: root.question == "";
                    text <=> root.text;
                    suggestions: root.suggestions;
                    highlighted: root.highlighted;
                    selected: root.suggestion-selected;
                    tab-index: root.autocomplete-tab;
                    tab-chosen(i) => { root.tab-chosen(i); }
                    list-height: root.autocomplete-height;
                    edited(text) => { root.text-edited(text); }
                    entered => { root.entered(); }
                    fetch => { root.fetch(); }
                    move-highlight(by) => { root.move-highlight(by); }
                    navigate(d,ctrl,shift) => { root.navigate(d,ctrl,shift); }
                    results-action(a) => { root.results-action(a) }
                    chosen(i) => { root.suggestion-chosen(i); }
                    selection-clicked(i,ctrl,shift) => { root.selection-clicked(i,ctrl,shift); }
                    context-menu(i,x,y) => { root.context-menu(i,x,y); }
                    file-label:root.file-label;tag-label:root.tag-label;
                    domain-menu(tags,x,y)=>{root.domain-menu(tags,x,y);}
                    paste(button) => { root.paste-requested(button) }
                }
                if root.question != "": Text { text: "Want to paste everything?"; color: Theme.text; }
                if root.question != "": Question { text: root.question; answered(yes) => { root.paste-answered(yes); } }
                if root.error != "": Text {
                    text: root.error;
                    color: Theme.error;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: end;
                    Button {text: "migrate tags…"; clicked => {root.migrate-tags();}}
                    Button {
                        enabled: root.question == "";
                        text: "apply";
                        clicked => { root.apply(); }
                    }
                    Button {
                        text: "cancel";
                        clicked => { root.cancel(); }
                    }
                }
              }
              if root.most-used-enabled || root.recent-tags-enabled || root.related-tags-enabled: TagSuggestionPanels {
                most-used:root.most-used-rows;recent:root.recent-tag-rows;
                most-used-enabled:root.most-used-enabled;recent-enabled:root.recent-tags-enabled;
                related:root.related-tag-rows;related-enabled:root.related-tags-enabled;related-status:root.related-status;
                related-local<=>root.related-local;related-display<=>root.related-display;related-search=>{root.related-search();}
                columns:root.suggested-columns;column-width:root.suggested-width;selected:root.suggested-page;
                selected-page(i)=>{root.suggested-page=i;}
                clicked(p,i,c,s)=>{root.side-clicked(p,i,c,s);}
                activated(p,i)=>{root.side-activated(p,i);}
                enabled:root.question=="";
              }
            }
        }

        if root.tag-menu-panes.length > 0 || root.tag-menu-question != "": TagMenuOverlay {
            width: root.width; height: root.height;
            panes: root.tag-menu-panes; question: root.tag-menu-question;
            question-title: root.tag-menu-question-title; yes-label: root.tag-menu-yes-label; no-label: root.tag-menu-no-label;
            hovered(p,l,r,t,x) => { root.tag-menu-hovered(p,l,r,t,x); }
            clicked(p,l,r,t,x) => { root.tag-menu-clicked(p,l,r,t,x); }
            placed(p,x,y,w) => { root.tag-menu-placed(p,x,y,w); }
            dismissed => { root.tag-menu-dismissed(); }
            answered(yes) => { root.tag-menu-answered(yes); }
        }
    }
    if root.incremental-open: Rectangle { width: root.width; height: root.height; background: transparent; TouchArea { } }
}
