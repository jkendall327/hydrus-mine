// The media viewer's window: one file, fitted to the window. Right and left
// (or page down and up, or the mouse wheel) move through the page's files;
// space pauses and plays video; escape closes it. With the pointer over the
// window's left fifth, the file's tags show there, as the reference's tags
// hover frame does.

import { ListText } from "theme.slint";

export component MediaViewerWindow inherits Window {
    title: root.caption;
    preferred-width: 1000px;
    preferred-height: 750px;
    background: #202020;

    in property <image> media;
    in property <string> caption;
    // the file's tags, for the hover frame
    in property <[ListText]> tags;
    out property <bool> tags-showing: pointer.has-hover && pointer.mouse-x < root.width * 0.2 && root.tags.length > 0;

    callback next();
    callback previous();
    callback close-requested();
    callback toggle-pause();

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.RightArrow || event.text == Key.PageDown) {
                root.next();
                return accept;
            }
            if (event.text == Key.LeftArrow || event.text == Key.PageUp) {
                root.previous();
                return accept;
            }
            if (event.text == " ") {
                root.toggle-pause();
                return accept;
            }
            if (event.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            reject
        }
        Image {
            width: 100%;
            height: 100%;
            source: root.media;
            image-fit: contain;
        }
        pointer := TouchArea {
            scroll-event(event) => {
                if (event.delta-y < 0) {
                    root.next();
                } else if (event.delta-y > 0) {
                    root.previous();
                }
                accept
            }
        }
        // (nothing in it takes the pointer, so the area above keeps it)
        if root.tags-showing: Rectangle {
            x: 0;
            y: 0;
            width: root.width * 0.2;
            height: root.height;
            background: #202020e8;
            clip: true;
            VerticalLayout {
                padding: 6px;
                spacing: 2px;
                alignment: start;
                for tag in root.tags: Text {
                    text: tag.text;
                    color: tag.colour;
                    overflow: elide;
                }
            }
        }
    }
}
