// The media viewer's window: one file, at its default zoom (fitted to the
// window, by default). Right and left (or page down and up, or the mouse
// wheel) move through the page's files; space pauses and plays video;
// escape or enter closes it. As the reference's default shortcuts have it,
// z switches between 100% and fitting the window, + and - (or ctrl and the
// mouse wheel) zoom in and out, and shift and the arrow keys (or dragging)
// move the file. F3 manages the file's tags. F7 archives the file and
// shift+F7 returns it to the inbox; delete deletes it (asking first: enter
// or escape answers) and shift+delete undeletes it. With the pointer over the
// window's left fifth, the file's tags show there, as the reference's tags
// hover frame does.

import { ListText } from "theme.slint";

export component MediaViewerWindow inherits Window {
    title: root.caption;
    preferred-width: 1000px;
    preferred-height: 750px;
    background: #202020;

    in property <image> media;
    in property <string> caption;
    // the file's tags, for the hover frame
    in property <[ListText]> tags;
    out property <bool> tags-showing: pointer.has-hover && pointer.mouse-x < root.width * 0.2 && root.tags.length > 0;

    // a question to answer (a deletion): enter is yes, escape no
    in property <string> question;

    // where the file is drawn: its box at its zoom
    in property <length> media-x;
    in property <length> media-y;
    in property <length> media-width: root.width;
    in property <length> media-height: root.height;
    // the still drawn sharply over it, once rendered (see still.rs)
    in property <image> sharp;
    in property <bool> sharp-shown;
    in property <bool> sharp-opaque: true;
    in property <length> sharp-x;
    in property <length> sharp-y;
    in property <length> sharp-width;
    in property <length> sharp-height;
    // where a drag last was
    property <length> drag-x;
    property <length> drag-y;

    callback next();
    callback previous();
    callback close-requested();
    callback toggle-pause();
    callback archive();
    callback inbox();
    callback delete();
    callback undelete();
    callback answer(bool);
    callback manage-tags();
    // zoom in (1), out (-1) or switch (0), about the pointer if it is over
    // the window
    callback zoom(int, bool, length, length);
    callback pan(int, int);
    callback drag(length, length);
    callback canvas-resized(length, length);

    changed width => { root.canvas-resized(self.width, self.height); }
    changed height => { root.canvas-resized(self.width, self.height); }

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (root.question != "") {
                if (event.text == Key.Return) {
                    root.answer(true);
                } else if (event.text == Key.Escape) {
                    root.answer(false);
                }
                return accept;
            }
            if (event.text == Key.F3) {
                root.manage-tags();
                return accept;
            }
            if (event.text == Key.F7) {
                if (event.modifiers.shift) {
                    root.inbox();
                } else {
                    root.archive();
                }
                return accept;
            }
            if (event.text == Key.Delete) {
                if (event.modifiers.shift) {
                    root.undelete();
                } else {
                    root.delete();
                }
                return accept;
            }
            if (event.modifiers.shift) {
                if (event.text == Key.UpArrow) {
                    root.pan(0, -1);
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    root.pan(0, 1);
                    return accept;
                }
                if (event.text == Key.LeftArrow) {
                    root.pan(-1, 0);
                    return accept;
                }
                if (event.text == Key.RightArrow) {
                    root.pan(1, 0);
                    return accept;
                }
            }
            if ((event.text == "z" || event.text == "Z") && !event.modifiers.control && !event.modifiers.alt) {
                root.zoom(0, pointer.has-hover, pointer.mouse-x, pointer.mouse-y);
                return accept;
            }
            if (event.text == "+") {
                root.zoom(1, pointer.has-hover, pointer.mouse-x, pointer.mouse-y);
                return accept;
            }
            if (event.text == "-") {
                root.zoom(-1, pointer.has-hover, pointer.mouse-x, pointer.mouse-y);
                return accept;
            }
            if (event.text == Key.RightArrow || event.text == Key.PageDown) {
                root.next();
                return accept;
            }
            if (event.text == Key.LeftArrow || event.text == Key.PageUp) {
                root.previous();
                return accept;
            }
            if (event.text == " ") {
                root.toggle-pause();
                return accept;
            }
            if (event.text == Key.Escape || event.text == Key.Return) {
                root.close-requested();
                return accept;
            }
            reject
        }
        Image {
            x: root.media-x;
            y: root.media-y;
            width: root.media-width;
            height: root.media-height;
            source: root.media;
            visible: !root.sharp-shown || root.sharp-opaque;
            image-fit: contain;
        }
        if root.sharp-shown: Image {
            x: root.sharp-x;
            y: root.sharp-y;
            width: root.sharp-width;
            height: root.sharp-height;
            source: root.sharp;
            image-fit: fill;
        }
        pointer := TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.drag-x = self.mouse-x;
                    root.drag-y = self.mouse-y;
                }
            }
            moved => {
                root.drag(self.mouse-x - root.drag-x, self.mouse-y - root.drag-y);
                root.drag-x = self.mouse-x;
                root.drag-y = self.mouse-y;
            }
            scroll-event(event) => {
                if (event.modifiers.control) {
                    if (event.delta-y > 0) {
                        root.zoom(1, true, self.mouse-x, self.mouse-y);
                    } else if (event.delta-y < 0) {
                        root.zoom(-1, true, self.mouse-x, self.mouse-y);
                    }
                    return accept;
                }
                if (event.delta-y < 0) {
                    root.next();
                } else if (event.delta-y > 0) {
                    root.previous();
                }
                accept
            }
        }
        if root.question != "": Rectangle {
            width: min(root.width - 40px, 420px);
            height: 90px;
            background: #303030;
            border-width: 1px;
            border-color: #606060;
            border-radius: 4px;
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                Text {
                    text: root.question;
                    color: #f0f0f0;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
                Text {
                    text: "enter: yes, escape: no";
                    color: #a0a0a0;
                    horizontal-alignment: center;
                }
            }
        }
        // (nothing in it takes the pointer, so the area above keeps it)
        if root.tags-showing: Rectangle {
            x: 0;
            y: 0;
            width: root.width * 0.2;
            height: root.height;
            background: #202020e8;
            clip: true;
            VerticalLayout {
                padding: 6px;
                spacing: 2px;
                alignment: start;
                for tag in root.tags: Text {
                    text: tag.text;
                    color: tag.colour;
                    overflow: elide;
                }
            }
        }
    }
}
