// The media viewer's window: one file, fitted to the window. Right and left
// (or page down and up, or the mouse wheel) move through the page's files;
// space pauses and plays video; escape closes it. F3 manages the file's
// tags. F7 archives the file and
// shift+F7 returns it to the inbox; delete deletes it (asking first: enter
// or escape answers) and shift+delete undeletes it. With the pointer over the
// window's left fifth, the file's tags show there, as the reference's tags
// hover frame does.

import { ListText } from "theme.slint";

export component MediaViewerWindow inherits Window {
    title: root.caption;
    preferred-width: 1000px;
    preferred-height: 750px;
    background: #202020;

    in property <image> media;
    in property <string> caption;
    // the file's tags, for the hover frame
    in property <[ListText]> tags;
    out property <bool> tags-showing: pointer.has-hover && pointer.mouse-x < root.width * 0.2 && root.tags.length > 0;

    // a question to answer (a deletion): enter is yes, escape no
    in property <string> question;

    callback next();
    callback previous();
    callback close-requested();
    callback toggle-pause();
    callback archive();
    callback inbox();
    callback delete();
    callback undelete();
    callback answer(bool);
    callback manage-tags();

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (root.question != "") {
                if (event.text == Key.Return) {
                    root.answer(true);
                } else if (event.text == Key.Escape) {
                    root.answer(false);
                }
                return accept;
            }
            if (event.text == Key.F3) {
                root.manage-tags();
                return accept;
            }
            if (event.text == Key.F7) {
                if (event.modifiers.shift) {
                    root.inbox();
                } else {
                    root.archive();
                }
                return accept;
            }
            if (event.text == Key.Delete) {
                if (event.modifiers.shift) {
                    root.undelete();
                } else {
                    root.delete();
                }
                return accept;
            }
            if (event.text == Key.RightArrow || event.text == Key.PageDown) {
                root.next();
                return accept;
            }
            if (event.text == Key.LeftArrow || event.text == Key.PageUp) {
                root.previous();
                return accept;
            }
            if (event.text == " ") {
                root.toggle-pause();
                return accept;
            }
            if (event.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            reject
        }
        Image {
            width: 100%;
            height: 100%;
            source: root.media;
            image-fit: contain;
        }
        pointer := TouchArea {
            scroll-event(event) => {
                if (event.delta-y < 0) {
                    root.next();
                } else if (event.delta-y > 0) {
                    root.previous();
                }
                accept
            }
        }
        if root.question != "": Rectangle {
            width: min(root.width - 40px, 420px);
            height: 90px;
            background: #303030;
            border-width: 1px;
            border-color: #606060;
            border-radius: 4px;
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                Text {
                    text: root.question;
                    color: #f0f0f0;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
                Text {
                    text: "enter: yes, escape: no";
                    color: #a0a0a0;
                    horizontal-alignment: center;
                }
            }
        }
        // (nothing in it takes the pointer, so the area above keeps it)
        if root.tags-showing: Rectangle {
            x: 0;
            y: 0;
            width: root.width * 0.2;
            height: root.height;
            background: #202020e8;
            clip: true;
            VerticalLayout {
                padding: 6px;
                spacing: 2px;
                alignment: start;
                for tag in root.tags: Text {
                    text: tag.text;
                    color: tag.colour;
                    overflow: elide;
                }
            }
        }
    }
}
