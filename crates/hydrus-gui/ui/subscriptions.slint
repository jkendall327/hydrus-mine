import { Btn } from "btn.slint";
// The manage subscriptions dialog (network > subscriptions…; the
// reference's `EditSubscriptionsPanel`, bound by
// `src/subscriptions_window.rs`): the subscriptions list, the buttons
// hydrus-rs has so far (add and edit open `edit_subscription.slint`), and
// the questions they ask, held until "apply".

import { Button, CheckBox, LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ImportFavouriteRow, ImportFavouritesButton } from "import_options_favourites.slint";
import { ListTable, TableColumn, TableRow } from "list_table.slint";

// The list's original three transport choices (full selected package).
export component SubscriptionExchangeButton inherits ContextMenuArea {
    in property <string> label;
    in property <[string]> choices;
    in property <bool> available;
    callback selected(int);
    preferred-width: button.preferred-width;
    preferred-height: button.preferred-height;
    enabled: root.available;
    Menu {
        for choice[i] in root.choices: MenuItem { title: choice; activated => { root.selected(i); } }
    }
    button := Btn {
        width: parent.width; height: parent.height;
        text: root.label; enabled: root.available;
        clicked => { root.show({ x: 0px, y: self.height }); }
    }
}

// A question asked in a window (the reference's quick dialogs): its title
// and message, and its answers as buttons (`SelectFromListButtons`, a
// yes/no), or a text box to fill in (`EnterText`, whose first button is
// "ok"), or boxes to tick (`SelectMultipleFromList`). Escape or "cancel"
// closes it unanswered.
export struct Tick {
    label: string,
    on: bool,
}

export component Asking inherits Rectangle {
    in property <string> title;
    in property <string> message;
    in property <[string]> choices;
    in property <bool> wants-text;
    in-out property <string> text;
    in property <[Tick]> ticks;
    callback chosen(int);
    callback cancelled();
    callback ticked(int, bool);
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.panel;
    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        Text {
            text: root.title;
            font-weight: 700;
            color: Theme.text;
        }
        Text {
            text: root.message;
            wrap: word-wrap;
            color: Theme.text;
        }
        if root.wants-text: LineEdit {
            text <=> root.text;
            accepted => { root.chosen(0); }
        }
        for tick[i] in root.ticks: CheckBox {
            text: tick.label;
            checked: tick.on;
            toggled => { root.ticked(i, self.checked); }
        }
        HorizontalLayout {
            spacing: 6px;
            alignment: end;
            for choice[i] in root.choices: Btn {
                text: choice;
                clicked => { root.chosen(i); }
            }
            Btn {
                text: "cancel";
                clicked => { root.cancelled(); }
            }
        }
    }
}

// SelectGUGKeyAndName uses a separate list dialog, even for one gallery.
export component SubscriptionGalleryWindow inherits Window {
    in property <string> window-title: "select gallery";
    title: root.window-title;
    preferred-width: 420px;
    preferred-height: root.message == "" ? 320px : 180px;
    background: Theme.window;
    in property <[string]> galleries;
    in-out property <int> selected: 0;
    in property <string> message;
    callback accept-clicked();
    callback cancel();
    forward-focus: keys;
    keys := FocusScope {
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); return accept; }
            if event.text == Key.Return { root.accept-clicked(); return accept; }
            if event.text == Key.DownArrow { root.selected = min(root.galleries.length - 1, root.selected + 1); return accept; }
            if event.text == Key.UpArrow { root.selected = max(0, root.selected - 1); return accept; }
            reject
        }
        VerticalLayout {
            padding: 8px;
            spacing: 6px;
            if root.message != "": Text {
                text: root.message;
                wrap: word-wrap;
                color: Theme.text;
            }
            if root.message == "": ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start;
                    for gallery[index] in root.galleries: Rectangle {
                        height: 26px;
                        background: index == root.selected ? Theme.highlight : Theme.panel;
                        Text {
                            x: 6px;
                            text: gallery;
                            vertical-alignment: center;
                            color: index == root.selected ? Theme.highlight-text : Theme.text;
                        }
                        TouchArea {
                            clicked => { root.selected = index; }
                            double-clicked => { root.selected = index; root.accept-clicked(); }
                        }
                    }
                }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 6px;
                Btn { text: "ok"; clicked => { root.accept-clicked(); } }
                if root.message == "": Btn { text: "cancel"; clicked => { root.cancel(); } }
            }
        }
    }
}

export component SubscriptionsWindow inherits Window {
    in property <string> window-title: "manage subscriptions";
    title: root.window-title;
    preferred-width: 1180px;
    preferred-height: 560px;
    background: Theme.window;
    in property <bool> gallery-open;
    in property <bool> exchange-open;
    callback exchange(bool);
    callback exchange-mode(int);
    in property <[string]> exchange-export-labels: ["to clipboard", "to json file", "to png file"];
    in property <[string]> exchange-import-labels: ["from clipboard", "from json files", "from png files (you can also drag and drop pngs onto this list)"];
    in-out property <string> import-status;
    // subscriptions paused from the network menu
    in property <bool> globally-paused;
    in property <[TableRow]> rows;
    in property <int> sort-column;
    in property <bool> ascending: true;
    // what the buttons can do for the selection
    in property <bool> any-selected;
    in property <bool> one-selected;
    in property <bool> can-check-now;
    in property <bool> can-scrub-delays;
    in property <bool> can-merge;
    in property <bool> can-separate;
    in property <bool> can-lowercase;
    in property <bool> can-reset;
    in property <bool> can-retry-failed;
    in property <bool> can-retry-ignored;
    // a question waiting on an answer
    in property <bool> asking;
    in property <string> asking-title;
    in property <string> asking-message;
    in property <[string]> asking-choices;
    in property <bool> asking-text;
    in-out property <string> asked-text;
    in property <[Tick]> asking-ticks;
    in property <bool> can-dedupe;
    callback sort(int, bool);
    // (row, ctrl held, shift held)
    callback row-clicked(int, bool, bool);
    callback row-activated(int);
    callback add();
    callback edit();
    callback delete();
    callback pause-resume();
    callback scrub-delays();
    callback check-now();
    callback merge();
    callback separate();
    callback lowercase();
    callback reset();
    callback retry-failed();
    callback retry-ignored();
    callback overwrite-downloader();
    callback overwrite-checker();
    callback select-subscriptions();
    callback deduplicate();
    callback duplicate();
    in property <[ImportFavouriteRow]> favourites;
    in property <bool> import-child-open;
    callback refresh-favourites();
    callback favourite(int, string);
    callback copy-import-options();
    callback paste-import-options(int);
    callback clear-import-options();
    callback chosen(int);
    callback cancelled();
    callback ticked(int, bool);
    callback apply();
    callback cancel();

    forward-focus: keys;
    Timer {
        interval: 3s;
        running: root.import-status != "";
        triggered => { root.import-status = ""; }
    }
    keys := FocusScope {
        capture-key-pressed(event) => {
            if root.gallery-open { return accept; }
            reject
        }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.asking) {
                    root.cancelled();
                } else {
                    root.cancel();
                }
                return accept;
            }
            reject
        }
        VerticalLayout {
            padding: 8px;
            spacing: 6px;
            if root.globally-paused: Text {
                text: "SUBSCRIPTIONS ARE CURRENTLY GLOBALLY PAUSED! CHECK THE NETWORK MENU TO UNPAUSE THEM.";
                color: Theme.error;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            ListTable {
                min-height: 12 * 22px;
                vertical-stretch: 1;
                // (the reference's widths, in characters)
                columns: [
                    { title: "name", width: 140px, stretch: true },
                    { title: "source", width: 140px },
                    { title: "status", width: 175px },
                    { title: "last new file time", width: 130px },
                    { title: "last checked", width: 130px },
                    { title: "error/delay?", width: 112px },
                    { title: "items", width: 91px },
                    { title: "paused", width: 56px },
                    { title: "custom import options", width: 168px },
                ];
                rows: root.rows;
                sort-column: root.sort-column;
                ascending: root.ascending;
                sort(column, ascending) => { if !root.gallery-open { root.sort(column, ascending); } }
                row-clicked(row, ctrl, shift) => { if !root.gallery-open { root.row-clicked(row, ctrl, shift); } }
                row-activated(row) => { if !root.asking && !root.gallery-open { root.row-activated(row); } }
                delete-pressed => { if root.any-selected && !root.gallery-open { root.delete(); } }
            }
            // the reference's button rows, as far as hydrus-rs has them
            HorizontalLayout {
                spacing: 6px;
                alignment: end;
                Btn {
                    text: "add";
                    enabled: !root.asking && !root.gallery-open && !root.import-child-open && !root.exchange-open;
                    clicked => { root.add(); }
                }
                Btn {
                    text: "edit";
                    enabled: root.one-selected && !root.asking && !root.gallery-open && !root.import-child-open && !root.exchange-open;
                    clicked => { root.edit(); }
                }
                Btn {
                    text: "delete";
                    enabled: root.any-selected && !root.asking && !root.gallery-open && !root.import-child-open && !root.exchange-open;
                    clicked => { root.delete(); }
                }
                SubscriptionExchangeButton { label: "export"; choices: root.exchange-export-labels; available: root.any-selected && !root.asking && !root.gallery-open && !root.import-child-open && !root.exchange-open; selected(mode) => { root.exchange-mode(mode); } }
                SubscriptionExchangeButton { label: "import"; choices: root.exchange-import-labels; available: !root.asking && !root.gallery-open && !root.import-child-open && !root.exchange-open; selected(mode) => { root.exchange-mode(mode + 3); } }
                Rectangle { width: 12px; }
                Btn {
                    text: "duplicate";
                    enabled: root.any-selected && !root.asking && !root.gallery-open && !root.import-child-open && !root.exchange-open;
                    clicked => { root.duplicate(); }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: end;
                Btn {
                    text: "merge";
                    enabled: root.can-merge && !root.asking && !root.gallery-open && !root.import-child-open && !root.exchange-open;
                    clicked => { root.merge(); }
                }
                Btn {
                    text: "separate";
                    enabled: root.can-separate && !root.asking && !root.gallery-open && !root.import-child-open && !root.exchange-open;
                    clicked => { root.separate(); }
                }
                Btn {
                    text: "deduplicate";
                    enabled: root.can-dedupe && !root.asking && !root.gallery-open && !root.import-child-open && !root.exchange-open;
                    clicked => { root.deduplicate(); }
                }
                Btn {
                    text: "lowercase";
                    enabled: root.can-lowercase && !root.asking && !root.gallery-open && !root.import-child-open && !root.exchange-open;
                    clicked => { root.lowercase(); }
                }
                Rectangle { width: 12px; }
                Btn {
                    text: "pause/resume";
                    enabled: root.any-selected && !root.asking && !root.gallery-open && !root.import-child-open && !root.exchange-open;
                    clicked => { root.pause-resume(); }
                }
                Btn {
                    text: "scrub delays";
                    enabled: root.can-scrub-delays && !root.asking && !root.gallery-open && !root.import-child-open && !root.exchange-open;
                    clicked => { root.scrub-delays(); }
                }
                Btn {
                    text: "check queries now";
                    enabled: root.can-check-now && !root.asking && !root.gallery-open && !root.import-child-open && !root.exchange-open;
                    clicked => { root.check-now(); }
                }
                if root.can-retry-failed: Btn {
                    text: "retry failed";
                    enabled: !root.asking && !root.gallery-open && !root.import-child-open && !root.exchange-open;
                    clicked => { root.retry-failed(); }
                }
                if root.can-retry-ignored: Btn {
                    text: "retry ignored";
                    enabled: !root.asking && !root.gallery-open && !root.import-child-open && !root.exchange-open;
                    clicked => { root.retry-ignored(); }
                }
                Btn {
                    text: "reset";
                    enabled: root.can-reset && !root.asking && !root.gallery-open && !root.import-child-open && !root.exchange-open;
                    clicked => { root.reset(); }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: end;
                Btn {
                    text: "select subscriptions";
                    enabled: !root.asking && !root.gallery-open && !root.import-child-open && !root.exchange-open;
                    clicked => { root.select-subscriptions(); }
                }
                Btn {
                    text: "overwrite downloader";
                    enabled: root.any-selected && !root.asking && !root.gallery-open && !root.import-child-open && !root.exchange-open;
                    clicked => { root.overwrite-downloader(); }
                }
                Btn {
                    text: "overwrite checker options";
                    enabled: root.any-selected && !root.asking && !root.gallery-open && !root.import-child-open && !root.exchange-open;
                    clicked => { root.overwrite-checker(); }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: end;
                ImportFavouritesButton {
                    rows: root.favourites; save-current-allowed: false;
                    enabled: !root.asking && !root.gallery-open && !root.import-child-open && !root.exchange-open;
                    refresh => { root.refresh-favourites(); }
                    selected(action, name) => { root.favourite(action, name); }
                }
                Text { text: "import options:"; color: Theme.text; vertical-alignment: center; }
                Text { text: root.import-status; color: Theme.text; vertical-alignment: center; }
                Btn {
                    text: "copy";
                    enabled: root.one-selected && !root.asking && !root.gallery-open && !root.import-child-open && !root.exchange-open;
                    clicked => { root.copy-import-options(); }
                }
                Rectangle {
                    width: 66px;
                    height: 28px;
                    Btn {
                        width: parent.width;
                        height: parent.height;
                        text: "paste";
                        enabled: root.any-selected && !root.asking && !root.gallery-open && !root.import-child-open && !root.exchange-open;
                        clicked => { paste-menu.show(); }
                    }
                    paste-menu := PopupWindow {
                        y: parent.height;
                        width: 300px;
                        height: 148px;
                        Rectangle {
                            background: Theme.panel;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 4px;
                                spacing: 2px;
                                Btn { text: "custom paste: choose what you want"; clicked => { paste-menu.close(); root.paste-import-options(3); } }
                                Rectangle { height: 1px; background: Theme.border; }
                                Btn { text: "merge-paste"; clicked => { paste-menu.close(); root.paste-import-options(0); } }
                                Btn { text: "fill-in-gaps-paste"; clicked => { paste-menu.close(); root.paste-import-options(1); } }
                                Btn { text: "replace-paste"; clicked => { paste-menu.close(); root.paste-import-options(2); } }
                            }
                        }
                    }
                }
                Btn {
                    text: "clear";
                    enabled: root.any-selected && !root.asking && !root.gallery-open && !root.import-child-open && !root.exchange-open;
                    clicked => { root.clear-import-options(); }
                }
            }
            if root.asking: Asking {
                title: root.asking-title;
                message: root.asking-message;
                choices: root.asking-choices;
                wants-text: root.asking-text;
                text <=> root.asked-text;
                ticks: root.asking-ticks;
                chosen(index) => { root.chosen(index); }
                cancelled => { root.cancelled(); }
                ticked(index, on) => { root.ticked(index, on); }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 6px;
                Btn {
                    text: "apply";
                    enabled: !root.asking && !root.gallery-open && !root.import-child-open && !root.exchange-open;
                    clicked => { root.apply(); }
                }
                Btn {
                    text: "cancel";
                    enabled: !root.gallery-open && !root.import-child-open && !root.exchange-open;
                    clicked => { root.cancel(); }
                }
            }
        }
    }
}
