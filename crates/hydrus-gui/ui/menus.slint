// The right-click menus' rows, laid into the windows' fixed templates.

// The thumbnails' right-click menu, laid into a fixed template (a menu's
// markup can't mix items, submenus and separators from one list): each
// part's items, and a submenu's runs between separators as groups.
export struct MenuRow {
    label: string,
    id: int,
    // an item checked or not (the slideshow's)
    checkable: bool,
    checked: bool,
}

export struct MenuGroups {
    g1: [MenuRow],
    g2: [MenuRow],
    g3: [MenuRow],
    g4: [MenuRow],
    g5: [MenuRow],
    g6: [MenuRow],
}

export struct ThumbnailMenu {
    // the selection's info: a label alone, or a submenu of labels (one
    // submenu among them), then the views' labels or their summed submenu
    info-title: string,
    info-title-id: int,
    info-is-menu: bool,
    info-before: [MenuRow],
    info-sub-title: string,
    info-sub: [MenuRow],
    info-after: [MenuRow],
    views: [MenuRow],
    views-sub-title: string,
    views-sub: [MenuRow],
    head: [MenuRow],
    has-select: bool,
    select: MenuGroups,
    has-remove: bool,
    remove: MenuGroups,
    has-rearrange: bool,
    rearrange: [MenuRow],
    filter: [MenuRow],
    delete: [MenuRow],
    delete-title: string,
    delete-menu: [MenuRow],
    trash: [MenuRow],
    manage: [MenuRow],
    // manage's submenus: maintenance, viewing stats, and file
    // relationships (its runs before the merge options submenu, that
    // submenu, the run after it, and its remove and reset submenus)
    manage-maintenance: [MenuRow],
    manage-viewing: [MenuRow],
    has-relationships: bool,
    rel-b1: [MenuRow],
    rel-b2: [MenuRow],
    rel-b3: [MenuRow],
    rel-b4: [MenuRow],
    rel-merge: [MenuRow],
    rel-after: [MenuRow],
    rel-remove-one: [MenuRow],
    rel-reset-one-a: [MenuRow],
    rel-reset-one-b: [MenuRow],
    rel-remove-all: [MenuRow],
    rel-reset-all-a: [MenuRow],
    rel-reset-all-b: [MenuRow],
    rel-reset-all-c: [MenuRow],
    locations-current: [MenuRow],
    locations-copy: [MenuRow],
    locations-merge: [MenuRow],
    locations-move: [MenuRow],

    // the open menu: its first rows and similar files submenu, then the
    // focused file's
    // the urls menu: manage, then, if there are URLs to offer, open in
    // browser, open in a new page, and copy
    has-urls: bool,
    // the info menu's "show detailed embedded file metadata" (-1 for none)
    info-metadata: int,
    urls-manage: int,
    has-url-lists: bool,
    urls-visit: MenuGroups,
    has-url-pages: bool,
    urls-pages: MenuGroups,
    urls-copy: MenuGroups,
    has-open: bool,
    open-a: [MenuRow],
    open-similar-title: string,
    open-similar: [MenuRow],
    open-b: [MenuRow],
    // the share menu: the selection's rows, copy hashes and file ids; then
    // the focused file's path, copy hash and file id
    has-share: bool,
    share-export: [MenuRow],
    share-a: [MenuRow],
    share-hashes-title: string,
    share-hashes: [MenuRow],
    share-b: [MenuRow],
    share-c: [MenuRow],
    share-hash-title: string,
    share-hash: [MenuRow],
    share-d: [MenuRow],
    // the media viewer's own: its zoom submenu, the slideshow and volume
    // submenus' groups, "remove from view", and what plays the file
    zoom-title: string,
    zoom: [MenuRow],
    slideshow-title: string,
    slideshow: MenuGroups,
    has-volume: bool,
    volume: MenuGroups,
    dismiss: [MenuRow],
    player-title: string,
    player: [MenuRow],
}
