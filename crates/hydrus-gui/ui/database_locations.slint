import { Btn } from "btn.slint";
// Database > locations (the reference's `MoveMediaFilesPanel`; its rows
// and words are hydrus-gui-model's `database_locations`, bound by
// `src/database_locations_window.rs`): the database's parts, the media
// locations with their weights and limits, the thumbnail location
// override, and "move files now".

import { Button, CheckBox, ComboBox, SpinBox } from "std-widgets.slint";
import { ListTable, TableRow } from "list_table.slint";
import { Theme } from "theme.slint";

export component DatabaseLocationsWindow inherits Window {
    in property <string> window-title: "database locations";
    in property <string> title-suffix: "";
    // the title as composed, for tests and the platform
    out property <string> composed-title: root.title;
    title: (root.window-title) + root.title-suffix;
    preferred-width: 980px;
    preferred-height: 520px;
    background: Theme.window;
    in property <string> warning;
    in property <[string]> components;
    in property <[TableRow]> rows;
    in property <int> sort-column;
    in property <bool> ascending: true;
    // increase, decrease, set max size, remove
    in property <[bool]> buttons: [false, false, false, false];
    in property <string> thumbnail-location;
    in property <bool> can-clear-thumbnails;
    in property <string> granularity;
    in property <string> rebalance-status;
    in property <bool> can-rebalance;
    in property <bool> busy;
    callback clicked(int, bool, bool);
    callback activated(int);
    callback sort(int, bool);
    callback action(string);
    callback close-window();
    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        Text {
            text: root.warning;
            color: Theme.error;
            horizontal-alignment: center;
            font-weight: 700;
        }
        Rectangle {
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 6px;
                Text { text: "database components"; font-weight: 700; color: Theme.text; }
                for line in root.components: Text { text: line; color: Theme.text; }
            }
        }
        Rectangle {
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 6px;
                spacing: 4px;
                Text { text: "media file locations"; font-weight: 700; color: Theme.text; }
                ListTable {
                    min-height: 180px;
                    rows: root.rows;
                    sort-column: root.sort-column;
                    ascending: root.ascending;
                    columns: [
                        { title: "location", width: 260px, stretch: true },
                        { title: "beneath db dir?", width: 90px },
                        { title: "disk free space", width: 100px },
                        { title: "current usage", width: 170px },
                        { title: "weight", width: 60px },
                        { title: "max size", width: 80px },
                        { title: "ideal usage", width: 170px },
                    ];
                    row-clicked(i, c, s) => { root.clicked(i, c, s); }
                    row-activated(i) => { root.activated(i); }
                    sort(i, a) => { root.sort(i, a); }
                }
                HorizontalLayout {
                    spacing: 4px;
                    Btn { text: "add new location for files"; enabled: !root.busy; clicked => { root.action("add"); } }
                    Btn { text: "increase location weight"; enabled: !root.busy && root.buttons[0]; clicked => { root.action("increase"); } }
                    Btn { text: "decrease location weight"; enabled: !root.busy && root.buttons[1]; clicked => { root.action("decrease"); } }
                    Btn { text: "set max size"; enabled: !root.busy && root.buttons[2]; clicked => { root.action("max"); } }
                    Btn { text: "remove location"; enabled: !root.busy && root.buttons[3]; clicked => { root.action("remove"); } }
                }
                HorizontalLayout {
                    spacing: 4px;
                    Text { text: "thumbnail location override"; vertical-alignment: center; color: Theme.text; }
                    Text { text: root.thumbnail-location; vertical-alignment: center; color: Theme.text; horizontal-stretch: 1; }
                    Btn { text: "set"; enabled: !root.busy; clicked => { root.action("set thumbnails"); } }
                    Btn { text: "clear"; enabled: !root.busy && root.can-clear-thumbnails; clicked => { root.action("clear thumbnails"); } }
                }
                HorizontalLayout {
                    spacing: 4px;
                    Text { text: root.granularity; horizontal-alignment: right; vertical-alignment: center; color: Theme.text; horizontal-stretch: 1; }
                    Btn { text: "manage granularity"; enabled: !root.busy; clicked => { root.action("granularity"); } }
                }
                HorizontalLayout {
                    spacing: 4px;
                    Text {
                        text: root.rebalance-status;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        color: root.can-rebalance ? Theme.error : Theme.text;
                        horizontal-stretch: 1;
                    }
                    Btn { text: "move files now"; enabled: !root.busy && root.can-rebalance; clicked => { root.action("rebalance"); } }
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            Btn { text: "close"; clicked => { root.close-window(); } }
        }
    }
}

// "set max size": a size, or none (`NoneableBytesControl`).
export component LocationMaxSizeWindow inherits Window {
    in property <string> window-title: "edit max size";
    in property <string> title-suffix: "";
    // the title as composed, for tests and the platform
    out property <string> composed-title: root.title;
    title: (root.window-title) + root.title-suffix;
    preferred-width: 520px;
    background: Theme.window;
    in property <string> message;
    in-out property <bool> no-limit;
    in-out property <int> amount: 100;
    in-out property <int> unit: 3;
    callback apply();
    callback cancel();
    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        Text { text: root.message; wrap: word-wrap; color: Theme.text; }
        HorizontalLayout {
            spacing: 4px;
            SpinBox { minimum: 0; maximum: 1000000; value <=> root.amount; enabled: !root.no-limit; }
            ComboBox { model: ["B", "KB", "MB", "GB", "TB"]; current-index <=> root.unit; enabled: !root.no-limit; }
            CheckBox { text: "no limit"; checked <=> root.no-limit; }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 6px;
            Btn { text: "apply"; clicked => { root.apply(); } }
            Btn { text: "cancel"; clicked => { root.cancel(); } }
        }
    }
}

// "manage granularity" (`ReviewGranularityPanel`): this client's
// migration between 2 and 3, and an offline folder's.
export component GranularityWindow inherits Window {
    in property <string> window-title: "manage granularity";
    in property <string> title-suffix: "";
    // the title as composed, for tests and the platform
    out property <string> composed-title: root.title;
    title: (root.window-title) + root.title-suffix;
    preferred-width: 640px;
    background: Theme.window;
    in property <string> warning;
    in property <string> intro;
    in property <string> client-label;
    in property <string> offline-label;
    in property <int> granularity: 2;
    in property <bool> busy;
    callback action(string);
    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        Text { text: root.warning; wrap: word-wrap; color: Theme.error; font-weight: 700; }
        Text { text: root.intro; wrap: word-wrap; color: Theme.text; }
        Rectangle {
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 6px;
                spacing: 4px;
                Text { text: "this client"; font-weight: 700; color: Theme.text; }
                Text { text: root.client-label; wrap: word-wrap; color: Theme.text; }
                HorizontalLayout {
                    alignment: end;
                    if root.granularity == 2: Btn { text: "I AM READY TO GO FROM 2 TO 3"; enabled: !root.busy; clicked => { root.action("2to3"); } }
                    if root.granularity == 3: Btn { text: "I want to return from 3 back to 2"; enabled: !root.busy; clicked => { root.action("3to2"); } }
                }
            }
        }
        Rectangle {
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 6px;
                spacing: 4px;
                Text { text: "granularising offline storage"; font-weight: 700; color: Theme.text; }
                Text { text: root.offline-label; wrap: word-wrap; color: Theme.text; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 4px;
                    Btn { text: "Migrate an offline folder from 2 to 3"; enabled: !root.busy; clicked => { root.action("folder 2to3"); } }
                    Btn { text: "Migrate an offline folder from 3 to 2"; enabled: !root.busy; clicked => { root.action("folder 3to2"); } }
                }
            }
        }
    }
}
