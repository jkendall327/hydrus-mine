import { Button, CheckBox, ComboBox, LineEdit, SpinBox, ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { TableColumn, TableRow, ListTable } from "list_table.slint";
import { Theme } from "theme.slint";
export struct ServiceColourRow { label: string, border: string, fill: string }
export component ServicesEditorWindow inherits Window {
    in property <string> window-title: "edit services";
    title: root.window-title;
    width: 800px; height: 520px; background: Theme.window;
    in property <[TableColumn]> columns;
    in property <[TableRow]> rows;
    in property <int> sort-column: 1;
    in property <bool> ascending: true;
    in property <[string]> add-types;
    in-out property <int> add-type;
    in property <bool> can-edit;
    in property <bool> can-delete;
    in property <string> error;
    in property <string> question;
    callback row-clicked(int,bool,bool);
    callback sort(int,bool);
    callback add-clicked(int);
    callback edit-clicked();
    callback delete-clicked();
    callback apply-clicked();
    callback cancel-clicked();
    callback answered(bool);
    VerticalBox {
        padding: 12px; spacing: 8px;
        Text { text: "Remote repository, IPFS and account settings are not available here yet."; color: Theme.muted; wrap: word-wrap; }
        ListTable { columns: root.columns; rows: root.rows; sort-column: root.sort-column; ascending: root.ascending; vertical-stretch: 1;
            row-clicked(i,c,s) => { if root.question == "" { root.row-clicked(i,c,s); } }
            row-activated(i) => { if root.question == "" { root.row-clicked(i,false,false); root.edit-clicked(); } }
            sort(i,a) => { if root.question == "" { root.sort(i,a); } }
            delete-pressed => { if root.question == "" { root.delete-clicked(); } }
        }
        HorizontalBox {
            ComboBox { model: root.add-types; current-index <=> root.add-type; }
            Button { text: "add"; enabled: root.question == ""; clicked => { root.add-clicked(root.add-type); } }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "edit"; enabled: root.can-edit && root.question == ""; clicked => { root.edit-clicked(); } }
            Button { text: "delete"; enabled: root.can-delete && root.question == ""; clicked => { root.delete-clicked(); } }
        }
        Text { text: root.error; color: Theme.error; wrap: word-wrap; }
        if root.question != "": VerticalBox {
            Text { text: root.question; color: Theme.text; wrap: word-wrap; }
            HorizontalBox { Button { text: "yes"; clicked => { root.answered(true); } } Button { text: "no"; clicked => { root.answered(false); } } }
        }
        HorizontalBox {
            Rectangle { horizontal-stretch: 1; }
            Button { text: "apply"; enabled: root.question == ""; clicked => { root.apply-clicked(); } }
            Button { text: "cancel"; clicked => { root.cancel-clicked(); } }
        }
    }
}
export component EditServiceWindow inherits Window {
    in property <string> window-title: "edit service";
    title: root.window-title;
    width: 640px; height: 640px; background: Theme.window;
    in-out property <string> service-name;
    in property <string> service-type;
    in property <bool> rating;
    in property <bool> star-rating;
    in property <bool> numerical;
    in-out property <bool> show-thumbnail;
    in-out property <bool> show-null;
    in property <[string]> appearances;
    in-out property <int> appearance;
    in-out property <string> svg;
    in-out property <int> stars: 5;
    in-out property <bool> allow-zero;
    in-out property <int> icon-padding: 4;
    in-out property <int> fraction;
    in property <[ServiceColourRow]> colours;
    in property <string> error;
    callback colour-edited(int,bool,string);
    callback apply-clicked();
    callback cancel-clicked();
    VerticalBox {
        padding: 12px;
        ScrollView { vertical-stretch: 1;
            VerticalBox { spacing: 8px;
                Text { text: root.service-type; color: Theme.text; }
                Text { text: "name"; color: Theme.text; }
                LineEdit { text <=> root.service-name; }
                if !root.rating: Text { text: "There are no additional options for this local service."; color: Theme.muted; wrap: word-wrap; }
                if root.rating: VerticalBox {
                    Text { text: "rating display"; color: Theme.text; font-weight: 700; }
                    CheckBox { text: "show in thumbnails"; checked <=> root.show-thumbnail; }
                    CheckBox { text: "└ even when file has no rating value"; checked <=> root.show-null; enabled: root.show-thumbnail; }
                    for c[i] in root.colours: HorizontalBox {
                        Text { text: "border/fill for " + c.label + ": "; color: Theme.text; }
                        LineEdit { text: c.border; edited(t) => { root.colour-edited(i,true,t); } }
                        LineEdit { text: c.fill; edited(t) => { root.colour-edited(i,false,t); } }
                    }
                }
                if root.star-rating: VerticalBox {
                    Text { text: "star ratings"; color: Theme.text; font-weight: 700; }
                    ComboBox { model: root.appearances; current-index <=> root.appearance; }
                    if root.appearance == root.appearances.length - 1: LineEdit { text <=> root.svg; placeholder-text: "SVG name"; }
                }
                if root.numerical: VerticalBox {
                    Text { text: "numerical ratings"; color: Theme.text; font-weight: 700; }
                    HorizontalBox { Text { text: "number of 'stars': "; color: Theme.text; } SpinBox { minimum: 1; maximum: 20; value <=> root.stars; } }
                    CheckBox { text: "allow a zero rating: "; checked <=> root.allow-zero; }
                    HorizontalBox { Text { text: "icon padding: "; color: Theme.text; } SpinBox { minimum: -64; maximum: 64; value <=> root.icon-padding; } }
                    Text { text: "draw fraction beside the rating"; color: Theme.text; }
                    ComboBox { model: ["do not", "show on left", "show on right"]; current-index <=> root.fraction; }
                }
            }
        }
        Text { text: root.error; color: Theme.error; wrap: word-wrap; }
        HorizontalBox {
            Rectangle { horizontal-stretch: 1; }
            Button { text: "apply"; clicked => { root.apply-clicked(); } }
            Button { text: "cancel"; clicked => { root.cancel-clicked(); } }
        }
    }
}
