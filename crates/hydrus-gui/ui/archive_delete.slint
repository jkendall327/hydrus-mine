import { Btn } from "btn.slint";
// The archive/delete filter's window: a page's files one at a time, at
// their default zoom. As the reference's defaults have it, a left click or
// F7 keeps the file, a right click or delete deletes it, a middle click or
// backspace goes back, and up skips it; F12, escape or enter stops. With
// anything kept or deleted, finishing or stopping asks what to do: enter
// commits, f forgets, and escape goes back to filtering. As in the media
// viewer, z switches between 100% and fitting the window, + and - (or ctrl
// and the mouse wheel) zoom, and shift and the arrow keys pan. With the
// pointer over the window's left fifth, the file's tags show there; near
// its top, the file's info line.

import { Button } from "std-widgets.slint";
import { ListText, Theme } from "theme.slint";

export component ArchiveDeleteWindow inherits Window {
    in property <string> title-suffix: "";
    // the title as composed, for tests and the platform
    out property <string> composed-title: root.title;
    title: ("archive/delete filter " + root.caption) + root.title-suffix;
    preferred-width: 1000px;
    preferred-height: 750px;
    background: Theme.colour(10,#202020);

    in property <image> media;
    in property <string> caption;
    // the file's tags, for the hover frame
    in property <[ListText]> tags;
    // what committing would do, while asking
    in property <string> question;
    in property <[string]> commit-labels;
    in property <string> finish-header;
    in property <bool> commit-ready: true;
    in property <bool> forget-question;
    // where the file is drawn: its box at its zoom
    in property <length> media-x;
    in property <length> media-y;
    in property <length> media-width: root.width;
    in property <length> media-height: root.height;
    // the still drawn sharply over it, once rendered (see still.rs)
    in property <image> sharp;
    in property <bool> sharp-shown;
    in property <bool> sharp-opaque: true;
    in property <length> sharp-x;
    in property <length> sharp-y;
    in property <length> sharp-width;
    in property <length> sharp-height;
    // the file's info line, for the top hover frame
    in property <string> info-line;
    out property <bool> info-showing: root.info-line != "" && pointer.has-hover
        && pointer.mouse-y <= info-box.preferred-height + 20px
        && pointer.mouse-x >= root.width * 0.2 && pointer.mouse-x <= root.width * 0.8;
    out property <bool> tags-showing: pointer.has-hover && pointer.mouse-x < root.width * 0.2 && root.tags.length > 0;

    // the scanbar under a file mpv or the animator plays, and the volume
    // control at its right, as in the media viewer
    in property <bool> scanbar-shown;
    in property <float> scanbar-progress;
    in property <string> scanbar-text;
    in property <bool> volume-shown;
    in property <bool> global-muted;
    in property <bool> viewer-muted;
    in property <int> volume;
    in-out property <bool> volume-open;
    in property <length> seek-height: 20px;
    in property <length> seek-hidden-height: 5px;
    in property <length> seek-nub-width: 10px;
    out property <bool> seek-bar-full: root.scanbar-shown && bar.full;
    callback scan(length, length);
    callback scan-started();
    callback scan-ended();
    callback flip-global-mute();
    callback flip-viewer-mute();
    callback volume-changed(int);
    pure function volume-at(y: length, top: length, track: length) -> int {
        return max(0, min(100, round((top + track - y) / track * 100)));
    }
    property <length> bar-top: root.media-y + root.media-height - root.seek-height;
    property <bool> bar-near: pointer.has-hover
        && pointer.mouse-x >= root.media-x - 50px && pointer.mouse-x <= root.media-x + root.media-width + 50px
        && pointer.mouse-y >= root.bar-top - 100px && pointer.mouse-y <= root.bar-top + 40px;

    callback owner-valid() -> bool;
    callback retire();
    callback keep();
    callback delete();
    callback back();
    callback skip();
    callback close-requested();
    callback commit();
    callback commit-choice(int);
    callback forget-answered(bool);
    callback forget();
    callback resume();
    callback toggle-pause();
    // zoom in (1), out (-1) or switch (0), about the pointer if it is over
    // the window
    callback zoom(int, bool, length, length);
    callback pan(int, int);
    // (files aren't dragged here: a left click keeps them)
    callback drag(length, length);
    callback canvas-resized(length, length);

    changed width => { root.canvas-resized(self.width, self.height); }
    changed height => { root.canvas-resized(self.width, self.height); }

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (root.question != "") {
                if root.forget-question {
                    if event.text == Key.Return {root.forget-answered(true);}
                    else if event.text == Key.Escape {root.forget-answered(false);}
                    return accept;
                }
                if (event.text == Key.Return) {
                    if root.commit-ready { root.commit(); }
                } else if (event.text == "f" || event.text == "F") {
                    root.forget();
                } else if (event.text == Key.Escape) {
                    root.resume();
                }
                return accept;
            }
            if (event.modifiers.shift) {
                if (event.text == Key.UpArrow) {
                    root.pan(0, -1);
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    root.pan(0, 1);
                    return accept;
                }
                if (event.text == Key.LeftArrow) {
                    root.pan(-1, 0);
                    return accept;
                }
                if (event.text == Key.RightArrow) {
                    root.pan(1, 0);
                    return accept;
                }
            }
            if ((event.text == "z" || event.text == "Z") && !event.modifiers.control && !event.modifiers.alt) {
                root.zoom(0, pointer.has-hover, pointer.mouse-x, pointer.mouse-y);
                return accept;
            }
            if (event.text == "+") {
                root.zoom(1, pointer.has-hover, pointer.mouse-x, pointer.mouse-y);
                return accept;
            }
            if (event.text == "-") {
                root.zoom(-1, pointer.has-hover, pointer.mouse-x, pointer.mouse-y);
                return accept;
            }
            if (event.text == Key.F7) {
                root.keep();
                return accept;
            }
            if (event.text == Key.Delete) {
                root.delete();
                return accept;
            }
            if (event.text == Key.Backspace) {
                root.back();
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.skip();
                return accept;
            }
            if (event.text == Key.F12 || event.text == Key.Escape || event.text == Key.Return) {
                root.close-requested();
                return accept;
            }
            if (event.text == " ") {
                root.toggle-pause();
                return accept;
            }
            reject
        }
        Image {
            x: root.media-x;
            y: root.media-y;
            width: root.media-width;
            height: root.media-height;
            source: root.media;
            visible: !root.sharp-shown || root.sharp-opaque;
            image-fit: contain;
        }
        if root.sharp-shown: Image {
            x: root.sharp-x;
            y: root.sharp-y;
            width: root.sharp-width;
            height: root.sharp-height;
            source: root.sharp;
            image-fit: fill;
        }
        pointer := TouchArea {
            scroll-event(event) => {
                if (event.modifiers.control) {
                    if (event.delta-y > 0) {
                        root.zoom(1, true, self.mouse-x, self.mouse-y);
                    } else if (event.delta-y < 0) {
                        root.zoom(-1, true, self.mouse-x, self.mouse-y);
                    }
                    return accept;
                }
                reject
            }
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && root.question == "") {
                    if (event.button == PointerEventButton.left) {
                        root.keep();
                    } else if (event.button == PointerEventButton.right) {
                        root.delete();
                    } else if (event.button == PointerEventButton.middle) {
                        root.back();
                    }
                }
            }
        }
        bar := Rectangle {
            visible: root.scanbar-shown;
            property <bool> full: root.bar-near || scrub.has-hover || scrub.pressed || root.volume-open;
            x: root.media-x;
            width: root.media-width - (root.volume-shown ? 24px : 0px);
            height: self.full ? root.seek-height : root.seek-hidden-height;
            y: root.media-y + root.media-height - self.height;
            background: #303030;
            border-width: 1px;
            border-color: #606060;
            Rectangle {
                x: floor((parent.width - min(root.seek-nub-width, parent.width)) * root.scanbar-progress / 1px) * 1px;
                width: min(root.seek-nub-width, parent.width);
                background: #b0b0b0;
            }
            if bar.full: Text {
                x: bar.width - self.width - 3px;
                height: bar.height;
                vertical-alignment: center;
                text: root.scanbar-text;
                color: #f0f0f0;
                font-size: 11px;
            }
            scrub := TouchArea {
                pointer-event(event) => {
                    if (event.button == PointerEventButton.left) {
                        if (event.kind == PointerEventKind.down) {
                            root.scan-started();
                            root.scan(self.mouse-x, self.width);
                        } else if (event.kind == PointerEventKind.up) {
                            root.scan-ended();
                        }
                    }
                }
                moved => { root.scan(self.mouse-x, self.width); }
            }
        }
        if root.scanbar-shown && root.volume-shown: volume-box := Rectangle {
            property <bool> open: volume-area.has-hover || volume-area.pressed;
            changed open => { root.volume-open = self.open; }
            property <length> line: 20px;
            property <length> track-top: 10px;
            property <length> track: 100px;
            property <length> popup: self.track + 2 * self.track-top + self.line;
            width: 24px;
            height: self.open ? self.popup + root.seek-height : root.seek-bar-full ? root.seek-height : root.seek-hidden-height;
            x: root.media-x + root.media-width - self.width;
            y: root.media-y + root.media-height - self.height;
            background: #303030;
            border-width: 1px;
            border-color: #606060;
            if volume-box.open: Rectangle {
                x: (volume-box.width - self.width) / 2;
                y: volume-box.track-top;
                width: 4px;
                height: volume-box.track;
                background: #606060;
            }
            if volume-box.open: Rectangle {
                x: 4px;
                y: volume-box.track-top + volume-box.track * (1 - root.volume / 100) - 3px;
                width: volume-box.width - 8px;
                height: 6px;
                background: #b0b0b0;
            }
            if volume-box.open: Text {
                y: volume-box.popup - volume-box.line;
                width: volume-box.width;
                height: volume-box.line;
                horizontal-alignment: center;
                vertical-alignment: center;
                text: root.viewer-muted ? "🔇" : "🔊";
                color: #f0f0f0;
                font-size: 11px;
            }
            if volume-box.height >= volume-box.line: Text {
                y: volume-box.height - volume-box.line;
                width: volume-box.width;
                height: volume-box.line;
                horizontal-alignment: center;
                vertical-alignment: center;
                text: root.global-muted ? "🔇" : "🔊";
                color: #f0f0f0;
                font-size: 11px;
            }
            volume-area := TouchArea {
                enabled: root.seek-bar-full;
                pointer-event(event) => {
                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                        if (self.mouse-y >= volume-box.height - volume-box.line) {
                            root.flip-global-mute();
                        } else if (volume-box.open && self.mouse-y >= volume-box.popup - volume-box.line) {
                            root.flip-viewer-mute();
                        } else if (volume-box.open) {
                            root.volume-changed(root.volume-at(self.mouse-y, volume-box.track-top, volume-box.track));
                        }
                    }
                }
                moved => {
                    if (self.pressed && volume-box.open && self.pressed-y < volume-box.popup - volume-box.line) {
                        root.volume-changed(root.volume-at(self.mouse-y, volume-box.track-top, volume-box.track));
                    }
                }
            }
        }
        if root.question != "": Rectangle {
            x: (root.width - self.width)/2;
            y: (root.height - self.height)/2;
            width: min(root.width - 40px, 520px);
            height: finish-content.preferred-height+24px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 4px;
            finish-content := VerticalLayout {
                padding:12px;spacing:8px;
                if root.forget-question: Text {text:"Quit filtering now and forget your work?";color:Theme.text;wrap:word-wrap;horizontal-alignment:center;}
                if root.forget-question: HorizontalLayout {
                    Btn {text:"yes";clicked=>{root.forget-answered(true);}}
                    Btn {text:"no";clicked=>{root.forget-answered(false);}}
                }
                if !root.forget-question: VerticalLayout {
                    spacing:8px;
                    if root.finish-header!="": Text {text:root.finish-header;color:Theme.text;wrap:word-wrap;horizontal-alignment:center;}
                    for label[index] in root.commit-labels: VerticalLayout {
                        Text {text:label;color:Theme.text;wrap:word-wrap;horizontal-alignment:center;}
                        Btn {text:"commit";enabled:root.commit-ready;clicked=>{root.commit-choice(index);}}
                    }
                    Btn {text:"forget";clicked=>{root.forget();}}
                    Text {text:"-or-";color:Theme.text;horizontal-alignment:center;}
                    Btn {text:"back to filtering";clicked=>{root.resume();}}
                }
            }
        }
        // (nothing in it takes the pointer, so the area below keeps it)
        info-box := Rectangle {
            x: (root.width - self.width) / 2;
            y: 0;
            width: min(root.width * 0.6, info-text.preferred-width + 24px);
            height: info-text.preferred-height + 12px;
            background: #202020e8;
            visible: root.info-showing && root.question == "";
            info-text := Text {
                x: 12px;
                width: parent.width - 24px;
                text: root.info-line;
                color: Theme.colour(11,#f0f0f0);
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        // (nothing in it takes the pointer, so the area above keeps it)
        if root.tags-showing: Rectangle {
            x: 0;
            y: 0;
            width: root.width * 0.2;
            height: root.height;
            background: #202020e8;
            clip: true;
            VerticalLayout {
                padding: 6px;
                spacing: 2px;
                alignment: start;
                for tag in root.tags: Text {
                    text: tag.text;
                    color: tag.colour;
                    overflow: elide;
                }
            }
        }
    }
}
