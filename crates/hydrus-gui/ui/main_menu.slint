// The main window's menu bar (`src/main_menu.rs`): its titles, and the
// menus open from it, drawn over the window, each from the lines Rust
// gives it. Rust decides what opens and what is chosen; this only draws
// and says where the pointer is.

import { Theme } from "theme.slint";

// a line of an open menu
export struct MenuLine {
    label: string,
    // 0 an entry, 1 a tick box, 2 a separator, 3 a submenu
    kind: int,
    // whether it can be chosen (else greyed out)
    usable: bool,
    checked: bool,
}

// an open menu: where it opens (with no room on the right, it opens to
// the left of `left`), its lines, and the one highlighted (-1 for none)
export struct MenuPane {
    x: length,
    y: length,
    left: length,
    lines: [MenuLine],
    current: int,
}

// a title of the bar
export struct MenuTitle {
    label: string,
    usable: bool,
}

// (as `src/main_menu.rs` has them)
global MenuSizes {
    out property <length> line: 22px;
    out property <length> separator: 7px;
    out property <length> padding: 2px;
}

export component MenuBarRow inherits Rectangle {
    in property <[MenuTitle]> titles;
    // the title whose menu is open, -1 for none
    in property <int> open: -1;
    // a title pressed, or the pointer over one: which, and its left edge;
    // and where each title is
    callback pressed(int, length);
    callback hovered(int, length);
    callback placed(int, length);
    height: MenuSizes.line;
    background: Theme.panel;
    HorizontalLayout {
        padding-left: 2px;
        for title[i] in root.titles: Rectangle {
            width: label.preferred-width + 16px;
            init => { root.placed(i, self.absolute-position.x); }
            changed x => { root.placed(i, self.absolute-position.x); }
            background: i == root.open ? Theme.highlight : (touch.has-hover && title.usable ? Theme.hover : transparent);
            label := Text {
                text: title.label;
                color: i == root.open ? Theme.highlight-text : Theme.text;
                opacity: title.usable ? 1 : 0.45;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            touch := TouchArea {
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                        root.pressed(i, self.absolute-position.x);
                    }
                }
                changed has-hover => {
                    if (self.has-hover) {
                        root.hovered(i, self.absolute-position.x);
                    }
                }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
    }
}

// the open menus, over the whole window below the bar (`top`): a press
// anywhere else closes them
export component MenuPanes inherits Rectangle {
    in property <[MenuPane]> panes;
    in property <length> top;
    callback line-hovered(int, int, length, length, length);
    callback line-clicked(int, int, length, length, length);
    // where a menu was drawn: which, its left edge, top and width
    callback placed(int, length, length, length);
    callback dismiss();
    // (as Qt's, the menus take the keyboard while open; the window's keys
    // are what moves through them)
    FocusScope {
        width: 0;
        height: 0;
        init => { self.focus(); }
    }
    // (not over the bar, whose titles still take the pointer)
    TouchArea {
        y: root.top;
        height: root.height - root.top;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.dismiss();
            }
        }
    }
    for pane[p] in root.panes: Rectangle {
        // (to the left of its menu with no room on the right, and up with
        // none below)
        x: pane.x + self.width > root.width ? max(0px, pane.left - self.width) : pane.x;
        y: max(0px, min(pane.y, root.height - self.height));
        width: lines.preferred-width;
        height: lines.preferred-height;
        background: Theme.window;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 6px;
        drop-shadow-color: #00000040;
        init => { root.placed(p, self.x, self.y, self.width); }
        changed x => { root.placed(p, self.x, self.y, self.width); }
        changed y => { root.placed(p, self.x, self.y, self.width); }
        changed width => { root.placed(p, self.x, self.y, self.width); }
        // (a press between lines does nothing)
        TouchArea { }
        lines := VerticalLayout {
            padding: MenuSizes.padding;
            for line[i] in pane.lines: Rectangle {
                height: line.kind == 2 ? MenuSizes.separator : MenuSizes.line;
                background: i == pane.current && line.kind != 2 ? Theme.highlight : transparent;
                // (always laid out, so the menu is as wide as its lines)
                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 8px;
                    spacing: 4px;
                    Text {
                        width: 16px;
                        text: line.kind == 1 && line.checked ? "✓" : "";
                        color: i == pane.current ? Theme.highlight-text : Theme.text;
                        opacity: line.usable ? 1 : 0.45;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: line.kind == 2 ? "" : line.label;
                        color: i == pane.current ? Theme.highlight-text : Theme.text;
                        opacity: line.usable ? 1 : 0.45;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        width: 16px;
                        text: line.kind == 3 ? "▸" : "";
                        color: i == pane.current ? Theme.highlight-text : Theme.text;
                        opacity: line.usable ? 1 : 0.45;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                }
                if line.kind == 2: Rectangle {
                    x: 4px;
                    y: (parent.height - 1px) / 2;
                    width: parent.width - 8px;
                    height: 1px;
                    background: Theme.border;
                }
                touch := TouchArea {
                    changed has-hover => {
                        if (self.has-hover) {
                            root.line-hovered(p, i,
                                self.absolute-position.x + self.width + MenuSizes.padding,
                                self.absolute-position.y - MenuSizes.padding,
                                self.absolute-position.x - MenuSizes.padding);
                        }
                    }
                    clicked => {
                        root.line-clicked(p, i,
                            self.absolute-position.x + self.width + MenuSizes.padding,
                            self.absolute-position.y - MenuSizes.padding,
                            self.absolute-position.x - MenuSizes.padding);
                    }
                }
            }
        }
    }
}
