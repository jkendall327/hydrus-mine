// The session saving dialog (`src/session_dialog.rs`, driven by
// hydrus-gui-model's session_saving): a name asked, as the reference's
// text entry asks it (after a warning, for a name that can't be had), or a
// yes/no question with the reference's buttons.

import { Button, LineEdit } from "std-widgets.slint";
import { RegexTools } from "regex_tools.slint";
import { MenuPane, MenuPanes } from "main_menu.slint";
import { Theme } from "theme.slint";
import { MenuChoiceFrame } from "menu_choice_wheel.slint";

export component SessionDialog inherits Window {
    in property <string> window-title: "Enter Text";
    title: root.window-title;
    preferred-width: 520px;
    background: Theme.window;
    in property <string> message;
    // asking a name (else a question), its text, and a warning over it
    in property <bool> asking-name;
    // A critical clipboard notice shares the owned close/cancel boundary.
    in property <bool> notice-only;
    in property <string> notice-ok-label: "ok";
    in-out property <string> text;
    in property <string> warning;
    in property <string> name-ok-label: "apply";
    in property <string> yes-label: "yes";
    in property <string> no-label: "no";
    in property <string> placeholder;
    in property <bool> regex-mode;
    in property <bool> child-open;
    // Opt-in widget validation; direct handler replay remains separate.
    in property <bool> reject-blank-submission;
    in property <bool> measure-name-apply;
    callback name-apply-measured(MenuChoiceFrame);
    out property <MenuChoiceFrame> name-input-frame: {x:name.absolute-position.x,y:name.absolute-position.y,w:name.width,h:name.height};
    in property <string> regex-validity;
    in property <[string]> regex-components;
    in property <[MenuPane]> favourite-panes;
    callback regex-changed();
    callback regex-tool(int,int);
    callback favourite-menu(float,float);
    callback favourite-placed(int,float,float,float);
    callback favourite-line-hovered(int,int,float,float,float);
    callback favourite-line-clicked(int,int,float,float,float);
    callback favourite-dismissed();
    callback force-close();
    callback name-entered(string);
    callback blank-submitted();
    callback cancelled();
    callback answered(bool);
    forward-focus: keyboard;

    keyboard := FocusScope {
        forward-focus: name;
        capture-key-pressed(event) => {
            if root.notice-only && (event.text == Key.Return || event.text == Key.Escape) {
                root.cancelled();
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: 10px;
            spacing: 8px;
            if root.asking-name && root.warning != "": Text {
                text: root.warning;
                wrap: word-wrap;
                color: Theme.error;
            }
            Text {
                text: root.message;
                wrap: word-wrap;
                color: Theme.text;
            }
            name := LineEdit {
                visible: root.asking-name;
                // (no room taken while a question is asked)
                height: root.asking-name ? self.preferred-height : 0px;
                text <=> root.text;
                placeholder-text: root.placeholder;
                enabled: !root.child-open;
                edited => { if root.regex-mode { root.regex-changed(); } }
                accepted => {
                    if !root.child-open {
                        if root.reject-blank-submission && self.text == "" {
                            root.blank-submitted();
                        } else {
                            root.name-entered(self.text);
                        }
                    }
                }
            }
            if root.regex-mode: HorizontalLayout {
                RegexTools { components: root.regex-components; show-groups: false; enabled: !root.child-open; selected(c,i) => { root.regex-tool(c,i); } }
                favourite := Button { text: "favourites"; enabled: !root.child-open; clicked => { root.favourite-menu(favourite.x / 1px, (favourite.y + favourite.height) / 1px); } }
                Text { text: root.regex-validity; color: Theme.text; wrap: word-wrap; }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 6px;
                // The name editor is hidden for notices. Give their visible
                // button a focus path so the ancestor handles Enter/Escape.
                if root.notice-only: FocusScope {
                    init => { self.focus(); }
                    HorizontalLayout {
                        Button { text: root.notice-ok-label; clicked => { root.cancelled(); } }
                    }
                }
                if root.asking-name: name-apply := Button {
                    enabled: !root.child-open;
                    text: root.name-ok-label;
                    Timer {
                        interval: 1ms;
                        running: root.measure-name-apply;
                        triggered => {
                            root.name-apply-measured({x:name-apply.absolute-position.x,y:name-apply.absolute-position.y,w:name-apply.width,h:name-apply.height});
                        }
                    }
                    clicked => {
                        if root.reject-blank-submission && root.text == "" {
                            root.blank-submitted();
                        } else {
                            root.name-entered(root.text);
                        }
                    }
                }
                if root.asking-name: Button {
                    enabled: !root.child-open;
                    text: "cancel";
                    clicked => { root.cancelled(); }
                }
                if !root.asking-name && !root.notice-only: Button {
                    text: root.yes-label;
                    clicked => { root.answered(true); }
                }
                if !root.asking-name && !root.notice-only: Button {
                    text: root.no-label;
                    clicked => { root.answered(false); }
                }
            }
        }
    }
    if root.favourite-panes.length > 0: MenuPanes {
        width: root.width; height: root.height; top: 0px; panes: root.favourite-panes;
        dismiss => { root.favourite-dismissed(); }
        placed(p,x,y,w) => { root.favourite-placed(p,x / 1px,y / 1px,w / 1px); }
        line-hovered(p,l,r,t,left) => { root.favourite-line-hovered(p,l,r / 1px,t / 1px,left / 1px); }
        line-clicked(p,l,r,t,left) => { root.favourite-line-clicked(p,l,r / 1px,t / 1px,left / 1px); }
    }
}
