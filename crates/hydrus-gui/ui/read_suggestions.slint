// Shared embedded/floating read autocomplete; one stable hit surface owns selection.
import { ScrollView } from "std-widgets.slint";
import { ListText, Theme } from "theme.slint";

export component ReadSuggestions inherits Rectangle {
    in property <[ListText]> suggestions;
    in property <int> highlighted: -1;
    in property <[bool]> selected;
    callback chosen(int);
    callback selection-clicked(int,bool,bool);
    callback activated(bool);
    callback select-all();
    callback deselect() -> bool;
    callback move-highlight(int);
    callback context-menu(int,length,length);
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.panel;
    min-height: 26px;
    out property <bool> has-focus: keys.has-focus;
    out property <length> results-x: touch.absolute-position.x;
    out property <length> results-y: touch.absolute-position.y;
    property <bool> shift-activation;
    property <int> kept-in-view: root.highlighted;
    changed kept-in-view => {
        if self.kept-in-view >= 0 {
            if self.kept-in-view * 22px < -scroll.content-y { scroll.content-y = -self.kept-in-view * 22px; }
            else if (self.kept-in-view + 1) * 22px > scroll.visible-height - scroll.content-y { scroll.content-y = scroll.visible-height - (self.kept-in-view + 1) * 22px; }
        }
    }
    keys := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Escape && root.deselect() { return accept; }
            if event.text == Key.Return { root.activated(event.modifiers.shift); return accept; }
            if event.text == Key.UpArrow { root.move-highlight(-1); return accept; }
            if event.text == Key.DownArrow { root.move-highlight(1); return accept; }
            if event.modifiers.control && (event.text == "a" || event.text == "A") { root.select-all(); return accept; }
            reject
        }
        scroll := ScrollView {
            x: 2px; y: 2px;
            width: parent.width - 4px; height: parent.height - 4px;
            Rectangle {
                min-height: root.suggestions.length * 22px;
                VerticalLayout {
                    alignment: start;
                    for suggestion[i] in root.suggestions: Rectangle {
                        height: 22px;
                        background: (root.selected.length > i ? root.selected[i] : i == root.highlighted) ? Theme.highlight : transparent;
                        Text {
                            x: 4px; width: parent.width - 8px;
                            text: suggestion.text;
                            color: (root.selected.length > i ? root.selected[i] : i == root.highlighted) ? Theme.highlight-text : suggestion.colour;
                            vertical-alignment: center; overflow: elide;
                        }
                    }
                }
                touch := TouchArea {
                    height: root.suggestions.length * 22px;
                    double-clicked => {
                        if root.selected.length > 0 { root.activated(root.shift-activation); }
                        else { root.chosen(floor(self.mouse-y / 22px)); }
                    }
                    pointer-event(event) => {
                        let index = floor(self.mouse-y / 22px);
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                            keys.focus();root.shift-activation = event.modifiers.shift;
                            root.selection-clicked(index,event.modifiers.control,event.modifiers.shift);
                            if root.selected.length == 0 { root.chosen(index); }
                        }
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                            keys.focus();root.context-menu(index,self.absolute-position.x+self.mouse-x,self.absolute-position.y+self.mouse-y);
                        }
                    }
                }
            }
        }
    }
}
