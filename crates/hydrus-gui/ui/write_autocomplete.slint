// One write-tag input for editors. State, fetching and paste decisions live in Rust.
import { Button, LineEdit, ScrollView } from "std-widgets.slint";
import { ListText, Theme } from "theme.slint";

export component WriteTagInput inherits FocusScope {
    in-out property <string> text;
    in property <[ListText]> suggestions;
    in property <int> highlighted: -1;
    in property <int> list-height: 11;
    in property <string> placeholder: "enter a tag";
    callback edited(string);
    callback entered();
    callback fetch();
    callback move-highlight(int);
    callback chosen(int);
    callback paste(bool) -> bool;
    forward-focus: input;
    capture-key-pressed(event) => {
        if event.modifiers.control && event.text == " " { root.fetch(); return accept; }
        if event.modifiers.control && (event.text == "v" || event.text == "V") {
            if root.paste(false) { return accept; }
        }
        if event.text == Key.UpArrow { root.move-highlight(-1); return accept; }
        if event.text == Key.DownArrow { root.move-highlight(1); return accept; }
        reject
    }
    VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            spacing: 4px;
            input := LineEdit {
                horizontal-stretch: 1;
                enabled: root.enabled;
                text <=> root.text;
                placeholder-text: root.placeholder;
                edited(text) => { root.edited(text); }
                accepted => { root.entered(); }
            }
            Button { enabled: root.enabled; text: "paste"; clicked => { root.paste(true); } }
        }
        if root.suggestions.length > 0: Rectangle {
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.panel;
            height: min(root.suggestions.length, root.list-height) * 22px + 4px;
            ScrollView {
                VerticalLayout {
                    padding: 2px;
                    alignment: start;
                    for suggestion[i] in root.suggestions: Rectangle {
                        height: 22px;
                        background: i == root.highlighted ? Theme.highlight : transparent;
                        Text {
                            x: 4px;
                            text: suggestion.text;
                            color: i == root.highlighted ? Theme.highlight-text : suggestion.colour;
                            vertical-alignment: center;
                            overflow: elide;
                            width: parent.width - 8px;
                        }
                        TouchArea { enabled: root.enabled; clicked => { root.chosen(i); } }
                    }
                }
            }
        }
    }
}
