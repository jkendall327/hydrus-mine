import { PaintedTagText } from "tag_text.slint";
// One write-tag input for editors. State, fetching and paste decisions live in Rust.
import { Button, ComboBox, ScrollView, ListView } from "std-widgets.slint";
import { WriteTagLineEdit } from "write_tag_line_edit.slint";
import { Question } from "favourites.slint";
import { MenuPane, MenuPanes } from "main_menu.slint";
import { ListText, Theme } from "theme.slint";

export component WriteTagInput inherits FocusScope {
    in-out property <string> text;
    in property <[ListText]> suggestions;
    in property <int> highlighted: -1;
    in property <[bool]> selected;
    in-out property <int> tab-index;
    in property <int> list-height: 11;
    in property <string> placeholder: "enter a tag";
    callback tab-chosen(int);
    callback edited(string);
    callback entered();
    callback fetch();
    callback move-highlight(int);
    callback navigate(int,bool,bool);
    callback results-action(int) -> bool;
    callback chosen(int);
    callback selection-clicked(int, bool, bool);
    callback context-menu(int, length, length);
    callback domain-menu(bool,length,length);
    in property <string> file-label;
    in property <string> tag-label;
    callback paste(bool) -> bool;
    out property <length> results-x: result-keys.absolute-position.x;
    out property <length> results-y: result-keys.absolute-position.y;
    out property <length> results-width: result-keys.width;
    public function escape-results() -> bool { root.enabled && result-keys.has-focus && root.results-action(3) }
    public function focus-results() { result-keys.focus(); }
    public function focus-input() { input.focus(); }
    out property <bool> editor-focused: input.has-focus;
    public function normal-paste() { input.paste(); }
    public function undo-input() { input.undo(); }
    public function redo-input() { input.redo(); }
    public function select-input(anchor: int, cursor: int) { input.set-selection-offsets(anchor, cursor); }
    property <int> drag-start: -1;
    property <int> drag-last: -1;
    property <bool> drag-deselection;
    forward-focus: input;
    capture-key-pressed(event) => {
        if event.modifiers.control && event.text == " " { root.fetch(); return accept; }
        if event.modifiers.control && (event.text == "v" || event.text == "V") {
            if !root.paste(false) { root.normal-paste(); }
            return accept;
        }
        if event.modifiers.control && (event.text == "c" || event.text == "C") && (!input.has-focus || !input.has-selected-text) && root.suggestions.length > 0 {
            root.results-action(event.modifiers.shift ? 2 : 1); return accept;
        }
        if event.modifiers.control && (event.text == "a" || event.text == "A") && result-keys.has-focus {
            root.results-action(0); return accept;
        }
        if event.modifiers.control && (event.text == "p" || event.text == "P") { root.navigate(0,false,event.modifiers.shift); return accept; }
        if event.modifiers.control && (event.text == "n" || event.text == "N") { root.navigate(1,false,event.modifiers.shift); return accept; }
        if event.text == Key.UpArrow { root.navigate(0,event.modifiers.control,event.modifiers.shift); return accept; }
        if event.text == Key.DownArrow { root.navigate(1,event.modifiers.control,event.modifiers.shift); return accept; }
        if event.text == Key.Home { root.navigate(2,event.modifiers.control,event.modifiers.shift); return accept; }
        if event.text == Key.End { root.navigate(3,event.modifiers.control,event.modifiers.shift); return accept; }
        if event.text == Key.PageUp { root.navigate(4,event.modifiers.control,event.modifiers.shift); return accept; }
        if event.text == Key.PageDown { root.navigate(5,event.modifiers.control,event.modifiers.shift); return accept; }
        if event.text == Key.Return && result-keys.has-focus { root.entered(); return accept; }
        reject
    }
    VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            spacing: 4px;
            input := WriteTagLineEdit {
                horizontal-stretch: 1;
                enabled: root.enabled;
                text <=> root.text;
                placeholder-text: root.placeholder;
                edited(text) => { root.edited(text); }
                accepted => { root.entered(); }
            }
            Button { enabled: root.enabled; text: "paste"; clicked => { root.paste(true); } }
        }
        HorizontalLayout {
            spacing: 4px;
            Button {text:root.file-label;enabled:root.enabled;clicked=>{root.domain-menu(false,self.absolute-position.x,self.absolute-position.y+self.height);} }
            Button {text:root.tag-label;enabled:root.enabled;clicked=>{root.domain-menu(true,self.absolute-position.x,self.absolute-position.y+self.height);} }
        }
        ComboBox {
            enabled: root.enabled;
            model: ["tags", "favourites", "children"];
            current-index <=> root.tab-index;
            selected => { root.tab-chosen(self.current-index); }
        }
        Rectangle {
            visible: root.suggestions.length > 0;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.tags-background;
            height: root.suggestions.length > 0 ? min(root.suggestions.length, root.list-height) * 22px + 4px : 0px;
            result-keys := FocusScope {
                width: parent.width; height: parent.height;
                property <int> kept-in-view: root.highlighted;
                changed kept-in-view => {
                    if self.kept-in-view >= 0 {
                        if self.kept-in-view * 22px < -scroll.content-y { scroll.content-y = -self.kept-in-view * 22px; }
                        else if (self.kept-in-view + 1) * 22px > scroll.visible-height - scroll.content-y { scroll.content-y = scroll.visible-height - (self.kept-in-view + 1) * 22px; }
                    }
                }
                scroll := ScrollView {
                    Rectangle {
                        min-height: root.suggestions.length * 22px + 4px;
                        VerticalLayout {
                            padding: 2px;
                            alignment: start;
                            for suggestion[i] in root.suggestions: Rectangle {
                                height: 22px;
                                background: root.selected[i] ? Theme.highlight : transparent;
                                PaintedTagText { x:4px;item:suggestion;selected:root.selected[i];width:parent.width - 8px;height:parent.height; }
                            }
                        }
                        // Stay alive when a selection refresh replaces the repeated rows.
                        touch := TouchArea {
                            x: 2px; y: 2px;
                            width: parent.width - 4px;
                            height: root.suggestions.length * 22px;
                            enabled: root.enabled;
                            double-clicked => { root.chosen(floor(self.mouse-y / 22px)); }
                            moved => {
                                if self.pressed && root.drag-start >= 0 {
                                    let physical = max(0, min(root.suggestions.length - 1, floor(self.mouse-y / 22px)));
                                    if root.drag-last < 0 { root.drag-deselection = !root.selected[root.drag-start]; }
                                    if physical != root.drag-last {
                                        root.drag-last = physical;
                                        root.selection-clicked(physical, root.drag-deselection, true);
                                    }
                                }
                            }
                            pointer-event(event) => {
                                let physical = floor(self.mouse-y / 22px);
                                if event.kind == PointerEventKind.down && event.button == PointerEventButton.right { result-keys.focus(); root.context-menu(physical, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
                                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                    result-keys.focus(); root.drag-start = physical; root.drag-last = -1;
                                    root.selection-clicked(physical, event.modifiers.control, event.modifiers.shift);
                                }
                                if event.kind == PointerEventKind.up { root.drag-start = -1; }
                            }
                        }
                    }
                }
            }
        }
    }
}


// Shared root overlay: menu and confirmation capture pointer input above the owner.
export component TagMenuOverlay inherits Rectangle {
    in property <[MenuPane]> panes;
    in property <string> question;
    in property <string> question-title;
    in property <string> yes-label: "yes";
    in property <string> no-label: "no";
    callback hovered(int,int,length,length,length);
    callback clicked(int,int,length,length,length);
    callback placed(int,length,length,length);
    callback dismissed();
    callback answered(bool);
    if root.question == "": MenuPanes {
        width: root.width; height: root.height; top: 0px; panes: root.panes;
        line-hovered(p,l,r,t,x) => { root.hovered(p,l,r,t,x); }
        line-clicked(p,l,r,t,x) => { root.clicked(p,l,r,t,x); }
        placed(p,x,y,w) => { root.placed(p,x,y,w); }
        dismiss => { root.dismissed(); }
    }
    if root.question != "": Rectangle {
        background: Theme.window;
        TouchArea { }
        VerticalLayout {
            padding: 16px;
            alignment: center;
            if root.question-title != "": Text { text: root.question-title; color: Theme.text; }
            Text { text: root.question; color: Theme.text; wrap: word-wrap; }
            HorizontalLayout {
                alignment: end; spacing: 6px;
                Button { text: root.yes-label; clicked => { root.answered(true); } }
                Button { text: root.no-label; clicked => { root.answered(false); } }
            }
        }
    }
}

export component WriteTagsWindow inherits Window {
    in property <[MenuPane]> tag-menu-panes;
    in property <string> tag-menu-question;
    in property <string> tag-menu-question-title;
    in property <string> tag-menu-yes-label: "yes";
    in property <string> tag-menu-no-label: "no";
    callback tag-menu-hovered(int,int,length,length,length);
    callback tag-menu-clicked(int,int,length,length,length);
    callback tag-menu-placed(int,length,length,length);
    callback tag-menu-dismissed();
    callback tag-menu-answered(bool);

    in property <string> window-title: "edit tags";
    in property <string> title-suffix: "";
    title: (root.window-title) + root.title-suffix;
    preferred-width: 460px;
    preferred-height: 600px;
    background: Theme.window;
    in-out property <string> text;
    in property <[ListText]> tags;
    in property <[ListText]> suggestions;
    in property <int> highlighted: -1;
    in property <[bool]> selected;
    in property <int> tab-index;
    in property <int> list-height: 11;
    in property <string> question;
    in property <string> error;
    // a line of explanation above the tags (the reference's dialog `message`)
    in property <string> message;
    out property <length> results-x: input.results-x;
    out property <length> results-y: input.results-y;
    out property <length> results-width: input.results-width;
    public function focus-results() { input.focus-results(); }
    public function focus-input() { input.focus-input(); }
    out property <bool> input-focused: input.editor-focused;
    public function normal-paste() { input.normal-paste(); }
    public function undo-input() { input.undo-input(); }
    public function redo-input() { input.redo-input(); }
    public function select-input(anchor: int, cursor: int) { input.select-input(anchor,cursor); }
    callback tab-chosen(int);
    callback edited(string);
    callback entered();
    callback fetch();
    callback move-highlight(int);
    callback navigate(int,bool,bool);
    callback results-action(int) -> bool;
    callback chosen(int);
    callback selection-clicked(int, bool, bool);
    callback context-menu(int, length, length);
    callback domain-menu(bool,length,length);
    in property <string> file-label;
    in property <string> tag-label;
    callback paste(bool) -> bool;
    callback answered(bool);
    callback remove(int);
    callback apply();
    callback cancel();
    forward-focus: input;
    FocusScope {
        capture-key-pressed(event) => {
            if event.text == Key.Escape { if root.tag-menu-panes.length > 0 || root.tag-menu-question != "" { root.tag-menu-dismissed(); } else if !input.escape-results() { root.cancel(); } return accept; }
            reject
        }
        VerticalLayout {
            padding: 10px;
            spacing: 6px;
            if root.message != "": Text { text: root.message; color: Theme.text; wrap: word-wrap; }
            ListView {
                vertical-stretch: 1;
                for tag[i] in root.tags: Rectangle {
                    height: 22px;
                    Text { text: tag.text; color: tag.colour; x: 4px; vertical-alignment: center; }
                    TouchArea { enabled: root.question == ""; double-clicked => { root.remove(i); } }
                }
            }
            input := WriteTagInput {
                enabled: root.question == "";
                text <=> root.text;
                suggestions: root.suggestions;
                highlighted: root.highlighted;
                selected: root.selected;
                tab-index: root.tab-index;
                tab-chosen(i) => { root.tab-chosen(i); }
                list-height: root.list-height;
                edited(text) => { root.edited(text); }
                entered => { root.entered(); }
                fetch => { root.fetch(); }
                move-highlight(by) => { root.move-highlight(by); }
                navigate(d,ctrl,shift) => { root.navigate(d,ctrl,shift); }
                results-action(a) => { root.results-action(a) }
                chosen(i) => { root.chosen(i); }
                selection-clicked(i,ctrl,shift) => { root.selection-clicked(i,ctrl,shift); }
                context-menu(i,x,y) => { root.context-menu(i,x,y); }
                file-label:root.file-label;tag-label:root.tag-label;
                domain-menu(tags,x,y)=>{root.domain-menu(tags,x,y);}
                paste(button) => { root.paste(button) }
            }
            if root.question != "": Text { text: "Want to paste everything?"; color: Theme.text; }
            if root.question != "": Question { text: root.question; answered(yes) => { root.answered(yes); } }
            if root.error != "": Text { text: root.error; color: Theme.error; wrap: word-wrap; }
            HorizontalLayout {
                alignment: end;
                spacing: 6px;
                Button { enabled: root.question == ""; text: "apply"; clicked => { root.apply(); } }
                Button { text: "cancel"; clicked => { root.cancel(); } }
            }
        }

        if root.tag-menu-panes.length > 0 || root.tag-menu-question != "": TagMenuOverlay {
            width: root.width; height: root.height;
            panes: root.tag-menu-panes; question: root.tag-menu-question;
            question-title: root.tag-menu-question-title; yes-label: root.tag-menu-yes-label; no-label: root.tag-menu-no-label;
            hovered(p,l,r,t,x) => { root.tag-menu-hovered(p,l,r,t,x); }
            clicked(p,l,r,t,x) => { root.tag-menu-clicked(p,l,r,t,x); }
            placed(p,x,y,w) => { root.tag-menu-placed(p,x,y,w); }
            dismissed => { root.tag-menu-dismissed(); }
            answered(yes) => { root.tag-menu-answered(yes); }
        }
    }
}
