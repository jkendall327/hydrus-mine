// The import options editor for an importer ("edit import options", the
// reference's `EditSpecificImportOptionsContainerPanel`; its workings are
// hydrus-gui-model's `import_options_editor`, bound by
// `src/import_options_window.rs`): the kinds of options in a list, each
// labelled with whose default it uses or its custom options' summary, and
// the page of the kind chosen: its description, "use the default" or
// "set custom", and its options.

import { Button, CheckBox, ComboBox, LineEdit, ScrollView, SpinBox, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { EditorTreeRow, FiletypeTree } from "filetype_tree.slint";
import { ImportFavouriteRow, ImportFavouritesButton } from "import_options_favourites.slint";

// a file size limit: whether there is one, its number and unit (B, KB,
// MB, GB)
export struct SizeLimit {
    label: string,
    on: bool,
    value: int,
    unit: int,
}

// a resolution limit
export struct ResolutionLimit {
    label: string,
    on: bool,
    width: int,
    height: int,
}

// a tag service's part of the tags page (`EditServiceTagImportOptionsPanel`)
export struct TagServiceRow {
    name: string,
    get-tags: bool,
    // what its "get tags" filter lets through
    filter: string,
    additional: string,
    to-new: bool,
    to-inbox: bool,
    to-archive: bool,
    get-overwrite: bool,
    additional-overwrite: bool,
    only-existing: bool,
}

component Label inherits Text {
    vertical-alignment: center;
    wrap: word-wrap;
    color: Theme.text;
}

// a labelled row
component Row inherits HorizontalLayout {
    in property <string> label;
    spacing: 6px;
    Label {
        text: root.label;
        horizontal-stretch: 1;
    }
    @children
}

export component ImportOptionsWindow inherits Window {
    in property <string> window-title: "edit import options";
    title: root.window-title;
    preferred-width: 900px;
    preferred-height: 620px;
    background: Theme.window;
    in property <string> description;
    in property <[string]> labels;
    in property <int> shown;
    // the page: its kind's name, description and default choice's label
    in property <string> kind;
    in property <string> kind-description;
    in property <[string]> custom-choices;
    in-out property <int> custom-index;
    in property <bool> default-choice-enabled: true;
    // (a kind with no editor here yet: its options' summary)
    in property <string> summary;
    // presentation
    in-out property <int> status-index;
    in property <[string]> inbox-choices;
    in-out property <int> inbox-index;
    in property <[string]> location-choices;
    in-out property <int> location-index;
    // prefetch
    in-out property <int> hash-index;
    in-out property <int> url-index;
    in-out property <bool> fetch-hash;
    in-out property <bool> fetch-url;
    in-out property <bool> neighbour-spam;
    // file filtering
    in property <string> filetypes;
    // the allowed filetypes' tree
    in property <[EditorTreeRow]> filetype-rows;
    callback filetype-expanded(int, bool);
    callback filetype-ticked(int, int, bool);
    in-out property <bool> exclude-deleted;
    in-out property <bool> bombs;
    in property <[SizeLimit]> sizes;
    in property <[ResolutionLimit]> resolutions;
    // locations
    in property <[string]> destination-choices;
    in-out property <int> destination-index;
    in-out property <bool> already-destinations;
    in-out property <bool> archive;
    in-out property <bool> archive-already;
    in property <bool> downloader;
    in-out property <bool> primary-urls;
    in-out property <bool> source-urls;
    // notes
    in-out property <bool> get-notes;
    in-out property <bool> extend-notes;
    in-out property <int> conflict-index;
    in-out property <string> note-whitelist;
    in-out property <string> note-renames;
    in-out property <bool> rename-all-on;
    in-out property <string> rename-all;
    // tag filtering
    // the blacklist button's label
    in property <string> tag-blacklist;
    callback edit-blacklist();
    // a tag service's "get tags" filter button clicked
    callback edit-get-tags-filter(int);
    in-out property <string> tag-whitelist;
    in property <bool> tag-child-open;
    callback edit-whitelist();
    callback edit-additional-tags(int);
    // tags
    in property <[TagServiceRow]> tag-services;
    in property <bool> gets-no-tags;
    callback tag-service-toggled(int, string, bool);
    callback tag-service-text(int, string);
    callback kind-clicked(int);
    // a field changed: what the window's two-way fields hold is read
    callback changed();
    callback size-edited(int, bool, int, int);
    callback resolution-edited(int, bool, int, int);
    callback apply();
    callback cancel();
    callback copy-options();
    callback paste-options(int);
    in property <string> clipboard-error;
    in property <bool> overwrite-open;
    in property <[ImportFavouriteRow]> favourites;
    in property <bool> favourite-editor;
    in property <bool> favourite-child-open;
    in-out property <string> favourite-name;
    callback refresh-favourites();
    callback favourite(int, string);

    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        Label {
            text: root.description;
            horizontal-alignment: center;
        }
        if root.favourite-editor: HorizontalLayout {
            spacing: 6px;
            Label { text: "name: "; }
            LineEdit { horizontal-stretch: 1; text <=> root.favourite-name; }
        }
        HorizontalLayout {
            spacing: 10px;
            vertical-stretch: 1;
            Rectangle {
                width: 300px;
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    alignment: start;
                    for label[i] in root.labels: Rectangle {
                        height: 26px;
                        background: i == root.shown ? Theme.highlight : transparent;
                        Text {
                            x: 6px;
                            width: parent.width - 12px;
                            text: label;
                            vertical-alignment: center;
                            overflow: elide;
                            color: i == root.shown ? Theme.highlight-text : Theme.text;
                        }
                        TouchArea {
                            clicked => { root.kind-clicked(i); }
                        }
                    }
                }
            }
            ScrollView {
                horizontal-stretch: 1;
                VerticalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: root.kind;
                        font-weight: 700;
                        horizontal-alignment: center;
                        color: Theme.text;
                    }
                    Label {
                        text: root.kind-description;
                        horizontal-alignment: center;
                    }
                    ComboBox {
                        enabled: root.default-choice-enabled;
                        model: root.custom-choices;
                        current-index <=> root.custom-index;
                        selected => { root.changed(); }
                    }
                    if root.custom-index == 1 && root.kind == "presentation": HorizontalLayout {
                        spacing: 6px;
                        ComboBox {
                            model: ["all files", "new files", "do not show anything"];
                            current-index <=> root.status-index;
                            selected => { root.changed(); }
                        }
                        ComboBox {
                            enabled: root.status-index != 2;
                            model: root.inbox-choices;
                            current-index <=> root.inbox-index;
                            selected => { root.changed(); }
                        }
                        ComboBox {
                            enabled: root.status-index != 2;
                            model: root.location-choices;
                            current-index <=> root.location-index;
                            selected => { root.changed(); }
                        }
                    }
                    if root.custom-index == 1 && root.kind == "prefetch logic": VerticalLayout {
                        spacing: 6px;
                        Label {
                            text: "BE CAREFUL, PREFETCH LOGIC IS ADVANCED";
                            horizontal-alignment: center;
                            color: Theme.error;
                        }
                        Row {
                            label: "check hashes to determine \"already in db/previously deleted\" outcome?: ";
                            ComboBox {
                                model: ["do not check", "check", "check - and matches are dispositive"];
                                current-index <=> root.hash-index;
                                selected => { root.changed(); }
                            }
                        }
                        Row {
                            label: "check URLs to determine \"already in db/previously deleted\" outcome?: ";
                            ComboBox {
                                model: ["do not check", "check", "check - and matches are dispositive"];
                                current-index <=> root.url-index;
                                selected => { root.changed(); }
                            }
                        }
                        Row {
                            label: "force metadata/page fetch even if hash recognised and file appears \"already in db\"?: ";
                            CheckBox {
                                checked <=> root.fetch-hash;
                                toggled => { root.changed(); }
                            }
                        }
                        Row {
                            label: "force metadata/page fetch even if url recognised and file appears \"already in db\"?: ";
                            CheckBox {
                                checked <=> root.fetch-url;
                                toggled => { root.changed(); }
                            }
                        }
                        Row {
                            label: "during URL check, check for neighbour-spam?: ";
                            CheckBox {
                                enabled: root.url-index != 0;
                                checked <=> root.neighbour-spam;
                                toggled => { root.changed(); }
                            }
                        }
                    }
                    if root.custom-index == 1 && root.kind == "file filtering": VerticalLayout {
                        spacing: 6px;
                        Row {
                            label: "allowed filetypes: ";
                            Label { text: root.filetypes; }
                        }
                        FiletypeTree {
                            rows: root.filetype-rows;
                            expanded(group, on) => { root.filetype-expanded(group, on); }
                            ticked(group, option, on) => { root.filetype-ticked(group, option, on); }
                        }
                        Row {
                            label: "exclude previously deleted files: ";
                            CheckBox {
                                checked <=> root.exclude-deleted;
                                toggled => { root.changed(); }
                            }
                        }
                        Row {
                            label: "allow decompression bombs: ";
                            CheckBox {
                                checked <=> root.bombs;
                                toggled => { root.changed(); }
                            }
                        }
                        for size[i] in root.sizes: Row {
                            label: size.label;
                            CheckBox {
                                checked: size.on;
                                toggled => { root.size-edited(i, self.checked, size.value, size.unit); }
                            }
                            SpinBox {
                                enabled: size.on;
                                minimum: 1;
                                maximum: 1000000;
                                value: size.value;
                                edited(v) => { root.size-edited(i, size.on, v, size.unit); }
                            }
                            ComboBox {
                                enabled: size.on;
                                model: ["B", "KB", "MB", "GB"];
                                current-index: size.unit;
                                selected => { root.size-edited(i, size.on, size.value, self.current-index); }
                            }
                        }
                        for res[i] in root.resolutions: Row {
                            label: res.label;
                            CheckBox {
                                checked: res.on;
                                toggled => { root.resolution-edited(i, self.checked, res.width, res.height); }
                            }
                            SpinBox {
                                enabled: res.on;
                                minimum: 1;
                                maximum: 100000;
                                value: res.width;
                                edited(v) => { root.resolution-edited(i, res.on, v, res.height); }
                            }
                            Label { text: "x"; }
                            SpinBox {
                                enabled: res.on;
                                minimum: 1;
                                maximum: 100000;
                                value: res.height;
                                edited(v) => { root.resolution-edited(i, res.on, res.width, v); }
                            }
                        }
                    }
                    if root.custom-index == 1 && root.kind == "locations": VerticalLayout {
                        spacing: 6px;
                        Row {
                            label: "destination file service(s):";
                            ComboBox {
                                model: root.destination-choices;
                                current-index <=> root.destination-index;
                                selected => { root.changed(); }
                            }
                        }
                        Row {
                            label: "-- ensure 'already in db' files are added to destinations?: ";
                            CheckBox {
                                checked <=> root.already-destinations;
                                toggled => { root.changed(); }
                            }
                        }
                        Row {
                            label: "auto-archive imports: ";
                            CheckBox {
                                checked <=> root.archive;
                                toggled => { root.changed(); }
                            }
                        }
                        Row {
                            label: "-- even for 'already in db' files?: ";
                            CheckBox {
                                enabled: root.archive;
                                checked <=> root.archive-already;
                                toggled => { root.changed(); }
                            }
                        }
                        if root.downloader: Row {
                            label: "associate primary urls: ";
                            CheckBox {
                                checked <=> root.primary-urls;
                                toggled => { root.changed(); }
                            }
                        }
                        if root.downloader: Row {
                            label: "associate (and trust) additional source urls: ";
                            CheckBox {
                                checked <=> root.source-urls;
                                toggled => { root.changed(); }
                            }
                        }
                    }
                    if root.custom-index == 1 && root.kind == "notes": VerticalLayout {
                        spacing: 6px;
                        Row {
                            label: "get notes: ";
                            CheckBox {
                                checked <=> root.get-notes;
                                toggled => { root.changed(); }
                            }
                        }
                        Row {
                            label: "if possible, extend existing notes: ";
                            CheckBox {
                                checked <=> root.extend-notes;
                                toggled => { root.changed(); }
                            }
                        }
                        Row {
                            label: "if existing note-name conflict, what to do: ";
                            ComboBox {
                                model: ["replace the existing note", "do not add the new note", "append the new note to the end of the existing note", "add the new note under a new name"];
                                current-index <=> root.conflict-index;
                                selected => { root.changed(); }
                            }
                        }
                        Label { text: "only allow these note names\n(leave blank for 'get all'), one a line: "; }
                        TextEdit {
                            height: 80px;
                            text <=> root.note-whitelist;
                            edited => { root.changed(); }
                        }
                        Label { text: "rename these notes as they come in (\"parser name -> saved name\", one a line): "; }
                        TextEdit {
                            height: 80px;
                            text <=> root.note-renames;
                            edited => { root.changed(); }
                        }
                        Row {
                            label: "rename spare note(s) to this: ";
                            CheckBox {
                                checked <=> root.rename-all-on;
                                toggled => { root.changed(); }
                            }
                            LineEdit {
                                enabled: root.rename-all-on;
                                placeholder-text: "do not mass-rename";
                                text <=> root.rename-all;
                                edited => { root.changed(); }
                            }
                        }
                    }
                    if root.custom-index == 1 && root.kind == "tag filtering": VerticalLayout {
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 6px;
                            Label { text: "file blacklist: "; }
                            Button {
                                horizontal-stretch: 1;
                                text: root.tag-blacklist;
                                clicked => { root.edit-blacklist(); }
                            }
                        }
                        Label { text: "file whitelist (a file must have one of these tags, if any are set; a tag a line): "; }
                        Button { text: "edit whitelist tags…"; enabled: !root.tag-child-open; clicked => { root.edit-whitelist(); } }
                        TextEdit {
                            height: 100px;
                            text <=> root.tag-whitelist;
                            edited => { root.changed(); }
                        }
                    }
                    if root.custom-index == 1 && root.kind == "tags": VerticalLayout {
                        spacing: 8px;
                        if root.gets-no-tags: Label {
                            text: "THIS CURRENTLY GETS NO TAGS";
                            horizontal-alignment: center;
                            color: Theme.error;
                        }
                        for service[i] in root.tag-services: Rectangle {
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 6px;
                                spacing: 4px;
                                Text {
                                    text: service.name;
                                    font-weight: 700;
                                    color: Theme.text;
                                }
                                if root.downloader: HorizontalLayout {
                                    spacing: 6px;
                                    CheckBox {
                                        text: "get tags";
                                        checked: service.get-tags;
                                        toggled => { root.tag-service-toggled(i, "get-tags", self.checked); }
                                    }
                                    Button {
                                        text: service.filter;
                                        enabled: service.get-tags;
                                        horizontal-stretch: 1;
                                        clicked => { root.edit-get-tags-filter(i); }
                                    }
                                }
                                Label { text: "additional tags, one a line: "; }
                                Button { text: "edit additional tags…"; enabled: !root.tag-child-open; clicked => { root.edit-additional-tags(i); } }
                                TextEdit {
                                    height: 60px;
                                    text: service.additional;
                                    edited(text) => { root.tag-service-text(i, text); }
                                }
                                CheckBox {
                                    text: "apply tags to new files";
                                    checked: service.to-new;
                                    toggled => { root.tag-service-toggled(i, "to-new", self.checked); }
                                }
                                CheckBox {
                                    text: "apply tags to files already in inbox";
                                    checked: service.to-inbox;
                                    toggled => { root.tag-service-toggled(i, "to-inbox", self.checked); }
                                }
                                CheckBox {
                                    text: "apply tags to files already in archive";
                                    checked: service.to-archive;
                                    toggled => { root.tag-service-toggled(i, "to-archive", self.checked); }
                                }
                                if root.downloader: CheckBox {
                                    text: "parsed tags overwrite previously deleted tags";
                                    checked: service.get-overwrite;
                                    toggled => { root.tag-service-toggled(i, "get-overwrite", self.checked); }
                                }
                                CheckBox {
                                    text: "additional tags overwrite previously deleted tags";
                                    checked: service.additional-overwrite;
                                    toggled => { root.tag-service-toggled(i, "additional-overwrite", self.checked); }
                                }
                                CheckBox {
                                    text: "only add tags that already exist";
                                    checked: service.only-existing;
                                    toggled => { root.tag-service-toggled(i, "only-existing", self.checked); }
                                }
                            }
                        }
                    }
                    if root.custom-index == 1 && root.summary != "": Label {
                        text: root.summary;
                    }
                }
            }
        }
        if root.clipboard-error != "": Text { text: root.clipboard-error; color: Theme.error; wrap: word-wrap; }
        HorizontalLayout {
            alignment: end;
            spacing: 6px;
            ImportFavouritesButton {
                rows: root.favourites;
                edit-allowed: !root.favourite-editor;
                enabled: !root.favourite-child-open && !root.overwrite-open && !root.tag-child-open && !root.favourite-child-open;
                refresh => { root.refresh-favourites(); }
                selected(action, name) => { root.favourite(action, name); }
            }
            Button { text: "copy"; enabled: !root.overwrite-open && !root.tag-child-open && !root.favourite-child-open; clicked => { root.copy-options(); } }
            Rectangle {
                width: 66px;
                height: 28px;
                Button { width: parent.width; height: parent.height; text: "paste"; enabled: !root.overwrite-open && !root.tag-child-open && !root.favourite-child-open; clicked => { clipboard-menu.show(); } }
                clipboard-menu := PopupWindow {
                    y: parent.height;
                    width: 320px;
                    height: 148px;
                    Rectangle {
                        background: Theme.panel;
                        border-color: Theme.border;
                        border-width: 1px;
                        VerticalLayout {
                            padding: 4px;
                            spacing: 2px;
                            Button { text: "custom paste: choose what you want"; clicked => { clipboard-menu.close(); root.paste-options(3); } }
                            Rectangle { height: 1px; background: Theme.border; }
                            Button { text: "merge-paste"; clicked => { clipboard-menu.close(); root.paste-options(0); } }
                            Button { text: "fill-in-gaps-paste"; clicked => { clipboard-menu.close(); root.paste-options(1); } }
                            Button { text: "replace-paste"; clicked => { clipboard-menu.close(); root.paste-options(2); } }
                        }
                    }
                }
            }
            Button {
                text: "apply";
                enabled: !root.overwrite-open && !root.tag-child-open && !root.favourite-child-open;
                clicked => { root.apply(); }
            }
            Button {
                text: "cancel";
                clicked => { root.cancel(); }
            }
        }
    }
}
