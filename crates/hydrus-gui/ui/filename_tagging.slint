// The "filename tagging" dialog for files about to be imported from disk
// (the reference's `EditLocalImportFilenameTaggingPanel`, opened by "review
// files to import"'s "add tags/urls with the import >>"; its workings are
// hydrus-gui-model's `filename_tagging`, bound by
// `src/filename_tagging_window.rs`): a "sidecars" tab, with the paths and
// what each one's sidecars give and the routers that read them, then a tab
// per tag service, each with the paths and the tags each gets, over its
// "simple" and "advanced" options.

import { Button, CheckBox, LineEdit, SpinBox, TextEdit } from "std-widgets.slint";
import { MenuPane, MenuPanes } from "main_menu.slint";
import { Theme } from "theme.slint";
import { ListTable, TableRow } from "list_table.slint";

// a "misc" row: a checkbox and its namespace
export struct MiscRow {
    label: string,
    on: bool,
    namespace: string,
}

component Label inherits Text {
    vertical-alignment: center;
    wrap: word-wrap;
    color: Theme.text;
}

component BoxTitle inherits Text {
    font-weight: 700;
    color: Theme.text;
}

component Tab inherits Rectangle {
    in property <string> text;
    in property <bool> current;
    callback clicked();
    height: 28px;
    min-width: label.preferred-width + 20px;
    border-width: 1px;
    border-color: Theme.border;
    background: root.current ? Theme.highlight : transparent;
    label := Text {
        text: root.text;
        color: root.current ? Theme.highlight-text : Theme.text;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

export component FilenameTaggingWindow inherits Window {
    in property <string> window-title: "filename tagging";
    in property <string> title-suffix: "";
    title: (root.window-title) + root.title-suffix;
    preferred-width: 1000px;
    preferred-height: 760px;
    background: Theme.window;
    // one tag service's options alone (`EditFilenameTaggingOptionPanel`,
    // for an import folder): an example path and its tags in place of the
    // tabs and the files, and no single tags or "#"
    in property <bool> options-mode;
    in-out property <string> example;
    in property <string> example-tags;
    in property <[string]> services;
    in property <int> service-index;
    // the "sidecars" tab (not in options mode): whether it is the one
    // shown, its rows, and its routers button
    in property <bool> on-sidecars;
    in property <[TableRow]> sidecar-rows;
    in property <string> sidecars;
    in property <[TableRow]> rows;
    in-out property <bool> advanced;
    // simple
    in-out property <string> tags-all;
    in-out property <string> tags-selected;
    in property <bool> has-selection;
    in property <bool> tags-child-open;
    callback edit-tags(bool);
    callback paste-tags(bool);
    in property <[MiscRow]> misc;
    // advanced
    in-out property <string> quick;
    in-out property <string> regexes;
    in-out property <int> number-base;
    in-out property <int> number-step;
    in-out property <string> number-namespace;
    // Accepted advanced rules and the owned quick-namespace child.
    in property <[TableRow]> quick-rows;
    in property <[TableRow]> regex-rows;
    in property <bool> quick-one-selected;
    in property <bool> quick-any-selected;
    in property <int> quick-sort-column;
    in property <bool> quick-ascending;
    callback rule-sort(int, bool);
    in-out property <string> regex-input;
    in property <bool> rule-child;
    in property <bool> rule-delete;
    in property <string> rule-message;
    in property <[MenuPane]> regex-panes;
    in property <bool> regex-child-open;
    callback regex-menu(float, float);
    callback regex-placed(int, float, float, float);
    callback regex-hovered(int, int, float, float, float);
    callback regex-clicked(int, int, float, float, float);
    callback regex-dismissed();
    in-out property <string> rule-namespace;
    in-out property <string> rule-regex;
    callback rule-clicked(bool, int, bool, bool);
    callback rule-action(string);
    callback rule-entered();
    callback rule-answer(bool);
    callback rule-cancel();
    // what is wrong with what is typed
    in property <string> errors;
    callback service-chosen(int);
    callback sidecars-chosen();
    callback edit-sidecars();
    callback row-clicked(int, bool, bool);
    // a text field or number changed: the two-way fields are read
    callback changed();
    // a "misc" row's box ticked or not, or its namespace typed
    callback misc-toggled(int, bool);
    callback misc-namespace(int, string);
    callback apply();
    callback cancel();

    forward-focus: keys;
    keys := FocusScope {
        capture-key-pressed(event) => {
            if root.regex-child-open || root.tags-child-open { return accept; }
            if event.text == Key.Escape {
                if root.regex-panes.length > 0 { root.regex-dismissed(); return accept; }
                if root.rule-child || root.rule-delete { root.rule-cancel(); }
                else { root.cancel(); }
                return accept;
            }
            reject
        }
    if !root.rule-child && !root.rule-delete: VerticalLayout {
        padding: 10px;
        spacing: 6px;
        if !root.options-mode: HorizontalLayout {
            spacing: 0px;
            alignment: start;
            Tab {
                text: "sidecars";
                current: root.on-sidecars;
                clicked => { root.sidecars-chosen(); }
            }
            for name[i] in root.services: Tab {
                text: name;
                current: !root.on-sidecars && i == root.service-index;
                clicked => { root.service-chosen(i); }
            }
        }
        if root.options-mode: VerticalLayout {
            spacing: 4px;
            LineEdit {
                placeholder-text: "enter example path here";
                text <=> root.example;
                edited => { root.changed(); }
            }
            LineEdit {
                read-only: true;
                text: root.example-tags;
            }
        }
        if root.on-sidecars: VerticalLayout {
            vertical-stretch: 1;
            spacing: 6px;
            Label {
                text: "You can import tags, URLs, and other metadata via \"sidecars\", which are little text files accompanying each import file. For instance, where importing \"cool_image.jpg\", you can tell hydrus to check \"cool_image.jpg.txt\" for a list of tags to add.";
            }
            ListTable {
                vertical-stretch: 1;
                columns: [
                    { title: "#", width: 40px },
                    { title: "path", width: 420px },
                    { title: "metadata", width: 300px, stretch: true },
                ];
                rows: root.sidecar-rows;
            }
            BoxTitle { text: "sidecar import routes"; }
            Button {
                text: root.sidecars;
                clicked => { root.edit-sidecars(); }
            }
        }
        if !root.options-mode && !root.on-sidecars: ListTable {
            vertical-stretch: 1;
            columns: [
                { title: "#", width: 40px },
                { title: "path", width: 420px },
                { title: "metadata", width: 300px, stretch: true },
            ];
            rows: root.rows;
            row-clicked(row, ctrl, shift) => { root.row-clicked(row, ctrl, shift); }
        }
        if !root.on-sidecars: HorizontalLayout {
            spacing: 0px;
            alignment: start;
            Tab {
                text: "simple";
                current: !root.advanced;
                clicked => { root.advanced = false; }
            }
            Tab {
                text: "advanced";
                current: root.advanced;
                clicked => { root.advanced = true; }
            }
        }
        if !root.on-sidecars && !root.advanced: HorizontalLayout {
            spacing: 10px;
            height: 260px;
            VerticalLayout {
                spacing: 4px;
                BoxTitle { text: "tags for all"; }
                TextEdit {
                    vertical-stretch: 1;
                    read-only: true;
                    text <=> root.tags-all;
                }
                HorizontalLayout {
                    Button { text: "edit tags…"; clicked => { root.edit-tags(false); } }
                    Button { text: "paste tags"; clicked => { root.paste-tags(false); } }
                }
            }
            if !root.options-mode: VerticalLayout {
                spacing: 4px;
                BoxTitle { text: "tags just for selected files"; }
                if !root.has-selection: Label { text: "(select files above)"; }
                TextEdit {
                    vertical-stretch: 1;
                    read-only: true;
                    enabled: root.has-selection;
                    text <=> root.tags-selected;
                }
                HorizontalLayout {
                    Button { text: "edit tags…"; enabled: root.has-selection; clicked => { root.edit-tags(true); } }
                    Button { text: "paste tags"; enabled: root.has-selection; clicked => { root.paste-tags(true); } }
                }
            }
            VerticalLayout {
                spacing: 4px;
                alignment: start;
                BoxTitle { text: "misc"; }
                for row[i] in root.misc: HorizontalLayout {
                    spacing: 4px;
                    Label {
                        text: row.label;
                        min-width: 170px;
                    }
                    CheckBox {
                        checked: row.on;
                        toggled => { root.misc-toggled(i, self.checked); }
                    }
                    LineEdit {
                        width: 110px;
                        placeholder-text: "namespace";
                        text: row.namespace;
                        edited(text) => { root.misc-namespace(i, text); }
                    }
                }
            }
        }
        if !root.on-sidecars && root.advanced: HorizontalLayout {
            spacing: 10px;
            height: 260px;
            VerticalLayout {
                spacing: 4px;
                BoxTitle { text: "quick namespaces"; }
                ListTable {
                    vertical-stretch: 1;
                    columns: [{ title: "namespace", width: 160px }, { title: "regex", width: 250px, stretch: true }];
                    rows: root.quick-rows;
                    sort-column: root.quick-sort-column;
                    ascending: root.quick-ascending;
                    sort(column, ascending) => { root.rule-sort(column, ascending); }
                    delete-pressed => { root.rule-action("quick_delete"); }
                    row-clicked(i, ctrl, shift) => { root.rule-clicked(true, i, ctrl, shift); }
                    row-activated(i) => { root.rule-action("quick_edit"); }
                }
                HorizontalLayout {
                    spacing: 4px;
                    Button { text: "add"; clicked => { root.rule-action("quick_add"); } }
                    Button { text: "edit"; enabled: root.quick-one-selected; clicked => { root.rule-action("quick_edit"); } }
                    Button { text: "delete"; enabled: root.quick-any-selected; clicked => { root.rule-action("quick_delete"); } }
                }
            }
            VerticalLayout {
                spacing: 4px;
                BoxTitle { text: "regexes"; }
                ListTable {
                    vertical-stretch: 1;
                    columns: [{ title: "regex", width: 400px, stretch: true }];
                    rows: root.regex-rows;
                    row-clicked(i, ctrl, shift) => { root.rule-clicked(false, i, ctrl, shift); }
                    row-activated(i) => { root.rule-action("regex_remove"); }
                }
                HorizontalLayout {
                    spacing: 4px;
                    LineEdit {
                        horizontal-stretch: 1;
                        text <=> root.regex-input;
                        placeholder-text: "enter regex here";
                        accepted => { root.rule-action("regex_add"); }
                    }
                    regex-button := Button { text: ".*"; enabled: !root.regex-child-open; clicked => { root.regex-menu(regex-button.absolute-position.x / 1px, (regex-button.absolute-position.y + regex-button.height) / 1px); } }
                    Button { text: "add"; clicked => { root.rule-action("regex_add"); } }
                }
                if !root.options-mode: BoxTitle { text: "#"; }
                if !root.options-mode: HorizontalLayout {
                    spacing: 4px;
                    Label { text: "# base/step: "; }
                    SpinBox {
                        minimum: -10000000;
                        maximum: 10000000;
                        value <=> root.number-base;
                        edited => { root.changed(); }
                    }
                    SpinBox {
                        minimum: -1000000;
                        maximum: 1000000;
                        value <=> root.number-step;
                        edited => { root.changed(); }
                    }
                }
                if !root.options-mode: HorizontalLayout {
                    spacing: 4px;
                    Label { text: "# namespace: "; }
                    LineEdit {
                        text <=> root.number-namespace;
                        edited => { root.changed(); }
                    }
                }
            }
        }
        if root.errors != "": Label {
            text: root.errors;
            color: Theme.error;
        }
        HorizontalLayout {
            height: 32px;
            vertical-stretch: 0;
            alignment: end;
            spacing: 6px;
            Button {
                vertical-stretch: 0;
                text: "apply";
                clicked => { root.apply(); }
            }
            Button {
                vertical-stretch: 0;
                text: "cancel";
                clicked => { root.cancel(); }
            }
        }
    }
    if root.rule-child || root.rule-delete: VerticalLayout {
        padding: 12px;
        spacing: 8px;
        BoxTitle { text: root.rule-child ? "configure quick namespace" : "delete"; }
        Label { text: root.rule-message; }
        if root.rule-child: HorizontalLayout {
            spacing: 6px;
            LineEdit { horizontal-stretch: 1; text <=> root.rule-namespace; placeholder-text: "namespace"; }
            Label { text: ":"; }
            LineEdit { horizontal-stretch: 2; enabled: !root.regex-child-open; text <=> root.rule-regex; placeholder-text: "regex"; accepted => { root.rule-entered(); } }
            child-regex-button := Button { text: ".*"; enabled: !root.regex-child-open; clicked => { root.regex-menu(child-regex-button.absolute-position.x / 1px, (child-regex-button.absolute-position.y + child-regex-button.height) / 1px); } }
        }
        if root.errors != "": Label { text: root.errors; color: Theme.error; }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            alignment: end;
            spacing: 6px;
            Button { text: root.rule-child ? "OK" : "yes"; clicked => { if root.rule-child { root.rule-entered(); } else { root.rule-answer(true); } } }
            Button { text: root.rule-child ? "Cancel" : "no"; clicked => { root.rule-cancel(); } }
        }
    }
    }

    if root.regex-child-open || root.tags-child-open: Rectangle {
        width: root.width; height: root.height;
        TouchArea { }
    }
    if root.regex-panes.length > 0: MenuPanes {
        width: root.width; height: root.height; panes: root.regex-panes;
        dismiss => { root.regex-dismissed(); }
        placed(p, x, y, w) => { root.regex-placed(p, x / 1px, y / 1px, w / 1px); }
        line-hovered(p, l, r, t, left) => { root.regex-hovered(p, l, r / 1px, t / 1px, left / 1px); }
        line-clicked(p, l, r, t, left) => { root.regex-clicked(p, l, r / 1px, t / 1px, left / 1px); }
    }

}
