// The sidecar editors (the reference's `ClientGUIMetadataMigration*`;
// their workings are hydrus-gui-model's `sidecar_editors`, bound by
// `src/sidecars_window.rs`): the routers list, a router's editor (its
// sources, processing and destination), and the editor of a source or a
// destination.

import { Button, CheckBox, ComboBox, LineEdit, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Asking } from "subscriptions.slint";
import { ListTable, TableRow } from "list_table.slint";

component Box inherits Rectangle {
    in property <string> title;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: 6px;
        spacing: 4px;
        Text {
            text: root.title;
            font-weight: 700;
            color: Theme.text;
        }
        @children
    }
}

component Row inherits HorizontalLayout {
    in property <string> label;
    spacing: 6px;
    Text {
        width: 300px;
        text: root.label;
        wrap: word-wrap;
        vertical-alignment: center;
        color: Theme.text;
    }
    @children
}

// a list with add, edit and delete beside it
component EditList inherits HorizontalLayout {
    in property <[TableRow]> rows;
    in property <string> column;
    in property <bool> asking;
    in property <bool> one-selected;
    in property <bool> any-selected;
    callback row-clicked(int, bool, bool);
    callback row-activated(int);
    callback add();
    callback edit();
    callback delete();
    spacing: 4px;
    ListTable {
        horizontal-stretch: 1;
        min-height: 120px;
        columns: [{ title: root.column, width: 400px, stretch: true }];
        rows: root.rows;
        row-clicked(r, ctrl, shift) => { root.row-clicked(r, ctrl, shift); }
        row-activated(r) => { root.row-activated(r); }
    }
    VerticalLayout {
        spacing: 4px;
        alignment: start;
        Button {
            text: "add";
            enabled: !root.asking;
            clicked => { root.add(); }
        }
        Button {
            text: "edit";
            enabled: root.one-selected && !root.asking;
            clicked => { root.edit(); }
        }
        Button {
            text: "delete";
            enabled: root.any-selected && !root.asking;
            clicked => { root.delete(); }
        }
        @children
    }
}

component ApplyCancel inherits HorizontalLayout {
    in property <bool> enabled: true;
    callback apply();
    callback cancel();
    alignment: end;
    spacing: 6px;
    Button {
        text: "apply";
        enabled: root.enabled;
        clicked => { root.apply(); }
    }
    Button {
        text: "cancel";
        clicked => { root.cancel(); }
    }
}

// "edit metadata migration routers"
export component SidecarRoutersWindow inherits Window {
    in property <string> window-title: "edit metadata migration routers";
    in property <string> title-suffix: "";
    title: (root.window-title) + root.title-suffix;
    preferred-width: 760px;
    preferred-height: 420px;
    background: Theme.window;
    in property <[TableRow]> rows;
    in property <bool> one-selected;
    in property <bool> any-selected;
    // the templates menu's entries, if any
    in property <[string]> templates;
    in property <bool> asking;
    in property <bool> child-open;
    in property <string> error;
    in property <string> asking-title;
    in property <string> asking-message;
    in property <[string]> asking-choices;
    callback row-clicked(int, bool, bool);
    callback row-activated(int);
    callback add();
    callback edit();
    callback delete();
    callback exchange(bool);
    callback duplicate();
    callback template(int);
    callback chosen(int);
    callback cancelled();
    callback apply();
    callback cancel();

    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        EditList {
            vertical-stretch: 1;
            column: "sidecar actions";
            rows: root.rows;
            asking: root.asking || root.child-open;
            one-selected: root.one-selected;
            any-selected: root.any-selected;
            row-clicked(r, ctrl, shift) => { root.row-clicked(r, ctrl, shift); }
            row-activated(r) => { root.row-activated(r); }
            add => { root.add(); }
            edit => { root.edit(); }
            delete => { root.delete(); }
            templates-menu := ContextMenuArea {
                Menu {
                    for template[i] in root.templates: MenuItem {
                        title: template;
                        activated => { root.template(i); }
                    }
                }
                if root.templates.length > 0: Button {
                    text: "★";
                    enabled: !root.asking && !root.child-open;
                    clicked => { templates-menu.show({ x: 0px, y: self.height }); }
                }
            }
        }
        HorizontalLayout {
            alignment: start; spacing: 6px;
            Button { text: "import"; enabled: !root.asking && !root.child-open; clicked => { root.exchange(true); } }
            Button { text: "export"; enabled: root.any-selected && !root.asking && !root.child-open; clicked => { root.exchange(false); } }
            Button { text: "duplicate"; enabled: root.any-selected && !root.asking && !root.child-open; clicked => { root.duplicate(); } }
        }
        if root.error != "": Text { text: root.error; color: Theme.error; wrap: word-wrap; }
        if root.asking: Asking {
            title: root.asking-title;
            message: root.asking-message;
            choices: root.asking-choices;
            chosen(i) => { root.chosen(i); }
            cancelled => { root.cancelled(); }
        }
        ApplyCancel {
            enabled: !root.asking && !root.child-open;
            apply => { root.apply(); }
            cancel => { root.cancel(); }
        }
    }
}

// "edit metadata migration router"
export component SidecarRouterWindow inherits Window {
    in property <string> window-title: "edit metadata migration router";
    in property <string> title-suffix: "";
    title: (root.window-title) + root.title-suffix;
    preferred-width: 1000px;
    preferred-height: 720px;
    background: Theme.window;
    in property <[TableRow]> sources;
    in property <bool> one-selected;
    in property <bool> any-selected;
    in property <string> processing-note;
    in property <string> processing;
    in property <string> destination;
    in property <bool> asking;
    in property <bool> child-open;
    in property <string> asking-title;
    in property <string> asking-message;
    in property <[string]> asking-choices;
    in property <[string]> test-sources;
    in-out property <int> test-source;
    in property <[TableRow]> test-rows;
    in property <string> test-note;
    callback test-source-chosen();
    callback row-clicked(int, bool, bool);
    callback row-activated(int);
    callback add();
    callback edit();
    callback delete();
    callback edit-destination();
    callback edit-processing();
    callback chosen(int);
    callback cancelled();
    callback apply();
    callback cancel();
    callback closed();

    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        Box {
            vertical-stretch: 1;
            title: "sources";
            EditList {
                vertical-stretch: 1;
                column: "source";
                rows: root.sources;
                asking: root.asking || root.child-open;
                one-selected: root.one-selected;
                any-selected: root.any-selected;
                row-clicked(r, ctrl, shift) => { root.row-clicked(r, ctrl, shift); }
                row-activated(r) => { root.row-activated(r); }
                add => { root.add(); }
                edit => { root.edit(); }
                delete => { root.delete(); }
            }
        }
        Box {
            title: "processing";
            Text {
                text: root.processing-note;
                color: Theme.text;
            }
            Button {
                text: root.processing;
                enabled: !root.asking && !root.child-open;
                clicked => { root.edit-processing(); }
            }
        }
        Box {
            title: "destination";
            HorizontalLayout {
                spacing: 6px;
                Text {
                    horizontal-stretch: 1;
                    text: root.destination;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    color: Theme.text;
                }
                Button {
                    text: "edit";
                    enabled: !root.asking && !root.child-open;
                    clicked => { root.edit-destination(); }
                }
            }
        }
        Box {
            title: "testing";
            if root.test-note != "": Text {text: root.test-note;color: Theme.text;wrap: word-wrap;}
            if root.test-sources.length > 1: ComboBox {model: root.test-sources;current-index <=> root.test-source;selected => {root.test-source-chosen();}}
            if root.test-sources.length > 0: ListTable {
                min-height: 160px;
                columns: [{title: "file",width: 300px},{title: "source texts",width: 280px},{title: "processed texts",width: 280px,stretch: true}];
                rows: root.test-rows;
            }
        }
        if root.asking: Asking {
            title: root.asking-title;
            message: root.asking-message;
            choices: root.asking-choices;
            chosen(i) => { root.chosen(i); }
            cancelled => { root.cancelled(); }
        }
        ApplyCancel {
            enabled: !root.asking && !root.child-open;
            apply => { root.apply(); }
            cancel => { root.cancel(); }
        }
    }
}

// a source's or a destination's editor
export component SidecarNodeWindow inherits Window {
    in property <string> window-title: "edit metadata migration source";
    in property <string> title-suffix: "";
    title: (root.window-title) + root.title-suffix;
    preferred-width: 640px;
    preferred-height: 560px;
    background: Theme.window;
    in property <string> type-label;
    in property <bool> show-naming;
    in property <bool> show-separator;
    in property <bool> show-timestamp;
    in property <bool> show-tags;
    // a source's tags have a display type
    in property <bool> show-display;
    in property <bool> show-json;
    in property <bool> show-forced;
    in property <bool> show-nested;
    in property <bool> show-processing;
    in property <bool> show-sidecar-help;
    // the sidecar filename box
    in-out property <bool> remove-ext;
    in-out property <string> suffix;
    in-out property <string> example;
    in property <string> result;
    in property <string> converter-label;
    // the .txt separator
    in property <[string]> separators;
    in-out property <int> separator;
    in-out property <string> custom-separator;
    // the tag service
    in property <string> service-label;
    in property <[string]> displays;
    in-out property <int> display;
    // the timestamp type, and what shows below it: 0 nothing, 1 the file
    // service, 2 the deleted file service, 3 the viewer, 4 the domain
    in property <[string]> timestamp-kinds;
    in-out property <int> timestamp-kind;
    in property <int> detail;
    in property <[string]> file-services;
    in-out property <int> file-service;
    in property <[string]> deleted-services;
    in-out property <int> deleted-service;
    in property <[string]> canvases;
    in-out property <int> canvas;
    in-out property <string> domain;
    // A destination's forced note name and literal ordered JSON object names.
    in-out property <bool> forced-on;
    in-out property <string> forced-name;
    in property <[TableRow]> nested-rows;
    in property <bool> nested-selected;
    in property <bool> object-child-open;
    callback nested-clicked(int,bool,bool);
    callback nested-action(string);
    in property <string> processing-note;
    in property <string> processing;
    in property <bool> asking;
    in property <string> asking-title;
    in property <string> asking-message;
    in property <[string]> asking-choices;
    callback changed();
    callback edit-processing();
    callback edit-converter();
    callback edit-formula();
    callback change-type();
    callback choose-service();
    callback sidecar-help();
    callback chosen(int);
    callback cancelled();
    callback apply();
    callback cancel();
    callback closed();

    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        Button {
            text: root.type-label;
            enabled: !root.asking && !root.object-child-open;
            clicked => { root.change-type(); }
        }
        if root.show-tags: VerticalLayout {
            spacing: 4px;
            Row {
                label: "tag service: ";
                Button {
                    horizontal-stretch: 1;
                    text: root.service-label;
                    enabled: !root.asking && !root.object-child-open;
                    clicked => { root.choose-service(); }
                }
            }
            if root.show-display: Row {
                label: "tag display type: ";
                ComboBox {
                    horizontal-stretch: 1;
                    model: root.displays;
                    current-index <=> root.display;
                    selected => { root.changed(); }
                }
            }
        }
        if root.show-forced: Box {
            title: "name";
            HorizontalLayout {
                spacing: 6px;
                CheckBox {
                    text: "Forced Note Name: ";
                    checked <=> root.forced-on;
                    toggled => { root.changed(); }
                }
                LineEdit {
                    horizontal-stretch: 1;
                    enabled: root.forced-on;
                    placeholder-text: "use \"name: text\" format";
                    text <=> root.forced-name;
                    edited => { root.changed(); }
                }
            }
        }
        if root.show-timestamp: Box {
            title: "timestamp type";
            ComboBox {
                model: root.timestamp-kinds;
                current-index <=> root.timestamp-kind;
                selected => { root.changed(); }
            }
            if root.detail == 1: ComboBox {
                model: root.file-services;
                current-index <=> root.file-service;
                selected => { root.changed(); }
            }
            if root.detail == 2: ComboBox {
                model: root.deleted-services;
                current-index <=> root.deleted-service;
                selected => { root.changed(); }
            }
            if root.detail == 3: ComboBox {
                model: root.canvases;
                current-index <=> root.canvas;
                selected => { root.changed(); }
            }
            if root.detail == 4: Row {
                label: "domain: ";
                LineEdit {
                    horizontal-stretch: 1;
                    text <=> root.domain;
                    edited => { root.changed(); }
                }
            }
        }
        if root.show-sidecar-help: HorizontalLayout {
            alignment: end;
            Button {
                text: "?";
                enabled: !root.asking && !root.object-child-open;
                clicked => { root.sidecar-help(); }
            }
        }
        if root.show-nested: Box {
            title: "JSON Objects structure";
            HorizontalLayout {
                ListTable {
                    height: 90px;
                    columns: [{title: "", width: 100px, stretch: true}]; rows: root.nested-rows;
                    row-clicked(i,c,s) => {root.nested-clicked(i,c,s);}
                    row-activated(i) => {root.nested-clicked(i,false,false);root.nested-action("edit");}
                    delete-pressed => {root.nested-action("delete");}
                }
                VerticalLayout {
                    Button {text: "↑"; enabled: root.nested-selected && !root.asking && !root.object-child-open; clicked => {root.nested-action("up");}}
                    Button {text: "X"; enabled: root.nested-selected && !root.asking && !root.object-child-open; clicked => {root.nested-action("delete");}}
                    Button {text: "↓"; enabled: root.nested-selected && !root.asking && !root.object-child-open; clicked => {root.nested-action("down");}}
                }
            }
            HorizontalLayout {
                Button {text: "add"; enabled: !root.asking && !root.object-child-open; clicked => {root.nested-action("add");}}
                Button {text: "edit"; enabled: root.nested-selected && !root.asking && !root.object-child-open; clicked => {root.nested-action("edit");}}
            }
        }
        if root.show-json: Row {
            label: "json parsing formula: ";
            Button {
                horizontal-stretch: 1;
                text: "edit parsing formula";
                enabled: !root.asking && !root.object-child-open;
                clicked => { root.edit-formula(); }
            }
        }
        if root.show-separator: Box {
            title: "sidecar txt separator";
            Row {
                label: "separator: ";
                ComboBox {
                    horizontal-stretch: 1;
                    model: root.separators;
                    current-index <=> root.separator;
                    selected => { root.changed(); }
                }
            }
            Row {
                label: "custom: ";
                LineEdit {
                    horizontal-stretch: 1;
                    enabled: root.separator == 2;
                    text <=> root.custom-separator;
                    edited => { root.changed(); }
                }
            }
        }
        if root.show-naming: Box {
            title: "sidecar filename";
            Row {
                label: "remove file .ext?: ";
                CheckBox {
                    checked <=> root.remove-ext;
                    toggled => { root.changed(); }
                }
            }
            Row {
                label: "optional suffix: ";
                LineEdit {
                    horizontal-stretch: 1;
                    text <=> root.suffix;
                    edited => { root.changed(); }
                }
            }
            Row {
                label: "ADVANCED: final sidecar filename conversion: ";
                Button {
                    horizontal-stretch: 1;
                    text: root.converter-label;
                    enabled: !root.asking && !root.object-child-open;
                    clicked => { root.edit-converter(); }
                }
            }
            Row {
                label: "Test media path: ";
                LineEdit {
                    horizontal-stretch: 1;
                    text <=> root.example;
                    edited => { root.changed(); }
                }
            }
            Row {
                label: "Resulting sidecar path: ";
                LineEdit {
                    horizontal-stretch: 1;
                    read-only: true;
                    text: root.result;
                }
            }
        }
        if root.show-processing: VerticalLayout {
            spacing: 2px;
            Text {
                text: root.processing-note;
                color: Theme.text;
            }
            Button {
                text: root.processing;
                enabled: !root.asking && !root.object-child-open;
                clicked => { root.edit-processing(); }
            }
        }
        Rectangle { vertical-stretch: 1; }
        if root.asking: Asking {
            title: root.asking-title;
            message: root.asking-message;
            choices: root.asking-choices;
            chosen(i) => { root.chosen(i); }
            cancelled => { root.cancelled(); }
        }
        ApplyCancel {
            enabled: !root.asking && !root.object-child-open;
            apply => { root.apply(); }
            cancel => { root.cancel(); }
        }
    }
}
