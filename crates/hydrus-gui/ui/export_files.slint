import { Btn } from "btn.slint";
// Review selected files' manual export destinations, then export on a worker.
import { Button, CheckBox, LineEdit, ProgressIndicator } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ListTable, TableRow } from "list_table.slint";
import { Asking } from "subscriptions.slint";
import { ExportPatternButton } from "export_pattern.slint";
import { MenuChoiceFrame } from "menu_choice_wheel.slint";
import { ExportTags } from "export_tags.slint";
import { ListText } from "theme.slint";
import { MenuPane } from "main_menu.slint";
import { TagMenuOverlay } from "write_autocomplete.slint";
export component ExportFilesWindow inherits Window {
    title: "export files";
    preferred-width: 1120px;
    preferred-height: 690px;
    background: Theme.window;
    in property <[TableRow]> rows;
    in-out property <string> destination;
    in-out property <string> phrase;
    in property <[string]> pattern-shortcuts;
    in property <string> pattern-heading;
    callback pattern-chosen(int);
    in property <[ListText]> tags;
    in property <[bool]> tag-selected;
    in property <int> tag-sort-type;
    in property <[string]> tag-sort-orders;
    in property <int> tag-sort-order;
    in property <int> tag-sort-group;
    callback tag-row-clicked(int,bool,bool);
    callback tag-middle-clicked(int,bool,bool);
    callback tag-context-menu(int,length,length);
    callback tag-sort-chosen(int,int);
    callback tag-sort-geometry(int,MenuChoiceFrame);
    out property <MenuChoiceFrame> tag-sort-type-frame: tags.sort-type-frame;
    out property <MenuChoiceFrame> tag-sort-order-frame: tags.sort-order-frame;
    callback tag-copy();
    callback tag-select-all();
    in property <[MenuPane]> tag-menu-panes;
    in property <string> tag-menu-question;
    in property <string> tag-menu-question-title;
    in property <string> tag-menu-yes-label: "yes";
    in property <string> tag-menu-no-label: "no";
    callback tag-menu-hovered(int,int,length,length,length);
    callback tag-menu-clicked(int,int,length,length,length);
    callback tag-menu-placed(int,length,length,length);
    callback tag-menu-dismissed();
    callback tag-menu-answered(bool);
    in-out property <bool> trash;
    in-out property <bool> symlinks;
    in property <string> sidecars: "no sidecars";
    in property <string> status;
    in property <bool> working;
    in property <float> progress;
    in property <bool> asking;
    in property <string> question;
    callback update();
    callback browse();
    callback open-location();
    callback row-clicked(int, bool, bool);
    callback remove();
    callback edit-sidecars();
    callback export(bool);
    callback answer(int);
    callback cancel();
    callback dismissed();
    VerticalLayout {
        padding: 12px;
        spacing: 9px;
        Text { text: "files to export"; color: Theme.text; font-weight: 700; }
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 8px;
            tags := ExportTags {
                width: 280px;
                enabled: !root.working && !root.asking;
                rows: root.tags; selected: root.tag-selected;
                sort-type: root.tag-sort-type; orders: root.tag-sort-orders; order: root.tag-sort-order; group: root.tag-sort-group;
                clicked(row,ctrl,shift) => {root.tag-row-clicked(row,ctrl,shift);}
                middle-clicked(row,ctrl,shift) => {root.tag-middle-clicked(row,ctrl,shift);}
                context-menu(row,x,y) => {root.tag-context-menu(row,x,y);}
                sort-chosen(part,index) => {root.tag-sort-chosen(part,index);}
                sort-geometry(part,frame) => {root.tag-sort-geometry(part,frame);}
                copy => {root.tag-copy();}
                select-all => {root.tag-select-all();}
            }
            ListTable {
                horizontal-stretch: 1;
                columns: [ {title: "#", width: 50px}, {title: "filetype", width: 135px}, {title: "path", width: 610px} ];
                rows: root.rows;
                row-clicked(row, ctrl, shift) => { root.row-clicked(row, ctrl, shift); }
            }
        }
        HorizontalLayout {
            Btn { text: "remove selected"; enabled: !root.working && !root.asking; clicked => { root.remove(); } }
            Rectangle { horizontal-stretch: 1; }
        }
        Text { text: "export path"; color: Theme.text; font-weight: 700; }
        HorizontalLayout {
            LineEdit { text <=> root.destination; enabled: !root.working && !root.asking; accepted => { root.update(); } }
            Btn { text: "browse…"; enabled: !root.working && !root.asking; clicked => { root.browse(); } }
            Btn { text: "open this location"; clicked => { root.open-location(); } }
        }
        Text { text: "filenames"; color: Theme.text; font-weight: 700; }
        HorizontalLayout {
            LineEdit { text <=> root.phrase; enabled: !root.working && !root.asking; accepted => { root.update(); } }
            Btn { text: "update"; enabled: !root.working && !root.asking; clicked => { root.update(); } }
            ExportPatternButton {
                labels: root.pattern-shortcuts;
                heading: root.pattern-heading;
                available: !root.working && !root.asking;
                selected(index) => { root.pattern-chosen(index); }
            }
        }
        Text { text: "{hash}   {file_id}   {#}   {tags}   {nn tags}   [namespace]   (tag)"; color: Theme.text; }
        CheckBox { text: "trash files in hydrus client after export"; checked <=> root.trash; enabled: !root.working && !root.asking; toggled => { if root.trash { root.symlinks = false; } } }
        CheckBox { text: "EXPERIMENTAL: export symlinks"; checked <=> root.symlinks; enabled: !root.working && !root.trash; }
        Btn { text: root.sidecars; enabled: !root.working && !root.asking; clicked => { root.edit-sidecars(); } }
        Text { text: root.status; color: Theme.text; wrap: word-wrap; }
        if root.working: ProgressIndicator { progress: root.progress; }
        HorizontalLayout {
            Rectangle { horizontal-stretch: 1; }
            Btn { text: "close"; enabled: !root.working && !root.asking; clicked => { root.dismissed(); } }
            Btn { text: "cancel export"; enabled: root.working; clicked => { root.cancel(); } }
            Btn { text: "export and close"; enabled: !root.working && !root.asking; clicked => { root.export(true); } }
            Btn { text: "export"; enabled: !root.working && !root.asking; clicked => { root.export(false); } }
        }
    }
    if root.asking: Asking {
        title: "Are you sure?";
        message: root.question;
        choices: ["yes", "no"];
        chosen(i) => { root.answer(i); }
        cancelled => { root.answer(1); }
    }
    TagMenuOverlay {
        width: root.width; height: root.height;
        panes: root.tag-menu-panes; question: root.tag-menu-question;
            question-title: root.tag-menu-question-title; yes-label: root.tag-menu-yes-label; no-label: root.tag-menu-no-label;
        hovered(p,l,r,t,x) => {root.tag-menu-hovered(p,l,r,t,x);}
        clicked(p,l,r,t,x) => {root.tag-menu-clicked(p,l,r,t,x);}
        placed(p,x,y,w) => {root.tag-menu-placed(p,x,y,w);}
        dismissed => {root.tag-menu-dismissed();}
        answered(yes) => {root.tag-menu-answered(yes);}
    }
}
