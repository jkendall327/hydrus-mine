// A gallery downloader page's sidebar (the reference's
// SidebarImporterMultipleGallery): the "gallery downloader" box with its
// searches' list, their buttons, the query box, the downloader and file
// limit for new queries; and the "highlighted query" box.

import { Button, CheckBox, ComboBox, LineEdit, SpinBox } from "std-widgets.slint";
import { ListTable, TableColumn, TableRow } from "list_table.slint";
import { Theme } from "theme.slint";
import { JobCogMenu, DownloadLine, ImporterBoxes } from "importing.slint";

export struct GalleryData {
    // "3 queries - 12/40" and the total status, or "waiting for new queries"
    top-status: string,
    bottom-status: string,
    // what the list's buttons can do for the selected search
    has-selection: bool,
    can-highlight: bool,
    can-clear-highlight: bool,
    can-retry-ignored: bool,
    can-retry-failed: bool,
    // a selected one's options aren't the page's: "update selected with
    // current options" shows
    can-set-options: bool,
    // the page's import options for new ones, as its button names them
    import-options: string,
    // the downloader for new queries, among those offered
    gug-names: [string],
    gug-index: int,
    show-other-gugs: bool,
    has-other-gugs: bool,
    initial-search-text: string,
    // the file limit for new queries
    no-limit: bool,
    file-limit: int,
    // the search shown, and its status lines, file limit and import options
    highlighted: bool,
    shown-no-limit: bool,
    shown-file-limit: int,
    shown-import-options: string,
    highlighted-query: string,
    files-line: string,
    search-line: string,
    search-paused: bool,
}

export component GallerySidebar inherits VerticalLayout {
    in property <int> focus-requests;
    in property <bool> focus-on-show;
    callback input-focus-changed(bool);
    changed focus-requests => { input-box.focus(); }
    in property <GalleryData> data;
    in property <[TableRow]> rows;
    in property <int> sort-column: -1;
    in property <bool> ascending: true;
    // the highlighted search's importer, as a URL page's
    in property <string> import-status;
    in property <string> import-progress;
    in property <float> import-fraction;
    in property <bool> import-paused;
    in property <DownloadLine> file-download;
    in property <string> search-status;
    in property <DownloadLine> search-download;
    // (the row shown, ctrl held, shift held)
    callback row-clicked(int, bool, bool);
    // a right press on a row, and where (the list's menu)
    callback row-menu(int, length, length);
    // the page's import options' editor
    callback import-options();
    // the shown search's file limit changed (no limit, the limit), and its
    // import options' editor
    callback shown-limit-changed(bool, int);
    callback shown-import-options();
    callback sort(int, bool);
    callback highlight();
    callback clear-highlight();
    // a search's files or (true) its search, from the list or the
    // highlighted box (which, -1 for the list's selection, else the shown)
    callback pause-play(bool, bool);
    callback retry(bool);
    callback remove();
    callback set-options();
    callback queries-entered(string);
    callback paste();
    callback gug-chosen(int);
    callback other-gugs(bool);
    callback limit-changed(bool, int);
    in property <JobCogMenu> file-cog;
    in property <JobCogMenu> search-cog;
    callback control-action(bool, int);
    callback control-menu(bool);
    callback cancel-download(bool);
    // the highlighted query's file log
    callback file-log();
    callback search-log();
    spacing: 6px;
    Text {
        text: "gallery downloader";
        font-weight: 700;
    }
    Rectangle {
        border-width: 1px;
        border-color: Theme.border;
        VerticalLayout {
            padding: 6px;
            spacing: 4px;
            Text {
                text: root.data.top-status;
                overflow: elide;
            }
            if root.data.bottom-status != "": Text {
                text: root.data.bottom-status;
                overflow: elide;
            }
            table := ListTable {
                height: 180px;
                columns: [
                    { title: "query", width: 90px, stretch: true },
                    { title: "source", width: 50px },
                    { title: "files status", width: 18px },
                    { title: "search status", width: 18px },
                    { title: "status", width: 52px },
                    { title: "items", width: 54px },
                    { title: "added", width: 64px },
                ];
                rows: root.rows;
                sort-column: root.sort-column;
                ascending: root.ascending;
                sort(column, ascending) => { root.sort(column, ascending); }
                row-clicked(row, ctrl, shift) => { root.row-clicked(row, ctrl, shift); }
                row-menu(row, x, y) => { root.row-menu(row, x, y); }
                // (a double click: highlight it, as the button does)
                row-activated(row) => { root.highlight(); }
                delete-pressed => { if root.data.has-selection { root.remove(); } }
            }
            // the reference's buttons: highlight, clear highlight, pause/play
            // files, pause/play search, retry, remove
            HorizontalLayout {
                spacing: 4px;
                Button {
                    icon: @image-url("../../../static/highlight.png");
                    enabled: root.data.can-highlight;
                    clicked => { root.highlight(); }
                }
                Button {
                    icon: @image-url("../../../static/clear_highlight.png");
                    enabled: root.data.can-clear-highlight;
                    clicked => { root.clear-highlight(); }
                }
                Button {
                    icon: @image-url("../../../static/file_pause.png");
                    enabled: root.data.has-selection;
                    clicked => { root.pause-play(false, false); }
                }
                Button {
                    icon: @image-url("../../../static/gallery_pause.png");
                    enabled: root.data.has-selection;
                    clicked => { root.pause-play(true, false); }
                }
                Button {
                    icon: @image-url("../../../static/trash.png");
                    enabled: root.data.has-selection;
                    clicked => { root.remove(); }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            if root.data.can-retry-ignored || root.data.can-retry-failed: HorizontalLayout {
                spacing: 4px;
                if root.data.can-retry-ignored: Button {
                    text: "retry ignored";
                    clicked => { root.retry(true); }
                }
                if root.data.can-retry-failed: Button {
                    text: "retry failed";
                    clicked => { root.retry(false); }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            HorizontalLayout {
                spacing: 4px;
                input-box := LineEdit {
                    init => { if root.focus-on-show { self.focus(); } }
                    changed has-focus => { root.input-focus-changed(self.has-focus); }
                    horizontal-stretch: 1;
                    placeholder-text: root.data.initial-search-text;
                    accepted(text) => {
                        root.queries-entered(text);
                        self.text = "";
                    }
                }
                // (the reference's paste button: newline-separated queries
                // from the clipboard)
                Button {
                    icon: @image-url("../../../static/paste.png");
                    clicked => { root.paste(); }
                }
            }
            ComboBox {
                model: root.data.gug-names;
                current-index: root.data.gug-index;
                selected => { root.gug-chosen(self.current-index); }
            }
            if root.data.has-other-gugs: CheckBox {
                text: "show other downloaders";
                checked: root.data.show-other-gugs;
                toggled => { root.other-gugs(self.checked); }
            }
            HorizontalLayout {
                spacing: 4px;
                Text {
                    text: "stop after this many files";
                    vertical-alignment: center;
                }
                limit := SpinBox {
                    horizontal-stretch: 1;
                    minimum: 1;
                    maximum: 1000000;
                    value: root.data.file-limit;
                    enabled: !root.data.no-limit;
                    edited(value) => { root.limit-changed(false, value); }
                }
            }
            CheckBox {
                text: "no limit";
                checked: root.data.no-limit;
                toggled => { root.limit-changed(self.checked, limit.value); }
            }
            Button {
                text: root.data.import-options;
                clicked => { root.import-options(); }
            }
            if root.data.can-set-options: Button {
                text: "update selected with current options";
                clicked => { root.set-options(); }
            }
        }
    }
    if root.data.highlighted: Rectangle {
        border-width: 1px;
        border-color: Theme.border;
        VerticalLayout {
            padding: 6px;
            spacing: 4px;
            Text {
                text: "highlighted query";
                font-weight: 700;
            }
            LineEdit {
                text: root.data.highlighted-query;
                read-only: true;
            }
            ImporterBoxes {
                status-lines: true;
                files-line: root.data.files-line;
                import-status: root.import-status;
                import-progress: root.import-progress;
                import-fraction: root.import-fraction;
                import-paused: root.import-paused;
                file-download: root.file-download;
                search-line: root.data.search-line;
                search-paused: root.data.search-paused;
                search-status: root.search-status;
                search-download: root.search-download;
                pause-play-files => { root.pause-play(false, true); }
                pause-play-search => { root.pause-play(true, true); }
                file-cog: root.file-cog;
                search-cog: root.search-cog;
                control-action(gallery, id) => { root.control-action(gallery, id); }
                        control-menu(gallery) => { root.control-menu(gallery); }
                cancel-download(gallery) => { root.cancel-download(gallery); }
                file-log => { root.file-log(); }
                search-log => { root.search-log(); }
            }
            HorizontalLayout {
                spacing: 4px;
                Text {
                    text: "stop after this many files";
                    vertical-alignment: center;
                }
                shown-limit := SpinBox {
                    horizontal-stretch: 1;
                    minimum: 1;
                    maximum: 1000000;
                    value: root.data.shown-file-limit;
                    enabled: !root.data.shown-no-limit;
                    edited(value) => { root.shown-limit-changed(false, value); }
                }
            }
            CheckBox {
                text: "no limit";
                checked: root.data.shown-no-limit;
                toggled => { root.shown-limit-changed(self.checked, shown-limit.value); }
            }
            Button {
                text: root.data.shown-import-options;
                clicked => { root.shown-import-options(); }
            }
        }
    }
}
