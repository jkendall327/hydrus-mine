// The reference's "input predicate" dialog (`FleshOutPredicatePanel`),
// opened by a system predicate offered without a value
// (`src/predicate_editors.rs` has what each holds): a note, its pages'
// tabs when it has several, the page's ready-made buttons, and its panels,
// each a row of fields (some with a second line under it) and an "ok"
// button.

import { Button, CheckBox, ComboBox, LineEdit, ScrollView, SpinBox, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { HashChoices } from "hash_choices.slint";
import { FilesizeComparison } from "filesize_comparison.slint";

import { EditorTreeRow, FiletypeTree } from "filetype_tree.slint";

// One of a panel's fields: `kind` 0 a label, 1 a choice, 2 tick boxes, 3 a
// number, 4 a line of text, 5 several lines, 6 the filetype tree, 7 a
// button, 8 filesize comparison radios, 9 hash radios; on the panel's first line (0) or its second (1).
export struct EditorField {
    kind: int,
    text: string,
    placeholder: string,
    options: [string],
    chosen: int,
    ticked: [bool],
    value: int,
    minimum: int,
    maximum: int,
    before: string,
    after: string,
    shown: bool,
    enabled: bool,
    // a choice's width, to fit its longest option
    width: length,
    rows: [EditorTreeRow],
    line: int,
}

export struct EditorPanel {
    fields: [EditorField],
    two-lines: bool,
    hash-layout: bool,
    hash-text: string,
}

// A field, if it is shown on this line (else nothing, taking no room).
component FieldView {
    in property <EditorField> field;
    in property <bool> here;
    in property <bool> blocked: false;
    in property <bool> comparison-focus;
    callback chose(int);
    callback ticked(int, bool);
    callback number-edited(int);
    callback text-edited(string);
    callback accepted();
    callback force-radio-ok() -> bool;
    callback pressed();
    callback tree-ticked(int, int, bool);
    callback expanded(int, bool);

    // (hidden, it takes no room, and only what is typed into takes the
    // room spare)
    max-width: root.here ? 100000px : 0px;
    horizontal-stretch: root.field.kind == 4 || root.field.kind == 5 ? 1 : 0;

    // (an `if` straight under a component's root would give it no size)
    VerticalLayout {
    if root.here: VerticalLayout {
        alignment: center;
        padding-right: 6px;
        if root.field.kind == 0: Text {
            vertical-alignment: center;
            text: root.field.text;
            wrap: word-wrap;
            max-width: 900px;
            color: Theme.text;
        }
        if root.field.kind == 1: ComboBox {
            horizontal-stretch: 0;
            width: root.field.width;
            model: root.field.options;
            current-index: root.field.chosen;
            enabled: root.field.enabled && !root.blocked;
            selected => { root.chose(self.current-index); }
        }
        if root.field.kind == 8: FilesizeComparison {
            horizontal-stretch: 0;
            options: root.field.options;
            chosen: root.field.chosen;
            enabled: root.field.enabled && !root.blocked;
            focus-request: root.comparison-focus;
            chose(option) => { root.chose(option); }
            force-dialog-ok => { root.force-radio-ok() }
            accepted => { root.accepted(); }
        }
        if root.field.kind == 2: VerticalLayout {
            for option[o] in root.field.options: CheckBox {
                min-height: 24px;
                text: option;
                checked: root.field.ticked[o];
                enabled: root.field.enabled && !root.blocked;
                toggled => { root.ticked(o, self.checked); }
            }
        }
        if root.field.kind == 3: HorizontalLayout {
            spacing: 2px;
            if root.field.before != "": Text {
                vertical-alignment: center;
                text: root.field.before;
                color: Theme.text;
            }
            SpinBox {
                horizontal-stretch: 0;
                width: 84px;
                minimum: root.field.minimum;
                maximum: root.field.maximum;
                value: root.field.value;
                enabled: root.field.enabled && !root.blocked;
                edited(value) => { root.number-edited(value); }
            }
            if root.field.after != "": Text {
                vertical-alignment: center;
                text: root.field.after;
                color: Theme.text;
            }
        }
        if root.field.kind == 4: LineEdit {
            min-width: 160px;
            text: root.field.text;
            placeholder-text: root.field.placeholder;
            enabled: root.field.enabled && !root.blocked;
            edited(text) => { root.text-edited(text); }
            accepted => { root.accepted(); }
        }
        if root.field.kind == 5: TextEdit {
            min-width: 240px;
            min-height: 84px;
            text: root.field.text;
            placeholder-text: root.field.placeholder;
            enabled: root.field.enabled && !root.blocked;
            edited(text) => { root.text-edited(text); }
        }
        if root.field.kind == 6: FiletypeTree {
            rows: root.field.rows;
            enabled: root.field.enabled && !root.blocked;
            expanded(group, on) => { root.expanded(group, on); }
            ticked(group, option, on) => { root.tree-ticked(group, option, on); }
        }
        if root.field.kind == 7: Button {
            text: root.field.text;
            enabled: root.field.enabled && !root.blocked;
            clicked => { root.pressed(); }
        }
    }
    }
}

// A panel's star menu changes shared defaults immediately, outside its draft.
component DefaultsButton inherits Rectangle {
    in property <[string]> actions;
    in property <bool> enabled;
    callback opening();
    callback selected(string);
    width: 36px; height: 28px;
    Button { text: "★"; enabled: root.enabled; clicked => {root.opening(); entries.show();} }
    entries := PopupWindow {
        x: 0px; y: root.height;
        Rectangle {
            width: 270px;
            height: root.actions.length * 32px + 8px;
            background: Theme.panel;
            border-color: Theme.border;
            border-width: 1px;
            VerticalLayout {
                padding: 4px;
                for action in root.actions: Rectangle {
                    height: 32px;
                    background: hit.has-hover ? Theme.highlight : transparent;
                    Text { x: 6px; text: action; vertical-alignment: center; color: hit.has-hover ? Theme.highlight-text : Theme.text; }
                    hit := TouchArea { clicked => {entries.close(); root.selected(action);} }
                }
            }
        }
    }
}

export component PredicateEditorWindow inherits Window {
    in property <string> title-suffix: "";
    title: (root.editing-existing ? "edit predicates" : "input predicate") + root.title-suffix;
    in property <bool> editing-existing;
    in property <bool> batch-mode;
    in property <[string]> simple-texts;
    in property <[int]> edit-order;
    in property <[string]> invertible-labels;
    callback simple-edited(int, string);
    callback invertible-clicked(int);
    preferred-width: 1020px;
    background: Theme.window;
    in property <string> note;
    // the pages' names (none with one page), and the one shown
    in property <[string]> pages;
    in property <int> page;
    // the shown page's ready-made buttons, two to a row for file
    // properties
    in property <[string]> buttons;
    in property <bool> two-columns;
    in property <[EditorPanel]> panels;
    in property <string> error;
    in property <string> question;
    in property <bool> comparison-focus;
    in property <bool> hash-focus;
    in property <bool> notice-open;
    in property <string> notice-message;
    // The live TextEdit draft, two-way linked so cleanup also replaces real typing.
    in-out property <string> hash-text;
    callback answer(bool);
    // the shown page's recent predicates, each a button adding it with
    // one beside it forgetting it
    in property <[string]> recent;
    callback page-chosen(int);
    callback button-clicked(int);
    // Live preset geometry for native input replay.
    callback preset-placed(int, float, float, float, float);
    callback recent-clicked(int);
    callback recent-forgotten(int);
    // (panel, field, option)
    callback chose(int, int, int);
    // (panel, field, option, ticked)
    callback ticked(int, int, int, bool);
    // (panel, field, value)
    callback number-edited(int, int, int);
    // (panel, field, text)
    callback text-edited(int, int, string);
    // Measured native input bounds, also used by pointer replays.
    callback hash-field-placed(int, float, float, float, float);
    // (panel, field)
    callback pressed(int, int);
    // (panel, field, group, filetype or -1, ticked)
    callback tree-ticked(int, int, int, int, bool);
    // (panel, field, group, expanded)
    callback expanded(int, int, int, bool);
    // Each panel's immediate star menu; reset appears only for saved families.
    in property <[string]> defaults-actions;
    callback defaults-menu(int);
    callback defaults-action(int, string);
    callback force-radio-ok(int) -> bool;
    in-out property <int> radio-default-panel: -1;
    callback ok(int);
    callback cancel();
    callback closed();

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if root.notice-open { return accept; }
            if (event.text == Key.Escape) {
                if (root.question != "") {
                    root.answer(false);
                    return accept;
                }
                root.cancel();
                return accept;
            }
            if event.text == Key.Return && root.radio-default-panel >= 0 && root.question == "" {
                root.ok(root.radio-default-panel);
                return accept;
            }
            reject
        }
        VerticalLayout {
            padding: 8px;
            spacing: 6px;
            if root.note != "": Text {
                text: root.note;
                wrap: word-wrap;
                color: Theme.text;
            }
            if root.pages.length > 1: HorizontalLayout {
                spacing: 2px;
                alignment: start;
                for name[i] in root.pages: Button {
                    text: name;
                                    enabled: (root.question == "" && !root.notice-open);
                    checkable: true;
                    checked: i == root.page;
                    clicked => { root.page-chosen(i); }
                }
            }
            ScrollView {
                min-height: 120px;
                preferred-height: 420px;
                VerticalLayout {
                    alignment: start;
                    spacing: 4px;
                    if root.recent.length > 0: Rectangle {
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 4px;
                            spacing: 2px;
                            Text {
                                text: "recent";
                                color: Theme.muted;
                            }
                            for label[i] in root.recent: HorizontalLayout {
                                spacing: 2px;
                                Button {
                                    horizontal-stretch: 1;
                                    text: label;
                                    enabled: (root.question == "" && !root.notice-open);
                                    clicked => { root.recent-clicked(i); }
                                }
                                Button {
                                    text: "forget";
                                    enabled: (root.question == "" && !root.notice-open);
                                    clicked => { root.recent-forgotten(i); }
                                }
                            }
                        }
                    }
                    if !root.two-columns: VerticalLayout {
                        spacing: 2px;
                        for label[i] in root.buttons: Button {
                            property <{x:length,y:length,w:length,h:length}> frame: {x:self.absolute-position.x,y:self.absolute-position.y,w:self.width,h:self.height};
                            changed frame => { root.preset-placed(i,self.frame.x/1px,self.frame.y/1px,self.frame.w/1px,self.frame.h/1px); }
                            text: label;
                                    enabled: (root.question == "" && !root.notice-open);
                            clicked => { root.button-clicked(i); }
                        }
                    }
                    if root.two-columns: VerticalLayout {
                        spacing: 2px;
                        for row in (root.buttons.length + 1) / 2: HorizontalLayout {
                            spacing: 2px;
                            Button {
                                horizontal-stretch: 1;
                                text: root.buttons[row * 2];
                                    enabled: (root.question == "" && !root.notice-open);
                                clicked => { root.button-clicked(row * 2); }
                            }
                            if row * 2 + 1 < root.buttons.length: Button {
                                horizontal-stretch: 1;
                                text: root.buttons[row * 2 + 1];
                                    enabled: (root.question == "" && !root.notice-open);
                                clicked => { root.button-clicked(row * 2 + 1); }
                            }
                        }
                    }
                    for label[i] in root.invertible-labels: Button {
                        text: label;
                        enabled: root.question == "" && !root.notice-open;
                        clicked => { root.invertible-clicked(i); }
                    }
                    for row in root.edit-order: VerticalLayout {
                    if row < 0: LineEdit {
                        property <string> draft: root.simple-texts[-1 - row];
                        text <=> self.draft;
                        enabled: root.question == "" && !root.notice-open;
                        edited(value) => { root.simple-edited(-1 - row, value); }
                        accepted => { root.ok(0); }
                    }
                    if row >= 0: panel-box := Rectangle {
                        property <int> p: row;
                        property <EditorPanel> panel: root.panels[p];
                        // Keep the derived panel bound to its model after real typing.
                        property <string> hash-draft: panel.hash-text;
                        changed panel => { self.hash-draft = self.panel.hash-text; }
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 4px;
                            spacing: 4px;
                            if panel.hash-layout: HorizontalLayout {
                                spacing: 6px;
                                if !root.batch-mode: DefaultsButton {
                                    actions: root.defaults-actions;
                                    enabled: root.question == "" && !root.notice-open;
                                    opening => { root.defaults-menu(p); }
                                    selected(action) => { root.defaults-action(p, action); }
                                }
                                Text { text: panel.fields[0].text; vertical-alignment: center; color: Theme.text; }
                                VerticalLayout {
                                    alignment: center;
                                    HashChoices {
                                        options: panel.fields[1].options;
                                        chosen: panel.fields[1].chosen;
                                        enabled: root.question == "" && !root.notice-open;
                                        focus-request: root.hash-focus;
                                        chose(option) => { root.chose(p, 1, option); }
                                        force-dialog-ok => { root.force-radio-ok(p) }
                                        accepted => { root.ok(p); }
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1; spacing: 4px;
                                    TextEdit {
                                        property <{x:length,y:length,w:length,h:length}> frame: {x:self.absolute-position.x,y:self.absolute-position.y,w:self.width,h:self.height};
                                        changed frame => { root.hash-field-placed(2,self.frame.x/1px,self.frame.y/1px,self.frame.w/1px,self.frame.h/1px); }
                                        min-width: 420px; min-height: 220px;
                                        text <=> panel-box.hash-draft;
                                        placeholder-text: panel.fields[2].placeholder;
                                        enabled: root.question == "" && !root.notice-open;
                                        edited(text) => { root.text-edited(p, 2, text); }
                                    }
                                    Button { text: panel.fields[3].text; enabled: root.question == "" && !root.notice-open; clicked => { root.pressed(p, 3); } }
                                    Button { text: panel.fields[4].text; enabled: root.question == "" && !root.notice-open; clicked => { root.pressed(p, 4); } }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    HashChoices {
                                        property <{x:length,y:length,w:length,h:length}> frame: {x:self.absolute-position.x,y:self.absolute-position.y,w:self.width,h:self.height};
                                        changed frame => { root.hash-field-placed(5,self.frame.x/1px,self.frame.y/1px,self.frame.w/1px,self.frame.h/1px); }
                                        options: panel.fields[5].options;
                                        chosen: panel.fields[5].chosen;
                                        enabled: root.question == "" && !root.notice-open;
                                        chose(option) => { root.chose(p, 5, option); }
                                        force-dialog-ok => { root.force-radio-ok(p) }
                                        accepted => { root.ok(p); }
                                    }
                                }
                                if !root.batch-mode: VerticalLayout {
                                    alignment: center;
                                    Button { text: "ok"; enabled: root.question == "" && !root.notice-open; clicked => { root.ok(p); } }
                                }
                            }
                            if !panel.hash-layout: HorizontalLayout {
                                if !root.batch-mode: DefaultsButton {
                                    actions: root.defaults-actions;
                                    enabled: (root.question == "" && !root.notice-open);
                                    opening => { root.defaults-menu(p); }
                                    selected(action) => { root.defaults-action(p, action); }
                                }
                                for field[f] in panel.fields: FieldView {
                                    field: field;
                                    comparison-focus: root.comparison-focus;
                                    force-radio-ok => { root.force-radio-ok(p) }
                                    blocked: root.question != "" || root.notice-open;
                                    here: field.shown && field.line == 0;
                                    chose(option) => { root.chose(p, f, option); }
                                    ticked(option, on) => { root.ticked(p, f, option, on); }
                                    number-edited(value) => { root.number-edited(p, f, value); }
                                    text-edited(text) => { root.text-edited(p, f, text); }
                                    accepted => { root.ok(p); }
                                    pressed => { root.pressed(p, f); }
                                    tree-ticked(group, option, on) => { root.tree-ticked(p, f, group, option, on); }
                                    expanded(group, on) => { root.expanded(p, f, group, on); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                if !panel.two-lines && !root.batch-mode: VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: "ok";
                                    enabled: (root.question == "" && !root.notice-open);
                                        clicked => { root.ok(p); }
                                    }
                                }
                            }
                            if panel.two-lines && !panel.hash-layout: HorizontalLayout {
                                for field[f] in panel.fields: FieldView {
                                    field: field;
                                    comparison-focus: root.comparison-focus;
                                    force-radio-ok => { root.force-radio-ok(p) }
                                    blocked: root.question != "" || root.notice-open;
                                    here: field.shown && field.line == 1;
                                    chose(option) => { root.chose(p, f, option); }
                                    ticked(option, on) => { root.ticked(p, f, option, on); }
                                    number-edited(value) => { root.number-edited(p, f, value); }
                                    text-edited(text) => { root.text-edited(p, f, text); }
                                    accepted => { root.ok(p); }
                                    pressed => { root.pressed(p, f); }
                                    tree-ticked(group, option, on) => { root.tree-ticked(p, f, group, option, on); }
                                    expanded(group, on) => { root.expanded(p, f, group, on); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                if !root.batch-mode: VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: "ok";
                                    enabled: (root.question == "" && !root.notice-open);
                                        clicked => { root.ok(p); }
                                    }
                                }
                            }
                        }
                    }
                    }
                }
            }
            if root.error != "": Text {
                text: root.error;
                wrap: word-wrap;
                color: Theme.error;
            }
            if root.question != "": HorizontalLayout {
                Text { text: root.question; color: Theme.text; }
                Button { text: "yes"; clicked => { root.answer(true); } }
                Button { text: "no"; clicked => { root.answer(false); } }
            }
            HorizontalLayout {
                alignment: end;
                if root.batch-mode: Button {
                    text: "apply";
                    enabled: root.question == "" && !root.notice-open;
                    clicked => { root.ok(0); }
                }
                Button {
                    text: "cancel";
                    clicked => { root.cancel(); }
                }
            }
        }
    }
}
