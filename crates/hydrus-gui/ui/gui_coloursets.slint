// The two legacy coloursets share thirteen RGB roles; edits belong to Options.
import { Button, LineEdit, SpinBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
export struct GuiColourRow { label: string, first: int, colours: [color], hex: [string] }
export component GuiColoursets {
    in property <[GuiColourRow]> rows;
    in-out property <int> colourset;
    in property <bool> enabled;
    callback chosen(int,int);
    callback clipboard-action(int,int,bool);
    property <int> menu-role: -1;
    property <string> menu-hex;
    property <length> menu-x;
    property <length> menu-y;
    VerticalLayout {
        spacing: 8px;
        HorizontalLayout {
            alignment: start;
            Button { enabled: root.enabled; text: "default"; primary: root.colourset == 0; clicked => { root.colourset = 0; root.menu-role = -1; } }
            Button { enabled: root.enabled; text: "darkmode"; primary: root.colourset == 1; clicked => { root.colourset = 1; root.menu-role = -1; } }
        }
        for row in root.rows: HorizontalLayout {
            spacing: 8px;
            Text { text: row.label; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; color: root.enabled ? Theme.text : Theme.muted; }
            for colour[c] in row.colours: Rectangle {
                width: 20px; height: 20px; background: colour; border-width: 1px; border-color: Theme.border;
                TouchArea {
                    enabled: root.enabled;
                    clicked => { root.menu-role = -1; root.chosen(root.colourset,row.first+c); }
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                            root.menu-role = row.first+c;root.menu-hex=row.hex[c];root.menu-x=min(self.absolute-position.x - root.absolute-position.x,root.width - 280px);root.menu-y=self.absolute-position.y - root.absolute-position.y;
                        }
                    }
                }
            }
        }
    }
    if root.menu-role >= 0 && root.enabled: Rectangle {
        x: max(0px,root.menu-x);y:root.menu-y;width:280px;height:72px;
        background:Theme.panel;border-width:1px;border-color:Theme.border;
        VerticalLayout {
            Button { text:"copy "+root.menu-hex+" to the clipboard";clicked=>{root.clipboard-action(root.colourset,root.menu-role,false);root.menu-role=-1;} }
            Button { text:"import a hex colour from the clipboard";clicked=>{root.clipboard-action(root.colourset,root.menu-role,true);root.menu-role=-1;} }
        }
    }
}
export struct GuiColourPickerFrame { x:length,y:length,w:length,h:length }
export struct GuiColourPickerSize { w:length,h:length }
export component GuiColourPickerWindow inherits Window {
    in property <string> title-suffix: "";
    title: ("Select Color") + root.title-suffix;
    preferred-width: max(440px, content.min-width);
    preferred-height: content.preferred-height;
    min-width: content.min-width;
    min-height: content.min-height;
    out property <GuiColourPickerSize> opening-size: {w:root.preferred-width,h:root.preferred-height};
    out property <GuiColourPickerSize> minimum-size: {w:root.min-width,h:root.min-height};
    // Read-only measurements of the real labels, editors and action buttons.
    out property <[GuiColourPickerFrame]> control-frames: [
        {x:red-label.absolute-position.x,y:red-label.absolute-position.y,w:red-label.width,h:red-label.height},
        {x:red-input.absolute-position.x,y:red-input.absolute-position.y,w:red-input.width,h:red-input.height},
        {x:green-label.absolute-position.x,y:green-label.absolute-position.y,w:green-label.width,h:green-label.height},
        {x:green-input.absolute-position.x,y:green-input.absolute-position.y,w:green-input.width,h:green-input.height},
        {x:blue-label.absolute-position.x,y:blue-label.absolute-position.y,w:blue-label.width,h:blue-label.height},
        {x:blue-input.absolute-position.x,y:blue-input.absolute-position.y,w:blue-input.width,h:blue-input.height},
        {x:ok.absolute-position.x,y:ok.absolute-position.y,w:ok.width,h:ok.height},
        {x:cancel.absolute-position.x,y:cancel.absolute-position.y,w:cancel.width,h:cancel.height}
    ];
    background: Theme.window;
    in-out property <int> red;
    in-out property <int> green;
    in-out property <int> blue;
    callback accepted(int,int,int);
    callback cancelled();
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancelled(); return accept; }
            if event.text == Key.Return { root.accepted(root.red,root.green,root.blue); return accept; }
            reject
        }
        content := VerticalLayout {
            padding:12px;spacing:10px;alignment:start;
            HorizontalLayout {
                spacing:8px;vertical-stretch:0;
                Rectangle { width:42px;height:42px;horizontal-stretch:0;vertical-stretch:0;background:rgb(root.red,root.green,root.blue);border-width:1px;border-color:Theme.border; }
                GridLayout {
                    spacing:8px;
                    Row {
                        red-label := Text { text:"Red:";vertical-alignment:center; }
                        red-input := SpinBox { minimum:0;maximum:255;value<=>root.red; }
                    }
                    Row {
                        green-label := Text { text:"Green:";vertical-alignment:center; }
                        green-input := SpinBox { minimum:0;maximum:255;value<=>root.green; }
                    }
                    Row {
                        blue-label := Text { text:"Blue:";vertical-alignment:center; }
                        blue-input := SpinBox { minimum:0;maximum:255;value<=>root.blue; }
                    }
                }
            }
            HorizontalLayout {
                alignment:end;vertical-stretch:0;
                ok := Button { text:"OK";clicked=>{root.accepted(root.red,root.green,root.blue);} }
                cancel := Button { text:"Cancel";clicked=>{root.cancelled();} }
            }
        }
    }
}
