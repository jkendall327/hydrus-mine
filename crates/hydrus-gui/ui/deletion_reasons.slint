import { Button } from "std-widgets.slint";
import { ListTable, TableRow } from "list_table.slint";
export component DeletionReasonQueue inherits Rectangle {
    in property <[TableRow]> rows;
    in property <bool> enabled;
    in property <bool> selected;
    in property <bool> child-open;
    callback row-clicked(int,bool,bool);
    callback row-activated(int);
    callback action(string);
    min-width: 420px;
    min-height: 170px;
    VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            ListTable {
                rows: root.rows;
                columns: [{title:"",width:360px,stretch:true}];
                row-clicked(i,ctrl,shift)=>{if root.enabled && !root.child-open {root.row-clicked(i,ctrl,shift);}}
                row-activated(i)=>{if root.enabled && !root.child-open {root.row-activated(i);}}
                delete-pressed=>{if root.enabled && !root.child-open {root.action("delete");}}
            }
            VerticalLayout {
                spacing:4px;
                Button {text:"↑";enabled:root.enabled && root.selected && !root.child-open;clicked=>{root.action("up");}}
                Button {text:"X";enabled:root.enabled && root.selected && !root.child-open;clicked=>{root.action("delete");}}
                Button {text:"↓";enabled:root.enabled && root.selected && !root.child-open;clicked=>{root.action("down");}}
            }
        }
        HorizontalLayout {
            spacing:4px;
            Button {text:"add";enabled:root.enabled && !root.child-open;clicked=>{root.action("add");}}
            Button {text:"edit";enabled:root.enabled && root.selected && !root.child-open;clicked=>{root.action("edit");}}
        }
    }
}
