import { Btn } from "btn.slint";
import { Button, LineEdit } from "std-widgets.slint";
import { DownloadControl, DownloadLine, JobCogMenu } from "importing.slint";
import { Theme } from "theme.slint";
import { ListTable, TableRow } from "list_table.slint";
export component LoginScriptsWindow inherits Window {
    in property <string> title-suffix: "";
    // the title as composed, for tests and the platform
    out property <string> composed-title: root.title;
    title: ("manage login scripts") + root.title-suffix;
    preferred-width: 800px;
    preferred-height: 520px;
    background: Theme.window;
    in property <[TableRow]> rows;
    in property <bool> one-selected;
    in property <bool> any-selected;
    in property <bool> child-open;
    in property <bool> deleting;
    in property <string> error;
    callback row-clicked(int, bool, bool);
    callback row-activated(int);
    callback action(string);
    callback closed();
    VerticalLayout { padding: 12px; spacing: 8px;
        Text { text: "This system is very old and does not work well! Better to use a program like Hydrus Companion to sync cookies these days!"; color: Theme.error; wrap: word-wrap; }
        ListTable { vertical-stretch: 1; columns: [{title: "name", width: 260px}, {title: "example domains", width: 440px, stretch: true}]; rows: root.rows; row-clicked(i, ctrl, shift) => { if !root.child-open && !root.deleting { root.row-clicked(i, ctrl, shift); } } row-activated(i) => { if !root.child-open && !root.deleting { root.row-activated(i); } } }
        HorizontalLayout { spacing: 6px;
            Btn { text: "add"; enabled: !root.child-open && !root.deleting; clicked => { root.action("add"); } }
            Btn { text: "edit"; enabled: root.one-selected && !root.child-open && !root.deleting; clicked => { root.action("edit"); } }
            Btn { text: "delete"; enabled: root.any-selected && !root.child-open && !root.deleting; clicked => { root.action("delete"); } }
            Btn { text: "import"; enabled: !root.child-open && !root.deleting; clicked => { root.action("import"); } }
            Btn { text: "export selected"; enabled: root.any-selected && !root.child-open && !root.deleting; clicked => { root.action("export"); } }
        }
        if root.deleting: HorizontalLayout { spacing: 6px; Text { text: "Remove all selected?"; color: Theme.text; vertical-alignment: center; } Btn { text: "yes"; clicked => { root.action("confirm-delete"); } } Btn { text: "no"; clicked => { root.action("back"); } } }
        if root.error != "": Text { text: root.error; color: Theme.error; wrap: word-wrap; }
        HorizontalLayout { alignment: end; spacing: 6px; Btn { text: "apply"; enabled: !root.child-open && !root.deleting; clicked => { root.action("apply"); } } Btn { text: "cancel"; clicked => { root.action("cancel"); } } }
    }
}
export component LoginScriptWindow inherits Window {
    in property <string> title-suffix: "";
    // the title as composed, for tests and the platform
    out property <string> composed-title: root.title;
    title: ("edit login script") + root.title-suffix;
    preferred-width: 850px;
    preferred-height: 820px;
    background: Theme.window;
    in-out property <string> name;
    in property <[TableRow]> credentials;
    in property <[TableRow]> steps;
    in property <[TableRow]> cookies;
    in property <[TableRow]> examples;
    in property <bool> one-example;
    in property <bool> any-example;
    callback example-clicked(int,bool,bool);
    in property <bool> deleting;
    in property <[TableRow]> results;
    in property <bool> result-selected;
    in property <bool> running;
    in-out property <string> test-domain;
    in property <string> progress;
    in property <string> final-result;
    in property <DownloadLine> test-download;
    in property <JobCogMenu> test-cog;
    callback test-control-menu();
    callback test-control-action(int);
    callback result-clicked(int);
    in property <bool> step-selected;
    in property <bool> step-up;
    in property <bool> step-down;
    in property <bool> one-credential;
    in property <bool> any-credential;
    in property <bool> child-open;
    in property <string> question;
    in property <string> error;
    in property <string> check-result;
    callback step-clicked(int);
    callback credential-clicked(int, bool, bool);
    callback credential-activated(int);
    callback action(string);
    callback closed();
    VerticalLayout { padding: 12px; spacing: 6px;
        HorizontalLayout { alignment: end;
            Text { text: "help for this panel -->"; color: Theme.text; vertical-alignment: center; }
            help := ContextMenuArea {
                width: 30px;
                Menu { MenuItem { title: "open the login scripts help"; activated => { root.action("help"); } } }
                Btn { text: "?"; enabled: !root.child-open; clicked => { help.show({x: 0px, y: self.height}); } }
            }
        }
        HorizontalLayout { Text { text: "name: "; color: Theme.text; vertical-alignment: center; } LineEdit { text <=> root.name; enabled: !root.running && !root.child-open && root.question == ""; } }
        Text { text: "credential definitions"; color: Theme.text; font-weight: 700; }
        ListTable { vertical-stretch: 1; columns: [{title: "name", width: 180px}, {title: "input type", width: 140px}, {title: "permitted input", width: 350px, stretch: true}]; rows: root.credentials; row-clicked(i, ctrl, shift) => { if !root.child-open && root.question == "" { root.credential-clicked(i, ctrl, shift); } } row-activated(i) => { if !root.child-open && root.question == "" { root.credential-activated(i); } } }
        HorizontalLayout { spacing: 6px; Btn { text: "add"; enabled: !root.running && !root.child-open && root.question == ""; clicked => { root.action("add-credential"); } } Btn { text: "edit"; enabled: !root.running && root.one-credential && !root.child-open && root.question == ""; clicked => { root.action("edit-credential"); } } Btn { text: "delete"; enabled: !root.running && root.any-credential && !root.child-open && root.question == ""; clicked => { root.action("delete-credential"); } } Btn { text: "check credentials"; enabled: !root.running && !root.child-open && root.question == ""; clicked => { root.action("check-credentials"); } } }
        Text { text: "login steps"; color: Theme.text; font-weight: 700; }
        ListTable { vertical-stretch: 1; columns: [{title: "step", width: 700px, stretch: true}]; rows: root.steps; row-clicked(i,c,s) => { root.step-clicked(i); } row-activated(i) => { root.step-clicked(i); root.action("edit-step"); } }
        HorizontalLayout { spacing: 6px; Btn { text: "add"; enabled: !root.running && !root.child-open && root.question == ""; clicked => { root.action("add-step"); } } Btn { text: "edit"; enabled: !root.running && root.step-selected && !root.child-open && root.question == ""; clicked => { root.action("edit-step"); } } Btn { text: "delete"; enabled: !root.running && root.step-selected && !root.child-open && root.question == ""; clicked => { root.action("delete-step"); } } Btn { text: "up"; enabled: !root.running && root.step-up && !root.child-open && root.question == ""; clicked => { root.action("step-up"); } } Btn { text: "down"; enabled: !root.running && root.step-down && !root.child-open && root.question == ""; clicked => { root.action("step-down"); } } }
        Text { text: "cookies required to consider session logged in"; color: Theme.text; font-weight: 700; }
        ListTable { vertical-stretch: 1; columns: [{title: "cookie name", width: 280px}, {title: "permitted value", width: 400px, stretch: true}]; rows: root.cookies; }
        Btn { text: "edit required cookies"; enabled: !root.running && !root.child-open && root.question == ""; clicked => { root.action("cookies"); } }
        Text { text: "example domains"; color: Theme.text; font-weight: 700; }
        ListTable { vertical-stretch: 1; columns: [{title: "domain", width: 220px}, {title: "access", width: 120px}, {title: "description", width: 400px, stretch: true}]; rows: root.examples; row-clicked(i,c,s) => { root.example-clicked(i,c,s); } row-activated(i) => { root.example-clicked(i,false,false); root.action("edit-example"); } delete-pressed => { root.action("delete-example"); } }
        HorizontalLayout { spacing: 6px; Btn { text: "add"; enabled: !root.running && !root.child-open && root.question == ""; clicked => { root.action("add-example"); } } Btn { text: "edit"; enabled: root.one-example && !root.running && !root.child-open && root.question == ""; clicked => { root.action("edit-example"); } } Btn { text: "delete"; enabled: root.any-example && !root.running && !root.child-open && root.question == ""; clicked => { root.action("delete-example"); } } }
        HorizontalLayout { spacing: 6px; Btn { text: "run test"; enabled: !root.running && !root.child-open && root.question == ""; clicked => { root.action("run-test"); } } Btn { text: "cancel test"; enabled: root.running; clicked => { root.action("cancel-test"); } } }
        DownloadControl { line: root.test-download; cog: root.test-cog; advanced: true;
            open-menu => { root.test-control-menu(); }
            action(id) => { root.test-control-action(id); }
            cancel => { root.action("cancel-test"); }
        }
        if root.progress != "": Text { text: root.progress; color: Theme.text; wrap: word-wrap; }
        ListTable { vertical-stretch: 1; columns: [{title: "name", width: 200px}, {title: "url", width: 350px, stretch: true}, {title: "result", width: 230px}]; rows: root.results; row-clicked(i,c,s) => { root.result-clicked(i); } row-activated(i) => { root.result-clicked(i); root.action("review-result"); } }
        Btn { text: "review test result"; enabled: root.result-selected && !root.child-open && root.question == ""; clicked => { root.action("review-result"); } }
        if root.final-result != "": Text { text: root.final-result; color: Theme.text; wrap: word-wrap; }
        if root.check-result != "": Text { text: root.check-result; color: Theme.text; wrap: word-wrap; }
        if root.question != "": VerticalLayout { spacing: 4px; Text { text: root.question; color: Theme.text; wrap: word-wrap; } HorizontalLayout { alignment: end; spacing: 6px; Btn { text: root.deleting ? "yes" : "ok as invalid"; clicked => { root.action("confirm"); } } Btn { text: root.deleting ? "no" : "go back"; clicked => { root.action("back"); } } } }
        if root.error != "": Text { text: root.error; color: Theme.error; wrap: word-wrap; }
        HorizontalLayout { alignment: end; spacing: 6px; Btn { text: "apply"; enabled: !root.running && !root.child-open && root.question == ""; clicked => { root.action("apply"); } } Btn { text: "cancel"; clicked => { root.action("cancel"); } } }
    }
}
