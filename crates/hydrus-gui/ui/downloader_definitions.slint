// Native downloader lists and typed rule editors. Fields are individual
// controls, never a serialized definition or free-form JSON editor.
import { Button, CheckBox, ComboBox, LineEdit, ScrollView, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ListTable, TableColumn, TableRow } from "list_table.slint";
import { Question } from "favourites.slint";

export struct DefinitionField {
    id: int, label: string, kind: int, text: string,
    options: [string], chosen: int, checked: bool, enabled: bool,
}

component Fields inherits VerticalLayout {
    vertical-stretch: 0;
    in property <[DefinitionField]> fields;
    in property <bool> enabled: true;
    callback text-edited(int,string);
    callback choice-edited(int,int);
    callback toggled(int,bool);
    spacing: 6px;
    for field in root.fields: HorizontalLayout {
        spacing: 8px;
        vertical-stretch: 0;
        min-height: field.kind == 3 ? 70px : 32px;
        max-height: field.kind == 3 ? 70px : 32px;
        Text { width: 245px; text: field.label; color: Theme.text; vertical-alignment: center; wrap: word-wrap; }
        if field.kind == 0: LineEdit {
            text: field.text; enabled: field.enabled && root.enabled;
            edited(text) => { root.text-edited(field.id,text); }
        }
        if field.kind == 1: ComboBox {
            model: field.options; current-index: field.chosen; enabled: field.enabled && root.enabled;
            selected => { root.choice-edited(field.id,self.current-index); }
        }
        if field.kind == 2: CheckBox {
            checked: field.checked; enabled: field.enabled && root.enabled;
            toggled => { root.toggled(field.id,self.checked); }
        }
        if field.kind == 3: TextEdit {
            min-height: 70px; text: field.text; enabled: field.enabled && root.enabled;
            edited(text) => { root.text-edited(field.id,text); }
        }
    }
}

export component DownloaderDefinitionsWindow inherits Window {
    in property <string> window-title;
    title: root.window-title;
    preferred-width: 1000px; preferred-height: 560px;
    background: Theme.window;
    in property <bool> generators;
    in property <int> tab;
    in property <[TableColumn]> columns;
    in property <[TableRow]> rows;
    in property <bool> can-edit;
    in property <bool> can-delete;
    in property <int> sort-column;
    in property <bool> ascending;
    in-out property <string> test-url;
    in property <string> test-result;
    in property <string> question;
    in property <string> error;
    callback tab-chosen(int);
    callback row-clicked(int,bool,bool);
    callback sort(int,bool);
    callback action(string);
    callback test-edited(string);
    callback answered(bool);
    VerticalLayout {
        padding: 10px; spacing: 8px;
        if root.generators: HorizontalLayout {
            Button { text: "gallery url generators"; enabled: root.tab != 0; clicked => { root.tab-chosen(0); } }
            Button { text: "nested gallery url generators"; enabled: root.tab != 1; clicked => { root.tab-chosen(1); } }
        }
        if !root.generators: HorizontalLayout {
            LineEdit { text <=> root.test-url; placeholder-text: "test a URL"; edited(text) => { root.test-edited(text); } }
            Text { text: root.test-result; color: Theme.text; vertical-alignment: center; }
        }
        ListTable {
            columns: root.columns; rows: root.rows;
            sort-column: root.sort-column; ascending: root.ascending;
            row-clicked(i,c,s) => { root.row-clicked(i,c,s); }
            row-activated(i) => { root.row-clicked(i,false,false); root.action("edit"); }
            sort(c,a) => { root.sort(c,a); }
            delete-pressed => { root.action("delete"); }
        }
        HorizontalLayout {
            spacing: 6px; alignment: start;
            Button { text: "add"; clicked => { root.action("add"); } }
            Button { text: "edit"; enabled: root.can-edit; clicked => { root.action("edit"); } }
            Button { text: "duplicate"; enabled: root.can-edit; clicked => { root.action("duplicate"); } }
            Button { text: "delete"; enabled: root.can-delete; clicked => { root.action("delete"); } }
            Button { text: "import"; clicked => { root.action("import"); } }
            Button { text: "export"; enabled: root.can-delete; clicked => { root.action("export"); } }
        }
        if root.error != "": Text { text: root.error; color: Theme.error; wrap: word-wrap; }
        if root.question != "": Question { text: root.question; answered(yes) => { root.answered(yes); } }
        HorizontalLayout {
            alignment: end; spacing: 6px;
            Button { text: "apply"; clicked => { root.action("apply"); } }
            Button { text: "cancel"; clicked => { root.action("cancel"); } }
        }
    }
}

export component DownloaderDefinitionEditWindow inherits Window {
    in property <string> window-title;
    title: root.window-title;
    preferred-width: 950px; preferred-height: 740px;
    min-width: 650px; min-height: 300px;
    out property <float> layout-height: root.height / 1px;
    out property <float> footer-y: footer.y / 1px;
    out property <float> footer-height: footer.height / 1px;
    background: Theme.window;
    in property <[string]> tabs;
    in property <int> tab;
    in property <[DefinitionField]> fields;
    in property <[string]> rules;
    in property <[string]> rule-tabs;
    in property <int> rule-tab;
    in property <int> selected-rule: -1;
    in property <[TableRow]> members;
    in property <bool> nested;
    in property <bool> rule-processor;
    in property <bool> child-open;
    in property <string> note;
    in property <string> preview;
    in property <string> error;
    in property <string> question;
    callback tab-chosen(int);
    callback text-edited(int,string);
    callback choice-edited(int,int);
    callback toggled(int,bool);
    callback rule-tab-chosen(int);
    callback rule-selected(int);
    callback rule-action(string);
    callback member-toggled(int);
    callback converter(int);
    callback action(string);
    callback answered(bool);
    callback closed();
    VerticalLayout {
        height: root.height - 52px;
        padding: 10px; spacing: 8px;
        if root.tabs.length > 0: HorizontalLayout {
            vertical-stretch: 0;
            for name[i] in root.tabs: Button { text: name; enabled: root.tab != i && !root.child-open; clicked => { root.tab-chosen(i); } }
        }
        ScrollView {
            min-height: 0px;
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 8px;
                alignment: start;
                Fields {
                    fields: root.fields;
                    enabled: !root.child-open;
                    text-edited(i,t) => { root.text-edited(i,t); }
                    choice-edited(i,c) => { root.choice-edited(i,c); }
                    toggled(i,v) => { root.toggled(i,v); }
                }
                if root.rule-tabs.length > 0 && root.tab == 0: VerticalLayout {
                    HorizontalLayout {
                        for name[i] in root.rule-tabs: Button { text: name; enabled: root.rule-tab != i && !root.child-open; clicked => { root.rule-tab-chosen(i); } }
                    }
                    for rule[i] in root.rules: Rectangle {
                        height: 28px;
                        background: root.selected-rule == i ? Theme.highlight : Theme.panel;
                        Text { x: 5px; text: rule; color: Theme.text; vertical-alignment: center; }
                        TouchArea { enabled: !root.child-open; clicked => { root.rule-selected(i); } double-clicked => { root.rule-selected(i); root.rule-action("edit"); } }
                    }
                    HorizontalLayout {
                        spacing: 6px; alignment: start;
                        Button { text: "add"; enabled: !root.child-open; clicked => { root.rule-action("add"); } }
                        Button { text: "edit"; enabled: root.selected-rule >= 0 && !root.child-open; clicked => { root.rule-action("edit"); } }
                        Button { text: "delete"; enabled: root.selected-rule >= 0 && !root.child-open; clicked => { root.rule-action("delete"); } }
                        Button { text: "up"; enabled: root.rule-tab == 0 && root.selected-rule > 0 && !root.child-open; clicked => { root.rule-action("up"); } }
                        Button { text: "down"; enabled: root.rule-tab == 0 && root.selected-rule >= 0 && root.selected-rule < root.rules.length - 1 && !root.child-open; clicked => { root.rule-action("down"); } }
                    }
                }
                if root.rule-tabs.length > 0 && root.tab == 1: HorizontalLayout {
                    Button { text: "edit API/redirect converter"; enabled: !root.child-open; clicked => { root.converter(0); } }
                    Button { text: "edit referral converter"; enabled: !root.child-open; clicked => { root.converter(1); } }
                }
                if root.rule-processor: Button { text: "edit default value string processor"; enabled: !root.child-open; clicked => { root.converter(2); } }
                if root.nested: VerticalLayout {
                    vertical-stretch: 0;
                    Text { text: "choose gugs"; color: Theme.text; }
                    for member[i] in root.members: CheckBox { text: member.cells[0]; checked: member.selected; enabled: !root.child-open; toggled => { root.member-toggled(i); } }
                }
                if root.note != "": Text { text: root.note; color: Theme.text; wrap: word-wrap; }
                Text { text: root.preview; color: Theme.text; wrap: word-wrap; }
            }
        }
        if root.error != "": Text { text: root.error; color: Theme.error; wrap: word-wrap; }
        if root.question != "" && !root.child-open: Question { text: root.question; answered(yes) => { root.answered(yes); } }
    }
    footer := HorizontalLayout {
        x: 10px; y: root.height - 42px;
        width: root.width - 20px; height: 32px;
        spacing: 6px; alignment: end;
        Button { text: "apply"; enabled: !root.child-open; clicked => { root.action("apply"); } }
        Button { text: "cancel"; enabled: !root.child-open; clicked => { root.action("cancel"); } }
    }
}
