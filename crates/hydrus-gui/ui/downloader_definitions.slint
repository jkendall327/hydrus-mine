import { Btn } from "btn.slint";
// Native downloader lists and typed rule editors. Fields are individual
// controls, never a serialized definition or free-form JSON editor.
import { Button, CheckBox, ComboBox, LineEdit, ScrollView, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ListTable, TableColumn, TableRow } from "list_table.slint";
import { Question } from "favourites.slint";

export struct DefinitionField {
    id: int, label: string, kind: int, text: string,
    options: [string], chosen: int, checked: bool, enabled: bool,
}

component Fields inherits VerticalLayout {
    vertical-stretch: 0;
    in property <[DefinitionField]> fields;
    in property <bool> enabled: true;
    callback text-edited(int,string);
    callback choice-edited(int,int);
    callback toggled(int,bool);
    spacing: 6px;
    for field in root.fields: HorizontalLayout {
        spacing: 8px;
        vertical-stretch: 0;
        min-height: field.kind == 3 ? 70px : 32px;
        max-height: field.kind == 3 ? 70px : 32px;
        Text { width: 245px; text: field.label; color: Theme.text; vertical-alignment: center; wrap: word-wrap; }
        if field.kind == 0: LineEdit {
            text: field.text; enabled: field.enabled && root.enabled;
            edited(text) => { root.text-edited(field.id,text); }
        }
        if field.kind == 1: ComboBox {
            model: field.options; current-index: field.chosen; enabled: field.enabled && root.enabled;
            selected => { root.choice-edited(field.id,self.current-index); }
        }
        if field.kind == 2: CheckBox {
            checked: field.checked; enabled: field.enabled && root.enabled;
            toggled => { root.toggled(field.id,self.checked); }
        }
        if field.kind == 3: TextEdit {
            min-height: 70px; text: field.text; enabled: field.enabled && root.enabled;
            edited(text) => { root.text-edited(field.id,text); }
        }
    }
}

export component DownloaderDefinitionsWindow inherits Window {
    in property <string> window-title;
    in property <string> title-suffix: "";
    // the title as composed, for tests and the platform
    out property <string> composed-title: root.title;
    title: (root.window-title) + root.title-suffix;
    preferred-width: 1000px; preferred-height: 560px;
    background: Theme.window;
    in property <bool> generators;
    in property <int> tab;
    in property <[TableColumn]> columns;
    in property <[TableRow]> rows;
    in property <bool> can-edit;
    in property <bool> can-delete;
    in property <int> sort-column;
    in property <bool> ascending;
    in-out property <string> test-url;
    in property <string> test-result;
    in property <string> question;
    in property <string> error;
    callback tab-chosen(int);
    callback row-clicked(int,bool,bool);
    callback sort(int,bool);
    callback action(string);
    callback test-edited(string);
    callback answered(bool);
    VerticalLayout {
        padding: 10px; spacing: 8px;
        if root.generators: HorizontalLayout {
            Btn { text: "gallery url generators"; enabled: root.tab != 0; clicked => { root.tab-chosen(0); } }
            Btn { text: "nested gallery url generators"; enabled: root.tab != 1; clicked => { root.tab-chosen(1); } }
        }
        if !root.generators: HorizontalLayout {
            LineEdit { text <=> root.test-url; placeholder-text: "test a URL"; edited(text) => { root.test-edited(text); } }
            Text { text: root.test-result; color: Theme.text; vertical-alignment: center; }
        }
        ListTable {
            columns: root.columns; rows: root.rows;
            sort-column: root.sort-column; ascending: root.ascending;
            row-clicked(i,c,s) => { root.row-clicked(i,c,s); }
            row-activated(i) => { root.row-clicked(i,false,false); root.action("edit"); }
            sort(c,a) => { root.sort(c,a); }
            delete-pressed => { root.action("delete"); }
        }
        HorizontalLayout {
            spacing: 6px; alignment: start;
            Btn { text: "add"; clicked => { root.action("add"); } }
            Btn { text: "edit"; enabled: root.can-edit; clicked => { root.action("edit"); } }
            Btn { text: "duplicate"; enabled: root.can-edit; clicked => { root.action("duplicate"); } }
            Btn { text: "delete"; enabled: root.can-delete; clicked => { root.action("delete"); } }
            Btn { text: "import"; clicked => { root.action("import"); } }
            Btn { text: "export"; enabled: root.can-delete; clicked => { root.action("export"); } }
        }
        if root.error != "": Text { text: root.error; color: Theme.error; wrap: word-wrap; }
        if root.question != "": Question { text: root.question; answered(yes) => { root.answered(yes); } }
        HorizontalLayout {
            alignment: end; spacing: 6px;
            Btn { text: "apply"; clicked => { root.action("apply"); } }
            Btn { text: "cancel"; clicked => { root.action("cancel"); } }
        }
    }
}

export component DownloaderDefinitionEditWindow inherits Window {
    in property <string> window-title;
    in property <string> title-suffix: "";
    // the title as composed, for tests and the platform
    out property <string> composed-title: root.title;
    title: (root.window-title) + root.title-suffix;
    preferred-width: 950px; preferred-height: 740px;
    min-width: 650px; min-height: 300px;
    out property <float> layout-height: root.height / 1px;
    out property <float> footer-y: footer.y / 1px;
    out property <float> footer-height: footer.height / 1px;
    background: Theme.window;
    in property <[string]> tabs;
    in property <int> tab;
    in property <[DefinitionField]> fields;
    in property <[string]> rules;
    in property <[string]> rule-tabs;
    in property <int> rule-tab;
    in property <int> selected-rule: -1;
    in property <[TableRow]> members;
    in property <bool> nested;
    in property <bool> rule-processor;
    in property <bool> child-open;
    in property <string> note;
    in property <string> preview;
    in property <bool> url-class;
    in property <int> domain-mode;
    in property <bool> domain-mode-enabled;
    in-out property <string> domain-raw;
    in-out property <string> domain-regex;
    in property <bool> domain-match;
    in property <bool> domain-keep;
    in-out property <string> domain-test;
    in property <string> domain-status;
    in property <string> domain-normalised;
    in property <[TableRow]> domain-raw-rows;
    in property <[TableRow]> domain-regex-rows;
    in property <bool> domain-raw-selected;
    in property <bool> domain-regex-selected;
    callback domain-row-clicked(bool,int,bool,bool);
    callback domain-action(bool,string);
    in property <string> preview-status;
    in property <string> preview-normalised;
    in property <string> preview-request;
    in property <string> preview-api;
    in property <string> preview-referral;
    in property <string> preview-next;
    in property <string> error;
    in property <string> question;
    callback tab-chosen(int);
    callback text-edited(int,string);
    callback choice-edited(int,int);
    callback toggled(int,bool);
    callback rule-tab-chosen(int);
    callback rule-selected(int);
    callback rule-action(string);
    callback member-toggled(int);
    callback converter(int);
    callback action(string);
    callback answered(bool);
    callback closed();
    VerticalLayout {
        height: root.height - 52px;
        padding: 10px; spacing: 8px;
        if root.tabs.length > 0: HorizontalLayout {
            vertical-stretch: 0;
            for name[i] in root.tabs: Btn { text: name; enabled: root.tab != i && !root.child-open; clicked => { root.tab-chosen(i); } }
        }
        ScrollView {
            min-height: 0px;
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 8px;
                alignment: start;
                if root.url-class && root.tab == 0: VerticalLayout {
                    spacing: 6px; vertical-stretch: 0;
                    Text { text: "domain"; color: Theme.text; }
                    ComboBox {
                        model: ["simple - just one fixed domain", "full - multiple fixed domains and/or regex domain patterns"];
                        current-index: root.domain-mode;
                        enabled: root.domain-mode-enabled && !root.child-open;
                        selected => { root.choice-edited(30,self.current-index); }
                    }
                    if root.domain-mode == 0: LineEdit {
                        text <=> root.domain-raw; enabled: !root.child-open;
                        edited(t) => { root.text-edited(3,t); }
                    }
                    if root.domain-mode == 1: HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            Text { text: "fixed domains"; color: Theme.text; }
                            ListTable {
                                height: 120px; columns: [{title: "domain",width: 320px,stretch: true}]; rows: root.domain-raw-rows;
                                row-clicked(i,c,s) => { if !root.child-open {root.domain-row-clicked(false,i,c,s);} }
                                row-activated(i) => { if !root.child-open {root.domain-row-clicked(false,i,false,false);root.domain-action(false,"edit");} }
                                delete-pressed => { if !root.child-open {root.domain-action(false,"delete");} }
                            }
                            HorizontalLayout {
                                Btn { text: "add"; enabled: !root.child-open; clicked => {root.domain-action(false,"add");} }
                                Btn { text: "edit"; enabled: root.domain-raw-selected && !root.child-open; clicked => {root.domain-action(false,"edit");} }
                                Btn { text: "delete"; enabled: root.domain-raw-selected && !root.child-open; clicked => {root.domain-action(false,"delete");} }
                            }
                        }
                        VerticalLayout {
                            Text { text: "domain regexes"; color: Theme.text; }
                            ListTable {
                                height: 120px; columns: [{title: "regex",width: 320px,stretch: true}]; rows: root.domain-regex-rows;
                                row-clicked(i,c,s) => { if !root.child-open {root.domain-row-clicked(true,i,c,s);} }
                                row-activated(i) => { if !root.child-open {root.domain-row-clicked(true,i,false,false);root.domain-action(true,"edit");} }
                                delete-pressed => { if !root.child-open {root.domain-action(true,"delete");} }
                            }
                            HorizontalLayout {
                                Btn { text: "add"; enabled: !root.child-open; clicked => {root.domain-action(true,"add");} }
                                Btn { text: "edit"; enabled: root.domain-regex-selected && !root.child-open; clicked => {root.domain-action(true,"edit");} }
                                Btn { text: "delete"; enabled: root.domain-regex-selected && !root.child-open; clicked => {root.domain-action(true,"delete");} }
                            }
                        }
                    }
                    CheckBox { text: "match subdomains:"; checked: root.domain-match; enabled: !root.child-open; toggled => { root.toggled(5,self.checked); } }
                    CheckBox { text: "keep matched subdomains:"; checked: root.domain-keep; enabled: root.domain-match && !root.child-open; toggled => { root.toggled(6,self.checked); } }
                    Text { text: root.domain-status; color: root.domain-status == "Matches!" ? Theme.good : Theme.error; }
                    HorizontalLayout {
                        Text { width: 245px; text: "test domain:"; color: Theme.text; }
                        LineEdit { text <=> root.domain-test; placeholder-text: "Enter a domain here to test if it matches."; enabled: !root.child-open; edited(t) => { root.text-edited(31,t); } }
                    }
                    HorizontalLayout {
                        Text { width: 245px; text: "normalised domain:"; color: Theme.text; }
                        TextEdit { height: 32px; read-only: true; text: root.domain-normalised; }
                    }
                }
                Fields {
                    fields: root.fields;
                    enabled: !root.child-open;
                    text-edited(i,t) => { root.text-edited(i,t); }
                    choice-edited(i,c) => { root.choice-edited(i,c); }
                    toggled(i,v) => { root.toggled(i,v); }
                }
                if root.rule-tabs.length > 0 && root.tab == 0: VerticalLayout {
                    HorizontalLayout {
                        for name[i] in root.rule-tabs: Btn { text: name; enabled: root.rule-tab != i && !root.child-open; clicked => { root.rule-tab-chosen(i); } }
                    }
                    for rule[i] in root.rules: Rectangle {
                        height: 28px;
                        background: root.selected-rule == i ? Theme.highlight : Theme.panel;
                        Text { x: 5px; text: rule; color: Theme.text; vertical-alignment: center; }
                        TouchArea { enabled: !root.child-open; clicked => { root.rule-selected(i); } double-clicked => { root.rule-selected(i); root.rule-action("edit"); } }
                    }
                    HorizontalLayout {
                        spacing: 6px; alignment: start;
                        Btn { text: "add"; enabled: !root.child-open; clicked => { root.rule-action("add"); } }
                        Btn { text: "edit"; enabled: root.selected-rule >= 0 && !root.child-open; clicked => { root.rule-action("edit"); } }
                        Btn { text: "delete"; enabled: root.selected-rule >= 0 && !root.child-open; clicked => { root.rule-action("delete"); } }
                        Btn { text: "up"; enabled: root.rule-tab == 0 && root.selected-rule > 0 && !root.child-open; clicked => { root.rule-action("up"); } }
                        Btn { text: "down"; enabled: root.rule-tab == 0 && root.selected-rule >= 0 && root.selected-rule < root.rules.length - 1 && !root.child-open; clicked => { root.rule-action("down"); } }
                    }
                }
                if root.rule-tabs.length > 0 && root.tab == 1: HorizontalLayout {
                    Btn { text: "edit API/redirect converter"; enabled: !root.child-open; clicked => { root.converter(0); } }
                    Btn { text: "edit referral converter"; enabled: !root.child-open; clicked => { root.converter(1); } }
                }
                if root.rule-processor: Btn { text: "edit default value string processor"; enabled: !root.child-open; clicked => { root.converter(2); } }
                if root.nested: VerticalLayout {
                    vertical-stretch: 0;
                    Text { text: "choose gugs"; color: Theme.text; }
                    for member[i] in root.members: CheckBox { text: member.cells[0]; checked: member.selected; enabled: !root.child-open; toggled => { root.member-toggled(i); } }
                }
                if root.note != "": Text { text: root.note; color: Theme.text; wrap: word-wrap; }
                if !root.url-class: Text { text: root.preview; color: Theme.text; wrap: word-wrap; }
                if root.url-class: VerticalLayout {
                    vertical-stretch: 0; spacing: 6px;
                    Text { text: root.preview-status; color: Theme.text; wrap: word-wrap; }
                    for item in [
                        {label: "normalised url:",value: root.preview-normalised},
                        {label: "request url:",value: root.preview-request},
                        {label: "api/redirect url:",value: root.preview-api},
                        {label: "referral url:",value: root.preview-referral},
                        {label: "next gallery page url:",value: root.preview-next}
                    ]: HorizontalLayout {
                        Text { width: 245px; text: item.label; color: Theme.text; }
                        TextEdit { height: 32px; read-only: true; text: item.value; }
                    }
                }
            }
        }
        if root.error != "": Text { text: root.error; color: Theme.error; wrap: word-wrap; }
        if root.question != "" && !root.child-open: Question { text: root.question; answered(yes) => { root.answered(yes); } }
    }
    footer := HorizontalLayout {
        x: 10px; y: root.height - 42px;
        width: root.width - 20px; height: 32px;
        spacing: 6px; alignment: end;
        Btn { text: "apply"; enabled: !root.child-open; clicked => { root.action("apply"); } }
        Btn { text: "cancel"; enabled: !root.child-open; clicked => { root.action("cancel"); } }
    }
}
