import { Button, CheckBox, ComboBox, LineEdit, ScrollView } from "std-widgets.slint";
import { ListTable, TableRow } from "list_table.slint";
export component ShortcutSetWindow inherits Window {
    in property <string> title-suffix: "";
    // the title as composed, for tests and the platform
    out property <string> composed-title: root.title;
    title:("edit shortcuts") + root.title-suffix; width:800px; height:500px;
    in-out property <string> set-name;
    in property <bool> name-enabled;
    in property <string> description;
    in property <[TableRow]> rows;
    in-out property <int> selected:-1;
    in property <bool> child-open;
    in property <string> error;
    in-out property <bool> remove-question;
    callback remove-chosen(bool);
    callback selected-row(int);
    callback action(string);
    callback apply(); callback cancel();
    VerticalLayout {
        padding:12px;spacing:8px;
        Text {text:"Please note the shortcut system does not support multiple commands per shortcut yet. If there are shortcut duplicates in this list, only one command will ever fire.";wrap:word-wrap;}
        HorizontalLayout {spacing:6px; Text{text:"name: ";vertical-alignment:center;} LineEdit{text<=>root.set-name;enabled:root.name-enabled && !root.child-open;}}
        if root.description != "": Text {text:root.description;wrap:word-wrap;}
        ListTable { rows:root.rows; columns:[{title:"shortcut",width:300px,stretch:true},{title:"command",width:380px,stretch:true}]; row-clicked(i,c,s)=>{if !root.child-open {root.selected-row(i);}} row-activated(i)=>{if !root.child-open {root.selected-row(i);root.action("edit");}} }
        Text {text:root.error;color:#b00020;wrap:word-wrap;}
        if root.remove-question:HorizontalLayout {Text{text:"Remove all selected?";}Button{text:"yes";clicked=>{root.remove-chosen(true);}}Button{text:"no";clicked=>{root.remove-chosen(false);}}}
        HorizontalLayout {
            Button{text:"add";enabled:!root.child-open;clicked=>{root.action("add");}}
            Button{text:"edit";enabled:root.selected>=0 && !root.child-open;clicked=>{root.action("edit");}}
            Button{text:"remove";enabled:root.selected>=0 && !root.child-open;clicked=>{root.action("remove");}}
            Rectangle {horizontal-stretch:1;}
            Button{text:"ok";enabled:!root.child-open;clicked=>{root.apply();}}
            Button{text:"cancel";clicked=>{root.cancel();}}
        }
    }
}
// Options > shortcuts' built-in and custom set lists.
export component ShortcutSetsPanel inherits VerticalLayout {
    in property <[TableRow]> reserved-rows;
    in property <[TableRow]> custom-rows;
    in property <bool> enabled;
    in property <bool> reserved-selected;
    in property <bool> custom-selected;
    callback clicked(bool,int,bool,bool);
    callback activated(bool,int);
    callback action(string);
    spacing:8px;
    HorizontalLayout {alignment:end; Button{text:"help";enabled:root.enabled;clicked=>{root.action("help");}}}
    Text{text:"built-in hydrus shortcut sets";font-weight:700;}
    ListTable { min-height:200px; rows:root.reserved-rows; columns:[{title:"name",width:330px,stretch:true},{title:"number of shortcuts",width:160px,stretch:false}]; row-clicked(i,c,s)=>{if root.enabled {root.clicked(false,i,c,s);}} row-activated(i)=>{if root.enabled {root.activated(false,i);}} }
    HorizontalLayout {alignment:end;spacing:6px;
        Button{text:"edit";enabled:root.enabled && root.reserved-selected;clicked=>{root.action("edit-reserved");}}
        Button{text:"restore defaults";enabled:root.enabled;clicked=>{root.action("restore");}}
    }
    Text{text:"custom user sets";font-weight:700;}
    Text{text:"Custom shortcuts are advanced. They apply to the media viewer and must be turned on to take effect.";wrap:word-wrap;}
    ListTable { min-height:120px; rows:root.custom-rows; columns:[{title:"name",width:330px,stretch:true},{title:"number of shortcuts",width:160px,stretch:false}]; row-clicked(i,c,s)=>{if root.enabled {root.clicked(true,i,c,s);}} row-activated(i)=>{if root.enabled {root.activated(true,i);}} delete-pressed=>{if root.enabled {root.action("delete");}} }
    HorizontalLayout {alignment:end;spacing:6px;
        Button{text:"add";enabled:root.enabled;clicked=>{root.action("add");}}
        Button{text:"edit";enabled:root.enabled && root.custom-selected;clicked=>{root.action("edit-custom");}}
        Button{text:"delete";enabled:root.enabled && root.custom-selected;clicked=>{root.action("delete");}}
    }
}
export component ShortcutCommandWindow inherits Window {
    in property <string> title-suffix: "";
    // the title as composed, for tests and the platform
    out property <string> composed-title: root.title;
    title:("edit shortcut command") + root.title-suffix;width:700px;height:420px;
    in property <string> keyboard-text;
    in property <string> mouse-text;
    in-out property <int> mode;
    in-out property <int> release-choice;
    in property <bool> release-enabled;
    in property <[string]> commands;
    in-out property <int> command-index;
    // 0: a simple command; 1: a tag or rating (content) command
    in-out property <int> command-type;
    in property <[string]> content-services;
    in-out property <int> content-service;
    in property <[string]> content-actions;
    in-out property <int> content-action;
    in-out property <string> content-value;
    in property <string> content-hint;
    in property <string> content-error;
    callback content-service-changed(int);
    out property <bool> keyboard-focused: keyboard.has-focus;
    out property <length> capture-x:mouse.absolute-position.x;
    out property <length> capture-y:mouse.absolute-position.y;
    out property <length> capture-width:mouse.width;
    out property <length> capture-height:mouse.height;
    callback key-capture(string,int);
    callback mouse-capture(int,int,int);
    callback wheel-capture(float,int);
    callback release-changed(int);
    callback double-capture();
    callback apply();callback cancel();
    forward-focus:keyboard;
    VerticalLayout {
        padding:12px;spacing:10px;
        Text{text:"shortcut";font-weight:700;}
        Text{text:"Mouse events only work for some windows, mostly media viewer stuff, atm!";wrap:word-wrap;}
        HorizontalLayout {
            Button{text:"mouse";clicked=>{root.mode=1;}}
            mouse := Rectangle {
                background:#eeeeee;border-width:1px;border-color:#777;min-width:280px;height:45px;
                Text{text:root.mouse-text;vertical-alignment:center;horizontal-alignment:center;}
                TouchArea {
                    pointer-event(e)=>{if e.kind==PointerEventKind.down || e.kind==PointerEventKind.up {
                        root.mouse-capture(e.button==PointerEventButton.left?0:e.button==PointerEventButton.right?1:e.button==PointerEventButton.middle?2:e.button==PointerEventButton.back?7:e.button==PointerEventButton.forward?8:9,e.kind==PointerEventKind.down?0:1,(e.modifiers.control?1:0)+(e.modifiers.alt?2:0)+(e.modifiers.shift?4:0)+(e.modifiers.meta?32:0));
                    }}
                    double-clicked=>{root.double-capture();}
                    scroll-event(e)=>{root.wheel-capture(e.delta-y/1px,(e.modifiers.control?1:0)+(e.modifiers.alt?2:0)+(e.modifiers.shift?4:0)+(e.modifiers.meta?32:0));return accept;}
                }
            }
            ComboBox{model:["press","release"];current-index<=>root.release-choice;enabled:root.release-enabled;selected(_)=>{root.release-changed(self.current-index);}}
        }
        HorizontalLayout {
            Button{text:"keyboard";clicked=>{root.mode=0;keyboard.focus();}}
            keyboard := FocusScope {
                min-width:420px;height:45px;
                key-pressed(e)=>{if root.mode != 0 {return reject;}root.key-capture(e.text,(e.modifiers.control?1:0)+(e.modifiers.alt?2:0)+(e.modifiers.shift?4:0)+(e.modifiers.meta?32:0));return accept;}
                Rectangle{background:#fff;border-width:keyboard.has-focus?2px:1px;border-color:#777;Text{text:root.keyboard-text;vertical-alignment:center;horizontal-alignment:center;}TouchArea{clicked=>{root.mode=0;keyboard.focus();}}}
            }
        }
        Text{text:"command";font-weight:700;}
        ComboBox{model:["simple command","tag or rating"];current-index<=>root.command-type;enabled:root.content-services.length > 0;}
        if root.command-type == 0: ComboBox{model:root.commands;current-index<=>root.command-index;}
        if root.command-type == 1: VerticalLayout {
            spacing:6px;
            ComboBox{model:root.content-services;current-index<=>root.content-service;selected(_)=>{root.content-service-changed(self.current-index);}}
            ComboBox{model:root.content-actions;current-index<=>root.content-action;}
            LineEdit{text<=>root.content-value;placeholder-text:root.content-hint;}
            if root.content-error != "": Text{text:root.content-error;color:#b00020;wrap:word-wrap;}
        }
        HorizontalLayout {Rectangle{horizontal-stretch:1;}Button{text:"ok";clicked=>{root.apply();}}Button{text:"cancel";clicked=>{root.cancel();}}}
    }
}
