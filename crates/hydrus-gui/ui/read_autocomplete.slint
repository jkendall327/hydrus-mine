import { Btn } from "btn.slint";
// The same read tabs in embedded and floating search-page autocomplete.
import { ComboBox, Button } from "std-widgets.slint";
import { ReadSuggestions } from "read_suggestions.slint";
import { ListText, Theme } from "theme.slint";

export component ReadAutocomplete inherits Rectangle {
    in property <bool> enabled: true;
    in property <[ListText]> suggestions;
    in property <int> highlighted: -1;
    in property <int> tab-index;
    out property <bool> has-focus: tabs.has-focus || results.has-focus;
    callback tab-chosen(int);
    in property <[bool]> selected;
    callback chosen(int);
    callback selection-clicked(int,bool,bool);
    callback activated(bool);
    callback select-all();
    callback deselect() -> bool;
    callback move-highlight(int);
    out property <length> results-x: results.results-x;
    out property <length> results-y: results.results-y;
    callback scroll-geometry(length,length,length);
    callback context-menu(int,length,length);
    in property <bool> or-active;
    in property <bool> advanced-visible;
    in property <bool> or-rewind-visible;
    callback or-action(int);
    background: Theme.autocomplete-background;
    VerticalLayout {
        spacing: 4px;
        tabs := ComboBox {
            enabled: root.enabled;
            model: ["results", "favourites", "children"];
            current-index: root.tab-index;
            selected => { root.tab-chosen(self.current-index); }
        }
        HorizontalLayout {
            Btn { enabled: root.enabled; text: "OR"; clicked => { root.or-action(3); } }
            if root.advanced-visible: Btn { enabled: root.enabled; text: "advanced"; clicked => { root.or-action(4); } }
        }
        if root.or-active: HorizontalLayout {
            if root.or-rewind-visible: Btn { enabled: root.enabled; text: "↶"; clicked => { root.or-action(1); } }
            Btn { enabled: root.enabled; text: "cancel OR"; clicked => { root.or-action(2); } }
        }
        results := ReadSuggestions {
            vertical-stretch: 1;
            suggestions: root.suggestions;
            highlighted: root.highlighted;
            selected: root.selected;
            scroll-geometry(y,h,c) => { root.scroll-geometry(y,h,c); }
            move-highlight(by) => { if root.enabled { root.move-highlight(by); } }
            selection-clicked(i,c,s) => { if root.enabled { root.selection-clicked(i,c,s); } }
            activated(s) => { if root.enabled { root.activated(s); } }
            deselect => { root.deselect() }
            select-all => { if root.enabled { root.select-all(); } }
            context-menu(i,x,y) => { if root.enabled { root.context-menu(i,x,y); } }
            chosen(i) => { if root.enabled { root.chosen(i); } }
        }
    }
}
