import { Button, CheckBox, LineEdit, ListView, TextEdit } from "std-widgets.slint";
import { ListTable, TableColumn, TableRow } from "list_table.slint";
import { WriteTagInput, TagMenuOverlay } from "write_autocomplete.slint";
import { MenuPane } from "main_menu.slint";
import { Theme, ListText } from "theme.slint";
import { TagServicePanels } from "tag_service_panels.slint";

export component TagRelationshipsWindow inherits Window {
    in property <[MenuPane]> tag-menu-panes;
    in property <string> tag-menu-question;
    callback tag-menu-hovered(int,int,length,length,length);
    callback tag-menu-clicked(int,int,length,length,length);
    callback tag-menu-placed(int,length,length,length);
    callback tag-menu-dismissed();
    callback tag-menu-answered(bool);

    in property <bool> siblings;
    title: root.siblings ? "manage tag siblings" : "manage tag parents";
    preferred-width: 850px;
    preferred-height: 660px;
    background: Theme.window;
    in property <[string]> service-names;
    in property <bool> use-listbook;
    out property <float> service-content-offset: services.content-offset;
    in-out property <int> service-index;
    in property <[TableRow]> rows;
    in property <[ListText]> left-tags;
    in property <[ListText]> right-tags;
    in property <[ListText]> left-suggestions;
    in property <[ListText]> right-suggestions;
    in property <int> left-tab;
    in property <int> right-tab;
    in property <int> left-highlighted: -1;
    in property <int> right-highlighted: -1;
    in property <[bool]> left-selected;
    in property <[bool]> right-selected;
    in property <int> autocomplete-height: 11;
    in-out property <string> left-input;
    in-out property <string> right-input;
    in property <bool> can-add;
    in property <bool> has-selection;
    in property <string> sync-status;
    in property <string> workspace;
    in property <string> error;
    in-out property <bool> show-all;
    in-out property <bool> show-pending;
    in-out property <bool> whole-chain;
    in property <int> sort-column: 2;
    in property <bool> ascending: true;
    in property <string> question;
    in property <string> yes-label;
    in property <string> no-label;
    in property <bool> ask-reason;
    in-out property <string> reason;
    callback service-chosen(int);
    callback enter-tags(bool, string);
    callback autocomplete-edited(bool, string);
    callback autocomplete-fetch(bool);
    callback autocomplete-tab(bool, int);
    callback context-menu(bool,int,length,length);
    callback domain-menu(bool,bool,length,length);
    in property <string> left-file-label;
    in property <string> right-file-label;
    in property <string> left-tag-label;
    in property <string> right-tag-label;
    callback autocomplete-move(bool, int);
    callback autocomplete-chosen(bool, int);
    callback autocomplete-clicked(bool,int,bool,bool);
    callback autocomplete-paste(bool, bool) -> bool;
    callback remove-input(bool, int);
    callback filters-changed();
    callback wipe-workspace();
    callback row-clicked(int, bool, bool);
    callback row-activated(int);
    callback sort(int, bool);
    callback add();
    callback delete();
    callback import-pairs(bool);
    callback export-pairs(bool);
    callback apply();
    callback cancel();
    callback answered(bool);
    FocusScope {
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                if root.question != "" { root.answered(false); } else { root.cancel(); }
                return accept;
            }
            if root.question != "" { return accept; }
            reject
        }
        services := TagServicePanels {
            names: root.service-names;
            index: root.service-index;
            use-listbook: root.use-listbook;
            chosen(i) => { root.service-chosen(i); }
            VerticalLayout {
                padding: 10px;
                spacing: 8px;
                Text {
                    text: root.siblings ? "Tags on the left will appear as those on the right." : "Files with any tag on the left will also be given the tags on the right.";
                    color: Theme.text;
                }
                Text { text: root.sync-status; color: Theme.text; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 12px;
                    CheckBox { text: "show all pairs"; checked <=> root.show-all; toggled => { root.filters-changed(); } }
                    CheckBox { text: "show pending and petitioned groups"; enabled: !root.show-all; checked <=> root.show-pending; toggled => { root.filters-changed(); } }
                    if !root.siblings: CheckBox { text: "show whole chains"; enabled: !root.show-all; checked <=> root.whole-chain; toggled => { root.filters-changed(); } }
                }
                HorizontalLayout {
                    Button { text: "wipe workspace"; clicked => { root.wipe-workspace(); } }
                    Text { text: root.rows.length + " pairs."; color: Theme.text; vertical-alignment: center; }
                }
                ListTable {
                    vertical-stretch: 1;
                    columns: [
                        { title: "", width: 48px, stretch: false },
                        { title: root.siblings ? "to be replaced" : "child", width: 190px, stretch: true },
                        { title: root.siblings ? "ideal" : "parent", width: 190px, stretch: true },
                        { title: "note", width: 280px, stretch: true }
                    ];
                    rows: root.rows;
                    sort-column: root.sort-column;
                    ascending: root.ascending;
                    sort(c, asc) => { root.sort(c, asc); }
                    row-clicked(i, ctrl, shift) => { root.row-clicked(i, ctrl, shift); }
                    row-activated(i) => { root.row-activated(i); }
                    delete-pressed => { root.delete(); }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Button { text: "add"; enabled: root.can-add; clicked => { root.add(); } }
                    Button { text: "delete"; enabled: root.has-selection; clicked => { root.delete(); } }
                    Button { text: "import clipboard"; clicked => { root.import-pairs(false); } }
                    Button { text: "import .txt"; clicked => { root.import-pairs(true); } }
                    Button { text: "export clipboard"; enabled: root.has-selection; clicked => { root.export-pairs(false); } }
                    Button { text: "export .txt"; enabled: root.has-selection; clicked => { root.export-pairs(true); } }
                }
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        Text { text: root.siblings ? "set tags to be replaced" : "set children"; color: Theme.text; horizontal-alignment: center; }
                        Rectangle {
                            height: 84px; background: Theme.panel; border-width: 1px; border-color: Theme.border;
                            ListView {
                                for tag[i] in root.left-tags: Rectangle {
                                    height: 22px;
                                    Text { text: tag.text; color: tag.colour; x: 4px; vertical-alignment: center; }
                                    TouchArea { double-clicked => { root.remove-input(false, i); } }
                                }
                            }
                        }
                        WriteTagInput {
                            enabled: root.question == "";
                            text <=> root.left-input;
                            suggestions: root.left-suggestions;
                            highlighted: root.left-highlighted;
                            selected: root.left-selected;
                            tab-index: root.left-tab;
                            tab-chosen(i) => { root.autocomplete-tab(false, i); }
                            list-height: root.autocomplete-height;
                            edited(text) => { root.autocomplete-edited(false, text); }
                            entered => { root.enter-tags(false, self.text); }
                            fetch => { root.autocomplete-fetch(false); }
                            move-highlight(by) => { root.autocomplete-move(false, by); }
                            chosen(i) => { root.autocomplete-chosen(false, i); }
                            selection-clicked(i,ctrl,shift) => { root.autocomplete-clicked(false,i,ctrl,shift); }
                        context-menu(i,x,y) => { root.context-menu(false,i,x,y); }
                        file-label:root.left-file-label;tag-label:root.left-tag-label;
                        domain-menu(tags,x,y)=>{root.domain-menu(false,tags,x,y);}
                            paste(button) => { root.autocomplete-paste(false, button) }
                        }
                    }
                    VerticalLayout {
                        Text { text: root.siblings ? "set new ideal tag" : "set parents"; color: Theme.text; horizontal-alignment: center; }
                        Rectangle {
                            height: 84px; background: Theme.panel; border-width: 1px; border-color: Theme.border;
                            ListView {
                                for tag[i] in root.right-tags: Rectangle {
                                    height: 22px;
                                    Text { text: tag.text; color: tag.colour; x: 4px; vertical-alignment: center; }
                                    TouchArea { double-clicked => { root.remove-input(true, i); } }
                                }
                            }
                        }
                        WriteTagInput {
                            enabled: root.question == "";
                            text <=> root.right-input;
                            suggestions: root.right-suggestions;
                            highlighted: root.right-highlighted;
                            selected: root.right-selected;
                            tab-index: root.right-tab;
                            tab-chosen(i) => { root.autocomplete-tab(true, i); }
                            list-height: root.autocomplete-height;
                            edited(text) => { root.autocomplete-edited(true, text); }
                            entered => { root.enter-tags(true, self.text); }
                            fetch => { root.autocomplete-fetch(true); }
                            move-highlight(by) => { root.autocomplete-move(true, by); }
                            chosen(i) => { root.autocomplete-chosen(true, i); }
                            selection-clicked(i,ctrl,shift) => { root.autocomplete-clicked(true,i,ctrl,shift); }
                        context-menu(i,x,y) => { root.context-menu(true,i,x,y); }
                        file-label:root.right-file-label;tag-label:root.right-tag-label;
                        domain-menu(tags,x,y)=>{root.domain-menu(true,tags,x,y);}
                            paste(button) => { root.autocomplete-paste(true, button) }
                        }
                    }
                }
                if root.error != "": Text { text: root.error; color: Theme.error; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end; spacing: 8px;
                    Button { text: "apply"; clicked => { root.apply(); } }
                    Button { text: "cancel"; clicked => { root.cancel(); } }
                }
            }
        }
        if root.question != "": Rectangle {
            background: #00000055;
            TouchArea {}
        }
        if root.question != "": Rectangle {
            background: Theme.window;
            border-width: 1px; border-color: Theme.border;
            x: 50px; y: 150px; width: parent.width - 100px; height: 340px;
            VerticalLayout {
                padding: 20px; spacing: 10px;
                TextEdit { text: root.question; read-only: true; vertical-stretch: 1; }
                if root.ask-reason: LineEdit { text <=> root.reason; placeholder-text: "reason"; }
                HorizontalLayout {
                    alignment: end; spacing: 10px;
                    Button { text: root.yes-label; enabled: !root.ask-reason || root.reason != ""; clicked => { root.answered(true); } }
                    Button { text: root.no-label; clicked => { root.answered(false); } }
                }
            }
        }

        if root.tag-menu-panes.length > 0 || root.tag-menu-question != "": TagMenuOverlay {
            width: root.width; height: root.height;
            panes: root.tag-menu-panes; question: root.tag-menu-question;
            hovered(p,l,r,t,x) => { root.tag-menu-hovered(p,l,r,t,x); }
            clicked(p,l,r,t,x) => { root.tag-menu-clicked(p,l,r,t,x); }
            placed(p,x,y,w) => { root.tag-menu-placed(p,x,y,w); }
            dismissed => { root.tag-menu-dismissed(); }
            answered(yes) => { root.tag-menu-answered(yes); }
        }
    }
}
