import { Btn } from "btn.slint";
import { TipButton, TipComboBox } from "tip_widgets.slint";
import { MenuChoiceFrame } from "menu_choice_wheel.slint";
import { Button, ComboBox, VerticalBox, HorizontalBox, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { TableRow, TableColumn, ListTable } from "list_table.slint";
// A suggestion list (the reference's ListBoxTagsStrings): rows selected,
// activated, and its own keys, right-click menu and middle-click passed on.
component SuggestionList inherits FocusScope {
    in property <string> title;
    in property <length> column-width;
    in property <[TableRow]> rows;
    callback clicked(int,bool,bool);
    callback activated(int);
    callback key(string,bool,bool,int) -> bool;
    callback menu(int,length,length);
    callback middle(int,bool,bool);
    min-width: table.min-width;
    min-height: table.min-height;
    key-pressed(event) => {
        if root.key(event.text, event.modifiers.control, event.modifiers.shift, max(1, floor((self.height - 26px) / table.row-height))) { return accept; }
        reject
    }
    table := ListTable {
        width: root.width; height: root.height;
        background:Theme.tags-background; fill-empty:true;
        columns:[{title:root.title,width:root.column-width,stretch:true}]; rows:root.rows;
        row-clicked(i,c,s)=>{root.clicked(i,c,s);}
        row-activated(i)=>{root.activated(i);}
        row-menu(i,x,y)=>{root.menu(i,x,y);}
        row-middle(i,c,s)=>{root.middle(i,c,s);}
    }
}
export component TagSuggestionPanels inherits Rectangle {
    in property <bool> enabled: true;
    in property <[TableRow]> most-used;
    in property <[TableRow]> recent;
    in property <[TableRow]> related;
    in property <bool> related-enabled;
    in property <string> related-status;
    in-out property <bool> related-local:true;
    in-out property <bool> related-display:true;
    // the last duration button used: 0 quick, 1 medium, 2 thorough
    in-out property <int> related-level: 0;
    // what the reference shows when the pointer rests on these
    in property <string> related-button-tooltip;
    in property <string> related-local-tooltip;
    in property <string> related-display-tooltip;
    callback related-search(int);
    in property <bool> most-used-enabled;
    in property <bool> recent-enabled;
    in property <bool> columns;
    in property <length> column-width: 300px;
    in property <int> selected;
    callback selected-page(int);
    callback clicked(int,int,bool,bool);
    callback activated(int,int);
    callback clear-recent();
    // the lists' own keys (panel, key text, ctrl, shift, rows a page holds):
    // true when the list took the key
    callback list-key(int, string, bool, bool, int) -> bool;
    // a right press on a row (panel, row, where in the window)
    callback list-menu(int, int, length, length);
    // a middle press on a row (panel, row, ctrl, shift)
    callback list-middle(int, int, bool, bool);
    min-width: root.column-width * (root.columns ? (root.most-used-enabled ? 1 : 0) + (root.recent-enabled ? 1 : 0) + (root.related-enabled ? 1 : 0) : 1);
    horizontal-stretch: 0;
    VerticalLayout {
        if !root.columns: HorizontalLayout {
            if root.most-used-enabled: Btn { text:"most used"; primary:root.selected==0; clicked=>{root.selected-page(0);} }
            if root.related-enabled: Btn {text:"related"; primary:root.selected==2; clicked=>{root.selected-page(2);}}
            if root.recent-enabled: Btn { text:"recent"; primary:root.selected==1; clicked=>{root.selected-page(1);} }
        }
        HorizontalLayout {
            spacing:6px;
            if root.most-used-enabled && (root.columns || root.selected==0): SuggestionList {
                title:"most used"; column-width:root.column-width; rows:root.most-used; vertical-stretch:1;
                clicked(i,c,s)=>{root.clicked(0,i,c,s);}
                activated(i)=>{root.activated(0,i);}
                key(t,c,s,p)=>{return root.list-key(0,t,c,s,p);}
                menu(i,x,y)=>{root.list-menu(0,i,x,y);}
                middle(i,c,s)=>{root.list-middle(0,i,c,s);}
            }
            if root.related-enabled && (root.columns || root.selected==2): VerticalLayout {
                horizontal-stretch:0; min-width:root.column-width; max-width:root.column-width;
                Text {text:root.related-status; color:Theme.text;wrap:word-wrap;}
                HorizontalLayout {
                    spacing:4px;
                    TipButton {text:"quick"; tip:root.related-button-tooltip; clicked=>{root.related-level=0;root.related-search(0);}}
                    TipButton {text:"medium"; tip:root.related-button-tooltip; clicked=>{root.related-level=1;root.related-search(1);}}
                    TipButton {text:"thorough"; tip:root.related-button-tooltip; clicked=>{root.related-level=2;root.related-search(2);}}
                }
                TipComboBox {model:["just for my files","all known files"];current-index:root.related-local?0:1;tip:root.related-local-tooltip;selected(i)=>{root.related-local=i==0;root.related-search(root.related-level);}}
                TipComboBox {model:["siblings/parents","storage tags"];current-index:root.related-display?0:1;tip:root.related-display-tooltip;selected(i)=>{root.related-display=i==0;root.related-search(root.related-level);}}
                SuggestionList { title:"related"; column-width:root.column-width; rows:root.related; vertical-stretch:1;
                    clicked(i,c,s)=>{root.clicked(2,i,c,s);} activated(i)=>{root.activated(2,i);}
                    key(t,c,s,p)=>{return root.list-key(2,t,c,s,p);} menu(i,x,y)=>{root.list-menu(2,i,x,y);} middle(i,c,s)=>{root.list-middle(2,i,c,s);}
                }
            }
            if root.recent-enabled && (root.columns || root.selected==1): VerticalLayout {
                spacing:4px;
                Btn { text:"clear"; enabled:root.enabled; clicked=>{root.clear-recent();} }
                SuggestionList { title:"recent"; column-width:root.column-width; rows:root.recent; vertical-stretch:1;
                    clicked(i,c,s)=>{root.clicked(1,i,c,s);} activated(i)=>{root.activated(1,i);}
                    key(t,c,s,p)=>{return root.list-key(1,t,c,s,p);} menu(i,x,y)=>{root.list-menu(1,i,x,y);} middle(i,c,s)=>{root.list-middle(1,i,c,s);}
                }
            }
        }
    }
}
export component MostUsedTagsWindow inherits Window {
    in property <string> title-suffix: "";
    // the title as composed, for tests and the platform
    out property <string> composed-title: root.title;
    title: ("most used tags") + root.title-suffix;
    width: 520px; height: 440px; background: Theme.window;
    in property <[string]> services;
    in property <int> service;
    out property <string> displayed-service: service-choice.current-value;
    out property <int> displayed-service-index: service-choice.current-index;
    out property <MenuChoiceFrame> service-choice-frame: {x:service-choice.absolute-position.x,y:service-choice.absolute-position.y,w:service-choice.width,h:service-choice.height};
    in property <[string]> tags;
    in property <bool> child-open;
    callback service-chosen(int);
    callback edit-tags();
    callback apply();
    callback cancel();
    VerticalBox {
        padding: 12px; spacing: 8px;
        Text { text: "Add your most used tags for each particular service here, and then you can just double-click to add, rather than typing every time."; wrap: word-wrap; color: Theme.text; }
        HorizontalBox { Text {text:"Tag service: "; color:Theme.text;} service-choice := ComboBox { model:root.services; current-index:root.service; enabled:!root.child-open; selected(_)=>{root.service-chosen(self.current-index);} } }
        Rectangle { background:Theme.tags-background;vertical-stretch:1; ListView { for tag in root.tags: Text { text:tag; color:Theme.text; } } }
        Btn { text:"edit most used tags"; enabled:!root.child-open && root.services.length > 0; clicked=>{root.edit-tags();} }
        HorizontalBox { alignment:end; Btn {text:"apply"; enabled:!root.child-open; clicked=>{root.apply();}} Btn {text:"cancel"; clicked=>{root.cancel();}} }
    }
}
