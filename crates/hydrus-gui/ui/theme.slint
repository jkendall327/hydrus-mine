// The colours the windows draw with, from the style's palette, so they
// follow the system's light or dark mode as the standard widgets do.

import { Palette } from "std-widgets.slint";

export global Theme {
    // The legacy colourset paints explicit roles without changing the style palette.
    in property <bool> colours-override;
    in property <[color]> colours;
    callback colours-changed();
    callback refresh-colours();
    callback retire-colours();
    public pure function colour(role: int, fallback: brush) -> brush {
        self.colours-override && role >= 0 && role < self.colours.length ? self.colours[role] : fallback
    }
    public pure function thumbnail-background(local: bool, selected: bool) -> brush {
        self.colour((local ? 0 : 2) + (selected ? 1 : 0), self.panel)
    }
    public pure function thumbnail-border(local: bool, selected: bool) -> brush {
        self.colour((local ? 4 : 6) + (selected ? 1 : 0), selected ? self.accent : self.border)
    }
    out property <brush> grid-background: self.colour(8, self.window);
    out property <brush> autocomplete-background: self.colour(9, self.panel);
    out property <brush> tags-background: self.colour(12, self.panel);
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    // a window's background
    out property <brush> window: Palette.background;
    // lists, boxes and thumbnail cells
    out property <brush> panel: Palette.alternate-background;
    out property <brush> border: Palette.border;
    out property <brush> hover: self.dark ? #ffffff1a : #0000000f;
    // the highlighted suggestion, and its text
    out property <brush> highlight: Palette.selection-background;
    out property <brush> highlight-text: Palette.selection-foreground;
    // a selected thumbnail's border
    out property <brush> accent: Palette.accent-background;
    out property <brush> error: self.dark ? #ff8a94 : #b00020;
    // The reference stylesheet's HydrusValid and HydrusWarning text.
    out property <brush> valid: self.dark ? #70d070 : #008000;
    out property <brush> warning: self.dark ? #ffa040 : #b05000;
    // comparison statements for and against the file shown
    out property <brush> good: self.dark ? #7ed87e : #007000;
    out property <brush> bad: self.dark ? #ff8080 : #b00000;
    out property <brush> text: Palette.foreground;
    // text of a control not in use
    out property <brush> muted: self.dark ? #ffffff80 : #00000080;
    // behind a dialog
    out property <brush> shade: #00000080;
}

// a row of a tag or predicate list: its text, in its namespace's colour
export struct TagTextRun { text: string, colour: color, previous-colour: color, fade: bool }
export struct ListText {
    text: string,
    colour: color,
    parts: [TagTextRun],
}
