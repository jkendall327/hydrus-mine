// The favourite searches' dialogs (`src/favourites_window.rs` binds them):
// the reference's "edit favourite searches" (`EditFavouriteSearchesPanel`),
// a list of them to add to, edit and delete from, and its "edit favourite
// search" (`EditFavouriteSearchPanel`) for one.

import { Button, CheckBox, ComboBox, LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Tick } from "subscriptions.slint";

// A row of the list: its folder, name, search, sort and collect.
export struct FavouriteListRow {
    cells: [string],
    selected: bool,
}

// A yes/no question asked in the window, with its answers.
export component Question {
    in property <string> text;
    callback answered(bool);
    HorizontalLayout {
        spacing: 6px;
        Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            text: root.text;
            wrap: word-wrap;
            color: Theme.text;
        }
        Button {
            text: "yes";
            clicked => { root.answered(true); }
        }
        Button {
            text: "no";
            clicked => { root.answered(false); }
        }
    }
}

export component FavouritesWindow inherits Window {
    title: "edit favourite searches";
    preferred-width: 980px;
    preferred-height: 420px;
    background: Theme.window;
    in property <[string]> columns;
    in property <[length]> widths: [140px, 140px, 360px, 190px, 120px];
    in property <[FavouriteListRow]> rows;
    // the column sorted on, and whether ascending
    in property <int> sort-column;
    in property <bool> ascending: true;
    in property <bool> can-edit;
    in property <bool> can-delete;
    // a question waiting on an answer
    in property <string> question;
    callback header-clicked(int);
    // (row, ctrl held, shift held)
    callback row-clicked(int, bool, bool);
    callback row-activated(int);
    callback add();
    callback edit();
    callback delete();
    callback answered(bool);
    callback apply();
    callback cancel();

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel();
                return accept;
            }
            if (event.text == Key.Delete && root.can-delete) {
                root.delete();
                return accept;
            }
            reject
        }
        VerticalLayout {
            padding: 8px;
            spacing: 6px;
            Rectangle {
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.panel;
                VerticalLayout {
                    padding: 1px;
                    HorizontalLayout {
                        height: 24px;
                        for column[c] in root.columns: Rectangle {
                            width: root.widths[c];
                            background: header-touch.has-hover ? Theme.hover : transparent;
                            Text {
                                x: 4px;
                                width: parent.width - 8px;
                                vertical-alignment: center;
                                text: column + (c == root.sort-column ? (root.ascending ? " ▲" : " ▼") : "");
                                overflow: elide;
                                color: Theme.text;
                                font-weight: 700;
                            }
                            header-touch := TouchArea {
                                clicked => { root.header-clicked(c); }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    ScrollView {
                        min-height: 12 * 22px;
                        VerticalLayout {
                            alignment: start;
                            for row[r] in root.rows: Rectangle {
                                height: 22px;
                                background: row.selected ? Theme.highlight : row-touch.has-hover ? Theme.hover : transparent;
                                HorizontalLayout {
                                    for cell[c] in row.cells: Text {
                                        width: root.widths[c];
                                        vertical-alignment: center;
                                        text: " " + cell;
                                        overflow: elide;
                                        color: row.selected ? Theme.highlight-text : Theme.text;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                row-touch := TouchArea {
                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                            root.row-clicked(r, event.modifiers.control, event.modifiers.shift);
                                        }
                                    }
                                    double-clicked => { root.row-activated(r); }
                                }
                            }
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Button {
                    text: "add";
                    clicked => { root.add(); }
                }
                Button {
                    text: "edit";
                    enabled: root.can-edit;
                    clicked => { root.edit(); }
                }
                Button {
                    text: "delete";
                    enabled: root.can-delete;
                    clicked => { root.delete(); }
                }
            }
            if root.question != "": Question {
                text: root.question;
                answered(yes) => { root.answered(yes); }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 6px;
                Button {
                    text: "apply";
                    clicked => { root.apply(); }
                }
                Button {
                    text: "cancel";
                    clicked => { root.cancel(); }
                }
            }
        }
    }
}

export component FavouriteEditWindow inherits Window {
    title: "edit favourite search";
    min-width: 700px;
    preferred-height: 900px;
    background: Theme.window;
    in-out property <string> folder;
    in-out property <string> name;
    // the search's domains, as the page's buttons name them
    in property <string> location-label;
    in property <string> tags-label;
    in property <[string]> predicates;
    in-out property <string> typed;
    // why what was typed couldn't be added
    in property <string> error;
    in property <bool> synchronised;
    in property <string> sort-label;
    in property <bool> save-sort;
    in property <string> collect-label;
    in property <bool> save-collect;
    in property <string> question;
    in property <[string]> location-choices;
    in property <int> location-index;
    in property <[string]> tag-choices;
    in property <int> tag-index;
    in property <bool> include-current;
    in property <bool> include-pending;
    in property <[string]> sort-choices;
    in property <int> sort-index;
    in property <[string]> sort-orders;
    in property <int> sort-order;
    in property <[Tick]> collect-choices;
    in property <bool> collect-unmatched;
    in property <int> collect-tag-index;
    callback collect-tag-chosen(int);
    in property <[Tick]> location-ticks;
    in property <bool> selecting-locations;
    in property <[string]> suggestions;
    in property <int> suggestion-highlight;
    callback suggestion-moved(int);
    in property <bool> child-open;
    out property <bool> can-edit: !root.child-open && !root.selecting-locations && root.question == "";
    callback location-chosen(int);
    callback tag-chosen(int);
    callback tag-status-ticked(bool, bool);
    callback location-ticked(int, bool);
    callback locations-answered(bool);
    callback sort-chosen(int);
    callback sort-order-chosen(int);
    callback collect-ticked(int, bool);
    callback collect-unmatched-ticked(bool);
    callback typed-edited();
    callback suggestion-chosen(int);
    callback typed-accepted();
    callback predicate-removed(int);
    callback flip-synchronised();
    callback save-sort-ticked(bool);
    callback save-collect-ticked(bool);
    callback answered(bool);
    callback apply();
    callback cancel();

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel();
                return accept;
            }
            reject
        }
        VerticalLayout {
            padding: 8px;
            spacing: 6px;
            GridLayout {
                spacing: 6px;
                Row {
                    Text {
                        text: "folder (blank for none, \"/\" for nested): ";
                        vertical-alignment: center;
                        color: Theme.text;
                    }
                    LineEdit {
                        text <=> root.folder;
                        enabled: root.can-edit;
                    }
                }
                Row {
                    Text {
                        text: "name: ";
                        vertical-alignment: center;
                        color: Theme.text;
                    }
                    LineEdit {
                        text <=> root.name;
                        enabled: root.can-edit;
                    }
                }
            }
            // the search: what is typed adds to it, a double-click removes
            // from it
            FocusScope {
                height: search-input.preferred-height;
                capture-key-pressed(event) => {
                    if root.can-edit && event.text == Key.UpArrow { root.suggestion-moved(-1); return accept; }
                    if root.can-edit && event.text == Key.DownArrow { root.suggestion-moved(1); return accept; }
                    reject
                }
                search-input := LineEdit {
                    placeholder-text: "search";
                    text <=> root.typed;
                    enabled: root.can-edit;
                    edited => { root.typed-edited(); }
                    accepted => { root.typed-accepted(); }
                }
            }
            ScrollView {
                height: min(root.suggestions.length, 5) * 24px;
                VerticalLayout {
                    alignment: start;
                    for suggestion[i] in root.suggestions: Rectangle {
                        height: 24px;
                        background: root.suggestion-highlight == i ? Theme.highlight : transparent;
                        Text { text: suggestion; color: root.suggestion-highlight == i ? Theme.highlight-text : Theme.text; vertical-alignment: center; }
                        TouchArea { enabled: root.can-edit; clicked => { root.suggestion-chosen(i); } }
                    }
                }
            }
            if root.error != "": Text {
                text: root.error;
                wrap: word-wrap;
                color: Theme.error;
            }
            HorizontalLayout {
                spacing: 4px;
                Button {
                    horizontal-stretch: 1;
                    text: root.synchronised ? "searching immediately" : "search paused";
                    enabled: root.can-edit;
                    clicked => { root.flip-synchronised(); }
                }
            }
            HorizontalLayout {
                spacing: 4px;
                ComboBox {
                    horizontal-stretch: 1;
                    model: root.location-choices;
                    current-index: root.location-index;
                    enabled: root.can-edit;
                    selected(_) => { root.location-chosen(self.current-index); }
                }
                ComboBox {
                    horizontal-stretch: 1;
                    model: root.tag-choices;
                    current-index: root.tag-index;
                    enabled: root.can-edit;
                    selected(_) => { root.tag-chosen(self.current-index); }
                }
                CheckBox { text: "include current tags"; checked: root.include-current; enabled: root.can-edit; toggled => { root.tag-status-ticked(false, self.checked); } }
                CheckBox { text: "include pending tags"; checked: root.include-pending; enabled: root.can-edit; toggled => { root.tag-status-ticked(true, self.checked); } }
            }
            if root.selecting-locations: VerticalLayout {
                for tick[i] in root.location-ticks: CheckBox {
                    text: tick.label;
                    checked: tick.on;
                    toggled => { root.location-ticked(i, self.checked); }
                }
                HorizontalLayout {
                    Button { text: "apply locations"; clicked => { root.locations-answered(true); } }
                    Button { text: "cancel locations"; clicked => { root.locations-answered(false); } }
                }
            }
            Rectangle {
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.panel;
                height: min(max(root.predicates.length, 1) * 22px, 154px) + 6px;
                ScrollView {
                    x: 3px;
                    y: 3px;
                    width: parent.width - 6px;
                    height: parent.height - 6px;
                    VerticalLayout {
                        alignment: start;
                        for predicate[i] in root.predicates: Rectangle {
                            height: 22px;
                            background: remove-touch.has-hover ? Theme.hover : transparent;
                            Text {
                                x: 4px;
                                width: parent.width - 8px;
                                vertical-alignment: center;
                                text: predicate;
                                overflow: elide;
                                color: Theme.text;
                            }
                            remove-touch := TouchArea {
                                enabled: root.can-edit;
                                double-clicked => { root.predicate-removed(i); }
                            }
                        }
                    }
                }
            }
            GridLayout {
                spacing: 6px;
                Row {
                    Text {
                        width: 100px;
                        text: "save sort: ";
                        vertical-alignment: center;
                        color: Theme.text;
                    }
                    CheckBox {
                        horizontal-stretch: 1;
                        checked: root.save-sort;
                        enabled: root.can-edit;
                        toggled => { root.save-sort-ticked(self.checked); }
                    }
                }
                Row {
                    Text {
                        width: 100px;
                        text: "sort: ";
                        vertical-alignment: center;
                        color: Theme.text;
                    }
                    HorizontalLayout {
                        ComboBox { horizontal-stretch: 1; model: root.sort-choices; current-index: root.sort-index; enabled: root.save-sort && root.can-edit; selected(_) => { root.sort-chosen(self.current-index); } }
                        ComboBox { model: root.sort-orders; current-index: root.sort-order; enabled: root.save-sort && root.can-edit; selected(_) => { root.sort-order-chosen(self.current-index); } }
                    }
                }
                Row {
                    Text {
                        width: 100px;
                        text: "save collect: ";
                        vertical-alignment: center;
                        color: Theme.text;
                    }
                    CheckBox {
                        horizontal-stretch: 1;
                        checked: root.save-collect;
                        enabled: root.can-edit;
                        toggled => { root.save-collect-ticked(self.checked); }
                    }
                }
                Row {
                    Text {
                        width: 100px;
                        text: "collect: ";
                        vertical-alignment: center;
                        color: Theme.text;
                    }
                    VerticalLayout {
                        ScrollView {
                            height: 90px;
                            VerticalLayout {
                                alignment: start;
                                for tick[i] in root.collect-choices: CheckBox { text: tick.label; checked: tick.on; enabled: root.save-collect && root.can-edit; toggled => { root.collect-ticked(i, self.checked); } }
                            }
                        }
                        ComboBox { model: root.tag-choices; current-index: root.collect-tag-index; enabled: root.save-collect && root.can-edit; selected(_) => { root.collect-tag-chosen(self.current-index); } }
                        CheckBox { text: "collect unmatched files"; checked: root.collect-unmatched; enabled: root.save-collect && root.can-edit; toggled => { root.collect-unmatched-ticked(self.checked); } }
                    }
                }
            }
            if root.question != "": Question {
                text: root.question;
                answered(yes) => { root.answered(yes); }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 6px;
                Button {
                    text: "apply";
                    enabled: root.can-edit;
                    clicked => { root.apply(); }
                }
                Button {
                    text: "cancel";
                    clicked => { root.cancel(); }
                }
            }
        }
    }
}
