import { Btn } from "btn.slint";
import { Button, CheckBox, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";

export struct ImportOverwriteRow {
    current-label: string,
    pasted-label: string,
    result-label: string,
    current-checked: bool,
    pasted-checked: bool,
    pasted-enabled: bool,
}

export component ImportOptionsOverwriteWindow inherits Window {
    title: "customise import options overwrite";
    preferred-width: 1180px;
    preferred-height: 430px;
    background: Theme.window;
    in property <[ImportOverwriteRow]> rows;
    in property <string> notice;
    in property <bool> global-options;
    callback preset(int);
    callback ticked(int, bool, bool);
    callback apply();
    callback cancel();
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); return accept; }
            reject
        }
        VerticalLayout {
            spacing: 8px;
            padding: 10px;
            HorizontalLayout {
                spacing: 6px;
                Btn { text: "merge-paste"; clicked => { root.preset(0); } }
                if !root.global-options: Btn { text: "fill-in-gaps-paste"; clicked => { root.preset(1); } }
                if !root.global-options: Btn { text: "replace-paste"; clicked => { root.preset(2); } }
            }
            if root.notice != "": Text { text: root.notice; wrap: word-wrap; color: Theme.text; }
            HorizontalLayout {
                spacing: 8px;
                vertical-stretch: 1;
                Rectangle {
                    border-width: 1px;
                    border-color: Theme.border;
                    VerticalLayout {
                        padding: 6px;
                        Text { text: "current options"; color: Theme.text; font-weight: 700; }
                        ScrollView {
                            VerticalLayout {
                                alignment: start;
                                for row[i] in root.rows: CheckBox {
                                    text: row.current-label;
                                    checked: row.current-checked;
                                    enabled: !root.global-options;
                                    toggled => { root.ticked(i, false, self.checked); }
                                }
                            }
                        }
                    }
                }
                Text { text: "+"; color: Theme.text; vertical-alignment: center; }
                Rectangle {
                    border-width: 1px;
                    border-color: Theme.border;
                    VerticalLayout {
                        padding: 6px;
                        Text { text: "pasted/loaded options"; color: Theme.text; font-weight: 700; }
                        ScrollView {
                            VerticalLayout {
                                alignment: start;
                                for row[i] in root.rows: CheckBox {
                                    text: row.pasted-label;
                                    checked: row.pasted-checked;
                                    enabled: row.pasted-enabled;
                                    toggled => { root.ticked(i, true, self.checked); }
                                }
                            }
                        }
                    }
                }
                Text { text: "="; color: Theme.text; vertical-alignment: center; }
                Rectangle {
                    border-width: 1px;
                    border-color: Theme.border;
                    VerticalLayout {
                        padding: 6px;
                        Text { text: "result"; color: Theme.text; font-weight: 700; }
                        ScrollView {
                            VerticalLayout {
                                alignment: start;
                                for row in root.rows: Text { text: row.result-label; color: Theme.text; overflow: elide; height: 26px; }
                            }
                        }
                    }
                }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 6px;
                Btn { text: "apply"; clicked => { root.apply(); } }
                Btn { text: "cancel"; clicked => { root.cancel(); } }
            }
        }
    }
}
