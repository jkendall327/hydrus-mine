import { Btn } from "btn.slint";
import { Button, CheckBox, ComboBox, LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ListTable, TableRow } from "list_table.slint";
export component LoginStepWindow inherits Window {
    title: "edit login step";
    preferred-width: 880px;
    preferred-height: 680px;
    background: Theme.window;
    in-out property <string> name;
    in-out property <int> scheme;
    in-out property <int> method;
    in-out property <bool> has-subdomain;
    in-out property <string> subdomain;
    in-out property <string> path;
    in property <[TableRow]> variables;
    in property <[TableRow]> credential-variables;
    in property <[TableRow]> static-variables;
    in property <[TableRow]> temporary-variables;
    in property <bool> credential-one;
    in property <bool> credential-any;
    in property <bool> static-one;
    in property <bool> static-any;
    in property <bool> temporary-one;
    in property <bool> temporary-any;
    callback argument-clicked(int,int,bool,bool);
    in property <bool> variable-selected;
    in property <int> variable-index: -1;
    in-out property <int> variable-kind;
    callback variable-clicked(int);
    in property <[TableRow]> cookies;
    in property <bool> cookie-one;
    in property <bool> cookie-any;
    callback cookie-clicked(int,bool,bool);
    in property <[TableRow]> content;
    in property <bool> one-selected;
    in property <bool> any-selected;
    in property <bool> child-open;
    in property <bool> deleting;
    in property <string> error;
    out property <length> footer-y: footer.y;
    out property <length> footer-height: footer.height;
    callback content-clicked(int, bool, bool);
    callback content-activated(int);
    callback action(string);
    callback closed();
    VerticalLayout { padding: 12px; spacing: 6px;
        ScrollView { vertical-stretch: 1; VerticalLayout { spacing: 6px;
        HorizontalLayout { Text { text: "name: "; color: Theme.text; vertical-alignment: center; } LineEdit { text <=> root.name; enabled: !root.child-open && !root.deleting; } }
        HorizontalLayout { spacing: 6px;
            Text { text: "scheme: "; color: Theme.text; vertical-alignment: center; } ComboBox { model: ["http", "https"]; current-index <=> root.scheme; enabled: !root.child-open && !root.deleting; }
            Text { text: "method: "; color: Theme.text; vertical-alignment: center; } ComboBox { model: ["GET", "POST"]; current-index <=> root.method; enabled: !root.child-open && !root.deleting; }
        }
        HorizontalLayout { Text { text: "subdomain (replaces www, if present): "; color: Theme.text; vertical-alignment: center; } CheckBox { text: "set"; checked <=> root.has-subdomain; enabled: !root.child-open && !root.deleting; } LineEdit { text <=> root.subdomain; enabled: root.has-subdomain && !root.child-open && !root.deleting; } }
        HorizontalLayout { Text { text: "path: "; color: Theme.text; vertical-alignment: center; } LineEdit { text <=> root.path; enabled: !root.child-open && !root.deleting; } }
        Text { text: "credentials to send"; color: Theme.text; font-weight: 700; }
        ListTable { height: 120px; columns: [{title: "credential name", width: 340px}, {title: "parameter name", width: 440px, stretch: true}]; rows: root.credential-variables; row-clicked(i,c,s) => { root.argument-clicked(0,i,c,s); } row-activated(i) => { root.argument-clicked(0,i,false,false); root.action("edit-credential"); } delete-pressed => { root.action("delete-credential"); } }
        HorizontalLayout { spacing: 6px;
            Btn { text: "add"; enabled: !root.child-open && !root.deleting; clicked => { root.action("add-credential"); } }
            Btn { text: "edit"; enabled: root.credential-one && !root.child-open && !root.deleting; clicked => { root.action("edit-credential"); } }
            Btn { text: "delete"; enabled: root.credential-any && !root.child-open && !root.deleting; clicked => { root.action("delete-credential"); } }
        }
        Text { text: "static variables to send"; color: Theme.text; font-weight: 700; }
        ListTable { height: 120px; columns: [{title: "parameter name", width: 340px}, {title: "value", width: 440px, stretch: true}]; rows: root.static-variables; row-clicked(i,c,s) => { root.argument-clicked(1,i,c,s); } row-activated(i) => { root.argument-clicked(1,i,false,false); root.action("edit-static"); } delete-pressed => { root.action("delete-static"); } }
        HorizontalLayout { spacing: 6px;
            Btn { text: "add"; enabled: !root.child-open && !root.deleting; clicked => { root.action("add-static"); } }
            Btn { text: "edit"; enabled: root.static-one && !root.child-open && !root.deleting; clicked => { root.action("edit-static"); } }
            Btn { text: "delete"; enabled: root.static-any && !root.child-open && !root.deleting; clicked => { root.action("delete-static"); } }
        }
        Text { text: "temporary variables to send"; color: Theme.text; font-weight: 700; }
        ListTable { height: 120px; columns: [{title: "temp variable name", width: 340px}, {title: "parameter name", width: 440px, stretch: true}]; rows: root.temporary-variables; row-clicked(i,c,s) => { root.argument-clicked(2,i,c,s); } row-activated(i) => { root.argument-clicked(2,i,false,false); root.action("edit-temporary"); } delete-pressed => { root.action("delete-temporary"); } }
        HorizontalLayout { spacing: 6px;
            Btn { text: "add"; enabled: !root.child-open && !root.deleting; clicked => { root.action("add-temporary"); } }
            Btn { text: "edit"; enabled: root.temporary-one && !root.child-open && !root.deleting; clicked => { root.action("edit-temporary"); } }
            Btn { text: "delete"; enabled: root.temporary-any && !root.child-open && !root.deleting; clicked => { root.action("delete-temporary"); } }
        }
        Text { text: "cookies required to consider step successful"; color: Theme.text; font-weight: 700; }
        ListTable { height: 120px; columns: [{title: "key", width: 350px}, {title: "matching", width: 450px, stretch: true}]; rows: root.cookies;
            row-clicked(i,c,s) => { root.cookie-clicked(i,c,s); }
            row-activated(i) => { if !root.child-open && !root.deleting { root.cookie-clicked(i,false,false); root.action("edit-cookie"); } }
            delete-pressed => { root.action("delete-cookie"); }
        }
        HorizontalLayout { spacing: 6px;
            Btn { text: "add"; enabled: !root.child-open && !root.deleting; clicked => { root.action("add-cookie"); } }
            Btn { text: "edit"; enabled: root.cookie-one && !root.child-open && !root.deleting; clicked => { root.action("edit-cookie"); } }
            Btn { text: "delete"; enabled: root.cookie-any && !root.child-open && !root.deleting; clicked => { root.action("delete-cookie"); } }
        }
        Text { text: "content parsers"; color: Theme.text; font-weight: 700; }
        ListTable { height: 120px; columns: [{title: "name", width: 350px}, {title: "produces", width: 450px, stretch: true}]; rows: root.content; row-clicked(i,c,s) => { if !root.child-open && !root.deleting { root.content-clicked(i,c,s); } } row-activated(i) => { if !root.child-open && !root.deleting { root.content-activated(i); } } delete-pressed => { if !root.child-open && !root.deleting { root.action("delete-content"); } } }
        HorizontalLayout { spacing: 6px;
            Btn { text: "add"; enabled: !root.child-open && !root.deleting; clicked => { root.action("add-content"); } }
            Btn { text: "edit"; enabled: root.one-selected && !root.child-open && !root.deleting; clicked => { root.action("edit-content"); } }
            Btn { text: "delete"; enabled: root.any-selected && !root.child-open && !root.deleting; clicked => { root.action("delete-content"); } }
            Btn { text: "import"; enabled: !root.child-open && !root.deleting; clicked => { root.action("import-content"); } }
            Btn { text: "export selected"; enabled: root.any-selected && !root.child-open && !root.deleting; clicked => { root.action("export-content"); } }
        }
        if root.deleting: HorizontalLayout { spacing: 6px; Text { text: "Remove all selected?"; color: Theme.text; vertical-alignment: center; } Btn { text: "yes"; clicked => { root.action("confirm-delete"); } } Btn { text: "no"; clicked => { root.action("back"); } } }
        if root.error != "": Text { text: root.error; color: Theme.error; wrap: word-wrap; }
        } }
        footer := HorizontalLayout { alignment: end; spacing: 6px; Btn { text: "apply"; enabled: !root.child-open && !root.deleting; clicked => { root.action("apply"); } } Btn { text: "cancel"; clicked => { root.action("cancel"); } } }
    }
}
