import { Btn } from "btn.slint";
// The about window (help > about, the reference's `ShowAboutWindow`,
// bound by `src/about_window.rs`; its texts are hydrus-gui-model's
// `about`): the name, version and site over four tabs.

import { Button, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";

component Tab inherits Rectangle {
    in property <string> text;
    in property <bool> current;
    callback clicked();
    height: 26px;
    min-width: label.preferred-width + 16px;
    border-width: 1px;
    border-color: Theme.border;
    background: root.current ? Theme.highlight : transparent;
    label := Text {
        text: root.text;
        color: root.current ? Theme.highlight-text : Theme.text;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

export component AboutWindow inherits Window {
    in property <string> window-title: "about hydrus";
    title: root.window-title;
    preferred-width: 620px;
    preferred-height: 560px;
    background: Theme.window;
    in property <string> name;
    in property <string> version;
    in property <string> site;
    in property <[string]> tabs;
    in property <[string]> texts;
    in-out property <int> tab-index;
    callback open-site();
    callback close-clicked();

    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        Text {
            text: root.name;
            font-weight: 700;
            horizontal-alignment: center;
            color: Theme.text;
        }
        Text {
            text: root.version;
            horizontal-alignment: center;
            color: Theme.text;
        }
        Text {
            text: root.site;
            horizontal-alignment: center;
            color: Theme.highlight;
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open-site(); }
            }
        }
        HorizontalLayout {
            spacing: 0px;
            alignment: start;
            for tab[i] in root.tabs: Tab {
                text: tab;
                current: i == root.tab-index;
                clicked => { root.tab-index = i; }
            }
        }
        // (the description and libraries centred, as the reference's
        // labels; the credits and license in read-only boxes)
        if root.tab-index < 2: Text {
            vertical-stretch: 1;
            text: root.texts[root.tab-index];
            wrap: word-wrap;
            horizontal-alignment: center;
            vertical-alignment: center;
            color: Theme.text;
        }
        if root.tab-index >= 2: TextEdit {
            vertical-stretch: 1;
            read-only: true;
            text: root.texts[root.tab-index];
        }
        HorizontalLayout {
            alignment: end;
            Btn {
                text: "close";
                clicked => { root.close-clicked(); }
            }
        }
    }
}
