import { Button, CheckBox, ComboBox, LineEdit, ScrollView, SpinBox } from "std-widgets.slint";
import { ListTable, TableRow } from "list_table.slint";
export struct ExternalRule { label:string, enabled:bool, token:string, summary:string, value:string }
export component ExternalCallsTable inherits Rectangle {
    in property <string> error;
    in property <[TableRow]> rows;
    in property <bool> selected;
    in property <bool> single;
    in property <bool> child-open;
    in property <int> sort-column;
    in property <bool> ascending;
    callback clicked(int,bool,bool);
    callback activated(int);
    callback sort(int,bool);
    callback action(string);
    min-height:350px;
    help := PopupWindow {
        width:300px;height:40px;
        Rectangle { background:#f0f0f0;border-width:1px;border-color:#888;
            Button{text:"open the external programs help";clicked=>{help.close();root.action("help");}} }
    }
    VerticalLayout {
        spacing:6px;
        HorizontalLayout { alignment:end;spacing:6px;
            Text{text:"help for this panel -->";vertical-alignment:center;}
            help-button := Button{text:"help  ▾";clicked=>{help.show();}}
        }
        Text { text:"This system is under active development.\n\nHere we can teach your client about other programs it can call to complete jobs. You set them up here, and they will appear as options in appropriate places around the client. Each job has a certain type, starting with simple things like \"open file in external program\", and, as I write the pipelines for them, we will eventually get tasks like \"download URL\" and \"suggest tags\". Depending on the job type, it will have certain call parameters (e.g. a local media file path) that hydrus can pass on to the external program (e.g. an AI model for tagging). In future, there will also be response parameters (e.g. a list of tags) that hydrus will then ingest.";wrap:word-wrap; }
        Text { horizontal-alignment:center;color:#c00000;text:"IF YOU IMPORT A CALL HERE THAT SOMEONE ELSE MADE, MAKE SURE YOU INSPECT IT BEFORE HOOKING IT UP TO ANYTHING. LOOK AT THE PARAMETERS.\n\nUSE YOUR BRAIN. DO NOT CALL THINGS BLINDLY.";wrap:word-wrap; }
        ListTable {
            rows:root.rows;sort-column:root.sort-column;ascending:root.ascending;
            columns:[{title:"name",width:160px,stretch:true},{title:"type",width:110px},{title:"command",width:240px,stretch:true}];
            row-clicked(i,c,s)=>{if !root.child-open{root.clicked(i,c,s);}}
            row-activated(i)=>{if !root.child-open{root.activated(i);}}
            sort(i,a)=>{if !root.child-open{root.sort(i,a);}}
        }
        Text {text:root.error;wrap:word-wrap;}
        HorizontalLayout {
            Button{text:"add";enabled:!root.child-open;clicked=>{root.action("add");}}
            Button{text:"edit";enabled:root.selected && !root.child-open;clicked=>{root.action("edit");}}
            Button{text:"delete";enabled:root.selected && !root.child-open;clicked=>{root.action("delete");}}
            Button{text:"export";enabled:root.selected && !root.child-open;clicked=>{root.action("export");}}
            Button{text:"import";enabled:!root.child-open;clicked=>{root.action("import");}}
            Button{text:"duplicate";enabled:root.selected && !root.child-open;clicked=>{root.action("duplicate");}}
            defaults-menu := ContextMenuArea {
                enabled:false;
                width:140px;height:32px;
                Menu {
                    MenuItem {title:"add them all";activated=>{root.action("defaults-all");}}
                    MenuItem {title:"select from a list";activated=>{root.action("defaults");}}
                }
                Button {text:"add defaults";enabled:!root.child-open;clicked=>{defaults-menu.show({x:0px,y:defaults-menu.height});}}
            }
        }
    }
}
export component ExternalCallWindow inherits Window {
    title:"edit external program call";
    width:1050px;height:760px;
    in-out property <string> name;
    in-out property <int> pipeline;
    in-out property <int> call-type;
    in property <string> command-template;
    in property <[ExternalRule]> rules;
    in property <string> validity;
    in-out property <int> timeout:15;
    in-out property <bool> long-lived;
    in-out property <bool> hide-terminal:true;
    in-out property <bool> output-text:true;
    in property <string> preview;
    in property <string> pipeline-description;
    in property <string> default-launch-description;
    in property <string> test-status;
    in property <bool> testing;
    in property <bool> child-open;
    callback changed();
    callback rule-enabled(int,bool);
    callback rule-token(int,string);
    callback rule-process(int);
    callback test-input(int,string);
    callback command-edit();
    callback show-path();
    callback test(bool);
    callback apply();
    callback cancel();
    VerticalLayout {
        padding:12px;spacing:8px;
        HorizontalLayout {
            VerticalLayout {
                spacing:7px;
                Text{text:"pipeline";font-weight:700;}
                Text{text:"Set a name for this external call and select the job it will do.";wrap:word-wrap;}
                HorizontalLayout {Text{text:"name: ";}LineEdit{text<=>root.name;enabled:!root.child-open;}}
                HorizontalLayout {Text{text:"job: ";}ComboBox{model:["send single file","send single URL"];current-index<=>root.pipeline;enabled:!root.child-open;selected=>{root.changed();}}}
                Text{text:root.pipeline-description;wrap:word-wrap;}
                Text{text:"actual call";font-weight:700;}
                Text{text:"Choose the type of call and then set it up. Availability tests are mostly for other users who might import your call. Do not forget to test it!";wrap:word-wrap;}
                ComboBox{model:root.pipeline==0 ? ["local process call","default OS launch file call"] : ["local process call","default OS launch URL call"];current-index<=>root.call-type;enabled:!root.child-open;selected=>{root.changed();}}
                if root.call-type==0: VerticalLayout {
                    spacing:6px;
                    Text{text:"This makes a general process call. Select which input parameter(s) you want to use and make sure you are happy with their replacement tokens (the '%path%' stuff, which you can rename if you need to), and then insert those parameters in your command template (e.g. 'my_program \"%path%\"'). When this call fires, the given input parameters will be placed into your template and the process launched.\n\nThe \"availability\" test for this call just does a \"which\" call. If you have a full path, it checks if that path exists; if you have just a name, it searches for it in your PATH.";wrap:word-wrap;}
                    Button{text:"show PATH";enabled:!root.child-open;clicked=>{root.show-path();}}
                    Text{text:"input parameters";font-weight:700;}
                    for row[i] in root.rules: HorizontalLayout {
                        spacing:4px;
                        Text{text:row.label;min-width:110px;}
                        LineEdit{text:row.token;enabled:row.enabled && !root.child-open;edited=>{root.rule-token(i,self.text);}}
                        Button{text:row.summary;enabled:row.enabled && !root.child-open;clicked=>{root.rule-process(i);}}
                        CheckBox{text:"use this parameter: ";checked:row.enabled;enabled:!root.child-open;toggled=>{root.rule-enabled(i,self.checked);}}
                    }
                    HorizontalLayout { Text{text:"command template: ";} LineEdit{text:root.command-template;read-only:true;} Button{text:"edit";enabled:!root.child-open;clicked=>{root.command-edit();}} }
                    HorizontalLayout {Text{text:"timeout: ";}SpinBox{value<=>root.timeout;minimum:1;maximum:3600000;enabled:!root.long-lived && !root.child-open;edited=>{root.changed();}}CheckBox{text:"this can live for a very long time";checked<=>root.long-lived;enabled:!root.child-open;toggled=>{root.changed();}}}
                    CheckBox{text:"hide terminal: ";checked<=>root.hide-terminal;enabled:!root.child-open;toggled=>{root.changed();}}
                    CheckBox{text:"output is text: ";checked<=>root.output-text;enabled:!root.child-open;toggled=>{root.changed();}}
                }
                if root.call-type==1: Text{text:root.default-launch-description;wrap:word-wrap;}
                Text{text:root.validity;wrap:word-wrap;}
            }
            VerticalLayout {
                spacing:6px;
                Text{text:"testing";font-weight:700;}
                Text{text:"Test your call here. Put in a real path or URL in the provided input parameter box and click \"test call!\". It will fire for real, so don't screw around!\n\nRemember that if your application is inside a sandbox, for instance you installed it via flatpak, it needs to be able to see any paths you give it. Same deal for hydrus seeing an exe.";wrap:word-wrap;}
                Button{text:"test availability!";enabled:root.call-type==0 && !root.testing && !root.child-open;clicked=>{root.test(true);}}
                Text{text:"test input parameters";font-weight:700;}
                for row[i] in root.rules: HorizontalLayout {
                    visible:row.enabled;
                    Text{text:row.label;}
                    LineEdit{text:row.value;enabled:!root.testing && !root.child-open;edited=>{root.test-input(i,self.text);}}
                }
                LineEdit{text:root.preview;read-only:true;}
                Button{text:"test call!";enabled:root.call-type==0 && !root.testing && !root.child-open;clicked=>{root.test(false);}}
                Text{text:root.test-status;wrap:word-wrap;vertical-stretch:1;}
            }
        }
        HorizontalLayout {alignment:end;Button{text:"apply";enabled:!root.child-open && !root.testing;clicked=>{root.apply();}}Button{text:"cancel";clicked=>{root.cancel();}}}
    }
}
export component ExternalCommandWindow inherits Window {
    title:"edit command and parameters";
    width:760px;height:590px;
    in-out property <string> executable;
    in property <[TableRow]> rows;
    in property <bool> mac-delete-key;
    in property <bool> selected;
    in property <bool> single;
    in property <bool> child-open;
    in property <string> full-template;
    in property <string> error;
    out property <float> parameter-list-x: parameter-list.absolute-position.x / 1px;
    out property <float> parameter-list-y: parameter-list.absolute-position.y / 1px;
    in-out property <string> feedback;
    in-out property <int> feedback-generation;
    property <bool> feedback-visible;
    changed feedback-generation => { root.feedback-visible=false; }
    Timer { interval:50ms;running:root.feedback != "" && !root.feedback-visible;triggered=>{root.feedback-visible=true;} }
    Timer { interval:3000ms;running:root.feedback-visible;triggered=>{root.feedback="";root.feedback-visible=false;} }
    callback changed();
    callback clicked(int,bool,bool);
    callback navigated(string,bool,bool);
    callback action(string);
    callback apply();
    callback cancel();
    VerticalLayout {
        padding:12px;spacing:8px;
        Text{text:"Set the command and its parameters. Do not put parameters in the command input section. Put the %path% or %url% style parameter replacement token in the appropriate place in your parameter list. For quick entry, you can paste the whole template and I will try and figure it out.\n\nRemember to keep it simple. If you need to set up environment variables or use ten different awkward parameters or pipe and grep around, just write a .sh script to do it all and point to that instead.";wrap:word-wrap;}
        HorizontalLayout{Text{text:"executable command/path: ";}LineEdit{text<=>root.executable;enabled:!root.child-open;edited=>{root.changed();}}}
        Text{text:"parameters: ";}
        FocusScope {
            min-height: 150px;
            capture-key-pressed(event) => {
                if root.child-open { return accept; }
                if event.modifiers.control && (event.text == "c" || event.text == "C" || event.text == Key.Insert) { root.action("copy-selected"); return accept; }
                if event.modifiers.control && (event.text == "a" || event.text == "A") { root.action("select-all"); return accept; }
                if event.modifiers.control && event.text == " " { root.action("toggle-current"); return accept; }
                if event.text == Key.UpArrow { root.navigated("previous",event.modifiers.control,event.modifiers.shift); return accept; }
                if event.text == Key.DownArrow { root.navigated("next",event.modifiers.control,event.modifiers.shift); return accept; }
                if event.text == Key.Home { root.navigated("home",event.modifiers.control,event.modifiers.shift); return accept; }
                if event.text == Key.End { root.navigated("end",event.modifiers.control,event.modifiers.shift); return accept; }
                if event.text == Key.Delete || (root.mac-delete-key && event.text == Key.Backspace) { root.action("delete"); return accept; }
                reject
            }
            parameter-list := ListTable{rows:root.rows;columns:[{title:"parameter",width:550px,stretch:true}];row-clicked(i,c,s)=>{if !root.child-open{root.clicked(i,c,s);}}row-activated(i)=>{if !root.child-open{root.clicked(i,false,false);root.action("edit");}}delete-pressed=>{if !root.child-open{root.action("delete");}}}
        }
        HorizontalLayout{
            Button{text:"add";enabled:!root.child-open;clicked=>{root.action("add");}}
            Button{text:"edit";enabled:root.selected && !root.child-open;clicked=>{root.action("edit");}}
            Button{text:"delete";enabled:root.selected && !root.child-open;clicked=>{root.action("delete");}}
            Button{text:"↑";enabled:root.selected && !root.child-open;clicked=>{root.action("up");}}
            Button{text:"↓";enabled:root.selected && !root.child-open;clicked=>{root.action("down");}}
        }
        HorizontalLayout{Text{text:"current full template: ";}LineEdit{text:root.full-template;read-only:true;}}
        HorizontalLayout{copy-button := Button{text:"copy";enabled:!root.child-open;clicked=>{root.action("copy");}}paste-button := Button{text:"paste";enabled:!root.child-open;clicked=>{root.action("paste");}}}
        Text{text:root.error;wrap:word-wrap;}
        HorizontalLayout{alignment:end;Button{text:"apply";enabled:!root.child-open;clicked=>{root.apply();}}Button{text:"cancel";clicked=>{root.cancel();}}}
    }
    if root.feedback-visible && root.feedback != "": Rectangle {
        x: root.feedback == "Copied!" ? copy-button.absolute-position.x : paste-button.absolute-position.x;
        y: copy-button.absolute-position.y + copy-button.height;
        width: feedback-label.preferred-width + 16px; height:feedback-label.preferred-height + 12px;
        background:#ffffdc; border-width:1px; border-color:#888;
        feedback-label := Text { x:8px;y:6px;text:root.feedback;color:#000; }
    }

}
export component ExternalDefaultsWindow inherits Window {
    title:"select the defaults to add";
    width:600px;height:550px;
    in property <[TableRow]> rows;
    callback toggled(int);
    callback apply();callback cancel();
    VerticalLayout {padding:12px;spacing:8px;ListTable{rows:root.rows;columns:[{title:"defaults",width:500px,stretch:true}];row-clicked(i,c,s)=>{root.toggled(i);}row-activated(i)=>{root.toggled(i);}}HorizontalLayout{alignment:end;Button{text:"apply";clicked=>{root.apply();}}Button{text:"cancel";clicked=>{root.cancel();}}}}
}
