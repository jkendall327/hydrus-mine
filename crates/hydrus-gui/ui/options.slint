import { SortCollectCog, ContextCogServices, ContextCogItem } from "sort_collect_cog.slint";
import { OpenExternallyTable } from "open_externally.slint";
import { ExternalCallsTable } from "external_calls.slint";
import { FrameLocationsTable } from "frame_locations.slint";
// The options window (file > options, `src/options.rs`), as the
// reference's "manage options" dialog: its pages listed on the left, the
// page chosen on the right, each option its label then its control, in
// the page's titled boxes. Changes wait for "apply"; "cancel" (or escape)
// forgets them.

import { NamespaceColourRow, NamespaceColourList } from "namespace_colours.slint";
import { Button, CheckBox, ComboBox, LineEdit, ListView, ScrollView, SpinBox, StandardListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { TableRow } from "list_table.slint";
import { DeletionReasonQueue } from "deletion_reasons.slint";
import { PaletteProviderQueue } from "palette_provider_queue.slint";

// a field of a time: its value, largest value, and the unit after it
export struct DurationField {
    value: int,
    maximum: int,
    label: string,
}

export struct SortCogItem { label: string, checked: bool, separator: bool }

export struct OptionRow {
    // 0 a box's title, 1 a checkbox, 2 a number, 3 a number that may be
    // none, 4 a number with a fraction (typed), 5 a dropdown, 6 text, 7
    // text that may be none, 8 a time (its fields), 9 a number per a time,
    // 10 a file sort (its type and order), 11 a collect (its choices), 12
    // a tag sort (its type, order and grouping), 13 checker options (a
    // button, `text`, opening their editor), 14 regex favourites,
    // 15 tag service/session, 16 local location, 17 favourite tags,
    // 18 import options, 19 gallery source, 20 directory path,
    // 21 namespace sorting schemes.
    kind: int,
    label: string,
    // how many boxes it is in
    depth: int,
    checked: bool,
    enabled: bool,
    number: int,
    minimum: int,
    maximum: int,
    is-none: bool,
    none-phrase: string,
    unit: string,
    text: string,
    items: [string],
    index: int,
    fields: [DurationField],
    // (a rate's text between its number and its time)
    per: string,
    // gone to from the search: highlighted, as the reference's
    found: bool,
    // (10, a file sort: its types are `items`, the type `index`; then its
    // orders, and the one chosen. 11, a collect: its label is `text`, its
    // choices `items`, each checked or not; then the choices for files
    // matching none of it, as orders)
    orders: [string],
    order-index: int,
    checks: [bool],
    // (12, a tag sort: its types, orders as a sort's; then its groupings,
    // the one chosen, and whether its type groups)
    groups: [string],
    group-index: int,
    grouped: bool,
    sort-cog: bool,
}

// a whole number typed in a small box
export component NumberField inherits LineEdit {
    in property <int> number;
    callback number-edited(int);
    width: 64px;
    input-type: InputType.number;
    text: root.number;
    edited(text) => { root.number-edited(round(text.to-float())); }
}

// a time's fields, each its number then its unit
export component TimeFields {
    in property <bool> enabled:true;
    in property <[DurationField]> fields;
    callback edited(int, int);
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        for field[f] in root.fields: HorizontalLayout {
            spacing: 3px;
            NumberField {
                enabled:root.enabled;
                number: field.value;
                number-edited(n) => { root.edited(f, n); }
            }
            Text {
                text: field.label;
                vertical-alignment: center;
            }
        }
    }
}

export component OptionsWindow inherits Window {
    title: "manage options";
    preferred-width: 900px;
    preferred-height: 640px;
    background: Theme.window;
    callback noneable-text-geometry(int,length,length,length,length);

    in property <[TableRow]> routing-url-rows;
    in property <[TableRow]> routing-file-rows;
    in property <bool> routing-url-selected;
    in property <bool> routing-file-single;
    in property <bool> routing-file-delete;
    in property <bool> routing-child-open;
    in property <bool> routing-prepared;
    in property <string> routing-error;
    callback routing-url-clicked(int,bool,bool);
    callback routing-url-activated(int);
    callback routing-url-action(string);
    callback routing-file-clicked(int,bool,bool);
    callback routing-file-activated(int);
    callback routing-file-action(string);
    in property <string> external-call-error;
    in property <[TableRow]> external-call-rows;
    in property <bool> external-call-selected;
    in property <bool> external-call-single;
    in property <bool> external-call-child-open;
    in property <int> external-call-sort-column;
    in property <bool> external-call-ascending;
    callback external-call-clicked(int,bool,bool);
    callback external-call-activated(int);
    callback external-call-sort(int,bool);
    callback external-call-action(string);
    in property <[TableRow]> frame-rows;
    in property <bool> frame-selected;
    in property <bool> frame-single;
    in property <bool> frame-child-open;
    in property <int> frame-sort-column;
    in property <bool> frame-ascending;
    callback frame-clicked(int,bool,bool);
    callback frame-activated(int);
    callback frame-sort(int,bool);
    callback frame-action(string);
    in property <[TableRow]> reason-rows;
    in property <bool> reason-selected;
    in property <bool> reason-child-open;
    callback reason-clicked(int,bool,bool);
    callback reason-activated(int);
    callback reason-action(string);
    in property <[StandardListViewItem]> pages;
    in-out property <int> page;
    in property <[OptionRow]> rows;
    // the search box: its placeholder, text, what it suggests (at most
    // `shown` at once), and the one picked by the arrows (-1 for none)
    in property <string> search-placeholder;
    in property <bool> search-at-top: true;
    in property <int> shown: 10;
    in-out property <string> search-text;
    in property <[string]> matches;
    in-out property <int> match-highlighted: -1;
    in property <[NamespaceColourRow]> namespace-colour-rows;
    in property <bool> namespace-colour-child-open;
    in property <string> namespace-colour-error;
    callback namespace-colour-clicked(int,bool,bool);
    callback namespace-colour-action(string);
    callback search-edited(string);
    callback search-chosen(int);
    callback move-match(int);

    callback page-chosen(int);
    // (each by the option's place among the page's rows)
    callback check-toggled(int, bool);
    callback canvas-toggled(int, int, bool);
    callback number-edited(int, int);
    callback none-toggled(int, bool);
    callback text-edited(int, string);
    callback directory-browse(int);
    callback choice-chosen(int, int);
    // (a sort's type, or its order, by its place in the row's lists)
    callback sort-chosen(int, int);
    callback order-chosen(int, int);
    // (a collect's choice checked or not; its unmatched files' choice)
    callback collect-toggled(int, int, bool);
    // (a tag sort's type, order or grouping: the row, which, the choice)
    callback tag-sort-chosen(int, int, int);
    in property <ContextCogServices> collect-cog-services;
    in property <[ContextCogItem]> collect-cog-extra;
    callback collect-cog-opened(int);
    callback collect-cog-chosen(int, int);
    callback unmatched-chosen(int, int);
    // (a time's field: the row, the field, its value)
    callback field-edited(int, int, int);
    // (checker options' button clicked)
    callback checker-clicked(int);
    callback regex-favourites-clicked();
    in property <bool> regex-child-open;
    callback gallery-source-clicked();
    callback local-location-clicked(int);
    callback favourite-tags-clicked();
    callback most-used-tags-clicked();
    callback related-weights-clicked();
    callback import-options-clicked();
    callback namespace-sorts-clicked();
    callback banner-clicked(int);
    in property <[TableRow]> provider-rows;
    in property <[string]> provider-missing;
    in property <bool> provider-has-selection;
    in property <int> provider-mode;
    in property <string> provider-message;
    callback provider-clicked(int,bool,bool);
    callback provider-action(string);
    callback provider-chosen(int);
    callback provider-answer(bool);
    in property <[string]> sort-cog-groups;
    in property <[SortCogItem]> sort-cog-items;
    in property <int> sort-cog-group: -1;
    callback sort-cog-open(int);
    callback sort-cog-group-chosen(int, int);
    callback sort-cog-choice(int, int);
    callback sort-cog-cancel();
    callback apply();
    callback shortcuts-clicked();
    in property <bool> shortcuts-child-open;
    in-out property <bool> shortcuts-merge-numpad;
    in-out property <bool> shortcuts-primary-labels;
    callback shortcuts-policy(bool,bool);
    callback cancel();

    forward-focus: search;
    keys := FocusScope {
        // (the suggestions take the arrows, enter and escape while shown)
        capture-key-pressed(event) => {
            if (root.matches.length == 0) {
                return reject;
            }
            if (event.text == Key.UpArrow) {
                root.move-match(-1);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.move-match(1);
                return accept;
            }
            if (event.text == Key.Return) {
                root.search-chosen(max(0, root.match-highlighted));
                return accept;
            }
            if (event.text == Key.Escape) {
                root.search-text = "";
                root.search-edited("");
                return accept;
            }
            reject
        }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel();
                return accept;
            }
            reject
        }
        VerticalLayout {
            padding: 8px;
            spacing: 6px;
            top-search-slot := Rectangle {
                height: root.search-at-top ? 30px : 0px;
            }
            HorizontalLayout {
                spacing: 8px;
                vertical-stretch: 1;
                // (as the reference's 28 characters)
                page-list := StandardListView {
                    enabled: !root.shortcuts-child-open && !root.routing-child-open && !root.regex-child-open;
                    width: 200px;
                    model: root.pages;
                    current-item <=> root.page;
                    current-item-changed(i) => { root.page-chosen(i); }
                    // (a page gone to from the search brought into view)
                    property <int> shown-page: root.page;
                    changed shown-page => {
                        let height = self.content-height / max(1, root.pages.length);
                        let top = self.shown-page * height;
                        if (top < -self.content-y) {
                            self.content-y = -top;
                        } else if (top + height > -self.content-y + self.visible-height) {
                            self.content-y = -(top + height - self.visible-height);
                        }
                    }
                }
                ScrollView {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: 4px;
                        spacing: 4px;
                        alignment: start;
                        for row[i] in root.rows: VerticalLayout {
                            padding-left: row.depth * 16px;
                            spacing: 2px;
                          HorizontalLayout {
                            spacing: 8px;
                            min-height: 26px;
                            if row.kind == 0: Text {
                                text: row.label;
                                font-weight: 700;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                horizontal-stretch: 1;
                            }
                            if row.kind != 0: Rectangle {
                                horizontal-stretch: 1;
                                // (the reference's search highlight)
                                background: row.found ? #eaea007b : transparent;
                                VerticalLayout {
                                    Text {
                                        text: row.label;
                                        vertical-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                            if row.kind == 1: HorizontalLayout {
                                width: 260px;
                                CheckBox {
                                    checked: row.checked;
                                    toggled => { root.check-toggled(i, self.checked); }
                                }
                            }
                            if row.kind == 33: VerticalLayout {
                                width:400px;spacing:4px;
                                HorizontalLayout {
                                SpinBox {minimum:row.minimum;maximum:row.maximum;value:row.number;edited(value)=>{root.number-edited(i,value);}}
                                ComboBox {model:row.items;current-index:row.index;selected(value)=>{root.choice-chosen(i,self.current-index);}}
                                }
                                Text {text:row.text;}
                            }
                            if row.kind == 2: HorizontalLayout {
                                width: 260px;
                                SpinBox {
                                    minimum: row.minimum;
                                    maximum: row.maximum;
                                    value: row.number;
                                    edited(value) => { root.number-edited(i, value); }
                                }
                            }
                            if row.kind == 3: HorizontalLayout {
                                width: 260px;
                                spacing: 4px;
                                SpinBox {
                                    // (room for the longest none phrase)
                                    width: 100px;
                                    minimum: row.minimum;
                                    maximum: row.maximum;
                                    value: row.number;
                                    enabled: row.enabled && !none-box.checked;
                                    edited(value) => { root.number-edited(i, value); }
                                }
                                if row.unit != "": Text {
                                    text: row.unit;
                                    vertical-alignment: center;
                                }
                                none-box := CheckBox {
                                    enabled: row.enabled;
                                    text: row.none-phrase;
                                    checked: row.is-none;
                                    toggled => { root.none-toggled(i, self.checked); }
                                }
                            }
                            if row.kind == 4 || row.kind == 6: LineEdit {
                                width: 260px;
                                text: row.text;
                                edited(text) => { root.text-edited(i, text); }
                            }
                            if row.kind == 20: HorizontalLayout {
                                width: 260px;
                                LineEdit {
                                    text: row.text;
                                    edited(text) => { root.text-edited(i, text); }
                                }
                                Button {
                                    text: "browse";
                                    clicked => { root.directory-browse(i); }
                                }
                            }
                            if row.kind == 7: HorizontalLayout {
                                width: 260px;
                                spacing: 4px;
                                LineEdit {
                                    min-width: 80px;
                                    preferred-width: 80px;
                                    horizontal-stretch: 1;
                                    text: row.text;
                                    enabled: !text-none.checked;
                                    edited(text) => { root.text-edited(i, text); }
                                }
                                text-none := CheckBox {
                                    horizontal-stretch: 0;
                                    text: row.none-phrase;
                                    checked: row.is-none;
                                    toggled => { root.none-toggled(i, self.checked); }
                                    property <{x:length,y:length,w:length,preferred:length}> frame: {x:self.absolute-position.x,y:self.absolute-position.y,w:self.width,preferred:self.preferred-width};
                                    property <bool> measurement-pending: true;
                                    changed frame => { self.measurement-pending = true; }
                                }
                                Timer {
                                    interval: 1ms;
                                    running: text-none.measurement-pending;
                                    triggered => {
                                        text-none.measurement-pending = false;
                                        root.noneable-text-geometry(i,text-none.frame.x,text-none.frame.y,text-none.frame.w,text-none.frame.preferred);
                                    }
                                }
                            }
                            if row.kind == 16: Button {
                                text: row.text;
                                clicked => { root.local-location-clicked(i); }
                            }
                            if row.kind == 17: Button {
                                text: row.text;
                                clicked => { root.favourite-tags-clicked(); }
                            }
                            if row.kind == 32: VerticalLayout {
                                CheckBox{text:"Treat all non-number numpad inputs as \"normal\": ";checked<=>root.shortcuts-merge-numpad;enabled:!root.shortcuts-child-open && !root.routing-child-open && !root.regex-child-open;toggled=>{root.shortcuts-policy(self.checked,root.shortcuts-primary-labels);}}
                                CheckBox{text:"Replace \"left/right\"-click labels with \"primary/secondary\": ";checked<=>root.shortcuts-primary-labels;enabled:!root.shortcuts-child-open && !root.routing-child-open && !root.regex-child-open;toggled=>{root.shortcuts-policy(root.shortcuts-merge-numpad,self.checked);}}
                                Button { text:"edit shortcuts";enabled:!root.shortcuts-child-open && !root.routing-child-open && !root.regex-child-open;clicked=>{root.shortcuts-clicked();} }
                            }
                            if row.kind == 27: Button {
                                text: row.text;
                                clicked => { root.banner-clicked(i); }
                            }
                            if row.kind == 29: Button { text: "edit related tag weights"; clicked => { root.related-weights-clicked(); } }
                            if row.kind == 28: Button { text: "edit most used tags"; clicked => { root.most-used-tags-clicked(); } }
                            if row.kind == 21: Button {
                                text: row.text;
                                clicked => { root.namespace-sorts-clicked(); }
                            }
                            if row.kind == 19: Button {
                                text: row.text;
                                clicked => { root.gallery-source-clicked(); }
                            }
                            if row.kind == 18: Button {
                                text: row.text;
                                clicked => {root.import-options-clicked();}
                            }
                            if row.kind == 14: Button {
                                text: row.text;
                                enabled: !root.regex-child-open && !root.shortcuts-child-open && !root.routing-child-open;
                                clicked => { root.regex-favourites-clicked(); }
                            }
                            if row.kind == 13: HorizontalLayout {
                                width: 260px;
                                Button {
                                    text: row.text;
                                    clicked => { root.checker-clicked(i); }
                                }
                            }
                            if row.kind == 5 || row.kind == 15: ComboBox {
                                enabled: row.enabled;
                                width: 260px;
                                model: row.items;
                                current-index: row.index;
                                selected => { root.choice-chosen(i, self.current-index); }
                            }
                            if row.kind == 10: VerticalLayout {
                                width: 260px;
                                spacing: 2px;
                                ComboBox {
                                    model: row.items;
                                    current-index: row.index;
                                    selected => { root.sort-chosen(i, self.current-index); }
                                }
                                ComboBox {
                                    model: row.orders;
                                    current-index: row.order-index;
                                    selected => { root.order-chosen(i, self.current-index); }
                                }
                                if row.sort-cog: Rectangle {
                                    height: 28px;
                                    Button { text: "⚙"; clicked => { root.sort-cog-open(i); cog-menu.show(); } }
                                    cog-menu := PopupWindow {
                                        y: parent.height;
                                        width: 320px;
                                        Rectangle {
                                            background: Theme.panel;
                                            border-width: 1px;
                                            border-color: Theme.border;
                                            FocusScope {
                                                init => { self.focus(); }
                                                key-pressed(event) => {
                                                    if event.text == Key.Escape { cog-menu.close(); root.sort-cog-cancel(); return accept; }
                                                    reject
                                                }
                                                VerticalLayout {
                                                    padding: 4px;
                                                    spacing: 2px;
                                                    if root.sort-cog-group < 0: VerticalLayout {
                                                        for name[group] in root.sort-cog-groups: Button {
                                                            text: name + "  ›";
                                                            clicked => { root.sort-cog-group-chosen(i, group); }
                                                        }
                                                    }
                                                    if root.sort-cog-group >= 0: VerticalLayout {
                                                        for entry[index] in root.sort-cog-items: Rectangle {
                                                            height: entry.separator ? 3px : 28px;
                                                            if entry.separator: Rectangle { height: 1px; background: Theme.border; }
                                                            if !entry.separator: Button {
                                                                text: (entry.checked ? "✓ " : "") + entry.label;
                                                                clicked => { cog-menu.close(); root.sort-cog-choice(i, index); }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            if row.kind == 12: VerticalLayout {
                                width: 260px;
                                spacing: 2px;
                                ComboBox {
                                    model: row.items;
                                    current-index: row.index;
                                    selected => { root.tag-sort-chosen(i, 0, self.current-index); }
                                }
                                ComboBox {
                                    model: row.orders;
                                    current-index: row.order-index;
                                    selected => { root.tag-sort-chosen(i, 1, self.current-index); }
                                }
                                if row.grouped: ComboBox {
                                    model: row.groups;
                                    current-index: row.group-index;
                                    selected => { root.tag-sort-chosen(i, 2, self.current-index); }
                                }
                            }
                            if row.kind == 11: VerticalLayout {
                                width: 260px;
                                spacing: 2px;
                                HorizontalLayout {
                                    Text { text: row.text; vertical-alignment: center; min-height: 26px; horizontal-stretch:1; }
                                    SortCollectCog {
                                        collect: true;
                                        services:root.collect-cog-services; extra:root.collect-cog-extra;
                                        opened => {root.collect-cog-opened(i);}
                                        chosen(id) => {root.collect-cog-chosen(i,id);}
                                    }
                                }
                                for name[c] in row.items: CheckBox {
                                    text: name;
                                    checked: row.checks[c];
                                    toggled => { root.collect-toggled(i, c, self.checked); }
                                }
                                Text {
                                    text: "unmatched files:";
                                    vertical-alignment: center;
                                    min-height: 26px;
                                }
                                ComboBox {
                                    model: row.orders;
                                    current-index: row.order-index;
                                    selected => { root.unmatched-chosen(i, self.current-index); }
                                }
                            }
                          }
                            if row.kind == 34: OpenExternallyTable {
                                urls:root.routing-url-rows;files:root.routing-file-rows;url-selected:root.routing-url-selected;file-single:root.routing-file-single;file-delete:root.routing-file-delete;child-open:root.routing-child-open;error:root.routing-error;
                                url-clicked(i,c,s)=>{root.routing-url-clicked(i,c,s);}url-activated(i)=>{root.routing-url-activated(i);}url-action(a)=>{root.routing-url-action(a);}
                                file-clicked(i,c,s)=>{root.routing-file-clicked(i,c,s);}file-activated(i)=>{root.routing-file-activated(i);}file-action(a)=>{root.routing-file-action(a);}
                            }
                            if row.kind == 30: ExternalCallsTable {
                                error:root.external-call-error;rows:root.external-call-rows;selected:root.external-call-selected;single:root.external-call-single;child-open:root.external-call-child-open;sort-column:root.external-call-sort-column;ascending:root.external-call-ascending;
                                clicked(i,c,s)=>{root.external-call-clicked(i,c,s);}activated(i)=>{root.external-call-activated(i);}sort(i,a)=>{root.external-call-sort(i,a);}action(a)=>{root.external-call-action(a);}
                            }
                            if row.kind == 26: FrameLocationsTable {
                                rows:root.frame-rows;
                                selected:root.frame-selected;
                                single:root.frame-single;
                                child-open:root.frame-child-open;
                                sort-column:root.frame-sort-column;
                                ascending:root.frame-ascending;
                                clicked(i,c,s)=>{root.frame-clicked(i,c,s);}
                                activated(i)=>{root.frame-activated(i);}
                                sort(i,a)=>{root.frame-sort(i,a);}
                                action(a)=>{root.frame-action(a);}
                            }
                            if row.kind == 31: NamespaceColourList {
                                rows:root.namespace-colour-rows;
                                enabled:row.enabled;
                                child-open:root.namespace-colour-child-open;
                                error:root.namespace-colour-error;
                                clicked(index,ctrl,shift)=>{root.namespace-colour-clicked(index,ctrl,shift);}
                                action(action)=>{root.namespace-colour-action(action);}
                            }
                            if row.kind == 25: DeletionReasonQueue {
                                rows:root.reason-rows;
                                enabled:row.enabled;
                                selected:root.reason-selected;
                                child-open:root.reason-child-open;
                                row-clicked(index,ctrl,shift)=>{root.reason-clicked(index,ctrl,shift);}
                                row-activated(index)=>{root.reason-activated(index);}
                                action(action)=>{root.reason-action(action);}
                            }
                            if row.kind == 23: VerticalLayout {
                                width:260px;
                                for label[c] in row.items: CheckBox {
                                    text:label;
                                    checked:row.checks[c];
                                    toggled=>{root.canvas-toggled(i,c,self.checked);}
                                }
                            }
                            if row.kind == 22: PaletteProviderQueue {
                                rows:root.provider-rows;
                                missing:root.provider-missing;
                                has-selection:root.provider-has-selection;
                                mode:root.provider-mode;
                                message:root.provider-message;
                                row-clicked(i,ctrl,shift)=>{root.provider-clicked(i,ctrl,shift);}
                                action(action)=>{root.provider-action(action);}
                                chosen(i)=>{root.provider-chosen(i);}
                                answer(yes)=>{root.provider-answer(yes);}
                            }
                            // (a time or a rate: its fields under its label)
                            if row.kind == 24: HorizontalLayout {
                                spacing:6px;
                                TimeFields {
                                    fields:row.fields;
                                    enabled:!duration-none.checked;
                                    edited(f,n)=>{root.field-edited(i,f,n);}
                                }
                                duration-none:=CheckBox {
                                    text:row.none-phrase;
                                    checked:row.is-none;
                                    toggled=>{root.none-toggled(i,self.checked);}
                                }
                            }
                            if row.kind == 8: HorizontalLayout {
                                padding-left: 16px;
                                alignment: start;
                                TimeFields {
                                    fields: row.fields;
                                    edited(f, value) => { root.field-edited(i, f, value); }
                                }
                            }
                            if row.kind == 9: HorizontalLayout {
                                padding-left: 16px;
                                spacing: 6px;
                                alignment: start;
                                NumberField {
                                    number: row.number;
                                    number-edited(n) => { root.number-edited(i, n); }
                                }
                                Text {
                                    text: row.per;
                                    vertical-alignment: center;
                                }
                                TimeFields {
                                    fields: row.fields;
                                    edited(f, value) => { root.field-edited(i, f, value); }
                                }
                            }
                        }
                    }
                }
            }
            bottom-search-slot := Rectangle {
                height: root.search-at-top ? 0px : 30px;
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: end;
                Button {
                    text: "apply";
                    enabled: !root.regex-child-open && !root.shortcuts-child-open && !root.routing-child-open;
                    clicked => { root.apply(); }
                }
                Button {
                    text: "cancel";
                    clicked => { root.cancel(); }
                }
            }
        }
        search := LineEdit {
            enabled: !root.shortcuts-child-open && !root.routing-child-open && !root.regex-child-open;
            x: 8px;
            y: root.search-at-top ? top-search-slot.y : bottom-search-slot.y;
            width: parent.width - 16px;
            height: 30px;
            placeholder-text: root.search-placeholder;
            text <=> root.search-text;
            edited(text) => { root.search-edited(text); }
        }
        if root.matches.length > 0: Rectangle {
            x: search.x;
            y: root.search-at-top ? search.y + search.height + 2px : search.y - self.height - 2px;
            width: search.width;
            height: min(root.matches.length, root.shown) * 24px + 4px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            suggestions := ListView {
                x: 2px;
                y: 2px;
                width: parent.width - 4px;
                height: parent.height - 4px;
                // (the arrows' pick kept in view)
                property <int> picked: root.match-highlighted;
                changed picked => {
                    if (self.picked >= 0) {
                        let top = self.picked * 24px;
                        if (top < -self.content-y) {
                            self.content-y = -top;
                        } else if (top + 24px > -self.content-y + self.visible-height) {
                            self.content-y = -(top + 24px - self.visible-height);
                        }
                    }
                }
                for text[i] in root.matches: Rectangle {
                    height: 24px;
                    background: i == root.match-highlighted ? Theme.highlight
                        : pick.has-hover ? Theme.hover : transparent;
                    Text {
                        x: 4px;
                        width: parent.width - 8px;
                        text: text;
                        color: i == root.match-highlighted ? Theme.highlight-text : Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    pick := TouchArea {
                        clicked => { root.search-chosen(i); }
                    }
                }
            }
        }
    }
}
