import { Btn } from "btn.slint";
// Importers' boxes, as the reference's downloader pages show them: a
// download in progress (its network job control), and an importer's
// "imports" and "search" boxes (a URL page's, a gallery page's highlighted
// query's).

import { Button, ProgressIndicator, ScrollView, VerticalBox } from "std-widgets.slint";
import { MenuRow } from "menus.slint";
import { Theme } from "theme.slint";

// a download in progress, under an importer's log (the reference's
// network job control): its status, its size and speed, its gauge, and
// whether it can be cancelled
export struct DownloadLine {
    left: string,
    right: string,
    fraction: float,
    can-cancel: bool,
}

export struct JobCogMenu {
    url: string,
    rules: [MenuRow],
    actions: [MenuRow],
    auto-override: bool,
    has-error: bool,
}

// Error clearing belongs to the owner, never to this visible menu.
export component NetworkErrorWindow inherits Window {
    title: "Network Error";
    width: 660px;
    height: 370px;
    background: Theme.window;
    in property <string> error-text;
    callback close-clicked();
    VerticalBox {
        ScrollView {
            vertical-stretch: 1;
            Text { text: root.error-text; wrap: word-wrap; color: Theme.text; }
        }
        Btn { text: "close"; clicked => { root.close-clicked(); } }
    }
}

export component DownloadControl inherits Rectangle {
    in property <DownloadLine> line;
    in property <JobCogMenu> cog;
    in property <bool> advanced;
    callback action(int);
    callback open-menu();
    callback cancel();
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: 4px;
        spacing: 2px;
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: root.line.left;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if root.line.right != "": Text {
                text: root.line.right;
                horizontal-alignment: right;
            }
        }
        HorizontalLayout {
            spacing: 4px;
            ProgressIndicator {
                horizontal-stretch: 1;
                progress: root.line.fraction;
            }
            // (the reference's stop icon)
            Button {
                icon: @image-url("../../../static/stop.png");
                enabled: root.line.can-cancel;
                clicked => { root.cancel(); }
            }

            if root.advanced && root.cog.has-error: error-menu := ContextMenuArea {
                width: 30px;
                Menu {
                    MenuItem { title: "show error"; activated => { root.action(8); } }
                    MenuItem { title: "copy error"; activated => { root.action(9); } }
                }
                Button {
                    width: 30px;
                    icon: @image-url("../../../static/dump_fail.png");
                    clicked => { root.open-menu(); error-menu.show({ x: 0px, y: self.height }); }
                }
            }
            if root.advanced: cog-menu := ContextMenuArea {
                width: 30px;
                Menu {
                    if root.cog.url != "": MenuItem { title: root.cog.url; activated => { root.action(1); } }
                    if root.cog.url != "": MenuSeparator {}
                    if root.cog.rules.length > 0: Menu {
                        title: "edit bandwidth rules";
                        for item in root.cog.rules: MenuItem { title: item.label; activated => { root.action(item.id); } }
                    }
                    if root.cog.rules.length > 0: MenuSeparator {}
                    for item in root.cog.actions: MenuItem { title: item.label; activated => { root.action(item.id); } }
                    if root.cog.url != "": MenuSeparator {}
                    MenuItem {
                        title: "auto-override bandwidth rules for all jobs here after five seconds";
                        checkable: true;
                        checked: root.cog.auto-override;
                        activated => { root.action(7); }
                    }
                }
                Btn {
                    width: 30px;
                    text: "⚙";
                    clicked => { root.open-menu(); cog-menu.show({ x: 0px, y: self.height }); }
                }
            }
        }
    }
}

// an importer's "imports" box and "search" box: the file log's status and
// progress, the search log's, their downloads, and pausing; a gallery
// query's (`status-lines`) also have their live status lines, beside their
// pause buttons, and a search pause
export component ImporterBoxes inherits VerticalLayout {
    in property <bool> status-lines;
    in property <string> files-line;
    in property <string> import-status;
    in property <string> import-progress;
    in property <float> import-fraction;
    in property <bool> import-paused;
    in property <DownloadLine> file-download;
    in property <string> search-line;
    in property <bool> search-paused;
    in property <string> search-status;
    in property <DownloadLine> search-download;
    callback pause-play-files();
    callback pause-play-search();
    in property <JobCogMenu> file-cog;
    in property <JobCogMenu> search-cog;
    callback control-action(bool, int);
    callback control-menu(bool);
    callback cancel-download(bool);
    // the file log button (`FileSeedCacheButton`)
    callback file-log();
    // the search log button (`GallerySeedLogButton`)
    callback search-log();
    spacing: 6px;
    Rectangle {
        border-width: 1px;
        border-color: Theme.border;
        VerticalLayout {
            padding: 6px;
            spacing: 4px;
            if root.status-lines: Text {
                text: "imports";
                font-weight: 600;
            }
            HorizontalLayout {
                spacing: 4px;
                Text {
                    text: root.status-lines ? root.files-line : "imports";
                    font-weight: root.status-lines ? 400 : 600;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                // the reference's own file_pause/file_play icons: play while
                // paused
                Button {
                    icon: root.import-paused ? @image-url("../../../static/file_play.png") : @image-url("../../../static/file_pause.png");
                    clicked => { root.pause-play-files(); }
                }
            }
            HorizontalLayout {
                spacing: 4px;
                Text {
                    text: root.import-status;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Btn {
                    text: "file log";
                    clicked => { root.file-log(); }
                }
            }
            if root.import-progress != "": Text {
                text: root.import-progress;
            }
            ProgressIndicator {
                progress: root.import-fraction;
            }
            DownloadControl {
                line: root.file-download;
                advanced: true;
                cog: root.file-cog;
                action(id) => { root.control-action(false, id); }
                open-menu => { root.control-menu(false); }
                cancel => { root.cancel-download(false); }
            }
        }
    }
    Rectangle {
        border-width: 1px;
        border-color: Theme.border;
        VerticalLayout {
            padding: 6px;
            spacing: 4px;
            HorizontalLayout {
                spacing: 4px;
                Text {
                    text: "search";
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Btn {
                    text: "search log";
                    clicked => { root.search-log(); }
                }
            }
            // (gallery_pause/gallery_play)
            if root.status-lines: HorizontalLayout {
                spacing: 4px;
                Text {
                    text: root.search-line;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Button {
                    icon: root.search-paused ? @image-url("../../../static/gallery_play.png") : @image-url("../../../static/gallery_pause.png");
                    clicked => { root.pause-play-search(); }
                }
            }
            if root.search-status != "": Text {
                text: root.search-status;
                wrap: word-wrap;
            }
            DownloadControl {
                line: root.search-download;
                advanced: true;
                cog: root.search-cog;
                action(id) => { root.control-action(true, id); }
                open-menu => { root.control-menu(true); }
                cancel => { root.cancel-download(true); }
            }
        }
    }
}

// a local import page's "imports" box (the reference's `SidebarImporterHDD`):
// what it is doing and its pause button, then its file log's status and
// progress
export component LocalImportBox inherits Rectangle {
    in property <string> current-action;
    in property <string> import-status;
    in property <string> import-progress;
    in property <float> import-fraction;
    in property <bool> import-paused;
    callback pause-play-files();
    callback file-log();
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: 6px;
        spacing: 4px;
        Text {
            text: "imports";
            font-weight: 600;
        }
        HorizontalLayout {
            spacing: 4px;
            Text {
                text: root.current-action;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            // ("pause/play imports": file_pause, or file_play while paused)
            Button {
                icon: root.import-paused ? @image-url("../../../static/file_play.png") : @image-url("../../../static/file_pause.png");
                clicked => { root.pause-play-files(); }
            }
        }
        HorizontalLayout {
            spacing: 4px;
            Text {
                text: root.import-status;
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Btn {
                text: "file log";
                clicked => { root.file-log(); }
            }
        }
        if root.import-progress != "": Text {
            text: root.import-progress;
        }
        ProgressIndicator {
            progress: root.import-fraction;
        }
    }
}
