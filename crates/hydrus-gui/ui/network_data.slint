import { Btn } from "btn.slint";
import { Button, CheckBox, ComboBox, LineEdit, ScrollView, VerticalBox } from "std-widgets.slint";
import { ListTable, TableColumn, TableRow } from "list_table.slint";
import { DownloadControl, DownloadLine, JobCogMenu } from "importing.slint";
import { Theme } from "theme.slint";

export struct MonthlyBandwidthBar { month: string, usage: string, fraction: float }
export component BandwidthWindow inherits Window {
    title: "review bandwidth usage and edit rules";
    width: 1120px;
    height: 720px;
    background: Theme.window;
    in property <[TableColumn]> columns;
    in property <[TableRow]> rows;
    in-out property <int> sort-column: -1;
    in-out property <bool> ascending: true;
    in property <string> status;
    in property <string> detail;
    in property <bool> can-edit;
    in property <bool> can-revert;
    in property <bool> busy;
    in-out property <int> default-kind: 0;
    in-out property <int> history: 0;
    in-out property <string> domain;
    in-out property <string> history-seconds: "604800";
    in-out property <bool> show-all;
    in-out property <bool> include-rules;
    in property <bool> can-delete;
    in property <[MonthlyBandwidthBar]> monthly-bars;
    in property <string> chart-context;
    in-out property <string> question;
    callback row-clicked(int, bool, bool);
    callback sort(int, bool);
    callback edit-clicked();
    callback delete-history-clicked();
    callback revert-clicked();
    callback default-clicked();
    callback domain-clicked();
    callback reset-clicked();
    callback answer(bool);
    callback refresh();
    callback close-clicked();
    VerticalBox {
        Text { text: "Every context normally relies on the default bandwidth rules for its type. Select a row to review or override its rules."; wrap: word-wrap; color: Theme.text; }
        HorizontalLayout {
            Text { text: "History:"; color: Theme.text; vertical-alignment: center; }
            ComboBox { model: ["past 7 days", "past day", "this month", "all time", "custom seconds"]; enabled: !root.show-all; current-index <=> root.history; selected(_) => { root.refresh(); } }
            if root.history == 4: LineEdit { text <=> root.history-seconds; enabled: !root.show-all; edited => { root.refresh(); } }
            CheckBox { text: "show all"; checked <=> root.show-all; toggled => { root.refresh(); } }
            CheckBox { text: "show anything with specific bandwidth rules"; enabled: !root.show-all && root.history != 3; checked <=> root.include-rules; toggled => { root.refresh(); } }
            Btn { text: "refresh snapshot"; clicked => { root.refresh(); } }
        }
        ListTable { columns: root.columns; rows: root.rows; sort-column: root.sort-column; ascending: root.ascending; vertical-stretch: 1;
            row-clicked(r,c,s) => { root.row-clicked(r,c,s); }
            row-activated(_) => { root.edit-clicked(); }
            sort(c,a) => { root.sort(c,a); }
        }
        Text { text: root.detail; wrap: word-wrap; color: Theme.text; min-height: 70px; }
        if root.chart-context != "": VerticalBox {
            Text { text: "Monthly bandwidth history (UTC) — " + root.chart-context; color: Theme.text; }
            if root.monthly-bars.length == 0: Text { text: "No usage yet, so no usage history to show."; color: Theme.text; }
            if root.monthly-bars.length > 0: ScrollView {
                height: 180px;
                HorizontalLayout { spacing: 8px;
                    for bar in root.monthly-bars: VerticalLayout {
                        width: 94px;
                        Text { text: bar.usage; color: Theme.text; horizontal-alignment: center; }
                        Rectangle { height: 125px;
                            Rectangle { background: #508bd7; x: 16px; width: 62px; height: bar.fraction * parent.height; y: parent.height - self.height; }
                        }
                        Text { text: bar.month; color: Theme.text; horizontal-alignment: center; }
                    }
                }
            }
        }
        HorizontalLayout {
            Btn { text: "delete selected history"; enabled: root.can-delete && !root.busy && root.question == ""; clicked => { root.delete-history-clicked(); } }
            Btn { text: "edit rules"; enabled: root.can-edit && !root.busy; clicked => { root.edit-clicked(); } }
            Btn { text: "use default rules"; enabled: root.can-revert && !root.busy; clicked => { root.revert-clicked(); } }
            Rectangle { horizontal-stretch: 1; }
            ComboBox { model: ["global", "web domain", "hydrus service", "downloader page", "subscription", "watcher page"]; current-index <=> root.default-kind; }
            Btn { text: "edit default bandwidth rules"; enabled: !root.busy; clicked => { root.default-clicked(); } }
        }
        HorizontalLayout {
            LineEdit { text <=> root.domain; placeholder-text: "domain (for example example.com)"; horizontal-stretch: 1; }
            Btn { text: "set domain rules"; enabled: !root.busy; clicked => { root.domain-clicked(); } }
            Btn { text: "reset default bandwidth rules"; enabled: !root.busy; clicked => { root.reset-clicked(); } }
        }
        if root.question != "": HorizontalLayout {
            Text { text: root.question; wrap: word-wrap; color: Theme.text; horizontal-stretch: 1; }
            Btn { text: "yes"; clicked => { root.answer(true); } }
            Btn { text: "no"; clicked => { root.answer(false); } }
        }
        HorizontalLayout {
            Text { text: root.status; color: Theme.text; horizontal-stretch: 1; wrap: word-wrap; }
            Btn { text: "close"; clicked => { root.close-clicked(); } }
        }
    }
}

export component EditBandwidthRulesWindow inherits Window {
    in property <string> window-title;
    title: root.window-title;
    width: 670px;
    height: 460px;
    background: Theme.window;
    in property <[TableColumn]> columns;
    in property <[TableRow]> rows;
    in property <bool> busy;
    in-out property <bool> requests;
    in-out property <bool> monthly;
    in-out property <string> amount: "104857600";
    in-out property <string> seconds: "86400";
    in property <string> error;
    callback row-clicked(int, bool, bool);
    callback add-rule();
    callback replace-rule();
    callback delete-rule();
    callback apply-clicked();
    callback cancel-clicked();
    VerticalBox {
        Text { text: "bandwidth rules"; color: Theme.text; font-weight: 700; }
        ListTable { columns: root.columns; rows: root.rows; vertical-stretch: 1;
            row-clicked(r,c,s) => { root.row-clicked(r,c,s); }
            delete-pressed => { root.delete-rule(); }
        }
        HorizontalLayout {
            spacing: 8px;
            CheckBox { text: "requests (otherwise bytes)"; checked <=> root.requests; }
            LineEdit { text <=> root.amount; placeholder-text: "maximum allowed"; horizontal-stretch: 1; }
        }
        HorizontalLayout {
            spacing: 8px;
            CheckBox { text: "monthly"; checked <=> root.monthly; }
            Text { text: "every (seconds):"; color: Theme.text; vertical-alignment: center; }
            LineEdit { text <=> root.seconds; enabled: !root.monthly; horizontal-stretch: 1; }
        }
        HorizontalLayout {
            Btn { text: "add"; enabled: !root.busy; clicked => { root.add-rule(); } }
            Btn { text: "replace selected"; enabled: !root.busy; clicked => { root.replace-rule(); } }
            Btn { text: "delete selected"; enabled: !root.busy; clicked => { root.delete-rule(); } }
        }
        Text { text: root.error; wrap: word-wrap; color: Theme.text; }
        HorizontalLayout {
            Rectangle { horizontal-stretch: 1; }
            Btn { text: "apply"; enabled: !root.busy; clicked => { root.apply-clicked(); } }
            Btn { text: "cancel"; enabled: !root.busy; clicked => { root.cancel-clicked(); } }
        }
    }
}

export component NetworkJobsWindow inherits Window {
    title: "review current network jobs";
    width: 1100px;
    height: 590px;
    background: Theme.window;
    in property <[TableColumn]> columns;
    in property <[TableRow]> rows;
    in-out property <int> sort-column: -1;
    in-out property <bool> ascending: true;
    in-out property <bool> auto-refresh: true;
    in property <string> detail;
    in property <string> status;
    in property <bool> can-act;
    in property <DownloadLine> download;
    in property <JobCogMenu> cog;
    callback control-menu();
    callback control-action(int);
    callback row-clicked(int, bool, bool);
    callback sort(int, bool);
    callback refresh();
    callback cancel-jobs();
    callback override-jobs();
    callback close-clicked();
    VerticalBox {
        Text { text: "Current requests, including subscription and downloader work. Select jobs to see network contexts or cancel them."; wrap: word-wrap; color: Theme.text; }
        ListTable { columns: root.columns; rows: root.rows; sort-column: root.sort-column; ascending: root.ascending; vertical-stretch: 1;
            row-clicked(r,c,s) => { root.row-clicked(r,c,s); }
            sort(c,a) => { root.sort(c,a); }
        }
        DownloadControl {
            line: root.download;
            advanced: true;
            cog: root.cog;
            open-menu => { root.control-menu(); }
            action(id) => { root.control-action(id); }
            cancel => { root.cancel-jobs(); }
        }
        Text { text: root.detail; wrap: word-wrap; color: Theme.text; min-height: 75px; }
        HorizontalLayout {
            spacing: 8px;
            Btn { text: "refresh snapshot"; clicked => { root.refresh(); } }
            CheckBox { text: "auto-refresh"; checked <=> root.auto-refresh; }
            Btn { text: "cancel selected"; enabled: root.can-act; clicked => { root.cancel-jobs(); } }
            Btn { text: "override bandwidth"; enabled: root.can-act; clicked => { root.override-jobs(); } }
            Rectangle { horizontal-stretch: 1; }
            Btn { text: "close"; clicked => { root.close-clicked(); } }
        }
        Text { text: root.status; wrap: word-wrap; color: Theme.text; }
    }
}
