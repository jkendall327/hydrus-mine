// The quick tag entry dialog an interactive tag shortcut opens (the
// reference's `EnterText` with suggestions): a message, a button per recent
// tag (a press applies it), a line holding the newest one (selected), and
// apply/cancel. A blank or whitespace line is refused with a message. Driven
// by `src/quick_tag_entry.rs`.
import { Btn } from "btn.slint";
import { LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";

export component QuickTagEntryWindow inherits Window {
    in property <string> title-suffix: "";
    // the title as composed, for tests and the platform
    out property <string> composed-title: root.title;
    title: "Enter Text" + root.title-suffix;
    preferred-width: 560px;
    background: Theme.window;
    in property <string> message;
    in property <[string]> suggestions;
    in-out property <string> text;
    in-out property <bool> selected-all;
    in property <string> refusal;
    callback chosen(int);
    callback applied(string);
    callback cancelled();
    public function select-entry() {
        entry.focus();
        entry.select-all();
        root.selected-all = true;
    }
    forward-focus: entry;

    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancelled(); return accept; }
            reject
        }
        VerticalLayout {
            padding: 10px;
            spacing: 6px;
            Text {
                text: root.message;
                wrap: word-wrap;
                color: Theme.text;
            }
            for suggestion[i] in root.suggestions: Btn {
                text: suggestion;
                clicked => { root.chosen(i); }
            }
            entry := LineEdit {
                text <=> root.text;
                edited => { root.selected-all = false; }
                accepted => { root.applied(root.text); }
            }
            if root.refusal != "": Text {
                text: root.refusal;
                color: #b00020;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 6px;
                Rectangle { horizontal-stretch: 1; }
                Btn { text: "apply"; primary: true; clicked => { root.applied(root.text); } }
                Btn { text: "cancel"; clicked => { root.cancelled(); } }
            }
        }
    }
}
