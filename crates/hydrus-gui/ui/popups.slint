// Popup messages (`src/popups.rs`), as the reference's popup message
// manager shows them at the main window's bottom right: each popup's
// title, texts, gauges, download and buttons, and under them how many
// there are,
// "dismiss all", and an arrow to hide or show them.

import { Button, ProgressIndicator } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { DownloadControl, DownloadLine } from "importing.slint";

export struct PopupData {
    width-characters: int,
    fixed-width: bool,
    key: string,
    gui-owner: string,
    action-owner: string,
    question-token: string,
    has-question: bool,
    question: string,
    has-clipboard: bool,
    clipboard: string,
    has-callable: bool,
    callable: string,
    title: string,
    text-1: string,
    // a gauge: shown, how far, or going with no end known
    has-gauge-1: bool,
    gauge-1: float,
    gauge-1-going: bool,
    text-2: string,
    has-gauge-2: bool,
    gauge-2: float,
    gauge-2-going: bool,
    // the download it is doing, if any
    has-download: bool,
    download: DownloadLine,
    // "{label} - show 3 files", if it has files
    files: string,
    traceback: string,
    pausable: bool,
    paused: bool,
    cancellable: bool,
}

export struct PopupBounds { x: length, y: length, width: length, height: length }

// Observe the actual laid-out button, including its bottom edge. Width alone
// cannot establish that a wrapped card contains every interactive control.
component PopupButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    callback clicked();
    callback measured(PopupBounds);
    min-width: button.min-width;
    min-height: button.min-height;
    preferred-width: button.preferred-width;
    preferred-height: button.preferred-height;
    horizontal-stretch: button.horizontal-stretch;
    vertical-stretch: button.vertical-stretch;
    forward-focus: button;
    button := Button { width: parent.width; height: parent.height; text: root.text; icon: root.icon; clicked => { root.clicked(); } }
    property <PopupBounds> frame: {x:button.absolute-position.x,y:button.absolute-position.y,width:button.width,height:button.height};
    property <bool> measurement-pending: true;
    changed frame => { self.measurement-pending = true; }
    Timer {
        interval: 1ms;
        running: root.measurement-pending;
        triggered => { root.measurement-pending = false; root.measured(root.frame); }
    }
}

component Gauge inherits ProgressIndicator {
    in property <bool> going;
    indeterminate: self.going;
}

export component PopupStack inherits Rectangle {
    in property <[PopupData]> popups;
    in property <string> summary;
    in-out property <bool> expanded: true;
    // (each by its place among those shown)
    callback dismiss(int);
    callback pause-play(int);
    callback cancel(int);
    callback show-files(int);
    callback copy-traceback(int);
    callback copy-payload(string,string,string);
    callback call(string,string,string);
    callback answer(string,string,string,string,bool);
    callback dismiss-all();
    callback card-measured(int,string,string,length,length);
    callback control-measured(int,string,string,string,PopupBounds,PopupBounds);
    // Bold title font, as Qt's character-width conversion. Slint exposes text
    // measurement rather than Qt's averageCharWidth; approximate its padded
    // average using the same character sample, with native font metrics.
    character-sample := Text {
        visible: false;
        text: "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
        font-weight: 700;
    }
    property <length> character-width: character-sample.preferred-width / 62 * 1.1;
    width: layout.preferred-width;
    height: layout.preferred-height;
    background: Theme.window;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 6px;
    drop-shadow-color: #00000040;
    layout := VerticalLayout {
        padding: 4px;
        spacing: 4px;
        if root.expanded: VerticalLayout {
            spacing: 4px;
            for popup[i] in root.popups: card := Rectangle {
                clip: true;
                // An ancestor's preferred-width height query can be wider than
                // this capped card. Measure the actual body after its width is
                // resolved, then carry that owned height through the outer stack.
                property <length> content-height: body.preferred-height;
                height: self.content-height;
                property <PopupBounds> bounds: {x:self.absolute-position.x,y:self.absolute-position.y,width:self.width,height:self.height};
                property <length> cap: round(popup.width-characters * root.character-width / 1px) * 1px;
                property <{index:int,key:string,owner:string,w:length,cap:length}> frame: {index:i,key:popup.key,owner:popup.gui-owner,w:self.width,cap:self.cap};
                // Repeated cards may begin with their final layout, without a
                // changed notification. Report that first frame and carry the
                // job identity when a surviving card moves to another row.
                property <bool> measurement-pending: true;
                changed frame => { card.measurement-pending = true; }
                Timer {
                    interval: 1ms;
                    running: card.measurement-pending;
                    triggered => {
                        card.measurement-pending = false;
                        root.card-measured(card.frame.index,card.frame.key,card.frame.owner,card.frame.w,card.frame.cap);
                    }
                }
                max-width: self.cap;
                min-width: popup.fixed-width ? self.cap : (popup.has-gauge-1 || popup.has-gauge-2 ? self.cap * 0.9 + 4px : 0px);
                preferred-width: popup.fixed-width ? self.cap : min(self.cap,body.preferred-width);
                horizontal-stretch: 0;
                border-width: 1px;
                border-color: Theme.border;
                property <bool> traceback-shown: false;
                // a right click dismisses it, if it is done
                TouchArea {
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                            root.dismiss(i);
                        }
                    }
                }
                body := VerticalLayout {
                    padding: 2px;
                    spacing: 2px;
                    if popup.title != "": Text {
                        max-width: card.cap - 4px;
                        text: popup.title;
                        font-weight: 700;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    if popup.text-1 != "": Text {
                        max-width: card.cap - 4px;
                        text: popup.text-1;
                        wrap: word-wrap;
                    }
                    if popup.has-gauge-1: Gauge {
                        progress: popup.gauge-1;
                        going: popup.gauge-1-going;
                    }
                    if popup.text-2 != "": Text {
                        max-width: card.cap - 4px;
                        text: popup.text-2;
                        wrap: word-wrap;
                    }
                    if popup.has-gauge-2: Gauge {
                        progress: popup.gauge-2;
                        going: popup.gauge-2-going;
                    }
                    // Keep question text in the card's own vertical layout,
                    // as Qt does, so its intrinsic height uses its rendered width.
                    if popup.has-question: Text {
                        max-width: card.cap - 4px;
                        text: popup.question;
                        wrap: word-wrap;
                    }
                    if popup.has-question: HorizontalLayout {
                        PopupButton { text: "yes"; measured(b) => { root.control-measured(i,popup.key,popup.gui-owner,"yes",b,card.bounds); } clicked => { root.answer(popup.key,popup.action-owner,popup.question-token,popup.gui-owner,true); } }
                        PopupButton { text: "no"; measured(b) => { root.control-measured(i,popup.key,popup.gui-owner,"no",b,card.bounds); } clicked => { root.answer(popup.key,popup.action-owner,popup.question-token,popup.gui-owner,false); } }
                    }
                    if popup.has-download: DownloadControl {
                        line: popup.download;
                    }
                    if popup.has-clipboard: PopupButton { measured(b) => { root.control-measured(i,popup.key,popup.gui-owner,"clipboard",b,card.bounds); } text: popup.clipboard; clicked => { root.copy-payload(popup.key,popup.action-owner,popup.gui-owner); } }
                    if popup.files != "": Button {
                        text: popup.files;
                        clicked => { root.show-files(i); }
                    }
                    if popup.has-callable: PopupButton { measured(b) => { root.control-measured(i,popup.key,popup.gui-owner,"callable",b,card.bounds); } text: popup.callable; clicked => { root.call(popup.key,popup.action-owner,popup.gui-owner); } }
                    if popup.traceback != "": Button {
                        text: card.traceback-shown ? "hide traceback" : "show traceback";
                        clicked => { card.traceback-shown = !card.traceback-shown; }
                    }
                    if popup.traceback != "" && card.traceback-shown: Text {
                        max-width: card.cap - 4px;
                        text: popup.traceback;
                        wrap: word-wrap;
                    }
                    if popup.traceback != "": Button {
                        text: "copy traceback information";
                        clicked => { root.copy-traceback(i); }
                    }
                    if popup.pausable || popup.cancellable: HorizontalLayout {
                        alignment: end;
                        spacing: 2px;
                        if popup.pausable: Button {
                            icon: popup.paused ? @image-url("../../../static/play.png") : @image-url("../../../static/pause.png");
                            clicked => { root.pause-play(i); }
                        }
                        if popup.cancellable: PopupButton {
                            measured(b) => { root.control-measured(i,popup.key,popup.gui-owner,"cancel",b,card.bounds); }
                            icon: @image-url("../../../static/stop.png");
                            clicked => { root.cancel(i); }
                        }
                    }
                }
            }
        }
        // the summary bar
        Rectangle {
            border-width: 1px;
            border-color: Theme.border;
            HorizontalLayout {
                padding: 2px;
                spacing: 4px;
                Text {
                    text: root.summary;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Button {
                    text: "dismiss all";
                    clicked => { root.dismiss-all(); }
                }
                Button {
                    text: root.expanded ? "▾" : "▴";
                    clicked => { root.expanded = !root.expanded; }
                }
            }
        }
    }
}
