import { Btn } from "btn.slint";
import { Button, ComboBox, LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
export struct LoginCredentialRow { name: string, value: string, hidden: bool, label: string, valid: bool }
export component LoginCredentialDefinitionWindow inherits Window {
    in property <string> title-suffix: "";
    // the title as composed, for tests and the platform
    out property <string> composed-title: root.title;
    title: ("edit login credential definition") + root.title-suffix;
    preferred-width: 620px;
    preferred-height: 240px;
    background: Theme.window;
    in-out property <string> name;
    in-out property <int> kind;
    in property <string> matcher;
    in property <bool> child-open;
    in property <string> error;
    callback action(string);
    callback closed();
    VerticalLayout {
        padding: 12px; spacing: 8px;
        HorizontalLayout { Text { text: "name: "; color: Theme.text; vertical-alignment: center; } LineEdit { text <=> root.name; enabled: !root.child-open; } }
        HorizontalLayout { Text { text: "input type: "; color: Theme.text; vertical-alignment: center; } ComboBox { model: ["normal", "hidden (password)"]; current-index <=> root.kind; enabled: !root.child-open; } }
        HorizontalLayout { Text { text: "permitted input: "; color: Theme.text; vertical-alignment: center; } Btn { horizontal-stretch: 1; text: root.matcher; enabled: !root.child-open; clicked => { root.action("matcher"); } } }
        if root.error != "": Text { text: root.error; color: Theme.error; wrap: word-wrap; }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout { alignment: end; spacing: 6px; Btn { text: "apply"; enabled: !root.child-open; clicked => { root.action("apply"); } } Btn { text: "cancel"; clicked => { root.action("cancel"); } } }
    }
}
export component LoginCredentialsWindow inherits Window {
    in property <string> title-suffix: "";
    // the title as composed, for tests and the platform
    out property <string> composed-title: root.title;
    title: ("edit login credentials") + root.title-suffix;
    preferred-width: 760px;
    preferred-height: 360px;
    background: Theme.window;
    in property <[LoginCredentialRow]> rows;
    in property <string> question;
    in property <string> error;
    callback edited(int, string);
    callback action(string);
    callback closed();
    VerticalLayout {
        padding: 12px; spacing: 8px;
        ScrollView { vertical-stretch: 1; VerticalLayout { spacing: 8px;
            for row[i] in root.rows: HorizontalLayout {
                Text { text: row.name + ": "; min-width: 100px; color: Theme.text; vertical-alignment: center; }
                LineEdit { horizontal-stretch: 1; text: row.value; input-type: row.hidden ? InputType.password : InputType.text; enabled: root.question == ""; edited(value) => { root.edited(i, value); } }
                Text { text: row.label; horizontal-stretch: 1; max-width: 380px; color: row.valid ? Theme.text : Theme.error; wrap: word-wrap; vertical-alignment: center; }
            }
        } }
        if root.question != "": VerticalLayout { spacing: 6px; Text { text: root.question; color: Theme.text; wrap: word-wrap; } HorizontalLayout { alignment: end; spacing: 6px; Btn { text: "yes"; clicked => { root.action("confirm"); } } Btn { text: "no"; clicked => { root.action("back"); } } } }
        if root.error != "": Text { text: root.error; color: Theme.error; wrap: word-wrap; }
        HorizontalLayout { alignment: end; spacing: 6px; Btn { text: "apply"; enabled: root.question == ""; clicked => { root.action("apply"); } } Btn { text: "cancel"; clicked => { root.action("cancel"); } } }
    }
}
