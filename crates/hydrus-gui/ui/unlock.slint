import { Btn } from "btn.slint";
// Asked for before the client opens when a lock password is set, as the
// reference asks: until the password is right, or the window is closed. A
// wrong password is asked for again with nothing said; a blank one is warned
// about, as the reference's text dialog warns.

import { Button, LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";

export component UnlockWindow inherits Window {
    in property <string> title-suffix: "";
    // the title as composed, for tests and the platform
    out property <string> composed-title: root.title;
    title: ("hydrus client") + root.title-suffix;
    preferred-width: 360px;
    background: Theme.window;

    // the reference text dialog's warning, for a blank entry
    in property <string> warning;

    callback entered(string);
    callback cancelled();

    forward-focus: password;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        Text {
            text: "Enter your password.";
            color: Theme.text;
        }
        password := LineEdit {
            input-type: InputType.password;
            accepted(text) => {
                root.entered(text);
                self.text = "";
            }
        }
        if root.warning != "": Text {
            text: root.warning;
            color: Theme.error;
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Btn {
                text: "cancel";
                clicked => { root.cancelled(); }
            }
            Btn {
                text: "ok";
                clicked => {
                    root.entered(password.text);
                    password.text = "";
                }
            }
        }
    }
}
