import { Button, LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
export component DebugFetchWindow inherits Window {
    in property <string> title-suffix: "";
    title: (root.input-mode ? "Enter Text" : "Are you sure?") + root.title-suffix;
    preferred-width: 560px;
    background: Theme.window;
    in property <bool> input-mode: true;
    in property <string> message: "Enter the URL.";
    in-out property <string> url;
    callback accepted();
    // save bytes, copy decoded text, forget
    callback choice(int);
    callback cancelled();
    public function focus-result() { save.focus(); }
    forward-focus: keyboard;
    keyboard := FocusScope {
        forward-focus: url;
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancelled(); return accept; }
            return reject;
        }
        VerticalLayout {
            padding: 10px; spacing: 8px;
            Text { text: root.message; wrap: word-wrap; color: Theme.text; }
            url := LineEdit {
                visible: root.input-mode;
                height: root.input-mode ? self.preferred-height : 0px;
                text <=> root.url;
                accepted => { if root.url != "" { root.accepted(); } }
            }
            HorizontalLayout {
                alignment: end; spacing: 6px;
                if root.input-mode: Button { text: "apply"; enabled: root.url != ""; clicked => { root.accepted(); } }
                if root.input-mode: Button { text: "cancel"; clicked => { root.cancelled(); } }
                save := Button { visible: !root.input-mode; width: root.input-mode ? 0px : self.preferred-width; text: "save to file"; clicked => { root.choice(0); } }
                if !root.input-mode: Button { text: "copy to clipboard"; clicked => { root.choice(1); } }
                if !root.input-mode: Button { text: "forget it"; clicked => { root.cancelled(); } }
            }
        }
    }
}
