import { Btn } from "btn.slint";
import { Button, CheckBox, LineEdit, ScrollView, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
export struct PackageChoice { label: string, included: bool }
export component DownloaderExchangeWindow inherits Window {
    in property <string> window-title: root.importing ? "import downloader definitions" : "export downloader definitions";
    title: root.window-title;
    in property <string> instructions: root.importing ? "Paste reference downloader text or open a hydrus PNG. Review the definitions before importing." : "Copy reference downloader text or save a hydrus PNG to share these definitions.";
    preferred-width: 880px; preferred-height: 610px;
    background: Theme.window;
    in property <bool> importing;
    in-out property <string> text;
    out property <bool> text-read-only: !root.importing;
    out property <bool> export-empty: !root.importing && root.text == "";
    in-out property <string> path;
    in property <string> review;
    in property <string> error;
    in property <bool> ready;
    in property <bool> active;
    in property <bool> png-enabled;
    in property <bool> png-child;
    in property <bool> json-enabled;
    in property <bool> router-import;
    in property <string> overwrite-question;
    callback export-png();
    callback action(string);
    callback closed();
    in property <[PackageChoice]> package-choices;
    callback package-chosen(int, bool);
    // The reference's "add headers/bandwidth rules" button and its domain prompt.
    in property <bool> domain-enabled;
    in property <bool> domain-prompt;
    in-out property <string> domain-text;
    out property <string> domain-prompt-text: "Enter domain.";
    VerticalLayout {
        padding: 12px; spacing: 8px;
        Text { text: root.instructions; color: Theme.text; wrap: word-wrap; }
        if root.package-choices.length > 0: VerticalLayout {
            height: 170px;
            ScrollView { vertical-stretch: 1; VerticalLayout {
                for choice[index] in root.package-choices: CheckBox {
                    text: choice.label; checked: choice.included;
                    enabled: root.active && !root.png-child && root.overwrite-question == "";
                    toggled => { root.package-chosen(index, self.checked); }
                }
            } }
            HorizontalLayout {
                Btn { text: "all"; enabled: !root.png-child && root.overwrite-question == "" && !root.domain-prompt; clicked => { root.package-chosen(-1, true); } }
                Btn { text: "none"; enabled: !root.png-child && root.overwrite-question == "" && !root.domain-prompt; clicked => { root.package-chosen(-1, false); } }
                if root.domain-enabled: Btn { text: "add headers/bandwidth rules"; enabled: root.active && !root.png-child && root.overwrite-question == "" && !root.domain-prompt; clicked => { root.action("add-domain"); } }
            }
        }
        if root.domain-prompt: VerticalLayout {
            spacing: 4px;
            Text { text: root.domain-prompt-text; color: Theme.text; }
            HorizontalLayout {
                spacing: 8px;
                LineEdit { horizontal-stretch: 1; text <=> root.domain-text; accepted => { root.action("domain-ok"); } }
                Btn { text: "ok"; clicked => { root.action("domain-ok"); } }
                Btn { text: "cancel"; clicked => { root.action("domain-cancel"); } }
            }
        }
        TextEdit { vertical-stretch: 1; text <=> root.text; read-only: root.text-read-only; enabled: !root.ready && !root.png-child && root.overwrite-question == ""; }
        HorizontalLayout {
            Btn { text: root.importing ? "paste" : "copy"; enabled: !root.export-empty && !root.ready && !root.png-child && root.overwrite-question == ""; clicked => { root.action(root.importing ? "paste" : "copy"); } }
            if root.importing: Btn { text: "review text"; enabled: !root.ready && !root.png-child && root.overwrite-question == ""; clicked => { root.action("review"); } }
        }
        if root.json-enabled && root.importing: HorizontalLayout {
            Btn { text: "from json files"; enabled: !root.ready; clicked => { root.action("import-jsons"); } }
            Btn { text: "from png files"; enabled: !root.ready; clicked => { root.action("import-pngs"); } }
        }
        if root.router-import: Btn {
            text: "from pngs"; enabled: root.active && !root.ready;
            clicked => { root.action("import-pngs"); }
        }
        if !root.png-enabled || root.importing: HorizontalLayout {
            LineEdit { horizontal-stretch: 1; text <=> root.path; placeholder-text: "PNG or text file path"; enabled: !root.ready && !root.png-child && root.overwrite-question == ""; }
            if !root.router-import: Btn { text: "browse"; enabled: !root.ready && !root.png-child && root.overwrite-question == ""; clicked => { root.action("browse"); } }
            Btn { text: root.importing ? "open file" : "save PNG"; enabled: !root.export-empty && !root.ready && !root.png-child && root.overwrite-question == ""; clicked => { root.action(root.importing ? "open" : "save"); } }
        }
        if root.json-enabled && !root.importing: HorizontalLayout {
            LineEdit { horizontal-stretch: 1; text <=> root.path; placeholder-text: "JSON file path"; enabled: !root.png-child && root.overwrite-question == ""; }
            Btn { text: "browse json"; enabled: !root.png-child && root.overwrite-question == ""; clicked => { root.action("browse-json"); } }
            Btn { text: "export to json file"; enabled: !root.export-empty && !root.png-child && root.overwrite-question == ""; clicked => { root.action("save-json"); } }
        }
        if root.overwrite-question != "": VerticalLayout {
            Text { text: root.overwrite-question; wrap: word-wrap; color: Theme.text; }
            HorizontalLayout {
                Btn { text: "yes"; clicked => { root.action("yes-json"); } }
                Btn { text: "no"; clicked => { root.action("no-json"); } }
            }
        }
        if root.png-enabled && !root.importing: Btn { text: "export to png"; enabled: !root.png-child && root.overwrite-question == ""; clicked => { root.export-png(); } }
        if root.review != "": TextEdit { height: 140px; text: root.review; read-only: true; }
        if root.error != "": Text { text: root.error; color: Theme.error; wrap: word-wrap; }
        HorizontalLayout {
            alignment: end; spacing: 8px;
            if root.ready: Btn { text: "import"; clicked => { root.action("accept"); } }
            if root.ready: Btn { text: "back"; clicked => { root.action("back"); } }
            Btn { text: "cancel"; clicked => { root.action("cancel"); } }
        }
    }
}
