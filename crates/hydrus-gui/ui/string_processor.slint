// The string processor editor (the reference's `EditStringProcessorPanel`,
// bound by `src/string_processor_window.rs`; its workings are
// hydrus-gui-model's `string_editors`): its steps with up, delete, down,
// add and edit, and its test results (the starting strings and those
// strings processed, and a single example through each step, a tab each);
// and the editor of a splitter, joiner, selector/slicer or sorter step.

import { Button, CheckBox, ComboBox, LineEdit, SpinBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Asking } from "subscriptions.slint";
import { ListTable, TableRow } from "list_table.slint";

component Box inherits Rectangle {
    in property <string> title;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: 6px;
        spacing: 4px;
        Text {
            text: root.title;
            font-weight: 700;
            color: Theme.text;
        }
        @children
    }
}

component Label inherits Text {
    vertical-alignment: center;
    color: Theme.text;
}

component Tab inherits Rectangle {
    in property <string> text;
    in property <bool> current;
    callback clicked();
    height: 26px;
    min-width: label.preferred-width + 16px;
    border-width: 1px;
    border-color: Theme.border;
    background: root.current ? Theme.highlight : transparent;
    label := Text {
        text: root.text;
        color: root.current ? Theme.highlight-text : Theme.text;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

component ApplyCancel inherits HorizontalLayout {
    in property <bool> enabled: true;
    callback apply();
    callback cancel();
    alignment: end;
    spacing: 6px;
    Button {
        text: "apply";
        enabled: root.enabled;
        clicked => { root.apply(); }
    }
    Button {
        text: "cancel";
        clicked => { root.cancel(); }
    }
}

export component StringProcessorWindow inherits Window {
    in property <string> window-title: "edit string processor";
    title: root.window-title;
    preferred-width: 820px;
    preferred-height: 640px;
    background: Theme.window;
    in property <[TableRow]> steps;
    in property <bool> any-selected;
    in property <[TableRow]> starting;
    in property <[TableRow]> processed;
    in-out property <string> example;
    in property <[string]> tabs;
    in property <int> tab-index;
    in property <[TableRow]> tab-rows;
    in property <bool> asking;
    in property <string> asking-title;
    in property <string> asking-message;
    in property <[string]> asking-choices;
    in property <string> exchange-error;
    callback exchange(string);
    callback row-clicked(int, bool, bool);
    callback row-activated(int);
    callback up();
    callback delete();
    callback down();
    callback add();
    callback edit();
    callback text-clicked(int);
    callback example-edited();
    callback tab-chosen(int);
    callback chosen(int);
    callback cancelled();
    callback apply();
    callback cancel();
    callback closed();
    in property <bool> child-open;

    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        Box {
            vertical-stretch: 1;
            title: "processing steps";
            HorizontalLayout {
                spacing: 6px;
                vertical-stretch: 1;
                ListTable {
                    horizontal-stretch: 1;
                    columns: [{ title: "step", width: 600px, stretch: true }];
                    rows: root.steps;
                    row-clicked(r, ctrl, shift) => { if !root.child-open { root.row-clicked(r, ctrl, shift); } }
                    row-activated(r) => { if !root.child-open { root.row-activated(r); } }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    Button {
                        text: "\u{2191}";
                        enabled: root.any-selected && !root.asking && !root.child-open;
                        clicked => { root.up(); }
                    }
                    Button {
                        text: "X";
                        enabled: root.any-selected && !root.asking && !root.child-open;
                        clicked => { root.delete(); }
                    }
                    Button {
                        text: "\u{2193}";
                        enabled: root.any-selected && !root.asking && !root.child-open;
                        clicked => { root.down(); }
                    }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                vertical-stretch: 0;
                Button {
                    horizontal-stretch: 1;
                    text: "add";
                    enabled: !root.asking && !root.child-open;
                    clicked => { root.add(); }
                }
                Button {
                    horizontal-stretch: 1;
                    text: "edit";
                    enabled: root.any-selected && !root.asking && !root.child-open;
                    clicked => { root.edit(); }
                }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            Button { text: "import"; enabled: !root.asking && !root.child-open; clicked => { root.exchange("import"); } }
            Button { text: "export selected"; enabled: root.any-selected && !root.asking && !root.child-open; clicked => { root.exchange("export"); } }
            Button { text: "paste"; enabled: !root.asking && !root.child-open; clicked => { root.exchange("paste"); } }
        }
        if root.exchange-error != "": Text { text: root.exchange-error; color: Theme.error; wrap: word-wrap; }
        Box {
            vertical-stretch: 1;
            title: "test results";
            HorizontalLayout {
                spacing: 6px;
                ListTable {
                    columns: [{ title: "starting strings", width: 180px, stretch: true }];
                    rows: root.starting;
                    row-clicked(r, ctrl, shift) => { if !root.child-open { root.text-clicked(r); } }
                }
                ListTable {
                    columns: [{ title: "processed strings", width: 180px, stretch: true }];
                    rows: root.processed;
                }
                VerticalLayout {
                    spacing: 4px;
                    horizontal-stretch: 1;
                    Label { text: "single example string"; }
                    LineEdit {
                        text <=> root.example;
                        enabled: !root.child-open;
                        edited => { root.example-edited(); }
                    }
                    Label { text: "results for each step"; }
                    HorizontalLayout {
                        spacing: 0px;
                        alignment: start;
                        for tab[i] in root.tabs: Tab {
                            text: tab;
                            current: i == root.tab-index;
                            clicked => { if !root.child-open { root.tab-chosen(i); } }
                        }
                    }
                    ListTable {
                        vertical-stretch: 1;
                        columns: [{ title: "result", width: 200px, stretch: true }];
                        rows: root.tab-rows;
                    }
                }
            }
        }
        if root.asking: Asking {
            title: root.asking-title;
            message: root.asking-message;
            choices: root.asking-choices;
            chosen(i) => { root.chosen(i); }
            cancelled => { root.cancelled(); }
        }
        ApplyCancel {
            enabled: !root.asking && !root.child-open;
            apply => { root.apply(); }
            cancel => { root.cancel(); }
        }
    }
}

// A splitter (kind 0), joiner (1), selector/slicer (2), sorter (3),
// string match (4) or tag filter (5).
export component StringStepWindow inherits Window {
    in property <string> window-title: "edit processing step";
    title: root.window-title;
    preferred-width: 560px;
    preferred-height: 460px;
    background: Theme.window;
    in property <int> kind;
    // splitter
    in-out property <string> separator;
    in-out property <bool> max-splits-on;
    in-out property <int> max-splits: 1;
    in-out property <string> split-example;
    // joiner
    in-out property <string> joiner;
    in-out property <bool> tuple-on;
    in-out property <int> tuple-size: 2;
    // slicer
    in-out property <int> select-type;
    in-out property <int> single;
    in-out property <bool> start-on;
    in-out property <int> start;
    in-out property <bool> end-on;
    in-out property <int> end: -1;
    // sorter
    in-out property <int> sort-type;
    in-out property <bool> ascending;
    in-out property <bool> regex-on;
    in-out property <string> regex: "\\d+";
    // match
    in-out property <int> match-type;
    in-out property <string> fixed;
    in-out property <string> match-regex;
    in-out property <int> character-set;
    in-out property <bool> min-on;
    in-out property <int> min-chars: 16;
    in-out property <bool> max-on;
    in-out property <int> max-chars: 64;
    in-out property <string> match-example;
    in property <bool> show-fixed;
    in property <bool> show-match-regex;
    in property <bool> show-character-set;
    in property <bool> show-limits;
    in property <string> test-result;
    in property <bool> test-ok;
    // tag filter
    in property <string> tag-filter-message;
    in property <string> tag-filter;
    in-out property <string> tag-example;
    callback edit-tag-filter();
    in property <string> summary;
    in property <bool> invalid;
    in property <[TableRow]> texts;
    in property <[TableRow]> results;
    in property <string> veto;
    callback changed();
    callback apply();
    callback cancel();
    callback closed();
    in property <bool> child-open;

    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        if root.kind == 0: Box {
            title: "splitter values";
            HorizontalLayout {
                spacing: 6px;
                Label { text: "separator: "; }
                LineEdit {
                    text <=> root.separator;
                    edited => { root.changed(); }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                Label { text: "max splits: "; }
                CheckBox {
                    text: "no limit";
                    checked: !root.max-splits-on;
                    toggled => {
                        root.max-splits-on = !self.checked;
                        root.changed();
                    }
                }
                SpinBox {
                    enabled: root.max-splits-on;
                    minimum: 1;
                    maximum: 65535;
                    value <=> root.max-splits;
                    edited => { root.changed(); }
                }
            }
        }
        if root.kind == 1: Box {
            title: "join text";
            HorizontalLayout {
                spacing: 6px;
                Label { text: "text to join with: "; }
                LineEdit {
                    text <=> root.joiner;
                    edited => { root.changed(); }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                Label { text: "join groups of size: "; }
                CheckBox {
                    text: "merge all into one string";
                    checked: !root.tuple-on;
                    toggled => {
                        root.tuple-on = !self.checked;
                        root.changed();
                    }
                }
                SpinBox {
                    enabled: root.tuple-on;
                    minimum: 2;
                    maximum: 65535;
                    value <=> root.tuple-size;
                    edited => { root.changed(); }
                }
            }
        }
        if root.kind == 2: Box {
            title: "selector values";
            Label {
                text: "Negative indices are ok! Check the summary text to make sure your numbers are correct!";
                wrap: word-wrap;
            }
            ComboBox {
                model: ["select one item", "select range"];
                current-index <=> root.select-type;
                selected => { root.changed(); }
            }
            if root.select-type == 0: HorizontalLayout {
                spacing: 6px;
                Label { text: "index to select: "; }
                SpinBox {
                    minimum: -65536;
                    maximum: 65536;
                    value <=> root.single;
                    edited => { root.changed(); }
                }
            }
            if root.select-type == 1: HorizontalLayout {
                spacing: 6px;
                Label { text: "starting index: "; }
                CheckBox {
                    text: "start at the beginning";
                    checked: !root.start-on;
                    toggled => {
                        root.start-on = !self.checked;
                        root.changed();
                    }
                }
                SpinBox {
                    enabled: root.start-on;
                    minimum: -65536;
                    maximum: 65536;
                    value <=> root.start;
                    edited => { root.changed(); }
                }
            }
            if root.select-type == 1: HorizontalLayout {
                spacing: 6px;
                Label { text: "ending index: "; }
                CheckBox {
                    text: "finish at the end";
                    checked: !root.end-on;
                    toggled => {
                        root.end-on = !self.checked;
                        root.changed();
                    }
                }
                SpinBox {
                    enabled: root.end-on;
                    minimum: -65536;
                    maximum: 65536;
                    value <=> root.end;
                    edited => { root.changed(); }
                }
            }
        }
        if root.kind == 3: Box {
            title: "sort values";
            HorizontalLayout {
                spacing: 6px;
                Label { text: "sort type: "; }
                ComboBox {
                    model: ["human sort", "strict lexicographic", "reverse"];
                    current-index <=> root.sort-type;
                    selected => { root.changed(); }
                }
            }
            CheckBox {
                text: "ascending";
                checked <=> root.ascending;
                toggled => { root.changed(); }
            }
            HorizontalLayout {
                spacing: 6px;
                Label { text: "regex for substring sorting: "; }
                CheckBox {
                    text: "use whole string";
                    checked: !root.regex-on;
                    toggled => {
                        root.regex-on = !self.checked;
                        root.changed();
                    }
                }
                LineEdit {
                    enabled: root.regex-on;
                    text <=> root.regex;
                    edited => { root.changed(); }
                }
            }
        }
        if root.kind == 4: Box {
            title: "string match";
            HorizontalLayout {
                spacing: 6px;
                Label { text: "match type: "; }
                ComboBox {
                    model: ["any characters", "fixed characters", "character set", "regex"];
                    current-index <=> root.match-type;
                    selected => { root.changed(); }
                }
            }
            if root.show-fixed: HorizontalLayout {
                spacing: 6px;
                Label { text: "fixed text: "; }
                LineEdit {
                    text <=> root.fixed;
                    edited => { root.changed(); }
                }
            }
            if root.show-match-regex: HorizontalLayout {
                spacing: 6px;
                Label { text: "regex: "; }
                LineEdit {
                    text <=> root.match-regex;
                    edited => { root.changed(); }
                }
            }
            if root.show-match-regex || root.kind == 3: HorizontalLayout {
                spacing: 6px;
                ComboBox { horizontal-stretch: 1; model: root.favourites; current-index: -1; enabled: !root.child-open; selected(_) => { root.favourite-copied(self.current-index); } }
                Button { text: "manage favourites"; enabled: !root.child-open; clicked => { root.manage-favourites(); } }
            }
            if (root.show-match-regex || root.kind == 3) && root.favourite-status != "": Label { text: root.favourite-status; }
            if root.show-character-set: HorizontalLayout {
                spacing: 6px;
                Label { text: "character set: "; }
                ComboBox {
                    model: [
                        "alphabetic characters (a-zA-Z)",
                        "alphanumeric characters (a-zA-Z0-9)",
                        "numeric characters (0-9)",
                        "hexadecimal characters (0-9a-fA-F)",
                        "base64 characters (a-zA-z0-9+/ with = padding)",
                        "base64url characters (a-zA-z0-9-_ optionally with = padding)",
                        "base64 characters (url encoded) (a-zA-z0-9 %2B %2F with %3D padding)",
                    ];
                    current-index <=> root.character-set;
                    selected => { root.changed(); }
                }
            }
            if root.show-limits: HorizontalLayout {
                spacing: 6px;
                Label { text: "minimum allowed number of characters: "; }
                CheckBox {
                    text: "no limit";
                    checked: !root.min-on;
                    toggled => {
                        root.min-on = !self.checked;
                        root.changed();
                    }
                }
                SpinBox {
                    enabled: root.min-on;
                    minimum: 1;
                    maximum: 65535;
                    value <=> root.min-chars;
                    edited => { root.changed(); }
                }
            }
            if root.show-limits: HorizontalLayout {
                spacing: 6px;
                Label { text: "maximum allowed number of characters: "; }
                CheckBox {
                    text: "no limit";
                    checked: !root.max-on;
                    toggled => {
                        root.max-on = !self.checked;
                        root.changed();
                    }
                }
                SpinBox {
                    enabled: root.max-on;
                    minimum: 1;
                    maximum: 65535;
                    value <=> root.max-chars;
                    edited => { root.changed(); }
                }
            }
            if root.show-limits: HorizontalLayout {
                spacing: 6px;
                Label { text: "example string: "; }
                LineEdit {
                    text <=> root.match-example;
                    edited => { root.changed(); }
                }
            }
            if root.test-result != "": Label {
                text: root.test-result;
                wrap: word-wrap;
                color: root.test-ok ? Theme.text : Theme.error;
            }
        }
        if root.kind == 5: Box {
            title: "string tag filter";
            Label {
                text: root.tag-filter-message;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 6px;
                Label { text: "tag filter: "; }
                Button {
                    horizontal-stretch: 1;
                    text: root.tag-filter;
                    enabled: !root.child-open;
                    clicked => { root.edit-tag-filter(); }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                Label { text: "example string: "; }
                LineEdit {
                    text <=> root.tag-example;
                    edited => { root.changed(); }
                }
            }
            Label {
                text: root.test-result;
                wrap: word-wrap;
                color: root.test-ok ? Theme.text : Theme.error;
            }
        }
        if root.summary != "": Label {
            text: root.summary;
            horizontal-alignment: center;
        }
        if root.invalid: Label {
            text: "(invalid)";
            color: Theme.error;
        }
        if root.kind >= 4: Rectangle { vertical-stretch: 1; }
        if root.kind < 4: Box {
            vertical-stretch: 1;
            title: "test results";
            if root.kind == 0: HorizontalLayout {
                spacing: 6px;
                Label { text: "example string: "; }
                LineEdit {
                    text <=> root.split-example;
                    edited => { root.changed(); }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                vertical-stretch: 1;
                if root.kind != 0: ListTable {
                    columns: [{ title: "strings", width: 200px, stretch: true }];
                    rows: root.texts;
                }
                ListTable {
                    columns: [{ title: "result", width: 200px, stretch: true }];
                    rows: root.results;
                }
            }
        }
        if root.veto != "": Label {
            text: root.veto;
            wrap: word-wrap;
            color: Theme.error;
        }
        ApplyCancel {
            enabled: !root.child-open;
            apply => { root.apply(); }
            cancel => { root.cancel(); }
        }
    }
}

// A string converter's editor (`EditStringConverterPanel`): its
// conversions numbered, each with the example converted up to it.
export component StringConverterWindow inherits Window {
    in property <string> window-title: "edit string converter";
    title: root.window-title;
    preferred-width: 760px;
    preferred-height: 460px;
    background: Theme.window;
    in property <[TableRow]> rows;
    in property <bool> one-selected;
    in property <bool> any-selected;
    in property <bool> can-up;
    in property <bool> can-down;
    in-out property <string> example;
    in property <bool> asking;
    in property <string> asking-title;
    in property <string> asking-message;
    in property <[string]> asking-choices;
    in property <[string]> favourites;
    in property <string> favourite-status;
    callback favourite-copied(int);
    callback manage-favourites();
    callback row-clicked(int, bool, bool);
    callback row-activated(int);
    callback add();
    callback edit();
    callback delete();
    callback up();
    callback down();
    callback example-edited();
    callback chosen(int);
    callback cancelled();
    callback apply();
    callback cancel();
    callback closed();
    in property <bool> child-open;

    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 6px;
            vertical-stretch: 1;
            ListTable {
                horizontal-stretch: 1;
                columns: [
                    { title: "#", width: 40px },
                    { title: "conversion", width: 280px },
                    { title: "result", width: 280px, stretch: true },
                ];
                rows: root.rows;
                row-clicked(r, ctrl, shift) => { if !root.child-open { root.row-clicked(r, ctrl, shift); } }
                row-activated(r) => { if !root.child-open { root.row-activated(r); } }
            }
            VerticalLayout {
                spacing: 4px;
                alignment: start;
                Button {
                    text: "add";
                    enabled: !root.asking && !root.child-open;
                    clicked => { root.add(); }
                }
                Button {
                    text: "edit";
                    enabled: root.one-selected && !root.asking && !root.child-open;
                    clicked => { root.edit(); }
                }
                Button {
                    text: "delete";
                    enabled: root.any-selected && !root.asking && !root.child-open;
                    clicked => { root.delete(); }
                }
                Button {
                    text: "move up";
                    enabled: root.can-up && !root.asking && !root.child-open;
                    clicked => { root.up(); }
                }
                Button {
                    text: "move down";
                    enabled: root.can-down && !root.asking && !root.child-open;
                    clicked => { root.down(); }
                }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            Label { text: "example string: "; }
            LineEdit {
                text <=> root.example;
                        enabled: !root.child-open;
                edited => { root.example-edited(); }
            }
        }
        if root.asking: Asking {
            title: root.asking-title;
            message: root.asking-message;
            choices: root.asking-choices;
            chosen(i) => { root.chosen(i); }
            cancelled => { root.cancelled(); }
        }
        ApplyCancel {
            enabled: !root.asking && !root.child-open;
            apply => { root.apply(); }
            cancel => { root.cancel(); }
        }
    }
}

// A conversion's editor (`_ConversionPanel`): its type and the fields the
// type has, and the example converted.
export component ConversionWindow inherits Window {
    in property <string> window-title: "edit conversion";
    title: root.window-title;
    preferred-width: 560px;
    preferred-height: 380px;
    background: Theme.window;
    in property <[string]> types;
    in-out property <int> kind;
    in property <string> text-label;
    in-out property <string> text;
    in property <string> number-label;
    in property <int> number-min;
    in-out property <int> number;
    in property <[string]> encodings;
    in property <bool> show-encoding;
    in-out property <int> encoding;
    in property <bool> show-decoding;
    in-out property <int> decoding;
    in property <bool> show-regex;
    in-out property <string> pattern;
    in-out property <string> replacement;
    in property <bool> show-date-link;
    in property <bool> show-timezone-decode;
    in-out property <int> timezone-decode;
    in property <bool> show-timezone-offset;
    in-out property <int> timezone-offset;
    in property <bool> show-timezone-encode;
    in-out property <int> timezone-encode;
    in property <[string]> hashes;
    in property <bool> show-hash;
    in-out property <int> hash;
    in property <string> dateparser-note;
    in property <string> example;
    in property <string> result;
    in property <bool> asking;
    in property <string> asking-title;
    in property <string> asking-message;
    in property <[string]> asking-choices;
    callback changed();
    callback chosen(int);
    callback cancelled();
    callback apply();
    callback cancel();
    callback closed();

    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        Box {
            title: "string conversion step";
            HorizontalLayout {
                spacing: 6px;
                Label { text: "conversion type: "; }
                ComboBox {
                    model: root.types;
                    current-index <=> root.kind;
                    selected => { root.changed(); }
                }
            }
            if root.text-label != "": HorizontalLayout {
                spacing: 6px;
                Label { text: root.text-label; }
                LineEdit {
                    text <=> root.text;
                    edited => { root.changed(); }
                }
            }
            if root.number-label != "": HorizontalLayout {
                spacing: 6px;
                Label { text: root.number-label; }
                SpinBox {
                    minimum: root.number-min;
                    maximum: 65535;
                    value <=> root.number;
                    edited => { root.changed(); }
                }
            }
            if root.show-encoding: HorizontalLayout {
                spacing: 6px;
                Label { text: "encoding type: "; }
                ComboBox {
                    model: root.encodings;
                    current-index <=> root.encoding;
                    selected => { root.changed(); }
                }
            }
            if root.show-decoding: HorizontalLayout {
                spacing: 6px;
                Label { text: "decoding type: "; }
                ComboBox {
                    model: root.encodings;
                    current-index <=> root.decoding;
                    selected => { root.changed(); }
                }
            }
            if root.show-regex: HorizontalLayout {
                spacing: 6px;
                Label { text: "regex pattern: "; }
                LineEdit {
                    text <=> root.pattern;
                    edited => { root.changed(); }
                }
            }
            if root.show-regex: HorizontalLayout {
                spacing: 6px;
                Label { text: "regex replacement: "; }
                LineEdit {
                    text <=> root.replacement;
                    edited => { root.changed(); }
                }
            }
            if root.show-date-link: HorizontalLayout {
                spacing: 6px;
                Label { text: "date info: "; }
                Label { text: "https://docs.python.org/3/library/datetime.html#strftime-strptime-behavior"; }
            }
            if root.show-timezone-decode: HorizontalLayout {
                spacing: 6px;
                Label { text: "date decode timezone: "; }
                ComboBox {
                    model: ["UTC", "Local", "Offset"];
                    current-index <=> root.timezone-decode;
                    selected => { root.changed(); }
                }
            }
            if root.show-timezone-offset: HorizontalLayout {
                spacing: 6px;
                Label { text: "timezone offset: "; }
                SpinBox {
                    minimum: -86400;
                    maximum: 86400;
                    value <=> root.timezone-offset;
                    edited => { root.changed(); }
                }
            }
            if root.show-timezone-encode: HorizontalLayout {
                spacing: 6px;
                Label { text: "date encode timezone: "; }
                ComboBox {
                    model: ["UTC", "Local"];
                    current-index <=> root.timezone-encode;
                    selected => { root.changed(); }
                }
            }
            if root.show-hash: HorizontalLayout {
                spacing: 6px;
                Label { text: "hashing function: "; }
                ComboBox {
                    model: root.hashes;
                    current-index <=> root.hash;
                    selected => { root.changed(); }
                }
            }
            if root.dateparser-note != "": Label {
                text: root.dateparser-note;
                wrap: word-wrap;
            }
        }
        Box {
            title: "test results";
            HorizontalLayout {
                spacing: 6px;
                Label { text: "example string: "; }
                LineEdit {
                    read-only: true;
                    text: root.example;
                }
            }
            HorizontalLayout {
                spacing: 6px;
                Label { text: "converted string: "; }
                LineEdit {
                    read-only: true;
                    text: root.result;
                }
            }
        }
        Rectangle { vertical-stretch: 1; }
        if root.asking: Asking {
            title: root.asking-title;
            message: root.asking-message;
            choices: root.asking-choices;
            chosen(i) => { root.chosen(i); }
            cancelled => { root.cancelled(); }
        }
        ApplyCancel {
            enabled: !root.asking;
            apply => { root.apply(); }
            cancel => { root.cancel(); }
        }
    }
}
