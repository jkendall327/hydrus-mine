// The media viewer's top hover frame's row of buttons (the reference's
// `CanvasHoverFrameTop` and, for the browser, its
// `CanvasHoverFrameTopNavigableList`): on the left, first, previous, the
// file's place in the list, next, last, random and slideshow; in the middle
// the file's archive, trash, delete, undelete and metadata buttons; on the
// right the zoom, zoom buttons, the zoom options, the volume control, the
// shortcuts and view options menus, moving the window, fullscreen, opening
// the file externally, dragging it out and closing the viewer. Each button
// says what it is, and shows its tooltip, as the reference's does.

import { MenuGroups } from "menus.slint";
import { ViewerEyeMenu, ViewerEyeButton } from "viewer_eye_menu.slint";
import { ViewerShortcutButton } from "viewer_shortcut_menu.slint";

// the tooltips that name their shortcuts, and the metadata button's
export struct TopHoverTips {
    first: string,
    previous: string,
    next: string,
    last: string,
    // the filters' back and skip (the archive/delete filter's, or the
    // duplicate filter's go back a pair and show a different pair)
    back: string,
    skip: string,
    zoom-in: string,
    zoom-out: string,
    zoom-switch: string,
    open-externally: string,
    metadata: string,
}

// a button's tooltip, as the reference's, for its user and assistive
// technology: `label` names it, `tip` is the whole tooltip
component Tipped inherits Rectangle {
    in property <string> label;
    in property <string> tip;
    // (the tooltip as Slint's Markdown takes it)
    in property <string> tip-markdown;
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.tip;
    width: 22px;
    height: 22px;
    Tooltip { text: @markdown("\{root.tip-markdown}"); }
    @children
}

// a button of the top hover frame: the reference's icon for it; a right
// click is its own callback (random's undo, the drag button's focus)
export component HoverButton inherits Tipped {
    in property <image> icon;
    callback clicked();
    callback right-clicked();
    callback pointed-click(length, length);
    callback left-pressed();
    border-radius: 3px;
    background: touch.pressed ? #ffffff40 : touch.has-hover ? #ffffff24 : transparent;
    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        source: root.icon;
    }
    touch := TouchArea {
        clicked => {
            root.clicked();
            root.pointed-click(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y);
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.left-pressed();
            }
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right) {
                root.right-clicked();
            }
        }
    }
}

// a button that opens a menu of groups (separated) of rows; a row with a
// negative id is a label, not chosen; with `right-menu`, only a right click
// opens it, and a left press is `left-pressed`
export component HoverMenuButton inherits ContextMenuArea {
    in property <image> icon;
    in property <MenuGroups> menu;
    in property <bool> right-menu;
    in property <string> label;
    in property <string> tip;
    in property <string> tip-markdown;
    callback requested();
    callback chosen(int);
    callback left-pressed();
    width: 22px;
    height: 22px;
    Menu {
        for row in root.menu.g1: MenuItem {
            title: row.label; enabled: row.id >= 0; checkable: row.checkable; checked: row.checked;
            activated => { root.chosen(row.id); }
        }
        if root.menu.g2.length > 0: MenuSeparator { }
        for row in root.menu.g2: MenuItem {
            title: row.label; enabled: row.id >= 0; checkable: row.checkable; checked: row.checked;
            activated => { root.chosen(row.id); }
        }
        if root.menu.g3.length > 0: MenuSeparator { }
        for row in root.menu.g3: MenuItem {
            title: row.label; enabled: row.id >= 0; checkable: row.checkable; checked: row.checked;
            activated => { root.chosen(row.id); }
        }
        if root.menu.g4.length > 0: MenuSeparator { }
        for row in root.menu.g4: MenuItem {
            title: row.label; enabled: row.id >= 0; checkable: row.checkable; checked: row.checked;
            activated => { root.chosen(row.id); }
        }
        if root.menu.g5.length > 0: MenuSeparator { }
        for row in root.menu.g5: MenuItem {
            title: row.label; enabled: row.id >= 0; checkable: row.checkable; checked: row.checked;
            activated => { root.chosen(row.id); }
        }
    }
    Tipped {
        label: root.label;
        tip: root.tip;
        tip-markdown: root.tip-markdown;
        border-radius: 3px;
        background: touch.pressed ? #ffffff40 : touch.has-hover ? #ffffff24 : transparent;
        Image {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            source: root.icon;
        }
        touch := TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left && root.right-menu) {
                    root.left-pressed();
                }
                if (event.kind == PointerEventKind.up
                    && ((event.button == PointerEventButton.left && !root.right-menu)
                        || (event.button == PointerEventButton.right && root.right-menu))) {
                    root.requested();
                    if (root.menu.g1.length + root.menu.g2.length > 0) {
                        root.show({ x: 0px, y: root.height });
                    }
                }
            }
        }
    }
}

// the reference's `VolumeControl`: the global mute; with the pointer on it,
// below it the viewer's own mute and the volume (`_PopupWindow`)
component TopVolume inherits Tipped {
    in property <bool> global-muted;
    in property <bool> viewer-muted;
    in property <int> volume;
    callback flip-global-mute();
    callback flip-viewer-mute();
    callback volume-changed(int);
    // the popup opening and shutting
    callback opened(bool);
    property <bool> open: touch.has-hover || popup-touch.has-hover || popup-touch.pressed;
    changed open => { root.opened(self.open); }
    property <length> track: 100px;
    border-radius: 3px;
    background: touch.pressed ? #ffffff40 : touch.has-hover ? #ffffff24 : transparent;
    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        source: root.global-muted ? @image-url("../../../static/mute.png") : @image-url("../../../static/sound.png");
    }
    touch := TouchArea {
        clicked => { root.flip-global-mute(); }
    }
    popup-touch := TouchArea {
        x: 0;
        y: root.height;
        width: root.width;
        height: root.open ? root.track + 24px + 20px : 0;
        if root.open: Rectangle {
            background: #303030;
            border-width: 1px;
            border-color: #606060;
            Rectangle {
                x: (parent.width - 16px) / 2;
                y: 4px;
                width: 16px;
                height: 16px;
                accessible-role: button;
                accessible-label: "Mute/unmute: media viewer";
                accessible-description: "Mute/unmute: media viewer";
                Image {
                    width: 16px;
                    height: 16px;
                    source: root.viewer-muted ? @image-url("../../../static/mute.png") : @image-url("../../../static/sound.png");
                }
            }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: 34px;
                width: 4px;
                height: root.track;
                background: #606060;
            }
            Rectangle {
                x: 4px;
                y: 34px + root.track * (1 - root.volume / 100) - 3px;
                width: parent.width - 8px;
                height: 6px;
                background: #b0b0b0;
            }
        }
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                if (self.mouse-y < 24px) {
                    root.flip-viewer-mute();
                } else {
                    root.volume-changed(max(0, min(100, round((34px + root.track - self.mouse-y) / root.track * 100))));
                }
            }
        }
        moved => {
            if (self.pressed && self.pressed-y >= 24px) {
                root.volume-changed(max(0, min(100, round((34px + root.track - self.mouse-y) / root.track * 100))));
            }
        }
    }
}

// the move button's resize menu (`_ShowWindowResizeOptionsMenu`): drawn
// here rather than as a native menu, since an entry may be chosen with
// either button, and the reference remembers which
component ResizeMenu inherits PopupWindow {
    callback chosen(int, bool);
    close-policy: close-on-click-outside;
    property <[string]> entries: ["resize to fit", "-", "resize to 50%", "resize to 75%", "resize to 100%",
        "resize to 150%", "resize to 200%", "-",
        "Right click any of the above to skip centering the media in the viewer window before zooming and/or resizing."];
    // (each entry's place among the choices, past the separators)
    property <[int]> choices: [0, -1, 1, 2, 3, 4, 5, -1, 6];
    Rectangle {
        background: #2b2b2b;
        border-width: 1px;
        border-color: #606060;
        VerticalLayout {
            padding: 3px;
            for entry[i] in root.entries: VerticalLayout {
                if entry == "-": Rectangle {
                    height: 7px;
                    Rectangle {
                        y: 3px;
                        height: 1px;
                        background: #606060;
                    }
                }
                // (found by its text; the note wraps)
                if entry != "-": Rectangle {
                    min-height: 22px;
                    background: touch.has-hover ? #ffffff24 : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 3px;
                        padding-bottom: 3px;
                        Text {
                            text: entry;
                            color: #f0f0f0;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    touch := TouchArea {
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.up
                                && (event.button == PointerEventButton.left || event.button == PointerEventButton.right)) {
                                root.chosen(root.choices[i], event.button == PointerEventButton.right);
                                root.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

export component ViewerTopHoverRow inherits HorizontalLayout {
    // whose row it is: the media viewer's (0), the archive/delete
    // filter's (1) or the duplicate filter's (2), which differ on the left
    in property <int> kind;
    // the file's place in the list ("3/14") and its zoom ("100%")
    in property <string> index-text;
    in property <string> zoom-text;
    in property <TopHoverTips> tips;
    in property <bool> file-inbox;
    in property <bool> file-trashed;
    in property <bool> file-local;
    in property <bool> file-undeletable;
    // the volume control shows where mpv is available
    in property <bool> volume-available;
    in property <bool> global-muted;
    in property <bool> viewer-muted;
    in property <int> volume;
    in property <MenuGroups> slideshow-menu;
    in property <MenuGroups> zoom-menu;
    in property <[string]> shortcut-names;
    in property <[bool]> shortcut-current;
    in property <[bool]> shortcut-defaults;
    in property <ViewerEyeMenu> eye-menu;
    // the tooltips as Slint's Markdown takes them
    in property <TopHoverTips> tips-markdown;
    // the volume control's popup is open (it hangs below the row)
    out property <bool> volume-open;

    callback first();
    callback previous();
    callback next();
    callback last();
    callback random();
    callback undo-random();
    callback slideshow-requested();
    callback slideshow-chosen(int);
    callback archive();
    callback inbox();
    callback delete();
    callback undelete();
    callback show-metadata();
    callback zoom(int);
    callback zoom-switch(length, length);
    callback zoom-menu-requested();
    callback zoom-menu-chosen(int);
    callback flip-global-mute();
    callback flip-viewer-mute();
    callback volume-changed(int);
    callback shortcut-menu-requested();
    callback shortcut-menu-chosen(int, int);
    callback eye-menu-requested();
    callback eye-menu-chosen(int);
    callback back();
    callback skip();
    callback move-window();
    // an entry of the resize menu, and whether the right button chose it
    callback resize-chosen(int, bool);
    callback fullscreen();
    callback open-externally();
    callback drag-out();
    callback focus-media();
    callback close();

    spacing: 0px;
    // the left row (`_PopulateLeftButtons`): the viewer's first, previous,
    // index, next, last, random and slideshow; the archive/delete filter's
    // back, index and skip; the duplicate filter's go back a pair,
    // previous, index, next and show a different pair
    HorizontalLayout {
        horizontal-stretch: 1;
        alignment: start;
        spacing: 0px;
        if root.kind != 0: HoverButton {
            label: root.kind == 1 ? "back" : "go back a pair";
            tip: root.tips.back;
            tip-markdown: root.tips-markdown.back;
            icon: root.kind == 1 ? @image-url("../../../static/position_previous.svg") : @image-url("../../../static/position_first.svg");
            clicked => { root.back(); }
        }
        if root.kind == 0: HoverButton {
            label: "first";
            tip: root.tips.first;
            tip-markdown: root.tips-markdown.first;
            icon: @image-url("../../../static/position_first.svg");
            clicked => { root.first(); }
        }
        if root.kind != 1: HoverButton {
            label: "previous";
            tip: root.tips.previous;
            tip-markdown: root.tips-markdown.previous;
            icon: @image-url("../../../static/position_previous.svg");
            clicked => { root.previous(); }
        }
        Text {
            text: root.index-text;
            color: #f0f0f0;
            vertical-alignment: center;
        }
        if root.kind != 1: HoverButton {
            label: "next";
            tip: root.tips.next;
            tip-markdown: root.tips-markdown.next;
            icon: @image-url("../../../static/position_next.svg");
            clicked => { root.next(); }
        }
        if root.kind == 0: HoverButton {
            label: "last";
            tip: root.tips.last;
            tip-markdown: root.tips-markdown.last;
            icon: @image-url("../../../static/position_last.svg");
            clicked => { root.last(); }
        }
        if root.kind != 0: HoverButton {
            label: root.kind == 1 ? "skip" : "show a different pair";
            tip: root.tips.skip;
            tip-markdown: root.tips-markdown.skip;
            icon: root.kind == 1 ? @image-url("../../../static/position_next.svg") : @image-url("../../../static/position_last.svg");
            clicked => { root.skip(); }
        }
        if root.kind == 0: HoverButton {
            label: "random";
            tip: "random - right-click to undo showing random media";
            tip-markdown: "random \\- right\\-click to undo showing random media";
            icon: @image-url("../../../static/position_random.svg");
            clicked => { root.random(); }
            right-clicked => { root.undo-random(); }
        }
        if root.kind == 0: HoverMenuButton {
            label: "slideshow";
            tip: "slideshow";
            tip-markdown: "slideshow";
            icon: @image-url("../../../static/slideshow.svg");
            menu: root.slideshow-menu;
            requested => { root.slideshow-requested(); }
            chosen(id) => { root.slideshow-chosen(id); }
        }
    }
    // the middle row (`_PopulateCenterButtons`)
    HorizontalLayout {
        spacing: 0px;
        // (the archive/delete filter's always archives: keeps)
        HoverButton {
            label: root.file-inbox || root.kind == 1 ? "archive" : "return to inbox";
            tip: self.label;
            tip-markdown: self.label;
            icon: root.file-inbox || root.kind == 1 ? @image-url("../../../static/archive.png") : @image-url("../../../static/to_inbox.png");
            clicked => {
                if (root.file-inbox || root.kind == 1) {
                    root.archive();
                } else {
                    root.inbox();
                }
            }
        }
        // (send to trash for a local file, or from the trash delete completely)
        if !root.file-trashed && root.file-local: HoverButton {
            label: "send to trash";
            tip: self.label;
            tip-markdown: self.label;
            icon: @image-url("../../../static/trash.png");
            clicked => { root.delete(); }
        }
        if root.file-trashed: HoverButton {
            label: "delete completely";
            tip: self.label;
            tip-markdown: self.label;
            icon: @image-url("../../../static/delete.png");
            clicked => { root.delete(); }
        }
        if root.file-undeletable: HoverButton {
            label: "undelete";
            tip: self.label;
            tip-markdown: self.label;
            icon: @image-url("../../../static/undelete.png");
            clicked => { root.undelete(); }
        }
        HoverButton {
            label: "show detailed file metadata";
            tip: root.tips.metadata;
            tip-markdown: root.tips-markdown.metadata;
            icon: @image-url("../../../static/page_with_text.png");
            clicked => { root.show-metadata(); }
        }
    }
    // the right row (`_PopulateRightButtons`)
    HorizontalLayout {
        horizontal-stretch: 1;
        alignment: end;
        spacing: 0px;
        Text {
            text: root.zoom-text;
            color: #f0f0f0;
            vertical-alignment: center;
        }
        HoverButton {
            label: "zoom in";
            tip: root.tips.zoom-in;
            tip-markdown: root.tips-markdown.zoom-in;
            icon: @image-url("../../../static/zoom_in.png");
            clicked => { root.zoom(1); }
        }
        HoverButton {
            label: "zoom out";
            tip: root.tips.zoom-out;
            tip-markdown: root.tips-markdown.zoom-out;
            icon: @image-url("../../../static/zoom_out.png");
            clicked => { root.zoom(-1); }
        }
        HoverButton {
            label: "zoom switch";
            tip: root.tips.zoom-switch;
            tip-markdown: root.tips-markdown.zoom-switch;
            icon: @image-url("../../../static/zoom_switch.png");
            pointed-click(x, y) => { root.zoom-switch(x, y); }
        }
        HoverMenuButton {
            label: "advanced zoom";
            tip: "advanced zoom";
            tip-markdown: "advanced zoom";
            icon: @image-url("../../../static/zoom_cog.png");
            menu: root.zoom-menu;
            requested => { root.zoom-menu-requested(); }
            chosen(id) => { root.zoom-menu-chosen(id); }
        }
        if root.volume-available: TopVolume {
            label: "Global mute/unmute";
            tip: "Global mute/unmute";
            tip-markdown: "Global mute/unmute";
            global-muted: root.global-muted;
            viewer-muted: root.viewer-muted;
            volume: root.volume;
            flip-global-mute => { root.flip-global-mute(); }
            flip-viewer-mute => { root.flip-viewer-mute(); }
            volume-changed(v) => { root.volume-changed(v); }
            opened(open) => { root.volume-open = open; }
        }
        Tipped {
            label: "shortcuts";
            tip: "shortcuts";
            tip-markdown: "shortcuts";
            ViewerShortcutButton {
                width: 22px;
                height: 22px;
                icon: @image-url("../../../static/keyboard.png");
                names: root.shortcut-names;
                current: root.shortcut-current;
                defaults: root.shortcut-defaults;
                requested => { root.shortcut-menu-requested(); }
                chosen(kind, i) => { root.shortcut-menu-chosen(kind, i); }
            }
        }
        Tipped {
            label: "view options";
            tip: "view options";
            tip-markdown: "view options";
            ViewerEyeButton {
                width: 22px;
                height: 22px;
                menu: root.eye-menu;
                requested => { root.eye-menu-requested(); }
                chosen(id) => { root.eye-menu-chosen(id); }
            }
        }
        // (a left press moves the window; a right click offers resizes)
        HoverButton {
            label: "click and drag from here to move the window";
            tip: self.label;
            tip-markdown: self.label;
            icon: @image-url("../../../static/move.png");
            left-pressed => { root.move-window(); }
            right-clicked => { resize-menu.show(); }
            // (its right edge at the button's, so it stays in the window,
            // as a menu is moved to stay on the screen)
            resize-menu := ResizeMenu {
                x: parent.width - 320px;
                width: 320px;
                y: parent.height;
                chosen(choice, right) => { root.resize-chosen(choice, right); }
            }
        }
        HoverButton {
            label: "fullscreen switch";
            tip: self.label;
            tip-markdown: self.label;
            icon: @image-url("../../../static/fullscreen_switch.svg");
            clicked => { root.fullscreen(); }
        }
        HoverButton {
            label: "open externally";
            tip: root.tips.open-externally;
            tip-markdown: root.tips-markdown.open-externally;
            icon: @image-url("../../../static/open_externally.png");
            clicked => { root.open-externally(); }
        }
        // (the reference drags the file out from here, which Slint can't:
        // a click shows it in the file browser; a right click focuses the
        // page and the file)
        HoverButton {
            label: "drag from here to export file";
            tip: self.label;
            tip-markdown: self.label;
            icon: @image-url("../../../static/drag.png");
            clicked => { root.drag-out(); }
            right-clicked => { root.focus-media(); }
        }
        HoverButton {
            label: "close";
            tip: self.label;
            tip-markdown: self.label;
            icon: @image-url("../../../static/stop.png");
            clicked => { root.close(); }
        }
    }
}

// The filters' top hover frame (`CanvasHoverFrameTopArchiveDeleteFilter`,
// `CanvasHoverFrameTopDuplicatesFilter`): the row of buttons and, under it,
// the file's info line. It takes the pointer, so a click on it is not the
// canvas's; it is taller while the volume control's popup hangs below it.
export component TopHoverFrame inherits TouchArea {
    in property <int> kind;
    in property <string> info-line;
    in property <string> index-text;
    in property <string> zoom-text;
    in property <TopHoverTips> tips;
    in property <TopHoverTips> tips-markdown;
    in property <bool> file-inbox;
    in property <bool> file-trashed;
    in property <bool> file-local;
    in property <bool> file-undeletable;
    in property <bool> volume-available;
    in property <bool> global-muted;
    in property <bool> viewer-muted;
    in property <int> volume;
    in property <MenuGroups> zoom-menu;
    in property <[string]> shortcut-names;
    in property <[bool]> shortcut-current;
    in property <[bool]> shortcut-defaults;
    in property <ViewerEyeMenu> eye-menu;
    // the box's height (without the volume popup's), and the least width
    // its row needs (the reference's frame is no narrower than its minimum)
    out property <length> box-height: top-box.height;
    out property <length> least-width: top-row.min-width + 8px;
    out property <bool> volume-open: top-row.volume-open;

    callback back();
    callback previous();
    callback next();
    callback skip();
    callback archive();
    callback inbox();
    callback delete();
    callback undelete();
    callback show-metadata();
    callback zoom(int);
    callback zoom-switch(length, length);
    callback zoom-menu-requested();
    callback zoom-menu-chosen(int);
    callback flip-global-mute();
    callback flip-viewer-mute();
    callback volume-changed(int);
    callback shortcut-menu-requested();
    callback shortcut-menu-chosen(int, int);
    callback eye-menu-requested();
    callback eye-menu-chosen(int);
    callback move-window();
    callback resize-chosen(int, bool);
    callback fullscreen();
    callback open-externally();
    callback drag-out();
    callback focus-media();
    callback close();

    height: top-box.height + (top-row.volume-open ? 150px : 0px);
    top-box := Rectangle {
        x: 0;
        y: 0;
        height: top-layout.preferred-height;
        background: #202020e8;
        top-layout := VerticalLayout {
            padding: 4px;
            spacing: 2px;
            // (the row's place: the row is drawn after the text, so that
            // the volume popup hangs over it)
            Rectangle { height: top-row.preferred-height; }
            if root.info-line != "": Text {
                text: root.info-line;
                color: #f0f0f0;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
    }
    top-row := ViewerTopHoverRow {
        x: 4px;
        y: 4px;
        width: root.width - 8px;
        height: self.preferred-height;
        kind: root.kind;
        index-text: root.index-text;
        zoom-text: root.zoom-text;
        tips: root.tips;
        tips-markdown: root.tips-markdown;
        file-inbox: root.file-inbox;
        file-trashed: root.file-trashed;
        file-local: root.file-local;
        file-undeletable: root.file-undeletable;
        volume-available: root.volume-available;
        global-muted: root.global-muted;
        viewer-muted: root.viewer-muted;
        volume: root.volume;
        zoom-menu: root.zoom-menu;
        shortcut-names: root.shortcut-names;
        shortcut-current: root.shortcut-current;
        shortcut-defaults: root.shortcut-defaults;
        eye-menu: root.eye-menu;
        back => { root.back(); }
        previous => { root.previous(); }
        next => { root.next(); }
        skip => { root.skip(); }
        archive => { root.archive(); }
        inbox => { root.inbox(); }
        delete => { root.delete(); }
        undelete => { root.undelete(); }
        show-metadata => { root.show-metadata(); }
        zoom(direction) => { root.zoom(direction); }
        zoom-switch(x, y) => { root.zoom-switch(x, y); }
        zoom-menu-requested => { root.zoom-menu-requested(); }
        zoom-menu-chosen(id) => { root.zoom-menu-chosen(id); }
        flip-global-mute => { root.flip-global-mute(); }
        flip-viewer-mute => { root.flip-viewer-mute(); }
        volume-changed(v) => { root.volume-changed(v); }
        shortcut-menu-requested => { root.shortcut-menu-requested(); }
        shortcut-menu-chosen(kind, i) => { root.shortcut-menu-chosen(kind, i); }
        eye-menu-requested => { root.eye-menu-requested(); }
        eye-menu-chosen(id) => { root.eye-menu-chosen(id); }
        move-window => { root.move-window(); }
        resize-chosen(id, right) => { root.resize-chosen(id, right); }
        fullscreen => { root.fullscreen(); }
        open-externally => { root.open-externally(); }
        drag-out => { root.drag-out(); }
        focus-media => { root.focus-media(); }
        close => { root.close(); }
    }
}
