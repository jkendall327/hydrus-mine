import { Btn } from "btn.slint";
import { TipButton, TipComboBox } from "tip_widgets.slint";
import { Button, CheckBox, ComboBox, SpinBox } from "std-widgets.slint";
import { ListTable, TableRow } from "list_table.slint";
import { Theme } from "theme.slint";
export component TagDisplayWindow inherits Window {
    in property <bool> application;
    in property <bool> child-open;
    in property <string> title-suffix: "";
    // the title as composed, for tests and the platform
    out property <string> composed-title: root.title;
    title: (root.application ? "manage where tag siblings and parents apply" : "display/search") + root.title-suffix;
    preferred-width: 820px; preferred-height: 660px; background: Theme.window;
    in property <[string]> services;
    in-out property <int> service-index;
    in property <bool> real-service;
    in property <string> single-tooltip;
    in property <string> selection-tooltip;
    in property <string> single-label;
    in property <string> selection-label;
    in-out property <bool> fetch-automatically;
    in-out property <int> threshold;
    in-out property <bool> override-location;
    in property <string> location-label;
    in-out property <int> write-service;
    in-out property <bool> search-namespaces;
    in-out property <bool> any-namespace;
    in-out property <bool> bare-fetch;
    in-out property <bool> namespace-fetch;
    in-out property <bool> fetch-all;
    in property <[string]> source-services;
    in-out property <int> source-index;
    in property <[TableRow]> sibling-rows;
    in property <[TableRow]> parent-rows;
    in property <string> error;
    callback service-chosen(int);
    callback filter(bool);
    callback options-changed();
    callback rule-changed(int, bool);
    callback location();
    callback source-add(bool);
    callback source-click(bool, int);
    callback source-change(bool, int);
    callback apply(); callback cancel();
    FocusScope {
        capture-key-pressed(event) => { if event.text == Key.Escape { root.cancel(); return accept; } reject }
        VerticalLayout {
            padding: 12px; spacing: 8px;
            ComboBox { enabled: !root.child-open; model: root.services; current-index <=> root.service-index; selected => { root.service-chosen(self.current-index); } }
            if !root.application: VerticalLayout {
                spacing: 8px;
                HorizontalLayout { Text { text: "Tag filter for single file views:"; color: Theme.text; } TipButton { enabled: !root.child-open; text: root.single-label; tip: root.single-tooltip; clicked => { root.filter(false); } } }
                HorizontalLayout { Text { text: "Tag filter for multiple file views:"; color: Theme.text; } TipButton { enabled: !root.child-open; text: root.selection-label; tip: root.selection-tooltip; clicked => { root.filter(true); } } }
                CheckBox { enabled: !root.child-open; text: "Fetch results as you type"; checked <=> root.fetch-automatically; toggled => { root.options-changed(); } }
                HorizontalLayout { Text { text: "Do-not-autocomplete character threshold (0 = always):"; color: Theme.text; } SpinBox { enabled: !root.child-open; minimum: 0; maximum: 256; value <=> root.threshold; edited => { root.options-changed(); } } }
                if root.real-service: VerticalLayout {
                    CheckBox { enabled: !root.child-open; text: "Override default autocomplete file domain in manage tags"; checked <=> root.override-location; toggled => { root.options-changed(); } }
                    Btn { text: "Default autocomplete location: " + root.location-label; enabled: root.override-location && !root.child-open; clicked => { root.location(); } }
                    HorizontalLayout { Text { text: "Default autocomplete tag domain:"; color: Theme.text; } ComboBox { enabled: !root.child-open; model: root.services; current-index <=> root.write-service; selected => { root.options-changed(); } } }
                }
                CheckBox { enabled: !root.child-open; text: "Search namespaces with normal input"; checked <=> root.search-namespaces; toggled => { root.rule-changed(0, self.checked); } }
                CheckBox { enabled: !root.child-open; text: "Unnamespaced input gives (any namespace) wildcard results"; checked <=> root.any-namespace; toggled => { root.rule-changed(1, self.checked); } }
                CheckBox { text: "Allow namespace:"; enabled: !root.search-namespaces && !root.child-open; checked <=> root.bare-fetch; toggled => { root.rule-changed(2, self.checked); } }
                CheckBox { text: "Allow namespace:*"; enabled: !root.search-namespaces && !root.child-open; checked <=> root.namespace-fetch; toggled => { root.rule-changed(3, self.checked); } }
                CheckBox { enabled: !root.child-open; text: "Allow *"; checked <=> root.fetch-all; toggled => { root.rule-changed(4, self.checked); } }
                Text { text: "Expansive namespace and * queries can be expensive on large libraries. Ctrl+Space fetches results manually."; wrap: word-wrap; color: Theme.text; }
            }
            if root.application: VerticalLayout {
                spacing: 6px;
                Text { text: "Services at the top have precedence. Siblings apply first, then parents. An empty list disables that relationship kind. Changes apply when you accept."; wrap: word-wrap; color: Theme.text; }
                ComboBox { enabled: !root.child-open; model: root.source-services; current-index <=> root.source-index; }
                Text { text: "sibling application"; color: Theme.text; }
                ListTable { vertical-stretch: 1; columns: [{title: "service (priority order)", width: 600px, stretch: true}]; rows: root.sibling-rows; row-clicked(i, ctrl, shift) => { root.source-click(false, i); } }
                HorizontalLayout {
                    Btn { enabled: !root.child-open; text: "add"; clicked => { root.source-add(false); } }
                    Btn { enabled: !root.child-open; text: "remove"; clicked => { root.source-change(false, 0); } }
                    Btn { enabled: !root.child-open; text: "up"; clicked => { root.source-change(false, -1); } }
                    Btn { enabled: !root.child-open; text: "down"; clicked => { root.source-change(false, 1); } }
                }
                Text { text: "parent application"; color: Theme.text; }
                ListTable { vertical-stretch: 1; columns: [{title: "service (priority order)", width: 600px, stretch: true}]; rows: root.parent-rows; row-clicked(i, ctrl, shift) => { root.source-click(true, i); } }
                HorizontalLayout {
                    Btn { enabled: !root.child-open; text: "add"; clicked => { root.source-add(true); } }
                    Btn { enabled: !root.child-open; text: "remove"; clicked => { root.source-change(true, 0); } }
                    Btn { enabled: !root.child-open; text: "up"; clicked => { root.source-change(true, -1); } }
                    Btn { enabled: !root.child-open; text: "down"; clicked => { root.source-change(true, 1); } }
                }
            }
            Rectangle { vertical-stretch: root.application ? 0 : 1; background: transparent; }
            Text { text: root.error; color: Theme.error; wrap: word-wrap; }
            HorizontalLayout { Rectangle { horizontal-stretch: 1; background: transparent; } Btn { enabled: !root.child-open; text: "apply"; clicked => { root.apply(); } } Btn { text: "cancel"; clicked => { root.cancel(); } } }
        }
    }
}
