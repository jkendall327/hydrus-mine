import { Btn } from "btn.slint";
import { Button, LineEdit, SpinBox, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { TableRow, ListTable } from "list_table.slint";
export component RelatedWeightsWindow inherits Window {
    title:"related tag weights"; width:650px; height:520px; background:Theme.window;
    in property <[TableRow]> rows;
    in property <bool> result;
    in property <bool> can-delete;
    in property <bool> can-edit;
    in property <int> sort-column;
    in property <bool> ascending;
    in property <int> phase;
    in property <string> question;
    in-out property <string> namespace;
    in-out property <int> weight:100;
    in property <string> error;
    callback choose(bool);
    callback sort(int, bool);
    callback clicked(int,bool,bool);
    callback action(string);
    VerticalBox {
        padding:12px; spacing:8px;
        HorizontalBox {
            Btn {text:"adjust scores by search tags"; primary:!root.result; enabled:root.phase==0; clicked=>{root.choose(false);} }
            Btn {text:"adjust scores by suggested tags"; primary:root.result; enabled:root.phase==0; clicked=>{root.choose(true);} }
        }
        ListTable { columns:[{title:"tag slice",width:400px,stretch:true},{title:"weight",width:100px,stretch:false}]; rows:root.rows; sort-column:root.sort-column; ascending:root.ascending; sort(c,a)=>{root.sort(c,a);} vertical-stretch:1; row-clicked(i,c,s)=>{root.clicked(i,c,s);} row-activated(_)=>{root.action("edit");} }
        HorizontalBox {
            Btn {text:"add"; enabled:root.phase==0; clicked=>{root.action("add");}}
            Btn {text:"edit"; enabled:root.phase==0 && root.can-edit; clicked=>{root.action("edit");}}
            Btn {text:"delete"; enabled:root.phase==0 && root.can-delete; clicked=>{root.action("delete");}}
        }
        if root.phase>0: VerticalBox {
            Text {text:root.question; color:Theme.text;}
            if root.phase==1: LineEdit {text<=>root.namespace; accepted=>{root.action("accept-question");}}
            if root.phase==2: SpinBox {value<=>root.weight; minimum:0; maximum:10000;}
            HorizontalBox { Btn {text:"ok"; clicked=>{root.action("accept-question");}} Btn {text:"cancel"; clicked=>{root.action("cancel-question");}} }
        }
        Text {text:root.error; color:Theme.text; wrap:word-wrap;}
        HorizontalBox {alignment:end; Btn {text:"apply"; enabled:root.phase==0; clicked=>{root.action("apply");}} Btn {text:"cancel"; clicked=>{root.action("cancel");}} }
    }
}
