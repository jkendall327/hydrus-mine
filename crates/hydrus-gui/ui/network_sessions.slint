import { Button, CheckBox, ComboBox, LineEdit, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { ListTable, TableColumn, TableRow } from "list_table.slint";
import { Theme } from "theme.slint";
export component NetworkDataWindow inherits Window {
    in property <string> window-title;
    in property <string> title-suffix: "";
    // the title as composed, for tests and the platform
    out property <string> composed-title: root.title;
    title: (root.window-title) + root.title-suffix; width: 1100px; height: 620px; background: Theme.window;
    in property <[TableColumn]> columns; in property <[TableRow]> rows;
    in property <bool> browser; in property <bool> cookies; in property <bool> editing;
    in property <bool> can-edit; in property <bool> can-delete;
    in property <int> sort-column; in property <bool> ascending: true;
    in property <string> message; in property <string> description; in property <string> error; in property <string> question;
    in-out property <string> filter; in-out property <bool> show-empty;
    callback row-clicked(int,bool,bool); callback sort(int,bool); callback filter-changed();
    callback add-clicked(); callback edit-clicked(); callback duplicate-clicked(); callback delete-clicked();
    callback export-clicked(); callback import-clipboard-clicked(); callback import-file-clicked();
    callback refresh-clicked(); callback answered(bool); callback apply-clicked(); callback cancel-clicked();
    VerticalBox { padding: 12px; spacing: 8px;
        Text { text: root.description; color: Theme.text; wrap: word-wrap; }
        HorizontalBox {
            LineEdit { placeholder-text: "filter rows"; text <=> root.filter; edited => { root.filter-changed(); } }
            if root.browser: CheckBox { text: "show empty"; checked <=> root.show-empty; toggled => { root.filter-changed(); } }
        }
        ListTable { columns: root.columns; rows: root.rows; sort-column: root.sort-column; ascending: root.ascending; vertical-stretch: 1;
            row-clicked(i,c,s) => { if !root.editing && root.question == "" { root.row-clicked(i,c,s); } }
            row-activated(i) => { if !root.editing && root.question == "" { root.row-clicked(i,false,false); root.edit-clicked(); } }
            sort(i,a) => { root.sort(i,a); }
            delete-pressed => { root.delete-clicked(); }
        }
        HorizontalBox {
            Button { text: root.browser ? "create new" : "add"; enabled: !root.editing && root.question == ""; clicked => { root.add-clicked(); } }
            Button { text: root.browser ? "review" : "edit"; enabled: root.can-edit && !root.editing && root.question == ""; clicked => { root.edit-clicked(); } }
            Button { text: root.browser ? "clear" : "delete"; enabled: root.can-delete && !root.editing && root.question == ""; clicked => { root.delete-clicked(); } }
            if !root.browser && !root.cookies: Button { text: "duplicate"; enabled: root.can-delete && !root.editing; clicked => { root.duplicate-clicked(); } }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "refresh"; enabled: !root.editing; clicked => { root.refresh-clicked(); } }
        }
        if root.browser || root.cookies: HorizontalBox {
            Button { text: "export to clipboard"; enabled: root.can-delete && !root.editing && root.question == ""; clicked => { root.export-clicked(); } }
            Button { text: "import from clipboard"; enabled: !root.editing && root.question == ""; clicked => { root.import-clipboard-clicked(); } }
            Button { text: "import cookies.txt"; enabled: !root.editing && root.question == ""; clicked => { root.import-file-clicked(); } }
        }
        Text { text: root.message; color: Theme.text; wrap: word-wrap; }
        Text { text: root.error; color: Theme.error; wrap: word-wrap; }
        if root.question != "": VerticalBox {
            Text { text: root.question; color: Theme.text; wrap: word-wrap; }
            HorizontalBox { Button { text: "yes"; clicked => { root.answered(true); } } Button { text: "no"; clicked => { root.answered(false); } } }
        }
        HorizontalBox { Rectangle { horizontal-stretch: 1; }
            if !root.browser: Button { text: "apply"; enabled: !root.editing && root.question == ""; clicked => { root.apply-clicked(); } }
            Button { text: root.browser ? "close" : "cancel"; clicked => { root.cancel-clicked(); } }
        }
    }
}
export component EditNetworkValueWindow inherits Window {
    in property <string> title-suffix: "";
    // the title as composed, for tests and the platform
    out property <string> composed-title: root.title;
    in property <string> window-title; title: root.window-title + root.title-suffix; width: 680px; height: 560px; background: Theme.window;
    in property <bool> cookie; in property <bool> session-only;
    in-out property <bool> global; in-out property <bool> session-cookie; in-out property <bool> secure;
    in-out property <string> name; in-out property <string> value; in-out property <string> domain; in-out property <string> path;
    in-out property <string> expires; in-out property <string> expiry-delta: "2592000"; in-out property <string> reason;
    in-out property <int> approval; in property <string> error;
    // (a new session's context: a web domain or a hydrus service, as the
    // reference's context editor limits it)
    in-out property <int> context-type; in property <string> type-info;
    in property <[string]> service-names; in-out property <int> service-index;
    callback type-changed();
    callback delta-clicked(); callback apply-clicked(); callback cancel-clicked();
    VerticalBox { padding: 16px; spacing: 8px;
        if root.session-only: VerticalBox {
            ComboBox { model: ["web domain", "hydrus service"]; current-index <=> root.context-type; selected => { root.type-changed(); } }
            Text { text: root.type-info; color: Theme.text; wrap: word-wrap; }
            ComboBox { model: root.service-names; current-index <=> root.service-index; enabled: root.context-type == 1; }
        }
        if !root.cookie && !root.session-only: CheckBox { text: "global context"; checked <=> root.global; }
        HorizontalBox { Text { text: root.cookie ? "domain" : "web domain"; color: Theme.text; width: 140px; }
            LineEdit { text <=> root.domain; enabled: !root.global && (!root.session-only || root.context-type == 0); placeholder-text: "example.com"; } }
        if !root.session-only: VerticalBox {
            HorizontalBox { Text { text: root.cookie ? "name" : "header key"; color: Theme.text; width: 140px; } LineEdit { text <=> root.name; } }
            HorizontalBox { Text { text: root.cookie ? "value" : "header value"; color: Theme.text; width: 140px; } LineEdit { text <=> root.value; } }
            if root.cookie: VerticalBox {
                HorizontalBox { Text { text: "path"; color: Theme.text; width: 140px; } LineEdit { text <=> root.path; } }
                CheckBox { text: "secure (HTTPS only)"; checked <=> root.secure; }
                CheckBox { text: "session cookie (does not expire)"; checked <=> root.session-cookie; }
                HorizontalBox { Text { text: "expires (UTC seconds)"; color: Theme.text; width: 160px; } LineEdit { text <=> root.expires; enabled: !root.session-cookie; } }
                HorizontalBox { LineEdit { text <=> root.expiry-delta; placeholder-text: "seconds from now"; } Button { text: "set expires from now"; clicked => { root.delta-clicked(); } } }
            }
            if !root.cookie: VerticalBox {
                HorizontalBox { Text { text: "current state"; color: Theme.text; width: 140px; } ComboBox { model: ["approved - will use it", "denied - will not use it", "pending - will ask the user on next use"]; current-index <=> root.approval; } }
                HorizontalBox { Text { text: "description (optional)"; color: Theme.text; width: 140px; } LineEdit { text <=> root.reason; } }
            }
        }
        Text { text: root.error; color: Theme.error; wrap: word-wrap; }
        Rectangle { vertical-stretch: 1; }
        HorizontalBox { Rectangle { horizontal-stretch: 1; } Button { text: "ok"; clicked => { root.apply-clicked(); } } Button { text: "cancel"; clicked => { root.cancel-clicked(); } } }
    }
}

export component CookieImportWindow inherits Window {
    in property <string> title-suffix: "";
    // the title as composed, for tests and the platform
    out property <string> composed-title: root.title;
    title: ("import cookies") + root.title-suffix; width: 700px; height: 350px; background: Theme.window;
    in property <string> message; in property <bool> choosing;
    in property <string> matching-label;
    callback action(string);
    VerticalBox { padding: 16px; spacing: 12px;
        Text { text: root.message; color: Theme.text; wrap: word-wrap; }
        Rectangle { vertical-stretch: 1; }
        if root.choosing: VerticalBox {
            Button { text: root.matching-label; clicked => { root.action("matching"); } }
            Button { text: "import everything--I intend to rename the domains"; clicked => { root.action("all"); } }
        }
        HorizontalBox {
            Rectangle { horizontal-stretch: 1; }
            if !root.choosing: Button { text: "yes"; clicked => { root.action("import"); } }
            Button { text: root.choosing ? "cancel" : "no"; clicked => { root.action("cancel"); } }
        }
    }
}

export component HeaderApprovalWindow inherits Window {
    in property <string> title-suffix: "";
    // the title as composed, for tests and the platform
    out property <string> composed-title: root.title;
    title: ("custom HTTP header approval") + root.title-suffix; width: 700px; height: 360px; background: Theme.window;
    in property <string> question; in property <string> error; in property <bool> busy;
    callback answer(bool); callback later();
    VerticalBox { padding: 18px; spacing: 12px;
        Text { text: root.question; wrap: word-wrap; color: Theme.text; }
        Text { text: root.error; wrap: word-wrap; color: Theme.error; }
        Rectangle { vertical-stretch: 1; }
        HorizontalBox { Rectangle { horizontal-stretch: 1; }
            Button { text: "yes"; enabled: !root.busy; clicked => { root.answer(true); } }
            Button { text: "no"; enabled: !root.busy; clicked => { root.answer(false); } }
            Button { text: "later"; enabled: !root.busy; clicked => { root.later(); } }
        }
    }
}
