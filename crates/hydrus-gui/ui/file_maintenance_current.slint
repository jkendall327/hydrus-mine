import { Btn } from "btn.slint";
import { Button, ComboBox, LineEdit, TabWidget } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ListTable, TableRow } from "list_table.slint";

export component FileMaintenanceWindow inherits Window {
    title: "file maintenance";
    preferred-width: 950px;
    preferred-height: 480px;
    min-width: 580px;
    background: Theme.window;
    in property <[TableRow]> rows;
    in property <string> explanation;
    in property <string> error;
    in property <string> question;
    in property <bool> can-clear;
    in property <bool> can-work;
    in property <bool> can-all;
    in property <bool> ascending: true;
    in property <int> sort-column;
    callback clicked(int, bool, bool);
    callback sorted(int, bool);
    callback clear-clicked();
    callback work-clicked(bool);
    callback refresh-clicked();
    callback answered(bool);
    callback close-clicked();
    // The "add new work" tab.
    in property <string> new-explanation;
    in property <[string]> predicates;
    in-out property <string> search-input;
    in property <string> search-status;
    in property <bool> searching;
    in property <string> files-label;
    in property <[string]> job-labels;
    in-out property <int> job-index;
    in property <bool> can-add;
    in property <string> new-question;
    in property <string> information;
    callback search-entered();
    callback predicate-removed(int);
    callback run-search();
    callback easy-select(bool);
    callback see-description();
    callback add-job();
    callback new-answered(bool);
    callback information-closed();
    VerticalLayout {
        padding: 12px;
        spacing: 10px;
        TabWidget {
        Tab {
        title: "scheduled work";
        VerticalLayout {
        spacing: 10px;
        Text { text: root.explanation; wrap: word-wrap; color: Theme.text; }
        ListTable {
            columns: [{title: "job type", width: 400px, stretch: true}, {title: "due jobs", width: 180px, stretch: false}];
            rows: root.rows;
            sort-column: root.sort-column;
            ascending: root.ascending;
            row-clicked(i, ctrl, shift) => { root.clicked(i, ctrl, shift); }
            sort(c, asc) => { root.sorted(c, asc); }
            delete-pressed => { root.clear-clicked(); }
        }
        HorizontalLayout {
            Btn { text: "clear"; enabled: root.can-clear && root.question == ""; clicked => { root.clear-clicked(); } }
            Btn { text: "do work"; enabled: root.can-work && root.question == ""; clicked => { root.work-clicked(false); } }
            Btn { text: "do all work"; enabled: root.can-all && root.question == ""; clicked => { root.work-clicked(true); } }
            Btn { text: "refresh"; enabled: root.question == ""; clicked => { root.refresh-clicked(); } }
        }
        if root.question != "": VerticalLayout {
            Text { text: root.question; color: Theme.text; wrap: word-wrap; }
            HorizontalLayout {
                Btn { text: "yes"; clicked => { root.answered(true); } }
                Btn { text: "no"; clicked => { root.answered(false); } }
            }
        }
        }
        }
        Tab {
        title: "add new work";
        VerticalLayout {
            spacing: 10px;
            Text { text: root.new-explanation; wrap: word-wrap; color: Theme.text; }
            Text { text: "select files by search"; color: Theme.text; font-weight: 700; }
            LineEdit {
                text <=> root.search-input;
                placeholder-text: "enter a predicate, as the client api parses it";
                accepted => { root.search-entered(); }
            }
            for predicate[i] in root.predicates: HorizontalLayout {
                spacing: 6px;
                Text { text: predicate; color: Theme.text; vertical-alignment: center; }
                Btn { text: "remove"; clicked => { root.predicate-removed(i); } }
            }
            HorizontalLayout {
                Text { text: root.search-status; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                Btn { text: "run this search"; enabled: !root.searching; clicked => { root.run-search(); } }
            }
            Text { text: "easy select"; color: Theme.text; font-weight: 700; }
            HorizontalLayout {
                alignment: end;
                spacing: 6px;
                Btn { text: "all media files"; enabled: !root.searching; clicked => { root.easy-select(false); } }
                Btn { text: "all repository update files"; enabled: !root.searching; clicked => { root.easy-select(true); } }
            }
            Text { text: "add job"; color: Theme.text; font-weight: 700; }
            HorizontalLayout {
                spacing: 6px;
                Text { text: root.files-label; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                ComboBox { model: root.job-labels; current-index <=> root.job-index; }
                Btn { text: "see description"; clicked => { root.see-description(); } }
                Btn { text: "add job"; enabled: root.can-add && root.new-question == ""; clicked => { root.add-job(); } }
            }
            if root.new-question != "": VerticalLayout {
                Text { text: root.new-question; color: Theme.text; wrap: word-wrap; }
                HorizontalLayout {
                    Btn { text: "do it"; clicked => { root.new-answered(true); } }
                    Btn { text: "forget it"; clicked => { root.new-answered(false); } }
                }
            }
            if root.information != "": VerticalLayout {
                Text { text: root.information; color: Theme.text; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: start;
                    Btn { text: "ok"; clicked => { root.information-closed(); } }
                }
            }
        }
        }
        }
        if root.error != "": Text { text: root.error; wrap: word-wrap; color: Theme.error; }
        Btn { text: "close"; clicked => { root.close-clicked(); } }
    }
}
