{
  "menu_path": [
    "help",
    "debug",
    "report modes"
  ],
  "cache": {
    "size_limit": 1000,
    "off": [
      {
        "step": "add a (400 bytes)",
        "messages": []
      },
      {
        "step": "add b (400 bytes)",
        "messages": []
      },
      {
        "step": "add c (400 bytes)",
        "messages": []
      },
      {
        "step": "add d (100 bytes)",
        "messages": []
      },
      {
        "step": "delete c",
        "messages": []
      }
    ],
    "on": [
      {
        "step": "add a (400 bytes)",
        "messages": [
          {
            "sink": "show",
            "text": "Cache \"oracle cache\" adding \"a\" (400B). Current size 400B/1,000B."
          }
        ]
      },
      {
        "step": "add b (400 bytes)",
        "messages": [
          {
            "sink": "show",
            "text": "Cache \"oracle cache\" adding \"b\" (400B). Current size 800B/1,000B."
          }
        ]
      },
      {
        "step": "add c (400 bytes)",
        "messages": [
          {
            "sink": "show",
            "text": "Cache \"oracle cache\" adding \"c\" (400B). Current size 1.17 KB/1,000B."
          }
        ]
      },
      {
        "step": "add d (100 bytes)",
        "messages": [
          {
            "sink": "show",
            "text": "Cache \"oracle cache\" removing oldest item \"a\", size \"400B\". Current size 800B/1,000B."
          },
          {
            "sink": "show",
            "text": "Cache \"oracle cache\" adding \"d\" (100B). Current size 900B/1,000B."
          }
        ]
      },
      {
        "step": "delete c",
        "messages": [
          {
            "sink": "show",
            "text": "Cache \"oracle cache\" removing specific item \"c\", size \"400B\". Current size 500B/1,000B."
          }
        ]
      }
    ]
  },
  "subprocess": {
    "environment": {
      "HOME": "/home/oracle",
      "LANG": "C",
      "PATH": "/usr/bin:/bin"
    },
    "commands": [
      {
        "cmd": [
          "echo",
          "hello"
        ],
        "on": false,
        "messages": []
      },
      {
        "cmd": [
          "sh",
          "-c",
          "echo oops 1>&2"
        ],
        "on": false,
        "messages": []
      },
      {
        "cmd": [
          "true"
        ],
        "on": false,
        "messages": []
      },
      {
        "cmd": [
          "echo",
          "hello"
        ],
        "on": true,
        "messages": [
          {
            "sink": "show",
            "text": "Full environment:\nHOME: /home/oracle\nLANG: C\nPATH:\n    /usr/bin\n    /bin"
          },
          {
            "sink": "show",
            "text": "KWargs are: {'env': None, 'text': True, 'encoding': 'utf-8', 'errors': 'replace', 'startupinfo': None}"
          },
          {
            "sink": "show",
            "text": "stdout: 'hello\\n'"
          },
          {
            "sink": "show",
            "text": "stderr: ''"
          }
        ]
      },
      {
        "cmd": [
          "sh",
          "-c",
          "echo oops 1>&2"
        ],
        "on": true,
        "messages": [
          {
            "sink": "show",
            "text": "Full environment:\nHOME: /home/oracle\nLANG: C\nPATH:\n    /usr/bin\n    /bin"
          },
          {
            "sink": "show",
            "text": "KWargs are: {'env': None, 'text': True, 'encoding': 'utf-8', 'errors': 'replace', 'startupinfo': None}"
          },
          {
            "sink": "show",
            "text": "stdout: ''"
          },
          {
            "sink": "show",
            "text": "stderr: 'oops\\n'"
          }
        ]
      },
      {
        "cmd": [
          "true"
        ],
        "on": true,
        "messages": [
          {
            "sink": "show",
            "text": "Full environment:\nHOME: /home/oracle\nLANG: C\nPATH:\n    /usr/bin\n    /bin"
          },
          {
            "sink": "show",
            "text": "KWargs are: {'env': None, 'text': True, 'encoding': 'utf-8', 'errors': 'replace', 'startupinfo': None}"
          },
          {
            "sink": "show",
            "text": "stdout: ''"
          },
          {
            "sink": "show",
            "text": "stderr: ''"
          }
        ]
      }
    ]
  },
