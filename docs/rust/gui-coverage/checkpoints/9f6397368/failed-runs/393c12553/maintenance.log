2026-10-07T05:33:50.8367317Z   script: const refs = new Set(['refs/heads/master', 'refs/heads/codex/full-validation', 'refs/heads/codex/validation-runner']);
const familyPattern = /^(hydrus-ws-v1-check-Linux-X64-)/;
const budget = 3 * 1024 ** 3;
const entries = [];
for (let page = 1; ; page++) {
  const {data} = await github.request('GET /repos/{owner}/{repo}/actions/caches', {
    ...context.repo, page, per_page: 100
  });
  entries.push(...data.actions_caches.filter(cache => refs.has(cache.ref) && familyPattern.test(cache.key)));
  if (data.actions_caches.length < 100) break;
}
entries.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));
const counts = new Map();
let bytes = 0;
for (const cache of entries) {
  const family = cache.ref + ':' + cache.key.match(familyPattern)[1];
  const count = counts.get(family) || 0;
  if (count < 2 && bytes + cache.size_in_bytes <= budget) {
    counts.set(family, count + 1);
    bytes += cache.size_in_bytes;
    continue;
  }
  // Do not delete dependency caches, PR caches or unrelated branches.
  await github.request('DELETE /repos/{owner}/{repo}/actions/caches/{cache_id}', {
    ...context.repo, cache_id: cache.id
  });
  core.info(`Removed owned workspace snapshot ${cache.key} (${cache.size_in_bytes} bytes).`);
}
core.info(`Retained workspace snapshot bytes: ${bytes}; budget: ${budget}.`);

